<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================== -->
    <!-- 1. DESIGN TOKENS (SKILL: aura-ui-design)       -->
    <!-- ============================================== -->
    <!-- Colors -->
    <Color x:Key="ColorBgDeep">#0F1115</Color>
    <Color x:Key="ColorSurface">#171A21</Color>
    <Color x:Key="ColorSurfaceHover">#20242E</Color>
    <Color x:Key="ColorSurfacePressed">#12141A</Color>
    <Color x:Key="ColorBorder">#252A33</Color>
    <Color x:Key="ColorBorderHover">#353B47</Color>
    <Color x:Key="ColorAccent">#19D3A7</Color>
    <Color x:Key="ColorAccentHover">#33FFD6</Color>
    <Color x:Key="ColorAccentPressed">#129E7D</Color>
    <Color x:Key="ColorTextPrimary">#E8EAED</Color>
    <Color x:Key="ColorTextSecondary">#9AA3B2</Color>
    <Color x:Key="ColorTextMuted">#525768</Color>
    <Color x:Key="ColorError">#EF4444</Color>

    <!-- Legacy / Compatibility Colors -->
    <Color x:Key="ColorBgGlass">#171A21</Color>
    <Color x:Key="ColorCard">#171A21</Color>
    <Color x:Key="ColorCardHover">#20242E</Color>
    <Color x:Key="ColorInput">#171A21</Color>
    <Color x:Key="ColorAccentCyan">#19D3A7</Color>
    <Color x:Key="ColorAccentCyanHover">#33FFD6</Color>
    <Color x:Key="ColorAccentPurple">#19D3A7</Color>

    <!-- Solid Brushes (Always use Brushes for Background/Foreground/Border) -->
    <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource ColorBgDeep}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource ColorSurfaceHover}" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource ColorSurfacePressed}" />
    <SolidColorBrush x:Key="BgGlassBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource ColorSurfaceHover}" />
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource ColorBorderHover}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource ColorAccentHover}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource ColorAccentPressed}" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="AccentCyanHoverBrush" Color="{StaticResource ColorAccentHover}" />
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource ColorAccent}" />

    <!-- Dark Green Border Color for Panels & Buttons -->
    <Color x:Key="ColorBorderGreen">#1B3B2B</Color>
    <SolidColorBrush x:Key="BorderGreenBrush" Color="{StaticResource ColorBorderGreen}" />

    <!-- Minecraft Pixel Font (Pixelify Sans, OFL License) -->
    <FontFamily x:Key="PixelFont">pack://application:,,,/Resources/Fonts/#Pixelify Sans</FontFamily>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ColorError}" />

    <!-- Play Button Accent Brush -->
    <SolidColorBrush x:Key="PlayBtnBrush" Color="{StaticResource ColorAccent}" />

    <!-- ============================================== -->
    <!-- WORLD BACKGROUND IMAGE (DecodePixelWidth 1920) -->
    <!-- ============================================== -->
    <BitmapImage x:Key="WorldBackgroundBitmap"
                 UriSource="pack://application:,,,/AuraLauncher;component/bg_world.png"
                 DecodePixelWidth="1920"
                 CacheOption="OnLoad" />

    <!-- ============================================== -->
    <!-- CARD PANEL (CornerRadius 6, Hover Accent)      -->
    <!-- ============================================== -->
    <Style x:Key="CardPanel" TargetType="Border">
        <Setter Property="Background" Value="#D6121720" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderGreenBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================== -->
    <!-- 2. BUTTON STYLES                               -->
    <!-- ============================================== -->

    <!-- Primary Action Button: "ИГРАТЬ" (Accent #19D3A7, text #0F1115, PixelFont) -->
    <Style x:Key="PrimaryNeonBtn" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBrd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <TextBlock x:Name="BtnTxt"
                                   Text="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="#0F1115"
                                   FontFamily="{StaticResource PixelFont}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Hover: Background becomes #33FFD6 with 150ms animation -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBrd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>

                        <!-- Pressed: Background #129E7D -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBrd" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                        </Trigger>

                        <!-- Disabled: Background #252A33, Foreground #525768 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="BtnBrd" Property="Background" Value="{StaticResource BorderBrush}" />
                            <Setter TargetName="BtnTxt" Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Action Button: Surface #171A21, Border #1B3B2B, Text #E8EAED, CornerRadius 6 -->
    <Style x:Key="StandardBtn" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Brd"
                            Background="{TemplateBinding Background}"
                            BorderThickness="1"
                            BorderBrush="{StaticResource BorderGreenBrush}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover: Surface hover, border accent, 150 ms -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            <Setter TargetName="Brd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <!-- Pressed: Surface darker -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="{StaticResource SurfacePressedBrush}" />
                        </Trigger>
                        <!-- Focus: Highlight border with accent -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Brd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <!-- Disabled: Opacity 0.4 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ghost / Text Button: "Сбросить" (Transparent background, text #9AA3B2, hover #E8EAED) -->
    <Style x:Key="GhostBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Brd"
                            Background="{TemplateBinding Background}"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover: Text #E8EAED, light background #171A21 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="{StaticResource SurfaceBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <!-- Pressed: Darker surface #12141A -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="{StaticResource SurfacePressedBrush}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <!-- Focus -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Brd" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        </Trigger>
                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navigation Header Tab Radio Button: "ИГРАТЬ", "СКИН", "НАСТРОЙКИ" -->
    <!-- Active tab: #E8EAED + 2 px accent line (#19D3A7) at bottom, inactive: #9AA3B2, hover: #E8EAED -->
    <Style x:Key="NavTabRadio" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="HoverOverlay"
                                Background="{StaticResource SurfaceHoverBrush}"
                                Opacity="0" />
                        <Border Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <!-- 2 px Accent line at bottom (#19D3A7) -->
                        <Border x:Name="ActiveIndicator"
                                Height="2"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource AccentBrush}"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover: Text #E8EAED -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter TargetName="HoverOverlay" Property="Opacity" Value="1" />
                        </Trigger>
                        <!-- Checked (Active tab): Text #E8EAED, ActiveIndicator visible -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navigation Header Tab Button (Legacy Compatibility) -->
    <Style x:Key="NavTabBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Brd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover: Text becomes #E8EAED, subtle surface highlight #20242E -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <!-- Pressed: Surface #12141A, text white -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="{StaticResource SurfacePressedBrush}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window Caption Control Button (Minimize) -->
    <Style x:Key="WinControlBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Brd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="{StaticResource SurfacePressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window Close Button -->
    <Style x:Key="WinCloseBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Brd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="#E11D48" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="#BE123C" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================== -->
    <!-- 3. INPUTS & CONTROLS (TextBox, Slider, RAM)    -->
    <!-- ============================================== -->

    <!-- Modern Dark TextBox: Surface #171A21, Border #252A33, Focus #19D3A7 -->
    <Style x:Key="ModernTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderGreenBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Brd"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Brd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Brd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Brd" Property="Background" Value="{StaticResource SurfacePressedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RAM Selector Radio Button -->
    <Style x:Key="RamPillRadio" TargetType="RadioButton">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="62" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Brd"
                            Background="{TemplateBinding Background}"
                            BorderThickness="1"
                            BorderBrush="{StaticResource BorderBrush}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Checked State: Subtle accent tint background, accent border, accent text -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="#132B25" />
                            <Setter TargetName="Brd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <!-- Hover when Unchecked: Light surface #20242E, light border #353B47, text #E8EAED -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Brd" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            <Setter TargetName="Brd" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </MultiTrigger>
                        <!-- Hover when Checked -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Brd" Property="Background" Value="#17352E" />
                            <Setter TargetName="Brd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                        </MultiTrigger>
                        <!-- Focus -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Brd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Slider -->
    <Style x:Key="ModernSlider" TargetType="Slider">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <!-- Track -->
                        <Border Height="6" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="3" VerticalAlignment="Center" />
                        <!-- Thumb -->
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder"
                                                    Width="18" Height="18"
                                                    CornerRadius="9"
                                                    Background="{StaticResource AccentBrush}"
                                                    BorderBrush="#0F1115"
                                                    BorderThickness="2"
                                                    Cursor="Hand" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource TextMutedBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Clean ProgressBar -->
    <Style x:Key="NeonProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="2" ClipToBounds="True">
                        <Grid x:Name="TemplateRoot">
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    CornerRadius="2"
                                    Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================== -->
    <!-- 4. SLIM DARK SCROLLBAR & EXPANDER              -->
    <!-- ============================================== -->
    <Style x:Key="ScrollThumb" TargetType="{x:Type Thumb}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="Focusable" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border CornerRadius="3"
                            Background="{StaticResource BorderBrush}"
                            x:Name="ThumbBorder"
                            Margin="1" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource BorderHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Modern Dark Expander Style -->
    <Style x:Key="ModernExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Cursor="Hand"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="-90" />
                                                    </Path.RenderTransform>
                                                </Path>
                                                <ContentPresenter x:Name="HeaderContent"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  TextElement.Foreground="{StaticResource TextSecondaryBrush}"
                                                                  TextElement.FontSize="13"
                                                                  TextElement.FontWeight="SemiBold"
                                                                  VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource AccentBrush}" />
                                                <Setter TargetName="HeaderContent" Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource TextPrimaryBrush}" />
                                                <Setter TargetName="HeaderContent" Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" DockPanel.Dock="Bottom" Visibility="Collapsed" Focusable="false" Margin="0,12,0,0" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
