<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================== -->
    <!-- 1. DESIGN TOKENS (TASK 27A & 27B)              -->
    <!-- ============================================== -->
    <Color x:Key="ColorEmber">#F2A63C</Color>
    <Color x:Key="ColorEmberDark">#A85F12</Color>
    <Color x:Key="ColorInk">#EAF1EF</Color>
    <Color x:Key="ColorDimInk">#9EEAF1EF</Color> <!-- ink 62% -->
    <Color x:Key="ColorMute">#8FA7A4</Color>
    <Color x:Key="ColorLineInk">#24EAF1EF</Color> <!-- ink 14% -->
    <Color x:Key="ColorOk">#5FD39A</Color>
    <Color x:Key="ColorBad">#FF8A7A</Color>
    <Color x:Key="ColorNight">#071017</Color>

    <!-- Legacy / Compatibility Aliases -->
    <Color x:Key="ColorBgDeep">#071017</Color>
    <Color x:Key="ColorSurface">#0E171E</Color>
    <Color x:Key="ColorSurfaceHover">#14212B</Color>
    <Color x:Key="ColorSurfacePressed">#0A1218</Color>
    <Color x:Key="ColorBorder">#24EAF1EF</Color>
    <Color x:Key="ColorBorderHover">#40EAF1EF</Color>
    <Color x:Key="ColorAccent">#F2A63C</Color>
    <Color x:Key="ColorAccentHover">#F7B44F</Color>
    <Color x:Key="ColorAccentPressed">#EB962B</Color>
    <Color x:Key="ColorTextPrimary">#EAF1EF</Color>
    <Color x:Key="ColorTextSecondary">#9EEAF1EF</Color>
    <Color x:Key="ColorTextMuted">#8FA7A4</Color>
    <Color x:Key="ColorError">#FF8A7A</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="EmberBrush" Color="{StaticResource ColorEmber}" />
    <SolidColorBrush x:Key="EmberDarkBrush" Color="{StaticResource ColorEmberDark}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource ColorInk}" />
    <SolidColorBrush x:Key="DimInkBrush" Color="{StaticResource ColorDimInk}" />
    <SolidColorBrush x:Key="MuteBrush" Color="{StaticResource ColorMute}" />
    <SolidColorBrush x:Key="LineInkBrush" Color="{StaticResource ColorLineInk}" />
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource ColorOk}" />
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource ColorBad}" />
    <SolidColorBrush x:Key="NightBrush" Color="{StaticResource ColorNight}" />

    <!-- Aliases for existing views -->
    <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource ColorNight}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource ColorSurfaceHover}" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource ColorSurfacePressed}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorLineInk}" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource ColorBorderHover}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorEmber}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#F7B44F" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#EB962B" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorInk}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorDimInk}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColorMute}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ColorBad}" />

    <!-- Typography: Oswald (Headings & Menu) & Onest (Body) -->
    <FontFamily x:Key="HeadingFont">pack://application:,,,/Resources/Fonts/#Oswald, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="MainFont">pack://application:,,,/Resources/Fonts/#Onest, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="PixelFont">pack://application:,,,/Resources/Fonts/#Oswald, Segoe UI, sans-serif</FontFamily>

    <!-- WORLD BACKGROUND IMAGE -->
    <BitmapImage x:Key="WorldBackgroundBitmap"
                 UriSource="pack://application:,,,/AuraLauncher;component/bg_world.png"
                 DecodePixelWidth="1920"
                 CacheOption="OnLoad" />

    <!-- ============================================== -->
    <!-- 2. BUTTON STYLES                               -->
    <!-- ============================================== -->

    <!-- Standard Button: height 48, Oswald 600 18, padding 24, bg white 10%, bottom border 3px black 28%, radius 3px -->
    <!-- Hover: bg 17%, lift 1px. Press: depress 2px, border 1px. 120ms -->
    <Style x:Key="StandardBtn" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Height" Value="48" />
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                        <Border x:Name="OuterBrd"
                                Background="#1AFFFFFF"
                                BorderBrush="#47000000"
                                BorderThickness="0,0,0,3"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="BtnTrans" Y="0" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBrd" Property="Background" Value="#2BFFFFFF" />
                            <Setter TargetName="OuterBrd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="-1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="OuterBrd" Property="BorderThickness" Value="0,0,0,1" />
                            <Setter TargetName="OuterBrd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="2" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="OuterBrd" Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Main Button (Primary): gradient #F7B44F -> #EB962B, text #1C1106, bottom border 4px #A85F12, glow shadow ember, radius 3px -->
    <Style x:Key="PrimaryNeonBtn" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Height" Value="48" />
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="#1C1106" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="Template">
            <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OuterBrd"
                                BorderBrush="{StaticResource EmberDarkBrush}"
                                BorderThickness="0,0,0,4"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="BtnTrans" Y="0" />
                            </Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F7B44F" Offset="0" />
                                    <GradientStop Color="#EB962B" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#F2A63C" BlurRadius="12" Opacity="0.45" Direction="270" ShadowDepth="2" />
                            </Border.Effect>
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBrd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="-1" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="OuterBrd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#F2A63C" BlurRadius="18" Opacity="0.75" Direction="270" ShadowDepth="2" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="OuterBrd" Property="BorderThickness" Value="0,0,0,1" />
                            <Setter TargetName="OuterBrd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="2" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="OuterBrd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#F2A63C" BlurRadius="8" Opacity="0.2" Direction="270" ShadowDepth="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="OuterBrd" Property="Opacity" Value="0.4" />
                            <Setter TargetName="OuterBrd" Property="Effect" Value="{x:Null}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Large Play Button (260x70, font 28) with sheen sweep and bottom launch progress bar -->
    <Style x:Key="OverviewPlayBtn" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Width" Value="260" />
        <Setter Property="Height" Value="70" />
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Foreground" Value="#1C1106" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="OuterBrd"
                                BorderBrush="{StaticResource EmberDarkBrush}"
                                BorderThickness="0,0,0,4"
                                CornerRadius="3"
                                ClipToBounds="True"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="PlayBtnTrans" Y="0" />
                            </Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F7B44F" Offset="0" />
                                    <GradientStop Color="#EB962B" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#F2A63C" BlurRadius="16" Opacity="0.5" Direction="270" ShadowDepth="2" />
                            </Border.Effect>
                            <Grid>
                                <!-- Single Sheen sweep layer on hover (700ms) -->
                                <Border x:Name="SheenLayer" IsHitTestVisible="False" Opacity="0" HorizontalAlignment="Left" Width="60">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="SheenTrans" X="-70" />
                                    </Border.RenderTransform>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                            <GradientStop Color="#80FFFFFF" Offset="0.5" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover: single sheen sweep (700ms) and lift 1px -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBrd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="-1" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="OuterBrd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#F2A63C" BlurRadius="22" Opacity="0.8" Direction="270" ShadowDepth="2" />
                                </Setter.Value>
                            </Setter>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SheenLayer" Storyboard.TargetProperty="Opacity"
                                                         From="0.0" To="0.7" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="SheenTrans" Storyboard.TargetProperty="X"
                                                         From="-80" To="280" Duration="0:0:0.7">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="SheenLayer" Storyboard.TargetProperty="Opacity"
                                                         To="0.0" Duration="0:0:0.1" BeginTime="0:0:0.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="OuterBrd" Property="BorderThickness" Value="0,0,0,1" />
                            <Setter TargetName="OuterBrd" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="2" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="OuterBrd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#F2A63C" BlurRadius="8" Opacity="0.2" Direction="270" ShadowDepth="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="OuterBrd" Property="Opacity" Value="0.45" />
                            <Setter TargetName="OuterBrd" Property="Effect" Value="{x:Null}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ghost / Link button -->
    <Style x:Key="GhostBtn" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MuteBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bad / Destructive Link Button -->
    <Style x:Key="BadLinkBtn" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window Caption Controls: 32x34, hover white 10% -->
    <Style x:Key="WinControlBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MuteBrush}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Brd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="#1AFFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WinCloseBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MuteBrush}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Brd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="#1AFFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header Sound Toggle Button: 32x34, hover white 10% -->
    <Style x:Key="WinSoundBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MuteBrush}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Brd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="#1AFFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header Volume Slider (112px wide track) -->
    <Style x:Key="HeaderVolumeSlider" TargetType="Slider">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Height" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <!-- Track 4px -->
                        <Border Height="4" Background="#33FFFFFF" CornerRadius="2" VerticalAlignment="Center" />
                        <!-- Thumb -->
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder"
                                                    Width="10" Height="10"
                                                    CornerRadius="2"
                                                    Background="{StaticResource EmberBrush}"
                                                    Cursor="Hand" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#F7B44F" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RAM Selector Pill Radio Button -->
    <Style x:Key="RamPillRadio" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MuteBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,16,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                               Foreground="{TemplateBinding Foreground}"
                               TextDecorations="Underline" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource EmberBrush}" />
                            <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource InkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Settings RAM Slider (track 6px ember, thumb 14x22 radius 3) -->
    <Style x:Key="SettingsRamSlider" TargetType="Slider">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <!-- Track 6px -->
                        <Border Height="6" Background="#26FFFFFF" CornerRadius="3" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Width="14" Height="22"
                                                    CornerRadius="3"
                                                    Background="{StaticResource EmberBrush}"
                                                    BorderBrush="{StaticResource EmberDarkBrush}"
                                                    BorderThickness="1"
                                                    Cursor="Hand">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#F2A63C" BlurRadius="6" Opacity="0.4" Direction="270" ShadowDepth="1" />
                                                </Border.Effect>
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Custom CheckBox styled as Alex Toggle (46x26, radius 3, knob 20x20, ember when checked) -->
    <Style x:Key="AlexToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="SwitchTrack" Width="46" Height="26" CornerRadius="3"
                                Background="#1AFFFFFF" BorderBrush="{StaticResource LineInkBrush}" BorderThickness="1">
                            <Border x:Name="Knob" Width="20" Height="20" CornerRadius="2"
                                    Background="{StaticResource MuteBrush}"
                                    HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="KnobTrans" X="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchTrack" Property="Background" Value="#33F2A63C" />
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource EmberBrush}" />
                            <Setter TargetName="Knob" Property="Background" Value="{StaticResource EmberBrush}" />
                            <Setter TargetName="Knob" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="20" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
