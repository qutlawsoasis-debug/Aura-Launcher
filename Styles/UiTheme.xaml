<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:AuraLauncher.Behaviors"
                    xmlns:core="clr-namespace:AuraLauncher.Core">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <core:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    <core:IntToVisibilityConverter x:Key="IntToVis" />
    <core:InverseIntToVisibilityConverter x:Key="InverseIntToVis" />
    <core:BoolToEmberOrDarkBgConverter x:Key="BoolToEmberOrDarkBgConverter" />
    <core:BoolToEmberOrLineBorderConverter x:Key="BoolToEmberOrLineBorderConverter" />
    <core:BoolToInkOrDimBrushConverter x:Key="BoolToInkOrDimBrushConverter" />
    <core:BoolToInkOrMuteBrushConverter x:Key="BoolToInkOrMuteBrushConverter" />
    <core:BoolToEnabledTextConverter x:Key="BoolToEnabledTextConverter" />

    <!-- Design Tokens -->
    <Color x:Key="ColorEmber">#F2A63C</Color>
    <Color x:Key="ColorEmberDark">#A85F12</Color>
    <Color x:Key="ColorInk">#EAF1EF</Color>
    <Color x:Key="ColorDimInk">#9EEAF1EF</Color> <!-- ink 62% -->
    <Color x:Key="ColorMute">#8FA7A4</Color>
    <Color x:Key="ColorLineInk">#24EAF1EF</Color> <!-- ink 14% -->
    <Color x:Key="ColorOk">#5FD39A</Color>
    <Color x:Key="ColorBad">#FF8A7A</Color>
    <Color x:Key="ColorNight">#071017</Color>

    <!-- Legacy / Compatibility Aliases -->
    <Color x:Key="ColorBgDeep">#071017</Color>
    <Color x:Key="ColorSurface">#0E171E</Color>
    <Color x:Key="ColorSurfaceHover">#14212B</Color>
    <Color x:Key="ColorSurfacePressed">#0A1218</Color>
    <Color x:Key="ColorBorder">#24EAF1EF</Color>
    <Color x:Key="ColorBorderHover">#40EAF1EF</Color>
    <Color x:Key="ColorAccent">#F2A63C</Color>
    <Color x:Key="ColorAccentHover">#F7B44F</Color>
    <Color x:Key="ColorAccentPressed">#EB962B</Color>
    <Color x:Key="ColorTextPrimary">#EAF1EF</Color>
    <Color x:Key="ColorTextSecondary">#9EEAF1EF</Color>
    <Color x:Key="ColorTextMuted">#8FA7A4</Color>
    <Color x:Key="ColorError">#FF8A7A</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="EmberBrush" Color="{StaticResource ColorEmber}" />
    <SolidColorBrush x:Key="EmberDarkBrush" Color="{StaticResource ColorEmberDark}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource ColorInk}" />
    <SolidColorBrush x:Key="DimInkBrush" Color="{StaticResource ColorDimInk}" />
    <SolidColorBrush x:Key="MuteBrush" Color="{StaticResource ColorMute}" />
    <SolidColorBrush x:Key="LineInkBrush" Color="{StaticResource ColorLineInk}" />
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource ColorOk}" />
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource ColorBad}" />
    <SolidColorBrush x:Key="NightBrush" Color="{StaticResource ColorNight}" />

    <!-- Aliases for existing views -->
    <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource ColorNight}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource ColorSurfaceHover}" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource ColorSurfacePressed}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorLineInk}" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource ColorBorderHover}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorEmber}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#F7B44F" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#EB962B" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorInk}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorDimInk}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColorMute}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ColorBad}" />

    <!-- Typography: Oswald (Headings & Menu) & Onest (Body) -->
    <FontFamily x:Key="HeadingFont">pack://application:,,,/Resources/Fonts/#Oswald, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="MainFont">pack://application:,,,/Resources/Fonts/#Onest, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="PixelFont">pack://application:,,,/Resources/Fonts/#Oswald, Segoe UI, sans-serif</FontFamily>

    <!-- WORLD BACKGROUND IMAGE -->
    <BitmapImage x:Key="WorldBackgroundBitmap"
                 UriSource="pack://application:,,,/AuraLauncher;component/bg_world.png"
                 DecodePixelWidth="1920"
                 CacheOption="OnLoad" />

    <!-- KEYBOARD FOCUS VISUAL (2px solid ember, not dotted) -->
    <Style x:Key="EmberKeyboardFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{StaticResource EmberBrush}"
                            BorderThickness="2"
                            CornerRadius="3"
                            SnapsToDevicePixels="True"
                            Margin="-2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Global defaults: Null FocusVisualStyle and Focusable=False for containers -->
    <Style TargetType="{x:Type UserControl}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClipToBounds" Value="False" />
    </Style>

    <Style TargetType="{x:Type ContentControl}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <Style TargetType="{x:Type Grid}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <Style TargetType="{x:Type Border}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style TargetType="{x:Type StackPanel}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- Base Button keyboard focus -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource EmberKeyboardFocusVisual}" />
    </Style>

    <!-- Base TextBox keyboard focus and caret styling -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource EmberKeyboardFocusVisual}" />
        <Setter Property="CaretBrush" Value="{StaticResource EmberBrush}" />
        <Setter Property="SelectionBrush" Value="#80F2A63C" />
    </Style>

    <!-- Aura Cyberpunk Input Box -->
    <Style x:Key="AuraTextBox" TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource EmberKeyboardFocusVisual}" />
        <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Background" Value="#0F1B22" />
        <Setter Property="BorderBrush" Value="{StaticResource LineInkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{StaticResource EmberBrush}" />
        <Setter Property="SelectionBrush" Value="#80F2A63C" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                            <TextBlock Text="{TemplateBinding Tag}"
                                       Margin="{TemplateBinding Padding}"
                                       Foreground="#60E8F0F8"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       HorizontalAlignment="Left"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#40F2A63C" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource EmberBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="#14232C" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button Styles -->

    <!-- Standard Button: height 48, Oswald 600 18, padding 24, bg white 10%, bottom border 3px black 28%, radius 3px -->
    <Style x:Key="StandardBtn" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource EmberKeyboardFocusVisual}" />
        <Setter Property="Height" Value="48" />
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="OuterBrd"
                            Background="#1AFFFFFF"
                            BorderBrush="#47000000"
                            BorderThickness="0,0,0,3"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBrd" Property="Background" Value="#2BFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="OuterBrd" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="OuterBrd" Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Button (Alias based on StandardBtn) -->
    <Style x:Key="SecondaryBtn" BasedOn="{StaticResource StandardBtn}" TargetType="Button" />

    <!-- PrimaryActionBtn: compact ember button with smooth press -->
    <Style x:Key="PrimaryActionBtn" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource EmberKeyboardFocusVisual}" />
        <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#1C1106" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="OuterBrd"
                            BorderBrush="{StaticResource EmberDarkBrush}"
                            BorderThickness="0,0,0,2"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#F7B44F" Offset="0" />
                                <GradientStop Color="#EB962B" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBrd" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="OuterBrd" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="OuterBrd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SubNavPillRadio: compact tab radio button -->
    <Style x:Key="SubNavPillRadio" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="PillBorder"
                            CornerRadius="3"
                            Background="#0C141A"
                            BorderBrush="{StaticResource LineInkBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <TextBlock x:Name="PillText"
                                   Text="{TemplateBinding Content}"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="{StaticResource DimInkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PillBorder" Property="Background" Value="#2B1D0E" />
                            <Setter TargetName="PillBorder" Property="BorderBrush" Value="{StaticResource EmberBrush}" />
                            <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource EmberBrush}" />
                            <Setter TargetName="PillText" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PillBorder" Property="Background" Value="#14212B" />
                            <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource InkBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Main Button (Primary): gradient #F7B44F -> #EB962B, text #1C1106, bottom border 4px #A85F12, radius 3px -->
    <Style x:Key="PrimaryNeonBtn" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource EmberKeyboardFocusVisual}" />
        <Setter Property="Height" Value="48" />
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="#1C1106" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="OuterBrd"
                            BorderBrush="{StaticResource EmberDarkBrush}"
                            BorderThickness="0,0,0,4"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#F7B44F" Offset="0" />
                                <GradientStop Color="#EB962B" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBrd" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="OuterBrd" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="OuterBrd" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Large Play Button (260x70, font 28, radius 3px, no glow or sheen) -->
    <Style x:Key="OverviewPlayBtn" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource EmberKeyboardFocusVisual}" />
        <Setter Property="Width" Value="260" />
        <Setter Property="Height" Value="70" />
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Foreground" Value="#1C1106" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="OuterBrd"
                                BorderBrush="{StaticResource EmberDarkBrush}"
                                BorderThickness="0,0,0,4"
                                CornerRadius="3"
                                ClipToBounds="True"
                                SnapsToDevicePixels="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F7B44F" Offset="0" />
                                    <GradientStop Color="#EB962B" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBrd" Property="Opacity" Value="0.93" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="OuterBrd" Property="Opacity" Value="0.84" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="OuterBrd" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ghost / Link button -->
    <Style x:Key="GhostBtn" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MuteBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource EmberKeyboardFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bad / Destructive Link Button -->
    <Style x:Key="BadLinkBtn" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource EmberKeyboardFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Friend delete inline link button (FriendsView) -->
    <Style x:Key="FriendDeleteLinkBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
        <Setter Property="Opacity" Value="0.6" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1.0" />
                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsConfirmingDelete}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Lobby conditional action buttons (LobbyView) -->
    <Style x:Key="LobbyGuestConnectBtn" TargetType="Button" BasedOn="{StaticResource PrimaryNeonBtn}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHost}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LobbyGuestReconnectBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding CanReconnect}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LobbyFixAndProceedBtn" TargetType="Button" BasedOn="{StaticResource PrimaryNeonBtn}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding CanFixAny}" Value="True" />
                    <Condition Binding="{Binding IsGameRunningWarning}" Value="False" />
                    <Condition Binding="{Binding IsViewOnlyDialogMode}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LobbyJoinAsIsBtn" TargetType="Button" BasedOn="{StaticResource StandardBtn}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsJoinDialogMode}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Report modal submit button (MainWindow) -->
    <Style x:Key="ReportSubmitBtn" TargetType="Button" BasedOn="{StaticResource PrimaryNeonBtn}">
        <Setter Property="Content" Value="Отправить" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSubmittingReport}" Value="True">
                <Setter Property="Content" Value="Отправка..." />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Window Caption Controls: 32x34, hover white 10% -->
    <Style x:Key="WinControlBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MuteBrush}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Brd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="#1AFFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WinCloseBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MuteBrush}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Brd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="#1AFFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header Sound Toggle Button: 32x34, hover white 10% -->
    <Style x:Key="WinSoundBtn" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MuteBrush}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Brd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Brd" Property="Background" Value="#1AFFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header Volume Slider (112px wide track) -->
    <Style x:Key="HeaderVolumeSlider" TargetType="Slider">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Height" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <!-- Track 4px -->
                        <Border Height="4" Background="#33FFFFFF" CornerRadius="2" VerticalAlignment="Center" />
                        <!-- Thumb -->
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder"
                                                    Width="10" Height="10"
                                                    CornerRadius="2"
                                                    Background="{StaticResource EmberBrush}"
                                                    Cursor="Hand" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#F7B44F" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RAM Selector Pill Radio Button -->
    <Style x:Key="RamPillRadio" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MuteBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MainFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,16,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                               Foreground="{TemplateBinding Foreground}"
                               TextDecorations="Underline" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource EmberBrush}" />
                            <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource InkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Settings RAM Slider (track 6px ember, thumb 14x22 radius 3) -->
    <Style x:Key="SettingsRamSlider" TargetType="Slider">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <!-- Track 6px -->
                        <Border Height="6" Background="#26FFFFFF" CornerRadius="3" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Width="14" Height="22"
                                                    CornerRadius="3"
                                                    Background="{StaticResource EmberBrush}"
                                                    BorderBrush="{StaticResource EmberDarkBrush}"
                                                    BorderThickness="1"
                                                    Cursor="Hand" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Custom CheckBox styled as Alex Toggle (46x26, radius 3, knob 20x20, ember when checked) -->
    <Style x:Key="AlexToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="SwitchTrack" Width="46" Height="26" CornerRadius="3"
                                Background="#1AFFFFFF" BorderBrush="{StaticResource LineInkBrush}" BorderThickness="1">
                            <Border x:Name="Knob" Width="20" Height="20" CornerRadius="2"
                                    Background="{StaticResource MuteBrush}"
                                    HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="KnobTrans" X="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchTrack" Property="Background" Value="#33F2A63C" />
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource EmberBrush}" />
                            <Setter TargetName="Knob" Property="Background" Value="{StaticResource EmberBrush}" />
                            <Setter TargetName="Knob" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="20" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollBar: 6px width, white ~22% (#38FFFFFF), Accent on hover, radius 3, transparent track, no arrows -->
    <Style x:Key="AuraScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbBorder"
                            Background="#38FFFFFF"
                            CornerRadius="3"
                            SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AuraScrollBar" TargetType="{x:Type ScrollBar}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="6" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Width="6">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Opacity="0" Focusable="False" Height="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource AuraScrollBarThumb}" Width="6" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Opacity="0" Focusable="False" Height="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource AuraScrollBar}" />

    <!-- Aura ScrollViewer with 4px scrollbar and bottom 24px fade gradient -->
    <Style x:Key="AuraScrollViewer" TargetType="{x:Type ScrollViewer}">
        <Setter Property="behaviors:SmoothScroll.IsEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ScrollContentPresenter Grid.Column="0"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />

                        <!-- Bottom fade gradient (24px) -->
                        <Border Grid.Column="0"
                                Height="24"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Stretch"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00071017" Offset="0" />
                                    <GradientStop Color="#E6071017" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Column="1"
                                   Orientation="Vertical"
                                   Style="{StaticResource AuraScrollBar}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Margin="4,0,0,0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
