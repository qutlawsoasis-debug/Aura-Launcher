<Window x:Class="AuraLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AURA" Height="600" Width="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="18" CaptionHeight="48" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Main Window Background Container -->
    <Border Margin="10" CornerRadius="16" BorderThickness="1" BorderBrush="#252C3B" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#141720" Offset="0.0" />
                <GradientStop Color="#0B0D12" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="35" ShadowDepth="8" Opacity="0.8" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <!-- Left Sidebar -->
                <ColumnDefinition Width="*" />
                <!-- Main Tab Content Area -->
            </Grid.ColumnDefinitions>

            <!-- ============================================== -->
            <!-- 1. LEFT SIDEBAR (NAVIGATION)                   -->
            <!-- ============================================== -->
            <Border Grid.Column="0" Background="#0E1017" CornerRadius="15,0,0,15" BorderThickness="0,0,1,0" BorderBrush="#1E2433">
                <Grid Margin="20,24,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!-- Brand -->
                        <RowDefinition Height="*" />
                        <!-- Nav Items -->
                        <RowDefinition Height="Auto" />
                        <!-- Bottom User Profile Card -->
                    </Grid.RowDefinitions>

                    <!-- Brand Header -->
                    <StackPanel Grid.Row="0" Margin="4,0,0,32">
                        <TextBlock Text="A  U  R  A" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="CLIENT" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="2,4,0,0" />
                    </StackPanel>

                    <!-- Navigation Menu Items -->
                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="NavPlay" Content="⚡  Главная" IsChecked="True" Style="{DynamicResource NavRadioStyle}" Click="Nav_Click" Tag="TabPlay" />
                        <RadioButton x:Name="NavSkin" Content="👤  Скин" Style="{DynamicResource NavRadioStyle}" Click="Nav_Click" Tag="TabSkin" />
                        <RadioButton x:Name="NavMods" Content="📦  Моды (45)" Style="{DynamicResource NavRadioStyle}" Click="Nav_Click" Tag="TabMods" />
                        <RadioButton x:Name="NavSettings" Content="⚙️  Настройки" Style="{DynamicResource NavRadioStyle}" Click="Nav_Click" Tag="TabSettings" />
                    </StackPanel>

                    <!-- Bottom User Nickname Tag -->
                    <Border Grid.Row="2" Background="#141822" CornerRadius="10" BorderThickness="1" BorderBrush="#222A3A" Padding="12,10,12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="6" Background="#10B981" VerticalAlignment="Center">
                                <TextBlock Text="🎮" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSidebarNick" Text="NPC" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" />
                                <TextBlock Text="Fabric 1.20.1" Foreground="#64748B" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- 2. RIGHT MAIN CONTENT AREA                     -->
            <!-- ============================================== -->
            <Grid Grid.Column="1" Margin="28,16,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <!-- Top Window Controls -->
                    <RowDefinition Height="*" />
                    <!-- Dynamic Tab Views -->
                </Grid.RowDefinitions>

                <!-- Top Window Controls (Minimize, Close) -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Width="34" Height="34" Cursor="Hand" Margin="0,0,4,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Brd" Background="Transparent" CornerRadius="6">
                                    <TextBlock Text="—" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Brd" Property="Background" Value="#202636" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnClose" Click="BtnClose_Click" Width="34" Height="34" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Brd" Background="Transparent" CornerRadius="6">
                                    <TextBlock Text="✕" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Brd" Property="Background" Value="#E11D48" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- ============================================== -->
                <!-- TAB 1: ГЛАВНАЯ / ИГРАТЬ (PLAY TAB)             -->
                <!-- ============================================== -->
                <Grid x:Name="TabPlay" Grid.Row="1" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <!-- Hero & Model -->
                        <RowDefinition Height="Auto" />
                        <!-- Bottom Launch Bar -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <!-- Left: Welcome & Info -->
                            <ColumnDefinition Width="220" />
                            <!-- Right: Full Character Model -->
                        </Grid.ColumnDefinitions>

                        <!-- Left Hero Info -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="ДОБРО ПОЖАЛОВАТЬ" FontSize="12" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,6" />
                            <TextBlock x:Name="TxtHeroTitle" Text="Aura Vanilla+" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,14" />

                            <TextBlock Text="Идеальная оптимизированная сборка с живыми деревнями, новыми биомами Terralith, рюкзаками и красивыми шейдерами." 
                                       FontSize="13" Foreground="#94A3B8" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,24" />

                            <!-- Quick Specs Grid -->
                            <UniformGrid Columns="2" Margin="0,0,0,24">
                                <Border Background="#141822" CornerRadius="8" BorderThickness="1" BorderBrush="#202738" Padding="14,10" Margin="0,0,8,8">
                                    <StackPanel>
                                        <TextBlock Text="ЯДРО" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock Text="Fabric 1.20.1" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="#141822" CornerRadius="8" BorderThickness="1" BorderBrush="#202738" Padding="14,10" Margin="8,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="ШЕЙДЕР" FontSize="10" FontWeight="Bold" Foreground="#64748B" />
                                        <TextBlock Text="MakeUp UltraFast" FontSize="14" FontWeight="SemiBold" Foreground="#34D399" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Quick RAM Selector -->
                            <TextBlock Text="ВЫДЕЛЕНИЕ ОЗУ" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8" />
                            <Border Background="#141822" CornerRadius="8" BorderThickness="1" BorderBrush="#202738" Padding="3" Width="320" HorizontalAlignment="Left">
                                <UniformGrid Columns="4">
                                    <RadioButton x:Name="RbRam4" Content="4 GB" GroupName="RamGroup" Tag="4096" Style="{DynamicResource SegmentedRadioStyle}" Checked="RamRadio_Checked" />
                                    <RadioButton x:Name="RbRam6" Content="6 GB" GroupName="RamGroup" Tag="6144" Style="{DynamicResource SegmentedRadioStyle}" IsChecked="True" Checked="RamRadio_Checked" />
                                    <RadioButton x:Name="RbRam8" Content="8 GB" GroupName="RamGroup" Tag="8192" Style="{DynamicResource SegmentedRadioStyle}" Checked="RamRadio_Checked" />
                                    <RadioButton x:Name="RbRam12" Content="12 GB" GroupName="RamGroup" Tag="12288" Style="{DynamicResource SegmentedRadioStyle}" Checked="RamRadio_Checked" />
                                </UniformGrid>
                            </Border>
                        </StackPanel>

                        <!-- Right: Full Body Minecraft Model Showcase -->
                        <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Pedestal Glow -->
                            <Ellipse Width="170" Height="40" Fill="#10B981" Opacity="0.15" VerticalAlignment="Bottom" Margin="0,0,0,10">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="30" />
                                </Ellipse.Effect>
                            </Ellipse>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Real Minecraft Character Full Body (Scaled 10x with NearestNeighbor) -->
                                <Border Width="160" Height="320" Background="Transparent" HorizontalAlignment="Center">
                                    <Image x:Name="ImgBodyModel" Width="160" Height="320" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Bottom Launch Controls -->
                    <StackPanel Grid.Row="1" Margin="0,14,0,6">
                        <!-- CS-Style Quotes & Status Row -->
                        <Grid Margin="2,0,2,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtWittyQuote" Text="Готов к погружению в кубический мир" FontSize="13" FontWeight="SemiBold" Foreground="#34D399" />
                            <TextBlock x:Name="TxtTechnicalStatus" Grid.Column="1" Text="Все моды актуальны" FontSize="12" Foreground="#64748B" />
                        </Grid>

                        <!-- Progress Bar -->
                        <Border x:Name="BrdProgress" Height="6" CornerRadius="3" Background="#141822" Margin="0,0,0,12" Visibility="Collapsed">
                            <ProgressBar x:Name="ProgressBarDownload" Height="6" Minimum="0" Maximum="100" Value="0" Background="Transparent" Foreground="#10B981" BorderThickness="0" />
                        </Border>

                        <!-- Big Vibrant PLAY Button -->
                        <Button x:Name="BtnPlay" Click="BtnPlay_Click" Height="52" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Brd" CornerRadius="10">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#10B981" Offset="0.0" />
                                                <GradientStop Color="#059669" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="22" ShadowDepth="2" Color="#10B981" Opacity="0.4" />
                                        </Border.Effect>
                                        <TextBlock x:Name="Txt" Text="ИГРАТЬ" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Brd" Property="Opacity" Value="0.9" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Brd" Property="Background" Value="#222836" />
                                            <Setter TargetName="Brd" Property="Effect" Value="{x:Null}" />
                                            <Setter TargetName="Txt" Property="Foreground" Value="#64748B" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ============================================== -->
                <!-- TAB 2: СКИН (SKINS & WARDROBE TAB)             -->
                <!-- ============================================== -->
                <Grid x:Name="TabSkin" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Full Body Model in Wardrobe -->
                    <Border Grid.Column="0" Background="#11141D" CornerRadius="12" BorderThickness="1" BorderBrush="#202738" Padding="14">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image x:Name="ImgWardrobeModel" Width="160" Height="320" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <TextBlock x:Name="TxtSkinNickPreview" Text="NPC" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Skin Actions -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="32,0,0,0">
                        <TextBlock Text="ГАРДЕРОБ ПЕРСОНАЖА" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8" />
                        <TextBlock Text="Выбери любой файл скина .png (64x64). Он автоматически активируется в игре через CustomSkinLoader без необходимости перезахода на аккаунты." 
                                   Foreground="#94A3B8" FontSize="13" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,24" />

                        <Button Click="BtnChangeSkin_Click" Width="220" Height="44" HorizontalAlignment="Left" Cursor="Hand" Margin="0,0,0,12">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Brd" Background="#10B981" CornerRadius="8">
                                        <TextBlock Text="📂  Выбрать скин (.png)" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Brd" Property="Background" Value="#34D399" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Click="BtnResetSteve_Click" Width="220" Height="40" HorizontalAlignment="Left" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Brd" Background="#1A202C" CornerRadius="8" BorderThickness="1" BorderBrush="#2D3748">
                                        <TextBlock Text="Сбросить на классического Стива" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Brd" Property="Background" Value="#252F3F" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ============================================== -->
                <!-- TAB 3: МОДЫ (MODS TAB)                         -->
                <!-- ============================================== -->
                <Grid x:Name="TabMods" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="УСТАНОВЛЕННЫЕ МОДЫ (45)" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,14" />

                    <!-- Scrollable Mod List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PanelModsList" Margin="0,0,10,0">
                            <!-- Populated in code-behind -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ============================================== -->
                <!-- TAB 4: НАСТРОЙКИ (SETTINGS TAB)                -->
                <!-- ============================================== -->
                <Grid x:Name="TabSettings" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" Margin="10,0,10,0">
                        <TextBlock Text="ПАРАМЕТРЫ ЛАУНЧЕРА И ИГРЫ" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,20" />

                        <!-- Nickname Setting -->
                        <TextBlock Text="НИКНЕЙМ В ИГРЕ" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6" />
                        <Border Background="#141822" CornerRadius="8" BorderThickness="1" BorderBrush="#202738" Height="42" Margin="0,0,0,16">
                            <TextBox x:Name="TxtSettingsNick" Text="Player" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                     FontSize="14" VerticalAlignment="Center" Padding="12,0" CaretBrush="#10B981" TextChanged="TxtNickname_TextChanged" />
                        </Border>

                        <!-- Game Directory -->
                        <TextBlock Text="ПАПКА ИГРЫ (.MINECRAFT)" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#141822" CornerRadius="8" BorderThickness="1" BorderBrush="#202738" Height="42">
                                <TextBox x:Name="TxtGameDir" Text="D:\.minecraft" Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                                         FontSize="13" VerticalAlignment="Center" Padding="12,0" IsReadOnly="True" />
                            </Border>
                            <Button Grid.Column="1" Click="BtnOpenGameDir_Click" Width="90" Height="42" Margin="8,0,0,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Brd" Background="#1A202C" CornerRadius="8" BorderThickness="1" BorderBrush="#2D3748">
                                            <TextBlock Text="Открыть" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Brd" Property="Background" Value="#252F3F" />
                                                <Setter TargetName="Brd" Property="BorderBrush" Value="#4B5563" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- GitHub Repo -->
                        <TextBlock Text="РЕПОЗИТОРИЙ GITHUB ДЛЯ ОБНОВЛЕНИЙ" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6" />
                        <Border Background="#141822" CornerRadius="8" BorderThickness="1" BorderBrush="#202738" Height="42" Margin="0,0,0,24">
                            <TextBox x:Name="TxtGitHubRepo" Text="qutlawsoasis-debug/Aura" Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                                     FontSize="13" VerticalAlignment="Center" Padding="12,0" />
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Click="BtnSaveSettings_Click" Width="190" Height="42" HorizontalAlignment="Left" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Brd" Background="#10B981" CornerRadius="8">
                                            <TextBlock Text="💾  Сохранить настройки" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Brd" Property="Background" Value="#34D399" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock x:Name="TxtSettingsStatus" Foreground="#34D399" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed" Text="✓ Настройки сохранены" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>

    <Window.Resources>
        <!-- Sidebar Navigation RadioButton Style -->
        <Style x:Key="NavRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Brd" Background="Transparent" CornerRadius="8" Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#171C27" />
                                <Setter Property="Foreground" Value="#10B981" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#131720" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented RAM RadioButton Style -->
        <Style x:Key="SegmentedRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="2,0,2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,6,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1E2633" />
                                <Setter Property="Foreground" Value="#34D399" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#161B24" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
