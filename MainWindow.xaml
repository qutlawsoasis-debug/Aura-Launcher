<Window x:Class="AuraLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AURA" Height="620" Width="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system, sans-serif">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="16" CaptionHeight="48" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Apple Specular Top Rim Gradient -->
        <LinearGradientBrush x:Key="SpecularRimBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#455675" Offset="0.0" />
            <GradientStop Color="#1E273A" Offset="0.25" />
            <GradientStop Color="#111622" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Dynamic Island Nav Button Style -->
        <Style x:Key="IslandNavBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Brd" Background="Transparent" CornerRadius="16" Padding="14,0" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#1C2436" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#253046" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented RAM RadioButton Style -->
        <Style x:Key="SegmentedRamStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8E9CAE" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Brd" Background="Transparent" CornerRadius="7" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#1E283D" />
                                <Setter Property="Foreground" Value="#34D399" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#172030" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Canvas with Corner Radius and Shadow -->
    <Border Margin="10" CornerRadius="16" BorderThickness="1" BorderBrush="{StaticResource SpecularRimBrush}"
            ClipToBounds="True" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="45" ShadowDepth="12" Opacity="0.85" Color="#000000" />
        </Border.Effect>

        <Grid>
            <!-- ============================================== -->
            <!-- LAYER 0: ATMOSPHERIC BLURRED BACKDROP          -->
            <!-- ============================================== -->
            <!-- Real World Screenshot with Gaussian Blur -->
            <Image x:Name="ImgBgWorld" Source="bg_world.png" Stretch="UniformToFill" Opacity="0.22">
                <Image.Effect>
                    <BlurEffect Radius="35" KernelType="Gaussian" />
                </Image.Effect>
            </Image>

            <!-- Deep Obsidian Glass Scrim -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#E60D1017" Offset="0.0" />
                        <GradientStop Color="#F0090B10" Offset="0.5" />
                        <GradientStop Color="#FA06070B" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Ambient Emerald Glow from Pedestal -->
            <Ellipse Width="380" Height="140" Fill="#10B981" Opacity="0.10" VerticalAlignment="Bottom"
                     HorizontalAlignment="Right" Margin="0,0,130,120">
                <Ellipse.Effect>
                    <BlurEffect Radius="70" />
                </Ellipse.Effect>
            </Ellipse>

            <!-- ============================================== -->
            <!-- LAYER 1: MAIN STAGE CONTENT                    -->
            <!-- ============================================== -->
            <Grid Margin="24,18,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- Top Island Bar -->
                    <RowDefinition Height="*" />
                    <!-- Hero Stage & Character -->
                    <RowDefinition Height="Auto" />
                    <!-- Floating Launch Dock -->
                </Grid.RowDefinitions>

                <!-- ============================================== -->
                <!-- 1. TOP FLOATING ISLAND BAR                     -->
                <!-- ============================================== -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <!-- Brand -->
                        <ColumnDefinition Width="*" />
                        <!-- Center Island -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Controls -->
                    </Grid.ColumnDefinitions>

                    <!-- Clean Brand Header -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="A  U  R  A" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Center Floating Island (Capsule) -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" Background="#111624" CornerRadius="18"
                            BorderThickness="1" BorderBrush="#222C3E" Padding="4,3">
                        <StackPanel Orientation="Horizontal">
                            <Button Click="BtnOpenSkinSheet_Click" Style="{StaticResource IslandNavBtnStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Гардероб" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Click="BtnOpenModsSheet_Click" Style="{StaticResource IslandNavBtnStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12 2l-9 4.5v11l9 4.5 9-4.5v-11L12 2zm0 2.2l6.8 3.4L12 11 5.2 7.6 12 4.2zm-7 5.6l6 3v7.6l-6-3V9.8zm8 10.6v-7.6l6-3v7.6l-6 3z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock x:Name="TxtNavModsLabel" Text="Модификации (45)" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Click="BtnOpenSettingsSheet_Click" Style="{StaticResource IslandNavBtnStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Настройки" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Window Buttons (Minimize, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="BtnMinimize_Click" Width="30" Height="30" Cursor="Hand" Margin="0,0,4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Brd" Background="Transparent" CornerRadius="8">
                                        <TextBlock Text="—" Foreground="#8E9CAE" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Brd" Property="Background" Value="#1E2638" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Click="BtnClose_Click" Width="30" Height="30" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Brd" Background="Transparent" CornerRadius="8">
                                        <TextBlock Text="✕" Foreground="#8E9CAE" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Brd" Property="Background" Value="#E11D48" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ============================================== -->
                <!-- 2. HERO STAGE & CHARACTER MODEL                -->
                <!-- ============================================== -->
                <Grid Grid.Row="1" Margin="10,14,10,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <!-- Left Hero Info -->
                        <ColumnDefinition Width="380" />
                        <!-- Right Character Studio Stage -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Clean Modpack Presentation -->
                    <StackPanel VerticalAlignment="Center" Margin="10,0,20,0">
                        <TextBlock Text="Vanilla+" FontSize="42" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                        <TextBlock Text="Minecraft 1.20.1 Fabric • Шейдеры MakeUp • 45 модов" FontSize="14" Foreground="#94A3B8" Margin="0,0,0,24" />

                        <!-- Clean Minimalist Feature Chips -->
                        <WrapPanel Margin="0,0,0,20">
                            <Border Background="#121622" CornerRadius="7" BorderThickness="1" BorderBrush="#1F283C" Padding="10,6" Margin="0,0,8,8">
                                <TextBlock Text="🏔️ Terralith &amp; Tectonic" Foreground="#E2E8F0" FontSize="12" />
                            </Border>
                            <Border Background="#121622" CornerRadius="7" BorderThickness="1" BorderBrush="#1F283C" Padding="10,6" Margin="0,0,8,8">
                                <TextBlock Text="🛡️ Стражники деревень" Foreground="#E2E8F0" FontSize="12" />
                            </Border>
                            <Border Background="#121622" CornerRadius="7" BorderThickness="1" BorderBrush="#1F283C" Padding="10,6" Margin="0,0,8,8">
                                <TextBlock Text="🎒 Рюкзаки &amp; Спальники" Foreground="#E2E8F0" FontSize="12" />
                            </Border>
                            <Border Background="#121622" CornerRadius="7" BorderThickness="1" BorderBrush="#1F283C" Padding="10,6" Margin="0,0,8,8">
                                <TextBlock Text="⚡ Sodium 60+ FPS" Foreground="#34D399" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </WrapPanel>

                        <!-- Subtle Hint to Change Skin -->
                        <Button Click="BtnOpenSkinSheet_Click" HorizontalAlignment="Left" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <TextBlock Text="Изменить скин персонажа →" Foreground="#34D399" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Right: Character Studio Showcase with Pedestal and Floor Reflection -->
                    <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Pedestal Structure -->
                        <Grid VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,28">
                            <!-- Soft Base Shadow -->
                            <Ellipse Width="220" Height="40" Fill="#000000" Opacity="0.75">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="24" />
                                </Ellipse.Effect>
                            </Ellipse>

                            <!-- Glass Disc Pedestal -->
                            <Border Width="200" Height="26" CornerRadius="13" Background="#111624" BorderThickness="1" BorderBrush="#2D3A50"
                                    VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Color="#10B981" Opacity="0.25" />
                                </Border.Effect>
                            </Border>
                        </Grid>

                        <!-- Flipped Mirror Reflection Beneath Pedestal -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2" Height="100" ClipToBounds="True">
                            <Image x:Name="ImgBodyReflection" Width="160" Height="320" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   Opacity="0.16" VerticalAlignment="Top" Margin="0,-220,0,0">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleY="-1" CenterY="160" />
                                </Image.RenderTransform>
                                <Image.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop Color="#FF000000" Offset="0.0" />
                                        <GradientStop Color="#00000000" Offset="0.7" />
                                    </LinearGradientBrush>
                                </Image.OpacityMask>
                            </Image>
                        </Border>

                        <!-- Main Standing Model (Clickable to open Wardrobe) -->
                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40">
                            <Image x:Name="ImgBodyModel" Width="160" Height="320" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   Cursor="Hand" ToolTip="Нажми, чтобы открыть гардероб" MouseLeftButtonDown="BtnOpenSkinSheet_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ============================================== -->
                <!-- 3. FLOATING LAUNCH DOCK (BOTTOM)               -->
                <!-- ============================================== -->
                <Border Grid.Row="2" Background="#101420" CornerRadius="14" BorderThickness="1" BorderBrush="#202A3C" Padding="14,10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="6" Opacity="0.5" Color="#000000" />
                    </Border.Effect>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <!-- Player Card -->
                            <ColumnDefinition Width="Auto" />
                            <!-- Divider -->
                            <ColumnDefinition Width="Auto" />
                            <!-- RAM Selector -->
                            <ColumnDefinition Width="*" />
                            <!-- Dynamic Quotes & Status -->
                            <ColumnDefinition Width="Auto" />
                            <!-- PLAY Button -->
                        </Grid.ColumnDefinitions>

                        <!-- 1. Player Info Pill (Real Mini Face + Nick) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,14,0" Cursor="Hand"
                                    MouseLeftButtonDown="BtnOpenSettingsSheet_Click" ToolTip="Нажми, чтобы сменить ник">
                            <Border Width="34" Height="34" CornerRadius="8" Background="#161B28" ClipToBounds="True" BorderThickness="1" BorderBrush="#28354A">
                                <Image x:Name="ImgDockFace" Width="32" Height="32" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtDockNick" Text="Player" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="Готов к игре" Foreground="#64748B" FontSize="11" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Divider -->
                        <Border Grid.Column="1" Width="1" Height="28" Background="#1C2434" VerticalAlignment="Center" Margin="0,0,14,0" />

                        <!-- 2. Integrated RAM Segmented Control -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0">
                            <TextBlock Text="ОЗУ" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,3" />
                            <Border Background="#0C0E16" CornerRadius="8" BorderThickness="1" BorderBrush="#1C2434" Padding="2">
                                <UniformGrid Columns="4">
                                    <RadioButton x:Name="RbRam4" Content="4G" GroupName="DockRam" Tag="4096" Style="{StaticResource SegmentedRamStyle}" Checked="RamRadio_Checked" />
                                    <RadioButton x:Name="RbRam6" Content="6G" GroupName="DockRam" Tag="6144" Style="{StaticResource SegmentedRamStyle}" IsChecked="True" Checked="RamRadio_Checked" />
                                    <RadioButton x:Name="RbRam8" Content="8G" GroupName="DockRam" Tag="8192" Style="{StaticResource SegmentedRamStyle}" Checked="RamRadio_Checked" />
                                    <RadioButton x:Name="RbRam12" Content="12G" GroupName="DockRam" Tag="12288" Style="{StaticResource SegmentedRamStyle}" Checked="RamRadio_Checked" />
                                </UniformGrid>
                            </Border>
                        </StackPanel>

                        <!-- 3. Quotes & Progress Center Area -->
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,20,0">
                            <!-- CS:GO Quote -->
                            <TextBlock x:Name="TxtWittyQuote" Text="Заряжаем пули..." Foreground="#34D399" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <!-- Technical Status -->
                            <TextBlock x:Name="TxtTechnicalStatus" Text="Все файлы актуальны" Foreground="#64748B" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />

                            <!-- Glowing Download Progress Bar -->
                            <Border x:Name="BrdProgress" Height="4" CornerRadius="2" Background="#141A28" Margin="0,6,0,0" Visibility="Collapsed">
                                <ProgressBar x:Name="ProgressBarDownload" Height="4" Minimum="0" Maximum="100" Value="0" Background="Transparent" Foreground="#10B981" BorderThickness="0" />
                            </Border>
                        </StackPanel>

                        <!-- 4. Massive Vibrant PLAY Button -->
                        <Button x:Name="BtnPlay" Grid.Column="4" Click="BtnPlay_Click" Width="170" Height="48" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Brd" CornerRadius="11" BorderThickness="1" BorderBrush="#34D399" SnapsToDevicePixels="True">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#10B981" Offset="0.0" />
                                                <GradientStop Color="#059669" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Color="#10B981" Opacity="0.38" />
                                        </Border.Effect>
                                        <TextBlock x:Name="Txt" Text="ИГРАТЬ" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Brd" Property="Opacity" Value="0.92" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Brd" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.975" ScaleY="0.975" CenterX="85" CenterY="24" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Brd" Property="Background" Value="#1A202C" />
                                            <Setter TargetName="Brd" Property="BorderBrush" Value="#2D3748" />
                                            <Setter TargetName="Brd" Property="Effect" Value="{x:Null}" />
                                            <Setter TargetName="Txt" Property="Foreground" Value="#64748B" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================== -->
            <!-- LAYER 2: FLOATING SHEET OVERLAYS (APPLE HIG)   -->
            <!-- ============================================== -->
            <Grid x:Name="OverlayScrim" Background="#C805070B" Visibility="Collapsed" MouseLeftButtonDown="OverlayScrim_Click">
                <!-- Floating Glass Sheet Container -->
                <Border x:Name="SheetContainer" Width="720" Height="480" Background="#111624" CornerRadius="16"
                        BorderThickness="1" BorderBrush="#2D3A52" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MouseLeftButtonDown="SheetContainer_Click">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="50" ShadowDepth="12" Opacity="0.9" Color="#000000" />
                    </Border.Effect>

                    <Grid Margin="24,20,24,22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <!-- Sheet Header -->
                            <RowDefinition Height="*" />
                            <!-- Sheet Content -->
                        </Grid.RowDefinitions>

                        <!-- Sheet Header (Title + Close Button) -->
                        <Grid Grid.Row="0" Margin="0,0,0,18">
                            <TextBlock x:Name="TxtSheetTitle" Text="Гардероб" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            <Button Click="BtnCloseSheet_Click" HorizontalAlignment="Right" Width="32" Height="32" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Brd" Background="#1A2130" CornerRadius="16">
                                            <TextBlock Text="✕" Foreground="#8E9CAE" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Brd" Property="Background" Value="#253046" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- ========================= -->
                        <!-- 1. WARDROBE SHEET CONTENT -->
                        <!-- ========================= -->
                        <Grid x:Name="SheetSkin" Grid.Row="1" Visibility="Visible">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#0C0E16" CornerRadius="12" BorderThickness="1" BorderBrush="#1C2434" Padding="12">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Image x:Name="ImgWardrobeModel" Width="140" Height="280" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    <TextBlock x:Name="TxtWardrobeNick" Text="Player" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                    <TextBlock x:Name="TxtWardrobeFormat" Text="64×64 PNG" Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="28,0,0,0">
                                <TextBlock Text="Смена скина" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                <TextBlock Text="Выбери файл скина или перетащи любой .png прямо в это окно. Скин запишется в папку CustomSkinLoader и применится в игре моментально."
                                           Foreground="#8E9CAE" FontSize="13" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,22" />

                                <Button Click="BtnChangeSkin_Click" Width="220" Height="42" HorizontalAlignment="Left" Cursor="Hand" Margin="0,0,0,10">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Brd" Background="#10B981" CornerRadius="9">
                                                <TextBlock Text="📂  Выбрать скин (.png)" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Brd" Property="Background" Value="#34D399" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Click="BtnResetSteve_Click" Width="220" Height="38" HorizontalAlignment="Left" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Brd" Background="#141824" CornerRadius="9" BorderThickness="1" BorderBrush="#222B3D">
                                                <TextBlock Text="Сбросить на классического Стива" Foreground="#8E9CAE" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Brd" Property="Background" Value="#1C2335" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- ========================= -->
                        <!-- 2. MODS SHEET CONTENT     -->
                        <!-- ========================= -->
                        <Grid x:Name="SheetMods" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Live Search Filter -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Background="#0C0E16" CornerRadius="9" BorderThickness="1" BorderBrush="#1C2434" Height="36">
                                    <Grid Margin="10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🔍" Foreground="#64748B" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" />
                                        <TextBox x:Name="TxtSearchMods" Grid.Column="1" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                                 FontSize="13" VerticalAlignment="Center" CaretBrush="#10B981" TextChanged="TxtSearchMods_TextChanged" />
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="TxtModsCount" Grid.Column="1" Text="45 модов" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="14,0,4,0" />
                            </Grid>

                            <!-- Scrollable Mods -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PanelModsList" Margin="0,0,6,0" />
                            </ScrollViewer>
                        </Grid>

                        <!-- ========================= -->
                        <!-- 3. SETTINGS SHEET CONTENT -->
                        <!-- ========================= -->
                        <Grid x:Name="SheetSettings" Grid.Row="1" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="4,0,10,0">
                                    <!-- Nickname -->
                                    <TextBlock Text="НИКНЕЙМ В ИГРЕ" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6" />
                                    <Border Background="#0C0E16" CornerRadius="8" BorderThickness="1" BorderBrush="#1C2434" Height="40" Margin="0,0,0,16">
                                        <TextBox x:Name="TxtSettingsNick" Text="Player" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                                 FontSize="13" VerticalAlignment="Center" Padding="12,0" CaretBrush="#10B981" TextChanged="TxtNickname_TextChanged" />
                                    </Border>

                                    <!-- Directory -->
                                    <TextBlock Text="ДИРЕКТОРИЯ .MINECRAFT" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6" />
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#0C0E16" CornerRadius="8" BorderThickness="1" BorderBrush="#1C2434" Height="40">
                                            <TextBox x:Name="TxtGameDir" Text="D:\.minecraft" Background="Transparent" Foreground="#8E9CAE" BorderThickness="0"
                                                     FontSize="12" VerticalAlignment="Center" Padding="12,0" IsReadOnly="True" />
                                        </Border>
                                        <Button Grid.Column="1" Click="BtnOpenGameDir_Click" Width="90" Height="40" Margin="8,0,0,0" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Brd" Background="#141824" CornerRadius="8" BorderThickness="1" BorderBrush="#222B3D">
                                                        <TextBlock Text="Открыть" Foreground="#8E9CAE" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Brd" Property="Background" Value="#1C2335" />
                                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>

                                    <!-- GitHub Repo -->
                                    <TextBlock Text="GITHUB РЕПОЗИТОРИЙ СБОРКИ" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6" />
                                    <Border Background="#0C0E16" CornerRadius="8" BorderThickness="1" BorderBrush="#1C2434" Height="40" Margin="0,0,0,24">
                                        <TextBox x:Name="TxtGitHubRepo" Text="qutlawsoasis-debug/Aura" Background="Transparent" Foreground="#8E9CAE" BorderThickness="0"
                                                 FontSize="12" VerticalAlignment="Center" Padding="12,0" />
                                    </Border>

                                    <!-- Save Button -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button Click="BtnSaveSettings_Click" Width="190" Height="40" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Brd" Background="#10B981" CornerRadius="8">
                                                        <TextBlock Text="💾  Сохранить настройки" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Brd" Property="Background" Value="#34D399" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBlock x:Name="TxtSettingsStatus" Foreground="#34D399" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed" Text="✓ Настройки сохранены" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
