<Window x:Class="AuraLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AURA" Height="480" Width="740"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="16" CaptionHeight="48" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <!-- Window Outer Container with Border and Shadow effect -->
        <Border Margin="10" CornerRadius="14" BorderThickness="1" BorderBrush="#262C38">
            <Border.Background>
                <SolidColorBrush Color="#12151B" Opacity="0.88" />
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.6" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <!-- Header -->
                    <RowDefinition Height="*" />
                    <!-- Main Content -->
                    <RowDefinition Height="110" />
                    <!-- Bottom Controls & Progress -->
                </Grid.RowDefinitions>

                <!-- 1. Header -->
                <Grid Grid.Row="0" Margin="24,14,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="AURA" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" />
                        <Ellipse Width="7" Height="7" Fill="#10B981" Margin="14,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtStatusBadge" Text="Готов к игре" FontSize="12" Foreground="#8E99A8" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Window Control Buttons (Minimize, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Width="32" Height="32" Cursor="Hand" Margin="0,0,4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Brd" Background="Transparent" CornerRadius="6">
                                        <TextBlock Text="—" Foreground="#8E99A8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Brd" Property="Background" Value="#222834" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="BtnClose" Click="BtnClose_Click" Width="32" Height="32" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Brd" Background="Transparent" CornerRadius="6">
                                        <TextBlock Text="✕" Foreground="#8E99A8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Brd" Property="Background" Value="#DC2626" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2. Main Content (Skin & Settings) -->
                <Grid Grid.Row="1" Margin="24,10,24,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <!-- Skin Column -->
                        <ColumnDefinition Width="*" />
                        <!-- Settings Column -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Skin Preview & Selector -->
                    <Border Grid.Column="0" Background="#161922" CornerRadius="10" BorderThickness="1" BorderBrush="#202530" Margin="0,0,16,0" Padding="14">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Skin Face Preview Box -->
                            <Border Width="84" Height="84" CornerRadius="8" Background="#0C0E12" BorderThickness="1" BorderBrush="#2C3240" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Image x:Name="ImgSkinFace" Width="80" Height="80" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Border>

                            <Button x:Name="BtnChangeSkin" Click="BtnChangeSkin_Click" Width="130" Height="32" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Brd" Background="#1E232E" CornerRadius="6" BorderThickness="1" BorderBrush="#2B3240">
                                            <TextBlock Text="Сменить скин" Foreground="#D1D5DB" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Brd" Property="Background" Value="#29303F" />
                                                <Setter TargetName="Brd" Property="BorderBrush" Value="#3B4459" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Right: Nickname & RAM Settings -->
                    <Border Grid.Column="1" Background="#161922" CornerRadius="10" BorderThickness="1" BorderBrush="#202530" Padding="20">
                        <StackPanel VerticalAlignment="Center">
                            <!-- Nickname Field -->
                            <TextBlock Text="НИКНЕЙМ" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,6" />
                            <Border Background="#0E1015" CornerRadius="8" BorderThickness="1" BorderBrush="#262D38" Height="40" Margin="0,0,0,20">
                                <TextBox x:Name="TxtNickname" Text="Player" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                         FontSize="14" VerticalAlignment="Center" Padding="12,0,12,0" TextChanged="TxtNickname_TextChanged" />
                            </Border>

                            <!-- RAM Selector -->
                            <TextBlock Text="ВЫДЕЛЕНИЕ ПАМЯТИ (ОЗУ)" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,8" />
                            <UniformGrid Columns="4" Height="38">
                                <RadioButton x:Name="RbRam4" Content="4 GB" GroupName="RamGroup" Tag="4096" Style="{DynamicResource SegmentedRadioStyle}" Checked="RamRadio_Checked" />
                                <RadioButton x:Name="RbRam6" Content="6 GB" GroupName="RamGroup" Tag="6144" Style="{DynamicResource SegmentedRadioStyle}" IsChecked="True" Checked="RamRadio_Checked" />
                                <RadioButton x:Name="RbRam8" Content="8 GB" GroupName="RamGroup" Tag="8192" Style="{DynamicResource SegmentedRadioStyle}" Checked="RamRadio_Checked" />
                                <RadioButton x:Name="RbRam12" Content="12 GB" GroupName="RamGroup" Tag="12288" Style="{DynamicResource SegmentedRadioStyle}" Checked="RamRadio_Checked" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 3. Bottom Controls & Loading Bar -->
                <Grid Grid.Row="2" Margin="24,6,24,20" VerticalAlignment="Bottom">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="50" />
                    </Grid.RowDefinitions>

                    <!-- CS-Style Atmospheric Status Quote -->
                    <TextBlock x:Name="TxtWittyQuote" Grid.Row="0" Text="Готов к погружению в кубический мир" FontSize="12" 
                               Foreground="#10B981" HorizontalAlignment="Left" Margin="2,0,0,4" />

                    <!-- Technical Progress Label -->
                    <TextBlock x:Name="TxtTechnicalStatus" Grid.Row="1" Text="Все моды и шейдеры обновлены" FontSize="11" 
                               Foreground="#6B7280" HorizontalAlignment="Left" Margin="2,0,0,8" />

                    <!-- Progress Bar (Visible during download) -->
                    <ProgressBar x:Name="ProgressBarDownload" Grid.Row="2" Height="48" Minimum="0" Maximum="100" Value="0" 
                                 Visibility="Collapsed" Background="#0C0E12" Foreground="#10B981" BorderThickness="1" BorderBrush="#202530" />

                    <!-- Main PLAY Button -->
                    <Button x:Name="BtnPlay" Grid.Row="2" Click="BtnPlay_Click" Height="48" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Brd" Background="#10B981" CornerRadius="8">
                                    <TextBlock x:Name="Txt" Text="ИГРАТЬ" Foreground="#0A1F18" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Brd" Property="Background" Value="#34D399" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Brd" Property="Background" Value="#1A2B24" />
                                        <Setter TargetName="Txt" Property="Foreground" Value="#4B665A" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>

    <Window.Resources>
        <!-- Minimalist Segmented RadioButton Style for RAM -->
        <Style x:Key="SegmentedRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8E99A8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="2,0,2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="#0E1015" CornerRadius="6" BorderThickness="1" BorderBrush="#262D38">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,6,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1E2822" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#10B981" />
                                <Setter Property="Foreground" Value="#10B981" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3D4759" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
