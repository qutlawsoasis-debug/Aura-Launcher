<Window x:Class="AuraLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AuraLauncher.ViewModels"
        xmlns:views="clr-namespace:AuraLauncher.Views"
        xmlns:core="clr-namespace:AuraLauncher.Core"
        Title="Aura" Height="620" Width="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Icon="app_icon.ico"
        FontFamily="{StaticResource MainFont}"
        FocusVisualStyle="{x:Null}">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="3" CaptionHeight="40" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <core:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WardrobeViewModel}">
            <views:WardrobeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LobbyViewModel}">
            <views:LobbyView />
        </DataTemplate>

        <!-- Menu Item RadioButton Style:
             Row height 50px, Oswald 500 40px.
             Ember 10x10 square (radius 2) to the left of word:
               active scale 1, hover scale 0.6, else scale 0 (160ms animation).
             Active word white/ink, others dim (62%).
             Hover: word shifts right by 8px in 160ms;
             When any item hovered, other items drop to opacity 0.42 (handled in code-behind / triggers).
             Content area does NOT shift!
        -->
        <Style x:Key="GameMenuRadio" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="GroupName" Value="GameMainMenu" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Ember 10x10 square with radius 2 -->
                                <Border x:Name="DotSquare"
                                        Width="10" Height="10"
                                        CornerRadius="2"
                                        Background="{StaticResource EmberBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,14,0"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="DotScale" ScaleX="0" ScaleY="0" />
                                    </Border.RenderTransform>
                                </Border>

                                <!-- Text with 8px horizontal translation -->
                                <TextBlock x:Name="MenuText"
                                           Text="{TemplateBinding Content}"
                                           FontFamily="{StaticResource HeadingFont}"
                                           FontSize="40"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource DimInkBrush}"
                                           VerticalAlignment="Center"
                                           RenderTransformOrigin="0,0.5">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="TextTrans" X="0" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Checked state: Scale 1, Color Ink -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="MenuText" Property="Foreground" Value="{StaticResource InkBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1.0" Duration="0:0:0.160">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1.0" Duration="0:0:0.160">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX"
                                                             To="0.0" Duration="0:0:0.160">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY"
                                                             To="0.0" Duration="0:0:0.160">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Hover state: Scale 0.6 (if unchecked) or keep 1 (if checked), shift text +8px -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX"
                                                             To="0.6" Duration="0:0:0.160">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY"
                                                             To="0.6" Duration="0:0:0.160">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX"
                                                             To="0.0" Duration="0:0:0.160">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY"
                                                             To="0.0" Duration="0:0:0.160">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>

                            <!-- Hover shift: text shifts right by 8px in 160ms -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TextTrans" Storyboard.TargetProperty="X"
                                                             To="8" Duration="0:0:0.160">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TextTrans" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.160">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window Border: 980x620, radius 3px -->
    <Border Background="{StaticResource NightBrush}" BorderThickness="1" BorderBrush="{StaticResource LineInkBrush}" CornerRadius="3" ClipToBounds="True">
        <Grid>
            <!-- 0. STATIC WORLD ART BACKGROUND ON ALL SCREENS (no parallax) -->
            <Image x:Name="BgWorldImage"
                   Source="{StaticResource WorldBackgroundBitmap}"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.CacheMode>
                    <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="True" />
                </Image.CacheMode>
            </Image>

            <!-- OVERVIEW BACKGROUND GRADIENTS -->
            <Grid x:Name="OverviewGradientOverlay" IsHitTestVisible="False">
                <!-- Top-to-bottom header gradient: rgba(5,12,16,.55) -> 0, height 90px (window icons visible on sky) -->
                <Border Height="90" VerticalAlignment="Top">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#8C050C10" Offset="0.0" />
                            <GradientStop Color="#00050C10" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Left-to-right gradient -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#EB050C10" Offset="0.0" />  <!-- 92% at 0 -->
                            <GradientStop Color="#B8050C10" Offset="0.30" /> <!-- 72% at 30% -->
                            <GradientStop Color="#1F050C10" Offset="0.62" /> <!-- 12% at 62% -->
                            <GradientStop Color="#00050C10" Offset="0.80" /> <!-- 0 at 80% -->
                            <GradientStop Color="#00050C10" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Bottom-to-top gradient up to 55% height -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Color="#CC050C10" Offset="0.0" />  <!-- 80% at 0 -->
                            <GradientStop Color="#66050C10" Offset="0.25" />
                            <GradientStop Color="#00050C10" Offset="0.55" /> <!-- 0 at 55% -->
                            <GradientStop Color="#00050C10" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <!-- OTHER SCREENS OVERLAY (rgba(6,14,18,0.66) fade-in 300ms) -->
            <Border x:Name="OtherScreensOverlay"
                    Background="#A8060E12"
                    Opacity="0"
                    IsHitTestVisible="False" />

            <!-- ============================================== -->
            <!-- 1. TOP HEADER                                  -->
            <!-- ============================================== -->
            <!-- Top-left: x=20, y=14: 12px "Aura" (600) + "beta 1.0.5" (mute) -->
            <Canvas Height="40" VerticalAlignment="Top" Panel.ZIndex="50">
                <StackPanel Canvas.Left="20" Canvas.Top="14" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Aura "
                               FontFamily="{StaticResource MainFont}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="{Binding LauncherVersionText}"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="{StaticResource MuteBrush}" />
                </StackPanel>
            </Canvas>

            <!-- Top-right: Sound Icon + Minimize + Close (32x34 each, on hover white 10%) -->
            <!-- Sound icon: on hover volume slider (112px wide) slides out to the LEFT in 180ms, collapses 400ms after mouse leave -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,8,12,0" Panel.ZIndex="60"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                
                <!-- Sound Root: slider on left, button on right -->
                <Grid x:Name="SoundControlRoot"
                      Background="Transparent"
                      MouseEnter="SoundControl_MouseEnter"
                      MouseLeave="SoundControl_MouseLeave"
                      Height="34" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Sliding Volume Box to the LEFT (Width 0 -> 112) -->
                        <Border x:Name="SliderBox" Width="0" Opacity="0" ClipToBounds="True" VerticalAlignment="Center">
                            <Slider x:Name="HeaderVolSlider"
                                    Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                    Value="{Binding AnthemVolume, Mode=TwoWay}"
                                    Style="{StaticResource HeaderVolumeSlider}"
                                    Width="112" Margin="0,0,8,0"
                                    ToolTip="Громкость гимна" />
                        </Border>

                        <!-- Sound Button -->
                        <Button Command="{Binding ToggleMuteCommand}"
                                Style="{StaticResource WinSoundBtn}"
                                ToolTip="Гимн: звук включён / выключен">
                            <Grid Width="16" Height="16">
                                <!-- Sound On -->
                                <Path x:Name="IconSoundOn"
                                      Data="M2,5 L5,5 L9,1 L9,15 L5,11 L2,11 Z M11.5,5.5 C12.8,6.8 13.5,8.3 13.5,10 C13.5,11.7 12.8,13.2 11.5,14.5 M13.8,3.2 C15.8,5.2 16.8,7.5 16.8,10 C16.8,12.5 15.8,14.8 13.8,16.8"
                                      Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.2"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Visibility="{Binding IsAnthemMuted, Converter={StaticResource InverseBoolToVis}}" />
                                <!-- Sound Muted -->
                                <Path x:Name="IconSoundMuted"
                                      Data="M2,5 L5,5 L9,1 L9,15 L5,11 L2,11 Z M12,7 L16,11 M16,7 L12,11"
                                      Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Visibility="{Binding IsAnthemMuted, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Minimize & Close Buttons -->
                <Button Command="{Binding MinimizeWindowCommand}" Style="{StaticResource WinControlBtn}" Content="—" />
                <Button Command="{Binding CloseWindowCommand}" Style="{StaticResource WinCloseBtn}" Content="✕" />
            </StackPanel>

            <!-- ============================================== -->
            <!-- 2. GAME MENU & PLAYER INFO (LEFT SIDE)         -->
            <!-- ============================================== -->
            <Canvas Width="340" HorizontalAlignment="Left" Panel.ZIndex="40">
                <!-- Game Menu (4 words: Играть, Лобби, Скин, Настройки):
                     x=50, bottom edge 128px from bottom (i.e. top = 620 - 128 - 4*50 = 292) -->
                <StackPanel x:Name="GameMenuPanel"
                            Canvas.Left="50" Canvas.Top="292"
                            Width="250"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    
                    <!-- 1. Играть -->
                    <RadioButton x:Name="MenuBtnPlay" Content="Играть"
                                 Command="{Binding NavigateCommand}" CommandParameter="Overview"
                                 IsChecked="{Binding IsOverviewActive, Mode=TwoWay}"
                                 Style="{StaticResource GameMenuRadio}"
                                 MouseEnter="MenuItem_MouseEnter" MouseLeave="MenuItem_MouseLeave" />

                    <!-- 2. Лобби -->
                    <RadioButton x:Name="MenuBtnLobby" Content="Лобби"
                                 Command="{Binding NavigateCommand}" CommandParameter="Lobby"
                                 IsChecked="{Binding IsLobbyActive, Mode=TwoWay}"
                                 Style="{StaticResource GameMenuRadio}"
                                 MouseEnter="MenuItem_MouseEnter" MouseLeave="MenuItem_MouseLeave" />

                    <!-- 3. Скин -->
                    <RadioButton x:Name="MenuBtnSkin" Content="Скин"
                                 Command="{Binding NavigateCommand}" CommandParameter="Wardrobe"
                                 IsChecked="{Binding IsWardrobeActive, Mode=TwoWay}"
                                 Style="{StaticResource GameMenuRadio}"
                                 MouseEnter="MenuItem_MouseEnter" MouseLeave="MenuItem_MouseLeave" />

                    <!-- 4. Настройки -->
                    <RadioButton x:Name="MenuBtnSettings" Content="Настройки"
                                 Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                 IsChecked="{Binding IsSettingsActive, Mode=TwoWay}"
                                 Style="{StaticResource GameMenuRadio}"
                                 MouseEnter="MenuItem_MouseEnter" MouseLeave="MenuItem_MouseLeave" />
                </StackPanel>

                <!-- Player info: x=56, bottom 40px (top = 620 - 40 - 40 = 540)
                     head 40x40 (nearest neighbor / aliased pixel scaling), nickname 16px 600, below "N ГБ памяти" 12px mute -->
                <StackPanel Canvas.Left="56" Canvas.Top="540" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="2" ClipToBounds="True" Background="#141E26" Margin="0,0,12,0">
                        <Image Source="{Binding PlayerAvatar}" Width="40" Height="40"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               RenderOptions.EdgeMode="Aliased"
                               Stretch="UniformToFill" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PlayerNickname}"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="180" />
                        <TextBlock Text="{Binding RamFormatted}"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="12" FontWeight="Normal"
                                   Foreground="{StaticResource MuteBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Canvas>

            <!-- ============================================== -->
            <!-- 3. CONTENT AREA (BOUNDS: LEFT 340, RIGHT 56,  -->
            <!--    TOP 64, BOTTOM 44). FIXED POSITION!         -->
            <!-- ============================================== -->
            <!-- Storyboard tab transitions: outgoing Opacity 1 -> 0 in 100ms; incoming Opacity 0 -> 1 and Y 8 -> 0 in 220ms -->
            <Grid x:Name="ScreensContainer" Margin="340,64,56,44" ClipToBounds="False" Focusable="False" FocusVisualStyle="{x:Null}" Panel.ZIndex="30">
                <views:OverviewView x:Name="ViewOverview"
                                    DataContext="{Binding OverviewVM}"
                                    Visibility="Visible"
                                    Opacity="1.0"
                                    Focusable="False"
                                    FocusVisualStyle="{x:Null}">
                    <views:OverviewView.RenderTransform>
                        <TranslateTransform Y="0" />
                    </views:OverviewView.RenderTransform>
                </views:OverviewView>

                <views:LobbyView x:Name="ViewLobby"
                                 DataContext="{Binding LobbyVM}"
                                 Visibility="Collapsed"
                                 Opacity="0.0"
                                 Focusable="False"
                                 FocusVisualStyle="{x:Null}">
                    <views:LobbyView.RenderTransform>
                        <TranslateTransform Y="0" />
                    </views:LobbyView.RenderTransform>
                </views:LobbyView>

                <views:WardrobeView x:Name="ViewWardrobe"
                                    DataContext="{Binding WardrobeVM}"
                                    Visibility="Collapsed"
                                    Opacity="0.0"
                                    Focusable="False"
                                    FocusVisualStyle="{x:Null}">
                    <views:WardrobeView.RenderTransform>
                        <TranslateTransform Y="0" />
                    </views:WardrobeView.RenderTransform>
                </views:WardrobeView>

                <views:SettingsView x:Name="ViewSettings"
                                    DataContext="{Binding SettingsVM}"
                                    Visibility="Collapsed"
                                    Opacity="0.0"
                                    Focusable="False"
                                    FocusVisualStyle="{x:Null}">
                    <views:SettingsView.RenderTransform>
                        <TranslateTransform Y="0" />
                    </views:SettingsView.RenderTransform>
                </views:SettingsView>

                <!-- Floating update toast banner -->
                <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                        Margin="0,8,0,0" Panel.ZIndex="100"
                        Background="#E0071017" BorderBrush="{StaticResource EmberBrush}" BorderThickness="1"
                        CornerRadius="3" Padding="14,10"
                        Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource EmberBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="{Binding UpdateBannerTitle}" Foreground="{StaticResource InkBrush}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding UpdateBannerMessage}" Foreground="{StaticResource DimInkBrush}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>

                        <Button Command="{Binding ApplyBannerUpdateCommand}"
                                Style="{StaticResource PrimaryNeonBtn}"
                                Height="30" Padding="12,0" FontSize="12"
                                Content="{Binding UpdateBannerButtonText}"
                                Margin="0,0,8,0" VerticalAlignment="Center" />

                        <Button Command="{Binding DismissBannerCommand}"
                                Style="{StaticResource WinCloseBtn}"
                                Width="24" Height="24" FontSize="11"
                                Content="✕" ToolTip="Закрыть"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
