<Window x:Class="AuraLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AURA" Height="620" Width="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0F121B"
        ResizeMode="NoResize"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        Icon="app_icon.ico"
        FontFamily="Segoe UI, -apple-system, sans-serif">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Clean Tab Nav Button Style: 100% Hit-testable -->
        <Style x:Key="NavTabBtn" TargetType="Button">
            <Setter Property="Background" Value="#00000000" />
            <Setter Property="Foreground" Value="#8E9CAE" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#171F2E" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button Style (Minimize, Close): 100% Hit-testable -->
        <Style x:Key="WinControlBtn" TargetType="Button">
            <Setter Property="Background" Value="#00000000" />
            <Setter Property="Foreground" Value="#8E9CAE" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#1E283D" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Action Button -->
        <Style x:Key="StandardBtn" TargetType="Button">
            <Setter Property="Background" Value="#182030" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="#26344E"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#222D44" />
                                <Setter TargetName="Brd" Property="BorderBrush" Value="#3B4F73" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#151C2A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented RAM Radio Button -->
        <Style x:Key="RamPillRadio" TargetType="RadioButton">
            <Setter Property="Background" Value="#141B28" />
            <Setter Property="Foreground" Value="#8E9CAE" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="#222C3E" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#1E2B40" />
                                <Setter TargetName="Brd" Property="BorderBrush" Value="#34D399" />
                                <Setter Property="Foreground" Value="#34D399" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#1B2436" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Solid Container -->
    <Grid Background="#0F121B">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <!-- 1. Header Bar -->
            <RowDefinition Height="*" />
            <!-- 2. Main Content Area -->
            <RowDefinition Height="96" />
            <!-- 3. Bottom Launch Deck -->
        </Grid.RowDefinitions>

        <!-- ============================================== -->
        <!-- 1. TOP HEADER BAR                              -->
        <!-- ============================================== -->
        <Border Grid.Row="0" Background="#0B0E16" BorderThickness="0,0,0,1" BorderBrush="#1C2333">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!-- Brand (Draggable) -->
                    <ColumnDefinition Width="*" />
                    <!-- Tabs (Clickable) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Window Controls (Clickable) -->
                </Grid.ColumnDefinitions>

                <!-- Left: Clean Brand (Draggable) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                            Cursor="SizeAll" MouseLeftButtonDown="Window_MouseLeftButtonDown" Background="Transparent">
                    <Image Source="app_icon.png" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="AURA" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="Minecraft 1.20.1 Fabric" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center: Clean Text Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="TabBtnOverview" Click="NavOverview_Click" Style="{StaticResource NavTabBtn}" Content="ИГРАТЬ" Foreground="#FFFFFF" />
                    <Button x:Name="TabBtnMods" Click="NavMods_Click" Style="{StaticResource NavTabBtn}" Content="МОДЫ" />
                    <Button x:Name="TabBtnWardrobe" Click="NavWardrobe_Click" Style="{StaticResource NavTabBtn}" Content="СКИН" />
                    <Button x:Name="TabBtnSettings" Click="NavSettings_Click" Style="{StaticResource NavTabBtn}" Content="НАСТРОЙКИ" />
                </StackPanel>

                <!-- Right: Window Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Click="BtnMinimize_Click" Style="{StaticResource WinControlBtn}" Content="—" />
                    <Button Click="BtnClose_Click" Style="{StaticResource WinControlBtn}" Content="✕" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- 2. MAIN CONTENT AREA                           -->
        <!-- ============================================== -->
        <Grid Grid.Row="1">
            <!-- ============================================== -->
            <!-- TAB 1: OVERVIEW (HERO CINEMATIC BANNER)        -->
            <!-- ============================================== -->
            <Grid x:Name="ViewOverview" Visibility="Visible">
                <!-- Crisp Cinematic Minecraft Background (Top 100% of this view) -->
                <Image x:Name="ImgBgWorld" Source="bg_world.png" Stretch="UniformToFill" VerticalAlignment="Top" Height="478" />

                <!-- Gradient Fade from Banner into Solid Bottom -->
                <Border VerticalAlignment="Bottom" Height="240">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#000F121B" Offset="0.0" />
                            <GradientStop Color="#990F121B" Offset="0.5" />
                            <GradientStop Color="#FF0F121B" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Clean Hero Text (No cards, no marketing pills) -->
                <StackPanel VerticalAlignment="Bottom" Margin="32,0,0,32">
                    <TextBlock Text="Vanilla+" FontSize="44" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.9" Color="#000000" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="45 модификаций • Встроенные шейдеры MakeUp • Сервер активен" FontSize="14" Foreground="#E2E8F0">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.9" Color="#000000" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- ============================================== -->
            <!-- TAB 2: MODS CATALOG (CLEAN SIMPLE LIST)        -->
            <!-- ============================================== -->
            <Grid x:Name="ViewMods" Visibility="Collapsed" Background="#0F121B" Margin="32,20,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header & Search -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Установленные модификации" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock x:Name="TxtModCountBadge" Text="Всего 45 модов" Foreground="#64748B" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Search Input -->
                    <Border Grid.Column="1" Background="#141B28" BorderThickness="1" BorderBrush="#222C3E" CornerRadius="6"
                            Width="260" Height="34" Margin="0,0,12,0" Padding="10,0">
                        <TextBox x:Name="TxtSearchMods" Background="Transparent" BorderThickness="0"
                                 Foreground="#FFFFFF" FontSize="12" VerticalAlignment="Center"
                                 TextChanged="TxtSearchMods_TextChanged" />
                    </Border>

                    <Button Grid.Column="2" Click="BtnOpenModsFolder_Click" Style="{StaticResource StandardBtn}" Content="Открыть папку mods" />
                </Grid>

                <!-- Scrollable Mods List (2-column clean list without colored badges) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ModsItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="445" Background="#131926" BorderThickness="1" BorderBrush="#1C2436"
                                        CornerRadius="6" Padding="14,10" Margin="0,0,10,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Category}" Foreground="#64748B" FontSize="11" />
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}" Foreground="#8E9CAE" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ============================================== -->
            <!-- TAB 3: WARDROBE (CRISP 2D PIXEL SKIN PREVIEW)  -->
            <!-- ============================================== -->
            <Grid x:Name="ViewWardrobe" Visibility="Collapsed" Background="#0F121B" Margin="32,24,32,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <!-- Skin Preview -->
                    <ColumnDefinition Width="*" />
                    <!-- Skin Actions -->
                </Grid.ColumnDefinitions>

                <!-- Left: Razor-sharp NearestNeighbor Skin Preview -->
                <Border Background="#131926" BorderThickness="1" BorderBrush="#1E283C" CornerRadius="8" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Pixel-perfect 2D model: 128x256 -->
                        <Image x:Name="ImgSkinPreview2D" Width="128" Height="256"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" x:Name="TxtWardrobeFormat" Text="Классический Стив (64×64)"
                                   Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    </Grid>
                </Border>

                <!-- Right: Clean Skin Controls -->
                <StackPanel Grid.Column="1" Margin="32,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Установка скина" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                    <TextBlock Text="Скин синхронизируется в игру через CustomSkinLoader и виден всем игрокам на сервере без лицензии."
                               Foreground="#8E9CAE" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,24" />

                    <!-- Nickname Field -->
                    <TextBlock Text="Игровой никнейм" Foreground="#64748B" FontSize="12" Margin="0,0,0,6" />
                    <Border Background="#141B28" BorderThickness="1" BorderBrush="#222C3E" CornerRadius="6"
                            Width="320" Height="36" HorizontalAlignment="Left" Padding="10,0" Margin="0,0,0,20">
                        <TextBox x:Name="TxtWardrobeNick" Background="Transparent" BorderThickness="0"
                                 Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                 TextChanged="TxtNickname_TextChanged" />
                    </Border>

                    <!-- Skin Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Click="BtnChangeSkin_Click" Style="{StaticResource StandardBtn}" Content="Выбрать файл скина (.png)"
                                Height="38" Padding="20,0" Margin="0,0,12,0" />
                        <Button Click="BtnResetSteve_Click" Style="{StaticResource StandardBtn}" Content="Сбросить на Стива"
                                Height="38" Padding="20,0" />
                    </StackPanel>

                    <TextBlock Text="Или перетащите файл .png прямо в окно лаунчера." Foreground="#556980" FontSize="11" />
                </StackPanel>
            </Grid>

            <!-- ============================================== -->
            <!-- TAB 4: SETTINGS                                -->
            <!-- ============================================== -->
            <Grid x:Name="ViewSettings" Visibility="Collapsed" Background="#0F121B" Margin="32,24,32,20">
                <StackPanel VerticalAlignment="Top" MaxWidth="600" HorizontalAlignment="Left">
                    <TextBlock Text="Настройки" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,20" />

                    <!-- Game Directory -->
                    <TextBlock Text="Рабочая папка игры (.minecraft)" Foreground="#64748B" FontSize="12" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#141B28" BorderThickness="1" BorderBrush="#222C3E" CornerRadius="6" Height="36" Padding="10,0">
                            <TextBox x:Name="TxtGameDir" Background="Transparent" BorderThickness="0"
                                     Foreground="#FFFFFF" FontSize="12" VerticalAlignment="Center" IsReadOnly="True" />
                        </Border>
                        <Button Grid.Column="1" Click="BtnOpenGameDir_Click" Style="{StaticResource StandardBtn}" Content="Открыть" Margin="10,0,0,0" Height="36" />
                    </Grid>

                    <!-- GitHub Updates Repo -->
                    <TextBlock Text="Репозиторий обновлений GitHub" Foreground="#64748B" FontSize="12" Margin="0,0,0,6" />
                    <Border Background="#141B28" BorderThickness="1" BorderBrush="#222C3E" CornerRadius="6" Height="36" Padding="10,0" Margin="0,0,0,24">
                        <TextBox x:Name="TxtGitHubRepo" Background="Transparent" BorderThickness="0"
                                 Foreground="#FFFFFF" FontSize="12" VerticalAlignment="Center" Text="qutlawsoasis-debug/Aura" />
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Click="BtnSaveSettings_Click" Style="{StaticResource StandardBtn}" Content="Сохранить настройки" Height="38" Padding="24,0" />
                        <TextBlock x:Name="TxtSettingsStatus" Text="Настройки сохранены!" Foreground="#34D399" FontSize="12"
                                   VerticalAlignment="Center" Margin="16,0,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ============================================== -->
        <!-- 3. BOTTOM LAUNCH DECK (100% SOLID & RELIABLE)  -->
        <!-- ============================================== -->
        <Border Grid.Row="2" Background="#0B0E16" BorderThickness="0,1,0,0" BorderBrush="#1C2333" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!-- Nickname Input & Face -->
                    <ColumnDefinition Width="Auto" />
                    <!-- RAM Selector -->
                    <ColumnDefinition Width="*" />
                    <!-- Dynamic Quotes & Progress -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Big Play Button -->
                </Grid.ColumnDefinitions>

                <!-- 1. Player Info (Mini Face + Nick Input) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Border Width="38" Height="38" Background="#141B28" BorderThickness="1" BorderBrush="#222C3E" CornerRadius="6" ClipToBounds="True" Margin="0,0,12,0">
                        <Image x:Name="ImgDockFace" Width="38" Height="38" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Игрок" Foreground="#64748B" FontSize="11" Margin="0,0,0,1" />
                        <TextBlock x:Name="TxtDockNick" Text="Player" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>

                <!-- 2. RAM Quick Radio Selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <RadioButton x:Name="RbRam4" Content="4 ГБ" Tag="4096" Checked="RamRadio_Checked" Style="{StaticResource RamPillRadio}" />
                    <RadioButton x:Name="RbRam6" Content="6 ГБ" Tag="6144" IsChecked="True" Checked="RamRadio_Checked" Style="{StaticResource RamPillRadio}" />
                    <RadioButton x:Name="RbRam8" Content="8 ГБ" Tag="8192" Checked="RamRadio_Checked" Style="{StaticResource RamPillRadio}" />
                    <RadioButton x:Name="RbRam12" Content="12 ГБ" Tag="12288" Checked="RamRadio_Checked" Style="{StaticResource RamPillRadio}" />
                </StackPanel>

                <!-- 3. Status & Dynamic CS:GO Quotes -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock x:Name="TxtWittyQuote" Text="Заряжаем пули..." Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TxtStatusDetails" Text="Все файлы актуальны" Foreground="#64748B" FontSize="11" Margin="0,2,0,0" />
                    <ProgressBar x:Name="ProgressBarLaunch" Height="3" Margin="0,4,0,0" Background="#151C2A" Foreground="#10B981"
                                 BorderThickness="0" Visibility="Collapsed" />
                </StackPanel>

                <!-- 4. Massive Emerald PLAY Button (100% Clickable Area) -->
                <Button x:Name="BtnPlay" Grid.Column="3" Click="BtnPlay_Click" Width="200" Height="48" Cursor="Hand" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Brd" Background="#10B981" CornerRadius="8">
                                <TextBlock x:Name="TxtPlayBtnText" Text="ИГРАТЬ" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Brd" Property="Background" Value="#059669" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Brd" Property="Background" Value="#047857" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Brd" Property="Background" Value="#2A384E" />
                                    <Setter TargetName="Brd" Property="Opacity" Value="0.6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
