<Window x:Class="AuraLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AuraLauncher.ViewModels"
        xmlns:views="clr-namespace:AuraLauncher.Views"
        xmlns:core="clr-namespace:AuraLauncher.Core"
        Title="Aura" Height="620" Width="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/Resources/aura-icon.ico"
        FontFamily="{StaticResource MainFont}"
        FocusVisualStyle="{x:Null}">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="3" CaptionHeight="40" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <core:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WorkshopViewModel}">
            <views:WorkshopView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WardrobeViewModel}">
            <views:WardrobeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LobbyViewModel}">
            <views:LobbyView />
        </DataTemplate>

        <Style x:Key="GameMenuRadio" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Ember 10x10 square with radius 2 -->
                                <Border x:Name="DotSquare"
                                        Width="10" Height="10"
                                        CornerRadius="2"
                                        Background="{StaticResource EmberBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,14,0"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="DotScale" ScaleX="0" ScaleY="0" />
                                    </Border.RenderTransform>
                                </Border>

                                <!-- Text with 8px horizontal translation -->
                                <TextBlock x:Name="MenuText"
                                           Text="{TemplateBinding Content}"
                                           FontFamily="{StaticResource HeadingFont}"
                                           FontSize="40"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource DimInkBrush}"
                                           VerticalAlignment="Center"
                                           RenderTransformOrigin="0,0.5">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="TextTrans" X="0" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Checked state: ALWAYS text Color Ink, active dot is handled by sliding ActiveNavIndicator -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="MenuText" Property="Foreground" Value="{StaticResource InkBrush}" />
                                <Setter TargetName="DotSquare" Property="Opacity" Value="0.0" />
                            </Trigger>

                            <!-- Hover state for unchecked items: faint preview dot Scale 0.6, Opacity 0.45 -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="DotSquare" Property="Opacity" Value="0.45" />
                                <Setter TargetName="DotSquare" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.6" ScaleY="0.6" />
                                    </Setter.Value>
                                </Setter>
                            </MultiTrigger>

                            <!-- Hover shift: text shifts right by 8px in 160ms -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TextTrans" Storyboard.TargetProperty="X"
                                                             To="8" Duration="0:0:0.160">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TextTrans" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.160">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window Border: 980x620, radius 3px -->
    <Border Background="{StaticResource NightBrush}" BorderThickness="1" BorderBrush="{StaticResource LineInkBrush}" CornerRadius="3" ClipToBounds="True">
        <Grid>
            <!-- 0. DYNAMIC ROTATING BACKGROUND WITH SMOOTH CROSS-FADE -->
            <Grid x:Name="BackgroundHost" ClipToBounds="True">
                <Image x:Name="BgImageCurrent"
                       Source="{StaticResource WorldBackgroundBitmap}"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.CacheMode>
                        <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="True" />
                    </Image.CacheMode>
                </Image>
                <Image x:Name="BgImageNext"
                       Opacity="0"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.CacheMode>
                        <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="True" />
                    </Image.CacheMode>
                </Image>
            </Grid>

            <!-- OVERVIEW BACKGROUND GRADIENTS -->
            <Grid x:Name="OverviewGradientOverlay" IsHitTestVisible="False">
                <!-- Top-to-bottom header gradient: rgba(5,12,16,.55) -> 0, height 90px (window icons visible on sky) -->
                <Border Height="90" VerticalAlignment="Top">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#8C050C10" Offset="0.0" />
                            <GradientStop Color="#00050C10" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Left-to-right gradient -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#EB050C10" Offset="0.0" />  <!-- 92% at 0 -->
                            <GradientStop Color="#B8050C10" Offset="0.30" /> <!-- 72% at 30% -->
                            <GradientStop Color="#1F050C10" Offset="0.62" /> <!-- 12% at 62% -->
                            <GradientStop Color="#00050C10" Offset="0.80" /> <!-- 0 at 80% -->
                            <GradientStop Color="#00050C10" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Bottom-to-top gradient up to 55% height -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Color="#CC050C10" Offset="0.0" />  <!-- 80% at 0 -->
                            <GradientStop Color="#66050C10" Offset="0.25" />
                            <GradientStop Color="#00050C10" Offset="0.55" /> <!-- 0 at 55% -->
                            <GradientStop Color="#00050C10" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <!-- OTHER SCREENS OVERLAY (rgba(6,14,18,0.66) fade-in 300ms) -->
            <Border x:Name="OtherScreensOverlay"
                    Background="#A8060E12"
                    Opacity="0"
                    IsHitTestVisible="False" />

            <!-- ============================================== -->
            <!-- 1. TOP HEADER                                  -->
            <!-- ============================================== -->

            <!-- Top-right: Sound Icon + Minimize + Close (32x34 each, on hover white 10%) -->
            <!-- Sound icon: on hover volume slider (112px wide) slides out to the LEFT in 180ms, collapses 400ms after mouse leave -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,8,12,0" Panel.ZIndex="60"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                
                <!-- Sound Root: slider on left, button on right -->
                <Grid x:Name="SoundControlRoot"
                      Background="Transparent"
                      MouseEnter="SoundControl_MouseEnter"
                      MouseLeave="SoundControl_MouseLeave"
                      Height="34" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Sliding Volume Box to the LEFT (Width 0 -> 180) -->
                        <Border x:Name="SliderBox" Width="0" Opacity="0" ClipToBounds="True" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                <!-- Prev Track -->
                                <Button Command="{Binding PreviousTrackCommand}"
                                        Style="{StaticResource WinSoundBtn}"
                                        ToolTip="Предыдущий трек"
                                        Width="20" Height="22" Margin="0,0,2,0">
                                    <TextBlock Text="⏮" FontSize="10" Foreground="{StaticResource DimInkBrush}" />
                                </Button>

                                <!-- Play/Pause -->
                                <Button Command="{Binding TogglePlayPauseCommand}"
                                        Style="{StaticResource WinSoundBtn}"
                                        ToolTip="{Binding CurrentTrackTitle, StringFormat='{}Музыка: {0}'}"
                                        Width="20" Height="22" Margin="0,0,2,0">
                                    <TextBlock Text="⏯" FontSize="10" Foreground="{StaticResource EmberBrush}" />
                                </Button>

                                <!-- Next Track -->
                                <Button Command="{Binding NextTrackCommand}"
                                        Style="{StaticResource WinSoundBtn}"
                                        ToolTip="Следующий трек"
                                        Width="20" Height="22" Margin="0,0,6,0">
                                    <TextBlock Text="⏭" FontSize="10" Foreground="{StaticResource DimInkBrush}" />
                                </Button>

                                <Slider x:Name="HeaderVolSlider"
                                        Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                        Value="{Binding AnthemVolume, Mode=TwoWay}"
                                        Style="{StaticResource HeaderVolumeSlider}"
                                        Width="74"
                                        ToolTip="{Binding CurrentTrackTitle, StringFormat='{}Громкость: {0}% • {1}'}" />
                            </StackPanel>
                        </Border>

                        <!-- Sound Button -->
                        <Button Command="{Binding ToggleMuteCommand}"
                                Style="{StaticResource WinSoundBtn}"
                                ToolTip="Гимн: звук включён / выключен">
                            <Grid Width="16" Height="16">
                                <!-- Sound On -->
                                <Path x:Name="IconSoundOn"
                                      Data="M2,5 L5,5 L9,1 L9,15 L5,11 L2,11 Z M11.5,5.5 C12.8,6.8 13.5,8.3 13.5,10 C13.5,11.7 12.8,13.2 11.5,14.5 M13.8,3.2 C15.8,5.2 16.8,7.5 16.8,10 C16.8,12.5 15.8,14.8 13.8,16.8"
                                      Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.2"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Visibility="{Binding IsAnthemMuted, Converter={StaticResource InverseBoolToVis}}" />
                                <!-- Sound Muted -->
                                <Path x:Name="IconSoundMuted"
                                      Data="M2,5 L5,5 L9,1 L9,15 L5,11 L2,11 Z M12,7 L16,11 M16,7 L12,11"
                                      Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Visibility="{Binding IsAnthemMuted, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Minimize & Close Buttons -->
                <Button Command="{Binding MinimizeWindowCommand}" Style="{StaticResource WinControlBtn}" Content="—" />
                <Button Command="{Binding CloseWindowCommand}" Style="{StaticResource WinCloseBtn}" Content="✕" />
            </StackPanel>

            <!-- ============================================== -->
            <!-- 2. GAME MENU & PLAYER INFO (LEFT SIDE)         -->
            <!-- ============================================== -->
            <Canvas Width="340" HorizontalAlignment="Left" Panel.ZIndex="40">
                <!-- Large Title "Aura" (Oswald 600 124px): x=50, y=44, shown only on Overview tab -->
                <TextBlock Canvas.Left="50" Canvas.Top="44"
                           Text="Aura"
                           FontFamily="{StaticResource HeadingFont}"
                           FontSize="124"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}"
                           LineHeight="116"
                           LineStackingStrategy="BlockLineHeight"
                           IsHitTestVisible="False"
                           Visibility="{Binding IsOverviewActive, Converter={StaticResource BoolToVis}}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="12" Opacity="0.7" Direction="0" ShadowDepth="0" />
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Game Menu (6 words: Играть, Лобби, Друзья, Мастерская, Профиль, Настройки):
                     x=50, top=224 -->
                <StackPanel x:Name="GameMenuPanel"
                            Canvas.Left="50" Canvas.Top="224"
                            Width="250"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    
                    <!-- 1. Играть -->
                    <RadioButton x:Name="MenuBtnPlay" Content="Играть"
                                 Command="{Binding NavigateCommand}" CommandParameter="Overview"
                                 IsChecked="{Binding IsOverviewActive, Mode=TwoWay}"
                                 Style="{StaticResource GameMenuRadio}"
                                 MouseEnter="MenuItem_MouseEnter" MouseLeave="MenuItem_MouseLeave" />

                    <!-- 2. Лобби -->
                    <RadioButton x:Name="MenuBtnLobby" Content="Лобби"
                                 Command="{Binding NavigateCommand}" CommandParameter="Lobby"
                                 IsChecked="{Binding IsLobbyActive, Mode=TwoWay}"
                                 Style="{StaticResource GameMenuRadio}"
                                 MouseEnter="MenuItem_MouseEnter" MouseLeave="MenuItem_MouseLeave" />

                    <!-- 3. Друзья -->
                    <RadioButton x:Name="MenuBtnFriends" Content="Друзья"
                                 Command="{Binding NavigateCommand}" CommandParameter="Friends"
                                 IsChecked="{Binding IsFriendsActive, Mode=TwoWay}"
                                 Style="{StaticResource GameMenuRadio}"
                                 MouseEnter="MenuItem_MouseEnter" MouseLeave="MenuItem_MouseLeave" />

                    <!-- 4. Мастерская -->
                    <RadioButton x:Name="MenuBtnWorkshop" Content="Мастерская"
                                 Command="{Binding NavigateCommand}" CommandParameter="Workshop"
                                 IsChecked="{Binding IsWorkshopActive, Mode=TwoWay}"
                                 Style="{StaticResource GameMenuRadio}"
                                 MouseEnter="MenuItem_MouseEnter" MouseLeave="MenuItem_MouseLeave" />

                    <!-- 5. Профиль -->
                    <RadioButton x:Name="MenuBtnSkin" Content="Профиль"
                                 Command="{Binding NavigateCommand}" CommandParameter="Wardrobe"
                                 IsChecked="{Binding IsWardrobeActive, Mode=TwoWay}"
                                 Style="{StaticResource GameMenuRadio}"
                                 MouseEnter="MenuItem_MouseEnter" MouseLeave="MenuItem_MouseLeave" />

                    <!-- 6. Настройки -->
                    <RadioButton x:Name="MenuBtnSettings" Content="Настройки"
                                 Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                 IsChecked="{Binding IsSettingsActive, Mode=TwoWay}"
                                 Style="{StaticResource GameMenuRadio}"
                                 MouseEnter="MenuItem_MouseEnter" MouseLeave="MenuItem_MouseLeave" />
                </StackPanel>

                <!-- Smooth sliding active navigation indicator dot (Ember 10x10 square) -->
                <Border x:Name="ActiveNavIndicator"
                        Canvas.Left="50" Canvas.Top="242"
                        Width="10" Height="10"
                        CornerRadius="2"
                        Background="{StaticResource EmberBrush}"
                        IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="NavIndicatorTrans" Y="0" />
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect Color="#F2A63C" BlurRadius="8" Opacity="0.6" Direction="0" ShadowDepth="0" />
                    </Border.Effect>
                </Border>

                <!-- Player info: x=56, bottom 40px (top = 620 - 40 - 40 = 540)
                     head 40x40 (nearest neighbor / aliased pixel scaling), nickname 16px 600, below "N ГБ памяти" 12px mute -->
                <StackPanel Canvas.Left="56" Canvas.Top="540" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="2" ClipToBounds="True" Background="#141E26" Margin="0,0,12,0">
                        <Image Source="{Binding PlayerAvatar}" Width="40" Height="40"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               RenderOptions.EdgeMode="Aliased"
                               Stretch="UniformToFill" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PlayerNickname}"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="180" />
                        <TextBlock Text="{Binding RamFormatted}"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="12" FontWeight="Normal"
                                   Foreground="{StaticResource MuteBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Canvas>

            <!-- ============================================== -->
            <!-- 3. CONTENT AREA (BOUNDS: LEFT 340, RIGHT 56,  -->
            <!--    TOP 64, BOTTOM 44). FIXED POSITION!         -->
            <!-- ============================================== -->
            <!-- Storyboard tab transitions: outgoing Opacity 1 -> 0 in 100ms; incoming Opacity 0 -> 1 and Y 8 -> 0 in 220ms -->
            <Grid x:Name="ScreensContainer" Margin="340,64,56,44" ClipToBounds="False" Focusable="False" FocusVisualStyle="{x:Null}" Panel.ZIndex="30">
                <views:OverviewView x:Name="ViewOverview"
                                    DataContext="{Binding OverviewVM}"
                                    Visibility="Visible"
                                    Opacity="1.0"
                                    Focusable="False"
                                    FocusVisualStyle="{x:Null}">
                    <views:OverviewView.RenderTransform>
                        <TranslateTransform Y="0" />
                    </views:OverviewView.RenderTransform>
                </views:OverviewView>

                <views:LobbyView x:Name="ViewLobby"
                                 DataContext="{Binding LobbyVM}"
                                 Visibility="Collapsed"
                                 Opacity="0.0"
                                 Focusable="False"
                                 FocusVisualStyle="{x:Null}">
                    <views:LobbyView.RenderTransform>
                        <TranslateTransform Y="0" />
                    </views:LobbyView.RenderTransform>
                </views:LobbyView>

                <views:FriendsView x:Name="ViewFriends"
                                   DataContext="{Binding FriendsVM}"
                                   Visibility="Collapsed"
                                   Opacity="0.0"
                                   Focusable="False"
                                   FocusVisualStyle="{x:Null}">
                    <views:FriendsView.RenderTransform>
                        <TranslateTransform Y="0" />
                    </views:FriendsView.RenderTransform>
                </views:FriendsView>

                <views:WorkshopView x:Name="ViewWorkshop"
                                    DataContext="{Binding WorkshopVM}"
                                    Visibility="Collapsed"
                                    Opacity="0.0"
                                    Focusable="False"
                                    FocusVisualStyle="{x:Null}">
                    <views:WorkshopView.RenderTransform>
                        <TranslateTransform Y="0" />
                    </views:WorkshopView.RenderTransform>
                </views:WorkshopView>

                <views:WardrobeView x:Name="ViewWardrobe"
                                    DataContext="{Binding WardrobeVM}"
                                    Visibility="Collapsed"
                                    Opacity="0.0"
                                    Focusable="False"
                                    FocusVisualStyle="{x:Null}">
                    <views:WardrobeView.RenderTransform>
                        <TranslateTransform Y="0" />
                    </views:WardrobeView.RenderTransform>
                </views:WardrobeView>

                <views:SettingsView x:Name="ViewSettings"
                                    DataContext="{Binding SettingsVM}"
                                    Visibility="Collapsed"
                                    Opacity="0.0"
                                    Focusable="False"
                                    FocusVisualStyle="{x:Null}">
                    <views:SettingsView.RenderTransform>
                        <TranslateTransform Y="0" />
                    </views:SettingsView.RenderTransform>
                </views:SettingsView>
            </Grid>

            <!-- ============================================== -->
            <!-- TOAST NOTIFICATIONS (TOP-RIGHT CORNER OF WINDOW)-->
            <!-- ============================================== -->
            <!-- Update Toast: правый верхний угол, аккуратная прямоугольная плашка 290px -->
            <Border x:Name="UpdateToastBorder"
                    VerticalAlignment="Top" HorizontalAlignment="Right"
                    Width="290" Panel.ZIndex="150"
                    Background="#0F1B22"
                    BorderBrush="{StaticResource LineInkBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True"
                    Margin="0,48,20,0"
                    Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BoolToVis}}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="16" Opacity="0.65" Direction="270" ShadowDepth="4" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastTransform" X="0" />
                </Border.RenderTransform>
                <Grid>
                    <Border HorizontalAlignment="Left" Width="3" Background="{StaticResource EmberBrush}" />
                    <StackPanel Margin="14,10,12,10">
                        <TextBlock Text="{Binding UpdateBannerTitle}"
                                   FontFamily="{StaticResource MainFont}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{StaticResource InkBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding UpdateBannerMessage}"
                                   FontFamily="{StaticResource MainFont}"
                                   FontWeight="Normal"
                                   FontSize="11"
                                   Foreground="{StaticResource DimInkBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,8" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding ApplyBannerUpdateCommand}"
                                    IsEnabled="{Binding CanApplyUpdate}"
                                    Style="{StaticResource PrimaryNeonBtn}"
                                    Height="28" Padding="12,0" FontSize="12"
                                    Content="{Binding UpdateBannerButtonText}"
                                    Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink Command="{Binding DismissBannerCommand}"
                                           Foreground="{StaticResource MuteBrush}"
                                           TextDecorations="None">
                                    <Run Text="Позже" FontFamily="{StaticResource MainFont}" FontSize="12" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Invite Toast: правый верхний угол, аккуратная прямоугольная плашка 290px -->
            <Border x:Name="InviteToastBorder"
                    VerticalAlignment="Top" HorizontalAlignment="Right"
                    Width="290" Panel.ZIndex="151"
                    Background="#0F1B22"
                    BorderBrush="{StaticResource LineInkBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True"
                    Margin="0,48,20,0"
                    Visibility="{Binding IsInviteToastVisible, Converter={StaticResource BoolToVis}}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="16" Opacity="0.65" Direction="270" ShadowDepth="4" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="InviteToastTransform" X="0" />
                </Border.RenderTransform>
                <Grid>
                    <Border HorizontalAlignment="Left" Width="3" Background="{StaticResource EmberBrush}" />
                    <StackPanel Margin="14,10,12,10">
                        <TextBlock Text="{Binding InviteToastTitle}"
                                   FontFamily="{StaticResource MainFont}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{StaticResource InkBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding InviteToastSubtitle}"
                                   FontFamily="{StaticResource MainFont}"
                                   FontWeight="Normal"
                                   FontSize="11"
                                   Foreground="{StaticResource DimInkBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,8" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding AcceptInviteCommand}"
                                    Style="{StaticResource PrimaryNeonBtn}"
                                    Height="28" Padding="12,0" FontSize="12"
                                    Content="Принять"
                                    Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink Command="{Binding DeclineInviteCommand}"
                                           Foreground="{StaticResource MuteBrush}"
                                           TextDecorations="None">
                                    <Run Text="Отклонить" FontFamily="{StaticResource MainFont}" FontSize="12" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Protocol Action Prompt Toast: правый верхний угол, аккуратная прямоугольная плашка 290px -->
            <Border x:Name="ProtocolPromptBorder"
                    VerticalAlignment="Top" HorizontalAlignment="Right"
                    Width="290" Panel.ZIndex="152"
                    Background="#0F1B22"
                    BorderBrush="{StaticResource LineInkBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True"
                    Margin="0,48,20,0"
                    Visibility="{Binding IsProtocolPromptVisible, Converter={StaticResource BoolToVis}}">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="16" Opacity="0.65" Direction="270" ShadowDepth="4" />
                </Border.Effect>
                <Grid>
                    <Border HorizontalAlignment="Left" Width="3" Background="{StaticResource EmberBrush}" />
                    <StackPanel Margin="14,10,12,10">
                        <TextBlock Text="{Binding ProtocolPromptTitle}"
                                   FontFamily="{StaticResource MainFont}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{StaticResource InkBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ProtocolPromptSubtitle}"
                                   FontFamily="{StaticResource MainFont}"
                                   FontWeight="Normal"
                                   FontSize="11"
                                   Foreground="{StaticResource DimInkBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,8" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding ConfirmProtocolPromptCommand}"
                                    Style="{StaticResource PrimaryNeonBtn}"
                                    Height="28" Padding="12,0" FontSize="12"
                                    Content="{Binding ProtocolPromptConfirmText}"
                                    Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock VerticalAlignment="Center">
                                <Hyperlink Command="{Binding CancelProtocolPromptCommand}"
                                           Foreground="{StaticResource MuteBrush}"
                                           TextDecorations="None">
                                    <Run Text="Отмена" FontFamily="{StaticResource MainFont}" FontSize="12" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Info Toast: правый верхний угол, аккуратная прямоугольная плашка 290px -->
            <Border x:Name="InfoToastBorder"
                    VerticalAlignment="Top" HorizontalAlignment="Right"
                    Width="290" Panel.ZIndex="153"
                    Background="#0F1B22"
                    BorderBrush="{StaticResource LineInkBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True"
                    Margin="0,48,20,0"
                    Visibility="{Binding IsInfoToastVisible, Converter={StaticResource BoolToVis}}">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="16" Opacity="0.65" Direction="270" ShadowDepth="4" />
                </Border.Effect>
                <Grid>
                    <Border HorizontalAlignment="Left" Width="3" Background="{StaticResource EmberBrush}" />
                    <StackPanel Margin="14,10,12,10">
                        <TextBlock Text="{Binding InfoToastTitle}"
                                   FontFamily="{StaticResource MainFont}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{StaticResource InkBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding InfoToastSubtitle}"
                                   FontFamily="{StaticResource MainFont}"
                                   FontWeight="Normal"
                                   FontSize="11"
                                   Foreground="{StaticResource DimInkBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"
                                   Visibility="{Binding HasInfoToastSubtitle, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3.5 CHANGELOG MODAL OVERLAY (СПИСОК ИЗМЕНЕНИЙ СБОРКИ МОДОВ) -->
            <Grid x:Name="ChangelogModalOverlay"
                  Panel.ZIndex="120"
                  Visibility="Collapsed"
                  Opacity="0"
                  Background="#99071017">
                <Border x:Name="ChangelogModalCard"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="640" MaxHeight="520"
                        Background="#0F1B22"
                        BorderBrush="{StaticResource LineInkBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="24,20,24,20">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ChangelogModalTrans" Y="10" />
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header with Title and Close Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="3" Height="18" Background="{StaticResource EmberBrush}" Margin="0,0,10,0" CornerRadius="1" />
                                <TextBlock Text="Список изменений сборки"
                                           FontFamily="{StaticResource HeadingFont}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}" />
                            </StackPanel>

                            <Button Command="{Binding CloseChangelogCommand}"
                                    Style="{StaticResource WinCloseBtn}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Scrollable list of new mods -->
                        <ScrollViewer Grid.Row="1" Style="{StaticResource AuraScrollViewer}" MaxHeight="390" Margin="0,0,0,14">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="В сборку Aura для Minecraft 1.20.1 (Fabric) добавлены новые моды и приключения:"
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="13"
                                           Foreground="{StaticResource DimInkBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12" />

                                <!-- Mod entries -->
                                <Border Background="#14212B" CornerRadius="3" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="⚔️ Приключения и контент" FontFamily="{StaticResource MainFont}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource EmberBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="• Frostiful (+ Thermoo) — суровое зимнее выживание: механики замерзания, тёплая меховая одежда, ледяной мороз и новые мобы." FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                        <TextBlock Text="• Snowy Spirit — зимняя атмосфера, сани для путешествий по снегу, подарки и праздничный уют." FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                        <TextBlock Text="• Alex's Mobs (+ CodxLib) — десятки детализированных живых существ с продуманным поведением и анимациями." FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                        <TextBlock Text="• Cultural Delights — кулинарные традиции и новые фермерские культуры в дополнение к Farmer's Delight." FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                        <TextBlock Text="• Spell Engine &amp; Spell Power (+ PlayerAnimator) — система магии, атрибутов заклинаний и плавных анимаций заклинателя." FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#14212B" CornerRadius="3" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="🏛️ Исследования и структуры (YUNG's Series)" FontFamily="{StaticResource MainFont}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource EmberBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="• YUNG's Better Desert Temples — масштабные обновлённые пустынные пирамиды с ловушками и головоломками." FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                        <TextBlock Text="• YUNG's Better Dungeons — переработанные катакомбы, сокровищницы и лабиринты под землёй." FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                        <TextBlock Text="• YUNG's Better Mineshafts — глубокие заброшенные шахты с висячими мостами и рудными жилами." FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#14212B" CornerRadius="3" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="🏡 Декор и строительство" FontFamily="{StaticResource MainFont}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource EmberBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="• Supplementaries — анимированные вывески, флюгеры, кувшины, бомбы и интерактивные блоки." FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                        <TextBlock Text="• Decorative Blocks — аутентичные балки, цепи, костры и сиденья." FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                        <TextBlock Text="• Macaw’s Collection (Fences, Roofs, Bridges, Doors) — черепичные крыши, подвесные мосты, резные заборы и массивные двери." FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#14212B" CornerRadius="3" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="✨ Атмосфера, физика и визуальные эффекты" FontFamily="{StaticResource MainFont}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource EmberBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="• AmbientSounds &amp; Presence Footsteps — реалистичный звуковой ландшафт окружения и кинематографичные шаги по разным поверхностям." FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                        <TextBlock Text="• 3D Skin Layers &amp; Wavey Capes — объёмный внешний слой скинов персонажей и физика развевающихся плащей." FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                        <TextBlock Text="• Subtle Effects &amp; Particle Rain &amp; Inventory Particles — капли дождя, мягкие частицы в интерфейсе и тонкие визуальные детали." FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                        <TextBlock Text="• Teleport Animation (Grand Teleport) — кинематографичный переход камеры при телепортации вместо резкого экрана." FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                        <TextBlock Text="• Inventory Profiles Next (+ libIPN) — умная сортировка и организация инвентаря в один клик." FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                        <TextBlock Text="• Player Locator Plus — удобный индикатор и поиск направления к друзьям в мире." FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                        <TextBlock Text="• Enhanced Doors — плавная кинематическая анимация открывания и закрывания дверей." FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                        <TextBlock Text="• Fresh Animations (+ EMF, ETF) — детальные и живые анимации мобов, взглядов и эмоций." FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                        <TextBlock Text="• Dungeons UI &amp; Ancient City Panorama — обновлённое панорамное главное меню и фэнтезийный интерфейс." FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer button -->
                        <Button Grid.Row="2"
                                Command="{Binding CloseChangelogCommand}"
                                Style="{StaticResource PrimaryNeonBtn}"
                                Content="Понятно"
                                HorizontalAlignment="Right"
                                Height="34" Padding="20,0" FontSize="13" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 3.6 SEND REPORT CONFIRMATION MODAL -->
            <Grid Panel.ZIndex="125"
                  Visibility="{Binding IsSendReportModalVisible, Converter={StaticResource BoolToVis}}"
                  Background="#99071017">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="500" Background="#0F1B22"
                        BorderBrush="{StaticResource LineInkBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Padding="24,20,24,20">
                    <StackPanel>
                        <!-- Title -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="3" Height="18" Background="{StaticResource EmberBrush}" Margin="0,0,10,0" CornerRadius="1" />
                            <TextBlock Text="Отправка отчёта"
                                       FontFamily="{StaticResource HeadingFont}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" />
                        </StackPanel>

                        <!-- Consent text -->
                        <TextBlock Text="Будут отправлены логи лаунчера и игры, версии и ваш ник. Пароли и токены не отправляются."
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="13"
                                   Foreground="{StaticResource InkBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />

                        <!-- User comment label -->
                        <TextBlock Text="Что произошло (необязательно):"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource MuteBrush}"
                                   Margin="0,0,0,6" />

                        <!-- User comment input (max 300) -->
                        <TextBox Text="{Binding ReportUserComment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="300"
                                 Height="70"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#14212B"
                                 Foreground="{StaticResource InkBrush}"
                                 BorderBrush="{StaticResource LineInkBrush}"
                                 BorderThickness="1"
                                 Padding="8"
                                 FontFamily="{StaticResource MainFont}"
                                 FontSize="13"
                                 Margin="0,0,0,16" />

                        <!-- Action buttons -->
                        <Grid>
                            <Button Command="{Binding CancelSendReportCommand}"
                                    Style="{StaticResource StandardBtn}"
                                    Content="Отмена"
                                    HorizontalAlignment="Left"
                                    Height="36" Padding="18,0" FontSize="13" />

                            <Button Command="{Binding SubmitReportCommand}"
                                    HorizontalAlignment="Right"
                                    Height="36" Padding="20,0" FontSize="13">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryNeonBtn}">
                                        <Setter Property="Content" Value="Отправить" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSubmittingReport}" Value="True">
                                                <Setter Property="Content" Value="Отправка…" />
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3.7 REPORT SUCCESS MODAL -->
            <Grid Panel.ZIndex="126"
                  Visibility="{Binding IsReportSuccessModalVisible, Converter={StaticResource BoolToVis}}"
                  Background="#99071017">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="460" Background="#0F1B22"
                        BorderBrush="{StaticResource LineInkBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Padding="24,20,24,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="3" Height="18" Background="{StaticResource OkBrush}" Margin="0,0,10,0" CornerRadius="1" />
                            <TextBlock Text="Отчёт отправлен"
                                       FontFamily="{StaticResource HeadingFont}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" />
                        </StackPanel>

                        <TextBlock Text="Отчёт успешно отправлен разработчикам."
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="13"
                                   Foreground="{StaticResource InkBrush}"
                                   Margin="0,0,0,10" />

                        <Border Background="#14212B" CornerRadius="3" Padding="12,10" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ID отчёта: "
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="14"
                                           Foreground="{StaticResource DimInkBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CreatedReportId}"
                                           FontFamily="{StaticResource HeadingFont}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource EmberBrush}"
                                           VerticalAlignment="Center"
                                           Margin="4,0,14,0" />
                                <Button Command="{Binding CopyReportIdCommand}"
                                        Style="{StaticResource StandardBtn}"
                                        Height="30" Padding="12,0" FontSize="12"
                                        Content="Копировать ID" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Назовите этот ID, если вас спросят о вашей проблеме."
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource MuteBrush}"
                                   Margin="0,0,0,16" />

                        <Button Command="{Binding CloseReportSuccessCommand}"
                                Style="{StaticResource PrimaryNeonBtn}"
                                Content="Закрыть"
                                HorizontalAlignment="Right"
                                Height="34" Padding="20,0" FontSize="13" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3.8 REPORT FAILED FALLBACK PROMPT -->
            <Grid Panel.ZIndex="127"
                  Visibility="{Binding IsReportFailedPromptVisible, Converter={StaticResource BoolToVis}}"
                  Background="#99071017">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="460" Background="#0F1B22"
                        BorderBrush="{StaticResource LineInkBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Padding="24,20,24,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="3" Height="18" Background="#FF6B6B" Margin="0,0,10,0" CornerRadius="1" />
                            <TextBlock Text="Не удалось отправить отчёт"
                                       FontFamily="{StaticResource HeadingFont}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" />
                        </StackPanel>

                        <TextBlock Text="Не удалось отправить отчёт на сервер. Сохранить отчёт на рабочий стол?"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="13"
                                   Foreground="{StaticResource InkBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16" />

                        <Grid>
                            <Button Command="{Binding DismissReportFailedPromptCommand}"
                                    Style="{StaticResource StandardBtn}"
                                    Content="Отмена"
                                    HorizontalAlignment="Left"
                                    Height="36" Padding="18,0" FontSize="13" />

                            <Button Command="{Binding SaveReportToDesktopCommand}"
                                    Style="{StaticResource PrimaryNeonBtn}"
                                    Content="Сохранить на рабочий стол"
                                    HorizontalAlignment="Right"
                                    Height="36" Padding="18,0" FontSize="13" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            
            <!-- 4. Version & update dot in bottom-right corner: правый край 20px, низ 14px, Onest 12px mute. Точка ember слева от неё -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,20,14" Panel.ZIndex="50" IsHitTestVisible="False">
                <!-- Точка ember об обновлении (если есть) держать слева от неё -->
                <Border Width="6" Height="6" CornerRadius="3"
                        Background="{StaticResource EmberBrush}"
                        Margin="0,0,6,0" VerticalAlignment="Center"
                        Visibility="{Binding HasUpdateDot, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding LauncherVersionText}"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="12"
                           FontWeight="Normal"
                           Foreground="{StaticResource MuteBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
