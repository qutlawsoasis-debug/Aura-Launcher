<Window x:Class="AuraLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AURA" Height="460" Width="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="18" CaptionHeight="50" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Outer Container with Glass Effect -->
    <Border Margin="12" CornerRadius="16" BorderThickness="1" BorderBrush="#2A3241">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#181C24" Offset="0.0" />
                <GradientStop Color="#0F1217" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.75" Color="#000000" />
        </Border.Effect>

        <Grid Margin="28,20,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <!-- 0: Header -->
                <RowDefinition Height="*" />
                <!-- 1: Body (Open layout, no box-in-box) -->
                <RowDefinition Height="Auto" />
                <!-- 2: Status & Launch Bar -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Title (Pure, confident, minimal) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="A  U  R  A" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Width="36" Height="36" Cursor="Hand" Margin="0,0,4,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Brd" Background="Transparent" CornerRadius="8">
                                    <TextBlock Text="—" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Brd" Property="Background" Value="#252D3D" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnClose" Click="BtnClose_Click" Width="36" Height="36" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Brd" Background="Transparent" CornerRadius="8">
                                    <TextBlock Text="✕" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Brd" Property="Background" Value="#E11D48" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Main Content (Clean Two-Column layout without nested cards) -->
            <Grid Grid.Row="1" Margin="0,18,0,16" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="40" />
                    <!-- Spacer -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Skin Avatar & Action -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Glowing Avatar Frame -->
                    <Border Width="92" Height="92" CornerRadius="14" BorderThickness="2" BorderBrush="#10B981" Background="#0A0D12" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#10B981" Opacity="0.35" />
                        </Border.Effect>
                        <Image x:Name="ImgSkinFace" Width="88" Height="88" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>

                    <Button x:Name="BtnChangeSkin" Click="BtnChangeSkin_Click" Width="140" Height="36" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Brd" Background="#1E2430" CornerRadius="8" BorderThickness="1" BorderBrush="#2D3748">
                                    <TextBlock Text="Выбрать скин" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Brd" Property="Background" Value="#283244" />
                                        <Setter TargetName="Brd" Property="BorderBrush" Value="#10B981" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Right Column: Settings & Configuration -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <!-- Nickname Field -->
                    <TextBlock Text="НИКНЕЙМ В ИГРЕ" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,8" />
                    <Border Background="#161B23" CornerRadius="10" BorderThickness="1" BorderBrush="#273142" Height="46" Margin="0,0,0,24">
                        <TextBox x:Name="TxtNickname" Text="Player" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                 FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Padding="14,0,14,0" 
                                 CaretBrush="#10B981" TextChanged="TxtNickname_TextChanged" />
                    </Border>

                    <!-- RAM Memory Allocation Selector -->
                    <TextBlock Text="ВЫДЕЛЕНИЕ ПАМЯТИ" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,10" />
                    <Border Background="#161B23" CornerRadius="10" BorderThickness="1" BorderBrush="#273142" Padding="4" Height="46">
                        <UniformGrid Columns="4">
                            <RadioButton x:Name="RbRam4" Content="4 GB" GroupName="RamGroup" Tag="4096" Style="{DynamicResource SegmentedRadioStyle}" Checked="RamRadio_Checked" />
                            <RadioButton x:Name="RbRam6" Content="6 GB" GroupName="RamGroup" Tag="6144" Style="{DynamicResource SegmentedRadioStyle}" IsChecked="True" Checked="RamRadio_Checked" />
                            <RadioButton x:Name="RbRam8" Content="8 GB" GroupName="RamGroup" Tag="8192" Style="{DynamicResource SegmentedRadioStyle}" Checked="RamRadio_Checked" />
                            <RadioButton x:Name="RbRam12" Content="12 GB" GroupName="RamGroup" Tag="12288" Style="{DynamicResource SegmentedRadioStyle}" Checked="RamRadio_Checked" />
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 3. Bottom Launch & Progress Bar -->
            <StackPanel Grid.Row="2">
                <!-- Status Row -->
                <Grid Margin="2,0,2,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Witty CS Quote -->
                    <TextBlock x:Name="TxtWittyQuote" Text="Готов к погружению в кубический мир" FontSize="13" FontWeight="SemiBold" 
                               Foreground="#34D399" VerticalAlignment="Center" />

                    <!-- Technical Substatus -->
                    <TextBlock x:Name="TxtTechnicalStatus" Grid.Column="1" Text="Сборка актуальна" FontSize="12" 
                               Foreground="#64748B" VerticalAlignment="Center" />
                </Grid>

                <!-- Thin Modern Glowing Progress Bar -->
                <Border x:Name="BrdProgress" Height="6" CornerRadius="3" Background="#161B23" Margin="0,0,0,12" Visibility="Collapsed">
                    <ProgressBar x:Name="ProgressBarDownload" Height="6" Minimum="0" Maximum="100" Value="0" 
                                 Background="Transparent" Foreground="#10B981" BorderThickness="0" />
                </Border>

                <!-- Big Radiant PLAY Button -->
                <Button x:Name="BtnPlay" Click="BtnPlay_Click" Height="52" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Brd" CornerRadius="10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#10B981" Offset="0.0" />
                                        <GradientStop Color="#059669" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Color="#10B981" Opacity="0.38" />
                                </Border.Effect>
                                <TextBlock x:Name="Txt" Text="ИГРАТЬ" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Brd" Property="Opacity" Value="0.9" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Brd" Property="Background" Value="#232B38" />
                                    <Setter TargetName="Brd" Property="Effect" Value="{x:Null}" />
                                    <Setter TargetName="Txt" Property="Foreground" Value="#64748B" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>

    <Window.Resources>
        <!-- Sleek Segmented RadioButton Style for RAM -->
        <Style x:Key="SegmentedRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="2,0,2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,6,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1E2633" />
                                <Setter Property="Foreground" Value="#34D399" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1A202C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
