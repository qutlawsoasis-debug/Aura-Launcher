<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- Color definitions -->
    <Color x:Key="ColorBgBase">#091015</Color>
    <Color x:Key="ColorPanel">#0C141A</Color>
    <Color x:Key="ColorPanelRaised">#141E26</Color>
    <Color x:Key="ColorPanelCard">#0F1B22</Color>
    <Color x:Key="ColorPanelInput">#14212B</Color>
    <Color x:Key="ColorNight">#071017</Color>
    <Color x:Key="ColorTextPrimary">#E8F0F8</Color>
    <Color x:Key="ColorTextSecondary">#9EEAF1EF</Color>
    <Color x:Key="ColorTextWhite">#FFFFFF</Color>
    <Color x:Key="ColorAccent">#F2A63C</Color>
    <Color x:Key="ColorAccentDim">#99F2A63C</Color>
    <Color x:Key="ColorAccentFaint">#80F2A63C</Color>
    <Color x:Key="ColorDanger">#FF8A7A</Color>
    <Color x:Key="ColorSuccess">#5FD39A</Color>
    <Color x:Key="ColorBorder">#12FFFFFF</Color>
    <Color x:Key="ColorBorderStrong">#2EFFFFFF</Color>
    <Color x:Key="ColorBorderSubtle">#1FFFFFFF</Color>
    <Color x:Key="ColorTrackSubtle">#26FFFFFF</Color>
    <Color x:Key="ColorBarSubtle">#24FFFFFF</Color>
    <Color x:Key="ColorShade">#000000</Color>
    <Color x:Key="ColorShade40">#40000000</Color>
    <Color x:Key="ColorShadeOverlay">#D6050C10</Color>
    <Color x:Key="ColorModalBackdrop">#99071017</Color>
    <Color x:Key="ColorDialogBackdrop">#B2071017</Color>
    <Color x:Key="ColorMediaPlaceholder">#060E12</Color>
    <Color x:Key="ColorBgBaseFadeStart">#E0071017</Color>
    <Color x:Key="ColorBgBaseFadeEnd">#8C071017</Color>
    <Color x:Key="ColorScreensOverlay">#A8060E12</Color>
    <Color x:Key="ColorSelectedItemBackground">#0FFFFFFF</Color>

    <Color x:Key="ColorStoriesShadeBottom">#CC091015</Color>
    <Color x:Key="ColorStoriesShadeTransparent">#00091015</Color>
    <Color x:Key="ColorStoriesHeaderShade">#99091015</Color>
    <Color x:Key="ColorStoriesDim55">#8C091015</Color>
    <Color x:Key="ColorStoriesTrack">#47FFFFFF</Color>
    <Color x:Key="ColorStoriesTextSecondary">#80E8F0F8</Color>
    <Color x:Key="ColorPanelGlass">#1AFFFFFF</Color>
    <Color x:Key="ColorPrimaryActionText">#1C1106</Color>

    <!-- Changelog Modal Colors -->
    <Color x:Key="ColorChangelogModalBg">#E6091015</Color>

    <Color x:Key="ColorBadgeNewBg">#2EF2A63C</Color>
    <Color x:Key="ColorBadgeNewBorder">#59F2A63C</Color>
    <Color x:Key="ColorBadgeNewText">#F2A63C</Color>

    <Color x:Key="ColorBadgeImprovedBg">#14FFFFFF</Color>
    <Color x:Key="ColorBadgeImprovedBorder">#26FFFFFF</Color>
    <Color x:Key="ColorBadgeImprovedText">#CCE8F0F8</Color>

    <Color x:Key="ColorBadgeFixedBg">#295FD39A</Color>
    <Color x:Key="ColorBadgeFixedBorder">#595FD39A</Color>
    <Color x:Key="ColorBadgeFixedText">#5FD39A</Color>

    <Color x:Key="ColorText85">#D9E8F0F8</Color>
    <Color x:Key="ColorText70">#B3E8F0F8</Color>
    <Color x:Key="ColorText55">#8CE8F0F8</Color>
    <Color x:Key="ColorText90">#E6E8F0F8</Color>
    <Color x:Key="ColorAchievementGoldStart">#F2A63C</Color>
    <Color x:Key="ColorAchievementGoldEnd">#E08E1E</Color>

    <!-- Game Input Box & Form Button Colors -->
    <Color x:Key="ColorGameInputBg">#1A1F26</Color>
    <Color x:Key="ColorGameInputBorder">#2E3742</Color>
    <Color x:Key="ColorGameInputBorderFocus">#D9943B</Color>
    <Color x:Key="ColorGameInputTextMuted">#7E8B9B</Color>
    <Color x:Key="ColorCancelBtnBg">#2C323B</Color>

    <!-- Named SolidColorBrush resources for UI controls (Frozen for GPU performance) -->
    <SolidColorBrush x:Key="GameInputBgBrush" Color="{StaticResource ColorGameInputBg}" po:Freeze="True" />
    <SolidColorBrush x:Key="GameInputBorderBrush" Color="{StaticResource ColorGameInputBorder}" po:Freeze="True" />
    <SolidColorBrush x:Key="GameInputBorderFocusBrush" Color="{StaticResource ColorGameInputBorderFocus}" po:Freeze="True" />
    <SolidColorBrush x:Key="GameInputTextMutedBrush" Color="{StaticResource ColorGameInputTextMuted}" po:Freeze="True" />
    <SolidColorBrush x:Key="CancelBtnBgBrush" Color="{StaticResource ColorCancelBtnBg}" po:Freeze="True" />

    <SolidColorBrush x:Key="BgBase" Color="{StaticResource ColorBgBase}" po:Freeze="True" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource ColorPanel}" po:Freeze="True" />
    <SolidColorBrush x:Key="PanelRaised" Color="{StaticResource ColorPanelRaised}" po:Freeze="True" />
    <SolidColorBrush x:Key="PanelCard" Color="{StaticResource ColorPanelCard}" po:Freeze="True" />
    <SolidColorBrush x:Key="PanelInput" Color="{StaticResource ColorPanelInput}" po:Freeze="True" />
    <SolidColorBrush x:Key="PanelGlass" Color="{StaticResource ColorPanelGlass}" po:Freeze="True" />
    <SolidColorBrush x:Key="PanelGlassBrush" Color="{StaticResource ColorPanelGlass}" po:Freeze="True" />
    <SolidColorBrush x:Key="PrimaryActionText" Color="{StaticResource ColorPrimaryActionText}" po:Freeze="True" />
    <SolidColorBrush x:Key="Night" Color="{StaticResource ColorNight}" po:Freeze="True" />
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource ColorTextPrimary}" po:Freeze="True" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource ColorTextSecondary}" po:Freeze="True" />
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource ColorTextSecondary}" po:Freeze="True" />
    <SolidColorBrush x:Key="TextWhite" Color="{StaticResource ColorTextWhite}" po:Freeze="True" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource ColorAccent}" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentDim" Color="{StaticResource ColorAccentDim}" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentFaint" Color="{StaticResource ColorAccentFaint}" po:Freeze="True" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource ColorDanger}" po:Freeze="True" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource ColorSuccess}" po:Freeze="True" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource ColorBorder}" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource ColorBorderStrong}" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource ColorBorderSubtle}" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#28FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="TrackSubtle" Color="{StaticResource ColorTrackSubtle}" po:Freeze="True" />
    <SolidColorBrush x:Key="BarSubtle" Color="{StaticResource ColorBarSubtle}" po:Freeze="True" />
    <SolidColorBrush x:Key="Shade" Color="{StaticResource ColorShade}" po:Freeze="True" />
    <SolidColorBrush x:Key="Shade40" Color="{StaticResource ColorShade40}" po:Freeze="True" />
    <SolidColorBrush x:Key="ShadeOverlay" Color="{StaticResource ColorShadeOverlay}" po:Freeze="True" />
    <SolidColorBrush x:Key="ModalBackdrop" Color="{StaticResource ColorModalBackdrop}" po:Freeze="True" />
    <SolidColorBrush x:Key="DialogBackdrop" Color="{StaticResource ColorDialogBackdrop}" po:Freeze="True" />
    <SolidColorBrush x:Key="ScreensOverlay" Color="{StaticResource ColorScreensOverlay}" po:Freeze="True" />
    <SolidColorBrush x:Key="OtherScreensOverlay" Color="{StaticResource ColorScreensOverlay}" po:Freeze="True" />
    <SolidColorBrush x:Key="SelectedItemBackground" Color="{StaticResource ColorSelectedItemBackground}" po:Freeze="True" />
    <SolidColorBrush x:Key="MediaPlaceholder" Color="{StaticResource ColorMediaPlaceholder}" po:Freeze="True" />
    <SolidColorBrush x:Key="StoriesDim55" Color="{StaticResource ColorStoriesDim55}" po:Freeze="True" />
    <SolidColorBrush x:Key="StoriesTrack" Color="{StaticResource ColorStoriesTrack}" po:Freeze="True" />
    <SolidColorBrush x:Key="StoriesFill" Color="{StaticResource ColorTextPrimary}" po:Freeze="True" />
    <SolidColorBrush x:Key="StoriesTextSecondary" Color="{StaticResource ColorStoriesTextSecondary}" po:Freeze="True" />
    <SolidColorBrush x:Key="Text90" Color="{StaticResource ColorText90}" po:Freeze="True" />
    <SolidColorBrush x:Key="StoriesCardGlass" Color="#14FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="StoriesCardBorder" Color="#26FFFFFF" po:Freeze="True" />

    <LinearGradientBrush x:Key="StoriesPanelBg" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="{StaticResource ColorStoriesHeaderShade}" Offset="0.0" />
        <GradientStop Color="{StaticResource ColorStoriesShadeBottom}" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ChangelogModalBg" Color="{StaticResource ColorChangelogModalBg}" po:Freeze="True" />

    <SolidColorBrush x:Key="BadgeNewBg" Color="{StaticResource ColorBadgeNewBg}" po:Freeze="True" />
    <SolidColorBrush x:Key="BadgeNewBorder" Color="{StaticResource ColorBadgeNewBorder}" po:Freeze="True" />
    <SolidColorBrush x:Key="BadgeNewText" Color="{StaticResource ColorBadgeNewText}" po:Freeze="True" />

    <SolidColorBrush x:Key="BadgeImprovedBg" Color="{StaticResource ColorBadgeImprovedBg}" po:Freeze="True" />
    <SolidColorBrush x:Key="BadgeImprovedBorder" Color="{StaticResource ColorBadgeImprovedBorder}" po:Freeze="True" />
    <SolidColorBrush x:Key="BadgeImprovedText" Color="{StaticResource ColorBadgeImprovedText}" po:Freeze="True" />

    <SolidColorBrush x:Key="BadgeFixedBg" Color="{StaticResource ColorBadgeFixedBg}" po:Freeze="True" />
    <SolidColorBrush x:Key="BadgeFixedBorder" Color="{StaticResource ColorBadgeFixedBorder}" po:Freeze="True" />
    <SolidColorBrush x:Key="BadgeFixedText" Color="{StaticResource ColorBadgeFixedText}" po:Freeze="True" />

    <SolidColorBrush x:Key="Text85" Color="{StaticResource ColorText85}" po:Freeze="True" />
    <SolidColorBrush x:Key="Text70" Color="{StaticResource ColorText70}" po:Freeze="True" />
    <SolidColorBrush x:Key="Text55" Color="{StaticResource ColorText55}" po:Freeze="True" />

    <LinearGradientBrush x:Key="AchievementGoldBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="{StaticResource ColorAchievementGoldStart}" Offset="0.0" />
        <GradientStop Color="{StaticResource ColorAchievementGoldEnd}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Overview Screen Gradient Overlays (Frozen for GPU performance) -->
    <LinearGradientBrush x:Key="OverviewHeaderGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#8C050C10" Offset="0.0" />
        <GradientStop Color="#00050C10" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OverviewLeftGradient" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#EB050C10" Offset="0.0" />
        <GradientStop Color="#B8050C10" Offset="0.30" />
        <GradientStop Color="#1F050C10" Offset="0.62" />
        <GradientStop Color="#00050C10" Offset="0.80" />
        <GradientStop Color="#00050C10" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OverviewBottomGradient" StartPoint="0,1" EndPoint="0,0" po:Freeze="True">
        <GradientStop Color="#CC050C10" Offset="0.0" />
        <GradientStop Color="#66050C10" Offset="0.25" />
        <GradientStop Color="#00050C10" Offset="0.55" />
        <GradientStop Color="#00050C10" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Glass Music Widget Tokens (rgba(16,14,24,0.62), top gradient 8%->0%, border 20%->5%, 4% hover) -->
    <Color x:Key="ColorGlassDarkBase">#9E100E18</Color>
    <Color x:Key="ColorProgressTrack">#1FFFFFFF</Color>
    <Color x:Key="ColorVinylGroove">#0DFFFFFF</Color>
    <Color x:Key="ColorWhite60">#99FFFFFF</Color>
    <Color x:Key="ColorGlassHover">#0AFFFFFF</Color>
    <Color x:Key="ColorVinylBody">#0D0F12</Color>
    <Color x:Key="ColorTonearmBase">#2A2A32</Color>
    <Color x:Key="ColorTonearmMetal">#D0D0D8</Color>

    <SolidColorBrush x:Key="GlassDarkBaseBrush" Color="{StaticResource ColorGlassDarkBase}" po:Freeze="True" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="{StaticResource ColorProgressTrack}" po:Freeze="True" />
    <SolidColorBrush x:Key="VinylGrooveBrush" Color="{StaticResource ColorVinylGroove}" po:Freeze="True" />
    <SolidColorBrush x:Key="White60Brush" Color="{StaticResource ColorWhite60}" po:Freeze="True" />
    <SolidColorBrush x:Key="GlassHoverBrush" Color="{StaticResource ColorGlassHover}" po:Freeze="True" />
    <SolidColorBrush x:Key="VinylBodyBrush" Color="{StaticResource ColorVinylBody}" po:Freeze="True" />
    <SolidColorBrush x:Key="TonearmBaseBrush" Color="{StaticResource ColorTonearmBase}" po:Freeze="True" />
    <SolidColorBrush x:Key="TonearmMetalBrush" Color="{StaticResource ColorTonearmMetal}" po:Freeze="True" />

    <LinearGradientBrush x:Key="GlassTopGradientBrush" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#14FFFFFF" Offset="0.0" />
        <GradientStop Color="#00FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#33FFFFFF" Offset="0.0" />
        <GradientStop Color="#0DFFFFFF" Offset="1.0" />
    </LinearGradientBrush>
</ResourceDictionary>

