<UserControl x:Class="AuraLauncher.Views.WorkshopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:behaviors="clr-namespace:AuraLauncher.Behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="512" d:DesignWidth="680"
             Focusable="False" FocusVisualStyle="{x:Null}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <!-- MAIN CONTENT AREA -->
        <Grid Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. TOP HEADER & SUB-TABS -->
            <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="{StaticResource LineInkBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Мастерская"
                                       FontFamily="{StaticResource HeadingFont}"
                                       FontSize="28" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" />
                            <Border Background="#1C2833" CornerRadius="4" Padding="8,2" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Контент и данные"
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="12" Foreground="{StaticResource EmberBrush}" />
                            </Border>
                        </StackPanel>

                        <!-- SUB-NAVIGATION PILLS -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <!-- 1. Worlds Tab -->
                            <RadioButton Content="🗺️  Миры и бэкапы"
                                         IsChecked="{Binding IsWorldsTabActive, Mode=TwoWay}"
                                         Command="{Binding SwitchSubTabCommand}" CommandParameter="Worlds"
                                         Style="{StaticResource SubNavPillRadio}" Margin="0,0,8,0" />

                            <!-- 2. Mods Tab -->
                            <RadioButton Content="🧩  Моды и шейдеры"
                                         IsChecked="{Binding IsModsTabActive, Mode=TwoWay}"
                                         Command="{Binding SwitchSubTabCommand}" CommandParameter="Mods"
                                         Style="{StaticResource SubNavPillRadio}" Margin="0,0,8,0" />

                            <!-- 3. Screenshots Tab -->
                            <RadioButton Content="📸  Скриншоты"
                                         IsChecked="{Binding IsScreenshotsTabActive, Mode=TwoWay}"
                                         Command="{Binding SwitchSubTabCommand}" CommandParameter="Screenshots"
                                         Style="{StaticResource SubNavPillRadio}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- REFRESH BUTTON -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal">
                        <Button Command="{Binding RefreshAllCommand}"
                                Style="{StaticResource GhostBtn}"
                                ToolTip="Обновить все списки"
                                Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄 Обновить" FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource DimInkBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. SUB-PAGES HOST -->
            <Grid Grid.Row="1">

                <!-- ============================================== -->
                <!-- SUB-PAGE 1: WORLDS & BACKUPS                   -->
                <!-- ============================================== -->
                <Grid Visibility="{Binding IsWorldsTabActive, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,12" Background="#0C141A" CornerRadius="6" Padding="14,10" BorderBrush="{StaticResource LineInkBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Резервные копии создаются в формате .zip в 1 клик перед установкой новых модов"
                                       FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource MuteBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" />
                            <Button Grid.Column="1" Command="{Binding OpenBackupsFolderCommand}"
                                    Style="{StaticResource SecondaryBtn}"
                                    Content="📁 Папка бэкапов"
                                    Padding="12,5" FontSize="11" />
                        </Grid>
                    </Border>

                    <!-- WORLDS LIST -->
                    <ScrollViewer Grid.Row="1" behaviors:SmoothScroll.IsEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Empty message -->
                            <Border Background="#0B1318" CornerRadius="8" Padding="24" Margin="0,20,0,0" BorderBrush="{StaticResource LineInkBrush}" BorderThickness="1"
                                    Visibility="{Binding WorldSaves.Count, Converter={StaticResource InverseIntToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Сохранённых миров пока нет"
                                               FontFamily="{StaticResource MainFont}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource DimInkBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Запустите игру и создайте мир, после чего он сразу появится здесь для резервного копирования."
                                               FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource MuteBrush}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Worlds Items -->
                            <ItemsControl ItemsSource="{Binding WorldSaves}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0C141A" BorderBrush="{StaticResource LineInkBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- World Icon / Default thumbnail -->
                                                <Border Grid.Column="0" Width="54" Height="54" CornerRadius="4" ClipToBounds="True" Background="#141E26" Margin="0,0,14,0">
                                                    <Image Source="{Binding IconSource}" Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                </Border>

                                                <!-- Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontFamily="{StaticResource MainFont}" FontSize="16" FontWeight="SemiBold"
                                                               Foreground="{StaticResource InkBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding GameMode}"
                                                                   FontFamily="{StaticResource MainFont}" FontSize="12"
                                                                   Foreground="{StaticResource EmberBrush}" Margin="0,0,10,0" />
                                                        <TextBlock Text="{Binding SizeFormatted}"
                                                                   FontFamily="{StaticResource MainFont}" FontSize="12"
                                                                   Foreground="{StaticResource MuteBrush}" Margin="0,0,10,0" />
                                                        <TextBlock Text="{Binding LastPlayed, StringFormat='{}Изменен: {0:dd.MM.yyyy HH:mm}'}"
                                                                   FontFamily="{StaticResource MainFont}" FontSize="12"
                                                                   Foreground="{StaticResource MuteBrush}" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding BackupStatusText}"
                                                               FontFamily="{StaticResource MainFont}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{StaticResource EmberBrush}" Margin="0,4,0,0"
                                                               Visibility="{Binding BackupStatusText.Length, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>

                                                <!-- Actions -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Command="{Binding DataContext.CreateBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource PrimaryActionBtn}"
                                                            Content="💾 Создать бэкап"
                                                            Padding="12,7" FontSize="12" Margin="0,0,8,0" />

                                                    <Button Command="{Binding DataContext.OpenWorldFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryBtn}"
                                                            Content="📂 Папка"
                                                            Padding="10,7" FontSize="12" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ============================================== -->
                <!-- SUB-PAGE 2: MODS & SHADERS                     -->
                <!-- ============================================== -->
                <Grid Visibility="{Binding IsModsTabActive, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- TOP SHADER PACK SELECTOR -->
                    <Border Grid.Row="0" Margin="0,0,0,14" Background="#0C141A" CornerRadius="6" Padding="14,12" BorderBrush="{StaticResource LineInkBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Шейдерпаки (Iris Shaders)"
                                               FontFamily="{StaticResource MainFont}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text=" — выберите активный шейдер в 1 клик"
                                               FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource MuteBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding OpenShadersFolderCommand}"
                                        Style="{StaticResource SecondaryBtn}" Content="📂 Папка шейдеров" Padding="10,4" FontSize="11" />
                            </Grid>

                            <!-- Shader pills -->
                            <ItemsControl ItemsSource="{Binding ShaderPacks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectShaderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GhostBtn}"
                                                Margin="0,0,8,6" Padding="0">
                                            <Border CornerRadius="4" Padding="12,6"
                                                    BorderThickness="1"
                                                    Background="{Binding IsActive, Converter={StaticResource BoolToEmberOrDarkBgConverter}}"
                                                    BorderBrush="{Binding IsActive, Converter={StaticResource BoolToEmberOrLineBorderConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontFamily="{StaticResource MainFont}" FontSize="12" FontWeight="Medium"
                                                               Foreground="{Binding IsActive, Converter={StaticResource BoolToInkOrDimBrushConverter}}" />
                                                    <TextBlock Text="  ✓" FontFamily="{StaticResource MainFont}" FontSize="11"
                                                               Foreground="{StaticResource EmberBrush}"
                                                               Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- MODS SECTION -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Search and Controls -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Search Box with watermark and orange caret -->
                            <TextBox Grid.Column="0" Text="{Binding SearchModText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource AuraTextBox}"
                                     Tag="🔍 Поиск мода по названию..."
                                     Padding="12,8" Margin="0,0,10,0"
                                     ToolTip="Поиск мода по названию..." />

                            <!-- Open folder button -->
                            <Button Grid.Column="1" Command="{Binding OpenModsFolderCommand}"
                                    Style="{StaticResource SecondaryBtn}"
                                    Content="📂 Папка mods"
                                    Padding="12,6" FontSize="12" />
                        </Grid>

                        <!-- Mods Virtualized List -->
                        <ScrollViewer Grid.Row="1" behaviors:SmoothScroll.IsEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- Empty state when no mods match search -->
                                <Border Background="#0B1318" CornerRadius="8" Padding="24" Margin="0,16,0,0" BorderBrush="{StaticResource LineInkBrush}" BorderThickness="1"
                                        Visibility="{Binding FilteredMods.Count, Converter={StaticResource InverseIntToVis}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Моды не найдены"
                                                   FontFamily="{StaticResource MainFont}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource DimInkBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="В папке mods нет установленных модов или ничего не найдено по текущему запросу."
                                                   FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource MuteBrush}"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding FilteredMods}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0A1217" BorderBrush="{StaticResource LineInkBrush}" BorderThickness="0,0,0,1" Padding="8,8" Margin="0,0,0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Mod Name -->
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontFamily="{StaticResource MainFont}" FontSize="13" FontWeight="Medium"
                                                                   Foreground="{Binding IsEnabled, Converter={StaticResource BoolToInkOrDimBrushConverter}}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding FileName}"
                                                                   FontFamily="{StaticResource MainFont}" FontSize="11"
                                                                   Foreground="{StaticResource MuteBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <!-- Size -->
                                                    <TextBlock Grid.Column="1" Text="{Binding SizeFormatted}"
                                                               FontFamily="{StaticResource MainFont}" FontSize="12"
                                                               Foreground="{StaticResource MuteBrush}"
                                                               VerticalAlignment="Center" Margin="14,0" />

                                                    <!-- Toggle Switch Button -->
                                                    <Button Grid.Column="2" Command="{Binding DataContext.ToggleModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GhostBtn}"
                                                            VerticalAlignment="Center" Padding="0">
                                                        <Border Width="64" Height="26" CornerRadius="13"
                                                                Background="{Binding IsEnabled, Converter={StaticResource BoolToEmberOrDarkBgConverter}}"
                                                                BorderBrush="{Binding IsEnabled, Converter={StaticResource BoolToEmberOrLineBorderConverter}}"
                                                                BorderThickness="1">
                                                            <TextBlock Text="{Binding IsEnabled, Converter={StaticResource BoolToEnabledTextConverter}}"
                                                                       FontFamily="{StaticResource MainFont}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{Binding IsEnabled, Converter={StaticResource BoolToInkOrMuteBrushConverter}}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ============================================== -->
                <!-- SUB-PAGE 3: SCREENSHOTS                        -->
                <!-- ============================================== -->
                <Grid Visibility="{Binding IsScreenshotsTabActive, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,12" Background="#0C141A" CornerRadius="6" Padding="14,10" BorderBrush="{StaticResource LineInkBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="Делайте скриншоты в игре на F2 — они появятся здесь для быстрого копирования и просмотра"
                                           FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource MuteBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding StatusMessage}"
                                           FontFamily="{StaticResource MainFont}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource EmberBrush}" Margin="12,0,0,0"
                                           Visibility="{Binding StatusMessage.Length, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding OpenScreenshotsFolderCommand}"
                                    Style="{StaticResource SecondaryBtn}"
                                    Content="📂 Папка скриншотов"
                                    Padding="12,5" FontSize="11" />
                        </Grid>
                    </Border>

                    <!-- Screenshots Grid -->
                    <ScrollViewer Grid.Row="1" behaviors:SmoothScroll.IsEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Empty message -->
                            <Border Background="#0B1318" CornerRadius="8" Padding="24" Margin="0,20,0,0" BorderBrush="{StaticResource LineInkBrush}" BorderThickness="1"
                                    Visibility="{Binding Screenshots.Count, Converter={StaticResource InverseIntToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Скриншотов пока нет"
                                               FontFamily="{StaticResource MainFont}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource DimInkBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Делайте скриншоты в игре на клавишу F2, и они моментально появятся в этой галерее."
                                               FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource MuteBrush}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Screenshots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="196" Margin="0,0,12,14" Background="#0C141A" BorderBrush="{StaticResource LineInkBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                            <StackPanel>
                                                <!-- Image Preview Button -->
                                                <Button Command="{Binding DataContext.PreviewScreenshotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GhostBtn}"
                                                        Padding="0">
                                                    <Grid Width="196" Height="110" Background="#060E12">
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                        <Border Background="#40000000" Opacity="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Opacity" Value="1" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="🔍 Просмотр" FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </Grid>
                                                </Button>

                                                <!-- Footer info & buttons -->
                                                <Border Padding="8,6" Background="#091015">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CreatedDate, StringFormat='{}{0:dd.MM.yy HH:mm}'}"
                                                                       FontFamily="{StaticResource MainFont}" FontSize="11" Foreground="{StaticResource DimInkBrush}" />
                                                            <TextBlock Text="{Binding SizeFormatted}"
                                                                       FontFamily="{StaticResource MainFont}" FontSize="10" Foreground="{StaticResource MuteBrush}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <!-- Copy to Clipboard -->
                                                            <Button Command="{Binding DataContext.CopyScreenshotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource GhostBtn}"
                                                                    ToolTip="Скопировать в буфер обмена (для вставки в Discord/Telegram)"
                                                                    Padding="4,2">
                                                                <TextBlock Text="📋" FontSize="13" />
                                                            </Button>
                                                            <!-- Delete -->
                                                            <Button Command="{Binding DataContext.DeleteScreenshotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource GhostBtn}"
                                                                    ToolTip="Удалить скриншот"
                                                                    Padding="4,2" Margin="4,0,0,0">
                                                                <TextBlock Text="🗑️" FontSize="12" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- FULLSCREEN SCREENSHOT PREVIEW MODAL LIGHTBOX -->
        <Border Background="#D6050C10" Panel.ZIndex="100"
                Visibility="{Binding IsScreenshotPreviewOpen, Converter={StaticResource BoolToVis}}"
                ClipToBounds="True">
            <Grid Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top bar -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedScreenshot.FileName}"
                                   FontFamily="{StaticResource MainFont}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="{Binding SelectedScreenshot.CreatedDate, StringFormat='{} • {0:dd.MM.yyyy HH:mm}'}"
                                   FontFamily="{StaticResource MainFont}" FontSize="13"
                                   Foreground="{StaticResource MuteBrush}" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Command="{Binding CloseScreenshotPreviewCommand}"
                            Style="{StaticResource GhostBtn}" Content="✕ Закрыть" FontSize="14" Foreground="{StaticResource DimInkBrush}" />
                </Grid>

                <!-- Image -->
                <Border Grid.Row="1" Background="#000000" CornerRadius="4" ClipToBounds="True">
                    <Image Source="{Binding FullPreviewImage}" Stretch="Uniform" />
                </Border>

                <!-- Bottom Actions -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Button Command="{Binding CopyScreenshotCommand}" CommandParameter="{Binding SelectedScreenshot}"
                            Style="{StaticResource PrimaryActionBtn}" Content="📋 Скопировать в буфер обмена" Padding="16,8" FontSize="13" Margin="0,0,12,0" />
                    <Button Command="{Binding OpenScreenshotFileCommand}" CommandParameter="{Binding SelectedScreenshot}"
                            Style="{StaticResource SecondaryBtn}" Content="🖼️ Открыть файл" Padding="14,8" FontSize="13" Margin="0,0,12,0" />
                    <Button Command="{Binding DeleteScreenshotCommand}" CommandParameter="{Binding SelectedScreenshot}"
                            Style="{StaticResource SecondaryBtn}" Content="🗑️ Удалить" Padding="14,8" FontSize="13" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
