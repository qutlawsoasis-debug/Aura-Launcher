<UserControl x:Class="AuraLauncher.Views.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="478" d:DesignWidth="980"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="480" Margin="0,20">

                <!-- Заголовок ЛОББИ -->
                <TextBlock Text="ЛОББИ" FontFamily="{StaticResource PixelFont}" FontSize="20" FontWeight="Bold" Foreground="#E8EAED"
                           HorizontalAlignment="Center" Margin="0,0,0,8" />

                <!-- Статус одной строкой с цветной точкой -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#556277" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusOpen}" Value="True">
                                        <Setter Property="Fill" Value="#19D3A7" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsStatusWaiting}" Value="True">
                                        <Setter Property="Fill" Value="#9AA3B2" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="PulseStoryboard">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.25" To="1.0" Duration="0:0:0.7" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="PulseStoryboard" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding CombinedStatusText}" FontSize="13" FontWeight="SemiBold" Foreground="#E8EAED" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Основная карточка-форма -->
                <Border Style="{StaticResource CardPanel}" Padding="24">
                    <Grid>
                        <!-- ============================================== -->
                        <!-- 1. НЕ В ЛОББИ: СОЗДАТЬ ИЛИ ВОЙТИ ПО КОДУ      -->
                        <!-- ============================================== -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInLobby}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Блок хоста -->
                            <TextBlock Text="Создать лобби" FontSize="13" FontWeight="SemiBold" Foreground="#E8EAED" Margin="0,0,0,8" />
                            <Button Command="{Binding CreateLobbyCommand}"
                                    Style="{StaticResource PrimaryNeonBtn}"
                                    Height="40" Content="СОЗДАТЬ ЛОББИ" />

                            <!-- Ошибка создания с кнопкой копирования лога -->
                            <Border Background="#241416" BorderBrush="#EF444433" BorderThickness="1" CornerRadius="6"
                                    Padding="12,10" Margin="0,12,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowTunnelFailedLogButton}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding TunnelFailureReason}"
                                               FontSize="11" Foreground="#EF4444" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <Button Command="{Binding CopyTunnelLogCommand}"
                                            Height="32" FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource StandardBtn}">
                                                <Setter Property="Content" Value="Копировать лог" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TunnelLogCopied}" Value="True">
                                                        <Setter Property="Content" Value="Лог скопирован" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Разделитель -->
                            <Border Height="1" Background="#1B3B2B" Margin="0,20" />

                            <!-- Блок гостя: ввод кода и вход -->
                            <TextBlock Text="Войти по коду" FontSize="13" FontWeight="SemiBold" Foreground="#E8EAED" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="{Binding GuestCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="16" FontWeight="Bold" FontFamily="{StaticResource PixelFont}"
                                         MaxLength="6" Height="40"
                                         TextAlignment="Center"
                                         CharacterCasing="Upper" />
                                <Button Grid.Column="1"
                                         Command="{Binding JoinLobbyCommand}"
                                         Style="{StaticResource StandardBtn}"
                                         Content="ВОЙТИ" Height="40" Width="90" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- 2. В ЛОББИ КАК ХОСТ                            -->
                        <!-- ============================================== -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsInLobby}" Value="True" />
                                                <Condition Binding="{Binding IsHost}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Крупный код лобби пиксельным шрифтом с кнопкой копирования -->
                            <Border Background="#10141A" BorderBrush="#1B3B2B" BorderThickness="1" CornerRadius="6"
                                    Padding="16,12" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding LobbyCode, StringFormat='КОД: {0}'}"
                                               FontSize="22" FontWeight="Bold" FontFamily="{StaticResource PixelFont}"
                                               Foreground="#19D3A7" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Command="{Binding CopyCodeCommand}"
                                            Height="34" Padding="14,0" FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource StandardBtn}">
                                                <Setter Property="Content" Value="Копировать" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CodeCopied}" Value="True">
                                                        <Setter Property="Content" Value="Скопировано" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Список игроков с аватарками голов -->
                            <TextBlock Text="ИГРОКИ В ЛОББИ" FontFamily="{StaticResource PixelFont}" FontSize="12" Foreground="#9AA3B2" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding LobbyPlayers}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#10141A" BorderBrush="#1B3B2B" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Аватарка 32x32 -->
                                                <Border Grid.Column="0" Width="32" Height="32" Background="#171A21" CornerRadius="4" ClipToBounds="True" Margin="0,0,10,0">
                                                    <Image Source="{Binding Avatar}" Width="32" Height="32" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="UniformToFill" />
                                                </Border>
                                                <!-- Никнейм -->
                                                <TextBlock Grid.Column="1" Text="{Binding Nickname}" Foreground="#E8EAED" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <!-- Бейдж ХОСТ -->
                                                <Border Grid.Column="2" Background="#1B3B2B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                        Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="ХОСТ" FontFamily="{StaticResource PixelFont}" FontSize="10" Foreground="#19D3A7" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Отправьте код другу, затем откройте мир для сети в игре."
                                       FontSize="11" Foreground="#9AA3B2" TextWrapping="Wrap" Margin="0,0,0,14" />

                            <!-- Кнопка «Открыть мир» -->
                            <Button Command="{Binding OpenWorldCommand}"
                                    Height="40">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryNeonBtn}">
                                        <Setter Property="Content" Value="ОТКРЫТЬ МИР" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWorldOpen}" Value="True">
                                                <Setter Property="Content" Value="МИР ОТКРЫТ" />
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Ошибка туннеля с кнопкой копирования лога -->
                            <Border Background="#241416" BorderBrush="#EF444433" BorderThickness="1" CornerRadius="6"
                                    Padding="12,10" Margin="0,12,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowTunnelFailedLogButton}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding TunnelFailureReason}"
                                               FontSize="11" Foreground="#EF4444" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <Button Command="{Binding CopyTunnelLogCommand}"
                                            Height="32" FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource StandardBtn}">
                                                <Setter Property="Content" Value="Копировать лог" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TunnelLogCopied}" Value="True">
                                                        <Setter Property="Content" Value="Лог скопирован" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Button Command="{Binding LeaveLobbyCommand}"
                                    Style="{StaticResource GhostBtn}"
                                    Content="Выйти из лобби" Height="34" FontSize="12"
                                    Foreground="#EF4444" Margin="0,10,0,0" />
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- 3. В ЛОББИ КАК ГОСТЬ                           -->
                        <!-- ============================================== -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsGuestJoined}" Value="True" />
                                                <Condition Binding="{Binding IsHost}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Крупный код лобби -->
                            <Border Background="#10141A" BorderBrush="#1B3B2B" BorderThickness="1" CornerRadius="6"
                                    Padding="16,12" Margin="0,0,0,16">
                                <TextBlock Text="{Binding LobbyCode, StringFormat='ЛОББИ: {0}'}"
                                           FontSize="22" FontWeight="Bold" FontFamily="{StaticResource PixelFont}"
                                           Foreground="#E8EAED" HorizontalAlignment="Center" />
                            </Border>

                            <!-- Список игроков с аватарками голов -->
                            <TextBlock Text="ИГРОКИ В ЛОББИ" FontFamily="{StaticResource PixelFont}" FontSize="12" Foreground="#9AA3B2" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding LobbyPlayers}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#10141A" BorderBrush="#1B3B2B" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Аватарка 32x32 -->
                                                <Border Grid.Column="0" Width="32" Height="32" Background="#171A21" CornerRadius="4" ClipToBounds="True" Margin="0,0,10,0">
                                                    <Image Source="{Binding Avatar}" Width="32" Height="32" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="UniformToFill" />
                                                </Border>
                                                <!-- Никнейм -->
                                                <TextBlock Grid.Column="1" Text="{Binding Nickname}" Foreground="#E8EAED" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <!-- Бейдж ХОСТ -->
                                                <Border Grid.Column="2" Background="#1B3B2B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                        Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="ХОСТ" FontFamily="{StaticResource PixelFont}" FontSize="10" Foreground="#19D3A7" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Кнопка «Подключиться к игре» -->
                            <Button Command="{Binding ConnectToGameCommand}"
                                    Height="40" FontSize="13">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryNeonBtn}">
                                        <Setter Property="Content" Value="ОЖИДАНИЕ ХОСТА..." />
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanGuestConnect}" Value="True">
                                                <Setter Property="Content" Value="ПОДКЛЮЧИТЬСЯ К ИГРЕ" />
                                                <Setter Property="IsEnabled" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Command="{Binding LeaveLobbyCommand}"
                                    Style="{StaticResource GhostBtn}"
                                    Content="Выйти из лобби" Height="34" FontSize="12"
                                    Foreground="#EF4444" Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
