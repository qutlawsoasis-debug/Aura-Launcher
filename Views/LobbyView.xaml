<UserControl x:Class="AuraLauncher.Views.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="False"
             FocusVisualStyle="{x:Null}"
             ClipToBounds="False"
             Background="Transparent">

    <UserControl.CacheMode>
        <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="True" />
    </UserControl.CacheMode>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Converter or DataTrigger styles for Code Cell bottom lines -->
        <!-- Empty: 18% white (#2EFFFFFF) -->
        <!-- Filled: ember 60% (#99F2A63C) -->
        <!-- Current: ember (#F2A63C) with blinking caret 1s -->
        <Style x:Key="CodeCellBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Background" Value="#12FFFFFF" /> <!-- White 7% -->
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderThickness" Value="0,0,0,3" />
            <Setter Property="BorderBrush" Value="#2EFFFFFF" /> <!-- 18% white -->
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- Blinking caret 1s animation -->
        <Storyboard x:Key="BlinkingCaretAnim" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.0" Duration="0:0:0.5" AutoReverse="True" />
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="Transparent" Focusable="False" FocusVisualStyle="{x:Null}" ClipToBounds="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Header: Oswald 600 60px on top-left edge, 15px dim subtitle (Height=Auto, LineHeight 66, Margin сверху 6px) -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24" Focusable="False">
            <TextBlock Text="Лобби"
                       FontFamily="{StaticResource HeadingFont}"
                       FontSize="60"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}"
                       Height="Auto"
                       LineHeight="66"
                       LineStackingStrategy="BlockLineHeight"
                       Margin="0,6,0,6">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="12" Opacity="0.7" Direction="0" ShadowDepth="0" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="Совместная игра по сети через защищённый туннель"
                       FontFamily="{StaticResource MainFont}"
                       FontSize="15"
                       FontWeight="Normal"
                       Foreground="{StaticResource DimInkBrush}" />
        </StackPanel>

        <!-- Fixed 2 Columns: left 344px, gap 40px, right 200px (total 584px) -->
        <Grid Grid.Row="1" Focusable="False" ClipToBounds="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="344" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <!-- ============================================== -->
            <!-- LEFT COLUMN: Lobby Creation / Join / In Lobby -->
            <!-- ============================================== -->
            <Grid Grid.Column="0">
                <!-- ============================================== -->
                <!-- A. NOT IN LOBBY                                -->
                <!-- ============================================== -->
                <StackPanel VerticalAlignment="Top">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInLobby}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Main Button: "Создать лобби" -->
                    <Button Command="{Binding CreateLobbyCommand}"
                            Style="{StaticResource PrimaryNeonBtn}"
                            Height="48"
                            Content="Создать лобби"
                            HorizontalAlignment="Left"
                            Width="260"
                            Margin="0,0,0,20" />

                    <!-- Line "или" with flanking lines -->
                    <Grid Width="260" HorizontalAlignment="Left" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="1" Background="{StaticResource LineInkBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="или"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="13"
                                   Foreground="{StaticResource MuteBrush}"
                                   Margin="14,0" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Height="1" Background="{StaticResource LineInkBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- "Код от друга" 13px mute -->
                    <TextBlock Text="Код от друга"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               Foreground="{StaticResource MuteBrush}"
                               Margin="0,0,0,8" />

                    <!-- Six 44x58 code cells with gap 8 and hidden input + "Войти" button in WrapPanel -->
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Grid Margin="0,0,12,8">
                            <!-- 6 visual cells -->
                            <StackPanel Orientation="Horizontal">
                                <!-- Cell 0 -->
                                <Border Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CodeCellBorderStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCellFilled0}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#99F2A63C" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCellCurrent0}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource EmberBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock Text="{Binding CodeChar0}"
                                                   FontFamily="{StaticResource HeadingFont}"
                                                   FontSize="32" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <!-- Blinking Caret when current -->
                                        <Border Width="2" Height="28" Background="{StaticResource EmberBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding IsCellCurrent0, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>

                                <!-- Cell 1 -->
                                <Border Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CodeCellBorderStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCellFilled1}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#99F2A63C" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCellCurrent1}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource EmberBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock Text="{Binding CodeChar1}"
                                                   FontFamily="{StaticResource HeadingFont}"
                                                   FontSize="32" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border Width="2" Height="28" Background="{StaticResource EmberBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding IsCellCurrent1, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>

                                <!-- Cell 2 -->
                                <Border Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CodeCellBorderStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCellFilled2}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#99F2A63C" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCellCurrent2}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource EmberBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock Text="{Binding CodeChar2}"
                                                   FontFamily="{StaticResource HeadingFont}"
                                                   FontSize="32" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border Width="2" Height="28" Background="{StaticResource EmberBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding IsCellCurrent2, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>

                                <!-- Cell 3 -->
                                <Border Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CodeCellBorderStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCellFilled3}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#99F2A63C" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCellCurrent3}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource EmberBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock Text="{Binding CodeChar3}"
                                                   FontFamily="{StaticResource HeadingFont}"
                                                   FontSize="32" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border Width="2" Height="28" Background="{StaticResource EmberBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding IsCellCurrent3, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>

                                <!-- Cell 4 -->
                                <Border Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CodeCellBorderStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCellFilled4}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#99F2A63C" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCellCurrent4}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource EmberBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock Text="{Binding CodeChar4}"
                                                   FontFamily="{StaticResource HeadingFont}"
                                                   FontSize="32" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border Width="2" Height="28" Background="{StaticResource EmberBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding IsCellCurrent4, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>

                                <!-- Cell 5 -->
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CodeCellBorderStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCellFilled5}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#99F2A63C" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCellCurrent5}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource EmberBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock Text="{Binding CodeChar5}"
                                                   FontFamily="{StaticResource HeadingFont}"
                                                   FontSize="32" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border Width="2" Height="28" Background="{StaticResource EmberBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding IsCellCurrent5, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Hidden transparent TextBox overlaid on the cells for real keyboard typing -->
                            <TextBox x:Name="HiddenCodeInputBox"
                                     Text="{Binding GuestCodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="6"
                                     Opacity="0.01"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="Transparent"
                                     CaretBrush="Transparent"
                                     Cursor="IBeam"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch" />
                        </Grid>

                        <!-- "Войти" button (height 58, disabled until 6 chars, shows "Входим…" while joining) -->
                        <Button Command="{Binding JoinLobbyCommand}"
                                Style="{StaticResource StandardBtn}"
                                Height="58"
                                Content="{Binding JoinButtonText}"
                                Margin="0,0,0,8" />
                    </WrapPanel>

                    <!-- Error message under code line: 13px, #FF8A7A, disappears on typing -->
                    <StackPanel Orientation="Vertical" Margin="0,0,0,16" Visibility="{Binding HasJoinError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding JoinErrorMessage}"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="#FF8A7A"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <Button Command="{Binding SendReportCommand}"
                                Style="{StaticResource BadLinkBtn}"
                                Content="Отправить отчёт об ошибке"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>

                <!-- ============================================== -->
                <!-- B. IN LOBBY                                    -->
                <!-- ============================================== -->
                <StackPanel VerticalAlignment="Top">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInLobby}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- "Код лобби" -->
                    <TextBlock Text="Код лобби"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               Foreground="{StaticResource MuteBrush}"
                               Margin="0,0,0,8" />

                    <!-- Six cells displaying LobbyCode (304px total width) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Style="{StaticResource CodeCellBorderStyle}" Margin="0,0,8,0" BorderBrush="#99F2A63C">
                            <TextBlock Text="{Binding CodeChar0}" FontFamily="{StaticResource HeadingFont}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Style="{StaticResource CodeCellBorderStyle}" Margin="0,0,8,0" BorderBrush="#99F2A63C">
                            <TextBlock Text="{Binding CodeChar1}" FontFamily="{StaticResource HeadingFont}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Style="{StaticResource CodeCellBorderStyle}" Margin="0,0,8,0" BorderBrush="#99F2A63C">
                            <TextBlock Text="{Binding CodeChar2}" FontFamily="{StaticResource HeadingFont}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Style="{StaticResource CodeCellBorderStyle}" Margin="0,0,8,0" BorderBrush="#99F2A63C">
                            <TextBlock Text="{Binding CodeChar3}" FontFamily="{StaticResource HeadingFont}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Style="{StaticResource CodeCellBorderStyle}" Margin="0,0,8,0" BorderBrush="#99F2A63C">
                            <TextBlock Text="{Binding CodeChar4}" FontFamily="{StaticResource HeadingFont}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Style="{StaticResource CodeCellBorderStyle}" BorderBrush="#99F2A63C">
                            <TextBlock Text="{Binding CodeChar5}" FontFamily="{StaticResource HeadingFont}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <!-- Status string with square 10x10 dot (radius 2):
                         waiting ember pulsing 1.4s, ok #5FD39A static -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,20">
                        <!-- 10x10 status square -->
                        <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource EmberBrush}" />
                                    <!-- Default: waiting pulse 1.4s -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusWaiting}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource EmberBrush}" />
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="1.0" To="0.3" Duration="0:0:0.7" AutoReverse="True" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsStatusOpen}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource OkBrush}" />
                                            <Setter Property="Opacity" Value="1.0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <!-- Status text ("Ждём, пока вы откроете мир" / "Мир открыт для сети" / "Ждём хоста" / "Хост открыл мир") -->
                        <TextBlock Text="{Binding CombinedStatusText}"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource InkBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Ошибка туннеля: кнопка "Отправить отчёт" -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16"
                                Visibility="{Binding ShowTunnelFailedLogButton, Converter={StaticResource BoolToVis}}">
                        <Button Command="{Binding SendReportCommand}"
                                Style="{StaticResource BadLinkBtn}"
                                Content="Отправить отчёт об ошибке туннеля"
                                VerticalAlignment="Center"
                                Margin="0,0,14,0" />
                        <Button Command="{Binding CopyTunnelLogCommand}"
                                Style="{StaticResource StandardBtn}"
                                Height="28"
                                Padding="12,0"
                                FontSize="12"
                                Content="Копировать лог туннеля"
                                VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Main buttons row in WrapPanel: [Открыть мир / Подключиться к игре] [Копировать] [Выйти из лобби] -->
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,20">
                        <!-- Host: "Открыть мир" button -->
                        <Button Command="{Binding OpenWorldCommand}"
                                Style="{StaticResource PrimaryNeonBtn}"
                                Height="48"
                                Content="Открыть мир"
                                Margin="0,0,12,8"
                                Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}" />

                        <!-- Guest: "Подключиться к игре" button -->
                        <Button Command="{Binding ConnectToGameCommand}"
                                Height="48"
                                Content="Подключиться к игре"
                                Margin="0,0,12,8">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryNeonBtn}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHost}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Guest: "Переподключиться" button (активна при вылете или возможности повторного подключения) -->
                        <Button Command="{Binding ReconnectCommand}"
                                Height="48"
                                Content="Переподключиться"
                                Margin="0,0,12,8">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanReconnect}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- "Копировать" / "Скопировано" Button -->
                        <Button Command="{Binding CopyCodeCommand}"
                                Height="48"
                                Padding="20,0"
                                Margin="0,0,12,8">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource StandardBtn}">
                                    <Setter Property="Content" Value="Копировать" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CodeCopied}" Value="True">
                                            <Setter Property="Content" Value="Скопировано" />
                                            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- "Копировать ссылку" Button -->
                        <Button Command="{Binding CopyLinkCommand}"
                                Height="48"
                                Padding="16,0"
                                Margin="0,0,12,8">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource StandardBtn}">
                                    <Setter Property="Content" Value="{Binding CopyLinkButtonText}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLinkCopied}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- "Выйти из лобби" link in bad color -->
                        <Button Command="{Binding LeaveLobbyCommand}"
                                Style="{StaticResource BadLinkBtn}"
                                Content="Выйти из лобби"
                                Margin="0,0,0,8"
                                VerticalAlignment="Center" />
                    </WrapPanel>

                    <!-- Warning note for host: "Не показывайте код посторонним: в этом режиме проверка лицензии отключена."
                         13px dim, 2px ember left border, padding 12px -->
                    <Border BorderBrush="{StaticResource EmberBrush}"
                            BorderThickness="2,0,0,0"
                            Padding="12,4,0,4"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Left"
                            Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Не показывайте код посторонним: в этом режиме проверка лицензии отключена."
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   Foreground="{StaticResource DimInkBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="360" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ============================================== -->
            <!-- RIGHT COLUMN: Players list (width 200px)       -->
            <!-- 54px rows with 1px lines top/bottom            -->
            <!-- ============================================== -->
            <StackPanel Grid.Column="2" Width="200" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="Игроки"
                           FontFamily="{StaticResource HeadingFont}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource DimInkBrush}"
                           Margin="0,0,0,8" />

                <!-- Empty State -->
                <TextBlock Text="Игроки появятся здесь, когда вы создадите лобби или войдёте по коду."
                           FontFamily="{StaticResource MainFont}"
                           FontSize="13"
                           Foreground="{StaticResource MuteBrush}"
                           TextWrapping="Wrap"
                           MaxWidth="200"
                           LineHeight="18">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInLobby}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Players Rows (when in lobby) -->
                <ItemsControl ItemsSource="{Binding LobbyPlayers}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInLobby}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 54px row with 1px top border (and bottom on last item) -->
                            <Border Height="54" BorderBrush="{StaticResource LineInkBrush}" BorderThickness="0,1,0,0" Background="Transparent">
                                <!-- Animation: new player slides in from -14px in 320ms ONLY when IsNewlyAdded=True -->
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="PlayerTrans" X="0" />
                                </Border.RenderTransform>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNewlyAdded}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                             From="-14" To="0" Duration="0:0:0.320">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0" To="1" Duration="0:0:0.320">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Head 40x40 nearest neighbor -->
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="2" ClipToBounds="True" Background="#141E26">
                                        <Image Source="{Binding Avatar}" Width="40" Height="40"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               RenderOptions.EdgeMode="Aliased"
                                               Stretch="UniformToFill" />
                                    </Border>

                                    <!-- Nick 15px 600 -->
                                    <TextBlock Grid.Column="1" Text="{Binding Nickname}"
                                               FontFamily="{StaticResource MainFont}"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource InkBrush}"
                                               VerticalAlignment="Center"
                                               Margin="10,0,6,0"
                                               TextWrapping="Wrap" />

                                    <!-- Badge "хост" 12px ember -->
                                    <TextBlock Grid.Column="2" Text="хост"
                                               FontFamily="{StaticResource MainFont}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource EmberBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}" />

                                    <!-- Green dot -->
                                    <Border Grid.Column="3" Width="8" Height="8" CornerRadius="2"
                                            Background="{StaticResource OkBrush}"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
