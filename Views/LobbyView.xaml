<UserControl x:Class="AuraLauncher.Views.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="478" d:DesignWidth="980">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="InverseBoolToVisStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Сплошной темный фон без изображения, без блюра и стекла -->
    <Grid Background="#0F1115">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="440" Margin="0,32">

                <!-- Заголовок и одна строка статуса -->
                <TextBlock Text="ЛОББИ" FontSize="18" FontWeight="SemiBold" Foreground="#E8EAED"
                           HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#9AA3B2"
                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,24" />

                <!-- Основная плоская карточка-форма -->
                <Border Background="#171A21" BorderBrush="#252A33" BorderThickness="1" CornerRadius="4" Padding="24">
                    <Grid>
                        <!-- ============================================== -->
                        <!-- 1. НЕ В ЛОББИ: СОЗДАТЬ ИЛИ ВОЙТИ ПО КОДУ      -->
                        <!-- ============================================== -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInLobby}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Блок хоста -->
                            <TextBlock Text="Создать лобби" FontSize="13" FontWeight="SemiBold" Foreground="#E8EAED" Margin="0,0,0,8" />
                            <Button Command="{Binding CreateLobbyCommand}"
                                    Style="{StaticResource PrimaryNeonBtn}"
                                    Height="38" Content="СОЗДАТЬ ЛОББИ" />

                            <!-- Ошибка создания с кнопкой копирования лога -->
                            <Border Background="#241416" BorderBrush="#EF444433" BorderThickness="1" CornerRadius="4"
                                    Padding="12,10" Margin="0,12,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowTunnelFailedLogButton}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding TunnelFailureReason}"
                                               FontSize="11" Foreground="#EF4444" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <Button Command="{Binding CopyTunnelLogCommand}"
                                            Height="32" FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource StandardBtn}">
                                                <Setter Property="Content" Value="Копировать лог" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TunnelLogCopied}" Value="True">
                                                        <Setter Property="Content" Value="Лог скопирован" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Разделитель -->
                            <Border Height="1" Background="#252A33" Margin="0,20" />

                            <!-- Блок гостя: ввод кода и вход -->
                            <TextBlock Text="Войти по коду" FontSize="13" FontWeight="SemiBold" Foreground="#E8EAED" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="{Binding GuestCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="15" FontWeight="SemiBold" FontFamily="Consolas, Courier New"
                                         MaxLength="6" Height="38"
                                         TextAlignment="Center"
                                         CharacterCasing="Upper" />
                                <Button Grid.Column="1"
                                        Command="{Binding JoinLobbyCommand}"
                                        Style="{StaticResource StandardBtn}"
                                        Content="ВОЙТИ" Height="38" Width="90" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- 2. В ЛОББИ КАК ХОСТ                            -->
                        <!-- ============================================== -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsInLobby}" Value="True" />
                                                <Condition Binding="{Binding IsHost}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Статус одной строкой -->
                            <TextBlock Text="{Binding HostStatusText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#19D3A7" Margin="0,0,0,14" TextAlignment="Center" />

                            <!-- Код лобби и копирование -->
                            <Border Background="#0F1115" BorderBrush="#252A33" BorderThickness="1" CornerRadius="4"
                                    Padding="14,10" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding LobbyCode, StringFormat='КОД: {0}'}"
                                               FontSize="20" FontWeight="Bold" FontFamily="Consolas, Courier New"
                                               Foreground="#19D3A7" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Command="{Binding CopyCodeCommand}"
                                            Height="32" Padding="12,0" FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource StandardBtn}">
                                                <Setter Property="Content" Value="Копировать" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CodeCopied}" Value="True">
                                                        <Setter Property="Content" Value="Скопировано" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>

                            <TextBlock Text="Отправьте код другу, затем откройте мир для сети в игре."
                                       FontSize="11" Foreground="#9AA3B2" TextWrapping="Wrap" Margin="0,0,0,16" />

                            <!-- Кнопка «Открыть мир» -->
                            <Button Command="{Binding OpenWorldCommand}"
                                    Height="38">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryNeonBtn}">
                                        <Setter Property="Content" Value="ОТКРЫТЬ МИР" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWorldOpen}" Value="True">
                                                <Setter Property="Content" Value="МИР ОТКРЫТ" />
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Ошибка туннеля с кнопкой копирования лога -->
                            <Border Background="#241416" BorderBrush="#EF444433" BorderThickness="1" CornerRadius="4"
                                    Padding="12,10" Margin="0,12,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowTunnelFailedLogButton}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding TunnelFailureReason}"
                                               FontSize="11" Foreground="#EF4444" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <Button Command="{Binding CopyTunnelLogCommand}"
                                            Height="32" FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource StandardBtn}">
                                                <Setter Property="Content" Value="Копировать лог" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TunnelLogCopied}" Value="True">
                                                        <Setter Property="Content" Value="Лог скопирован" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Button Command="{Binding LeaveLobbyCommand}"
                                    Style="{StaticResource GhostBtn}"
                                    Content="Выйти из лобби" Height="34" FontSize="12"
                                    Foreground="#EF4444" Margin="0,8,0,0" />
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- 3. В ЛОББИ КАК ГОСТЬ                           -->
                        <!-- ============================================== -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsGuestJoined}" Value="True" />
                                                <Condition Binding="{Binding IsHost}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Статус гостя одной строкой -->
                            <TextBlock Text="{Binding GuestStatusText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#19D3A7" Margin="0,0,0,16" TextAlignment="Center" />

                            <Border Background="#0F1115" BorderBrush="#252A33" BorderThickness="1" CornerRadius="4"
                                    Padding="14,10" Margin="0,0,0,16">
                                <TextBlock Text="{Binding LobbyCode, StringFormat='ЛОББИ: {0}'}"
                                           FontSize="16" FontWeight="SemiBold" FontFamily="Consolas, Courier New"
                                           Foreground="#E8EAED" HorizontalAlignment="Center" />
                            </Border>

                            <!-- Кнопка «Подключиться к игре» -->
                            <Button Command="{Binding ConnectToGameCommand}"
                                    Height="38" FontSize="13">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryNeonBtn}">
                                        <Setter Property="Content" Value="ОЖИДАНИЕ ХОСТА..." />
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanGuestConnect}" Value="True">
                                                <Setter Property="Content" Value="ПОДКЛЮЧИТЬСЯ К ИГРЕ" />
                                                <Setter Property="IsEnabled" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Command="{Binding LeaveLobbyCommand}"
                                    Style="{StaticResource GhostBtn}"
                                    Content="Выйти из лобби" Height="34" FontSize="12"
                                    Foreground="#EF4444" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
