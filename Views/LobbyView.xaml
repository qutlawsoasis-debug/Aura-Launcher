<UserControl x:Class="AuraLauncher.Views.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="478" d:DesignWidth="980"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="480" Margin="0,20">

                <!-- Заголовок Лобби -->
                <TextBlock Text="Лобби" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,6" />

                <!-- Статус одной строкой с цветной точкой (пульсирует при ожидании) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Grid Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#4B5563" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusOpen}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsStatusWaiting}" Value="True">
                                            <Setter Property="Fill" Value="#9AA3B2" />
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="PulseAnim">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.3" To="1.0" Duration="0:0:0.75">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="PulseAnim" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    <TextBlock Text="{Binding CombinedStatusText}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Основная единая карточка (без рамок в рамках) -->
                <Border Style="{StaticResource CardPanel}" Padding="24">
                    <Grid>
                        <!-- ============================================== -->
                        <!-- 1. НЕ В ЛОББИ: СОЗДАТЬ ИЛИ ВОЙТИ ПО КОДУ      -->
                        <!-- ============================================== -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInLobby}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Блок хоста -->
                            <TextBlock Text="Создать новое лобби" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            <TextBlock Text="Запустите лобби для совместной игры с друзьями по сети." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />
                            <Button Command="{Binding CreateLobbyCommand}"
                                    Style="{StaticResource PrimaryNeonBtn}"
                                    Height="42" Content="Создать лобби" />

                            <!-- Ошибка создания с кнопкой копирования лога -->
                            <Border Background="#241416" BorderBrush="#EF444433" BorderThickness="1" CornerRadius="6"
                                    Padding="12,10" Margin="0,12,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowTunnelFailedLogButton}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding TunnelFailureReason}"
                                               FontSize="12" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <Button Command="{Binding CopyTunnelLogCommand}"
                                            Height="32" FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource StandardBtn}">
                                                <Setter Property="Content" Value="Копировать лог" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TunnelLogCopied}" Value="True">
                                                        <Setter Property="Content" Value="Лог скопирован" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Разделитель -->
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,20" />

                            <!-- Блок гостя: ввод кода и вход -->
                            <TextBlock Text="Войти по коду" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="{Binding GuestCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="15" FontWeight="Bold"
                                         MaxLength="6" Height="42"
                                         TextAlignment="Center"
                                         CharacterCasing="Upper" />
                                <Button Grid.Column="1"
                                         Command="{Binding JoinLobbyCommand}"
                                         Style="{StaticResource StandardBtn}"
                                         Content="Войти" Height="42" Width="96" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- 2. В ЛОББИ КАК ХОСТ                            -->
                        <!-- ============================================== -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsInLobby}" Value="True" />
                                                <Condition Binding="{Binding IsHost}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Код лобби с кнопкой копирования (без вложенной лишней рамки) -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Код лобби" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding LobbyCode}"
                                               FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding CopyCodeCommand}"
                                        Height="36" Padding="16,0" FontSize="12">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource StandardBtn}">
                                            <Setter Property="Content" Value="Копировать" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CodeCopied}" Value="True">
                                                    <Setter Property="Content" Value="Скопировано" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16" />

                            <!-- Список игроков с подсветкой слева на ховере и анимацией появления -->
                            <TextBlock Text="Игроки в лобби" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding LobbyPlayers}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- InteractiveCard: 2px left accent highlight + border accent on hover -->
                                        <ContentControl Style="{StaticResource InteractiveCard}" Margin="0,0,0,8">
                                            <ContentControl.RenderTransform>
                                                <TranslateTransform x:Name="ItemTrans" Y="0" />
                                            </ContentControl.RenderTransform>
                                            <!-- Анимация появления игрока (плавный въезд снизу) -->
                                            <ContentControl.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0.0" To="1.0" Duration="0:0:0.180" />
                                                            <DoubleAnimation Storyboard.TargetName="ItemTrans" Storyboard.TargetProperty="Y"
                                                                             From="8.0" To="0.0" Duration="0:0:0.180">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </ContentControl.Triggers>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Аватарка 32x32 -->
                                                <Border Grid.Column="0" Width="32" Height="32" Background="{StaticResource BgDeepBrush}" CornerRadius="4" ClipToBounds="True" Margin="0,0,12,0">
                                                    <Image Source="{Binding Avatar}" Width="32" Height="32" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="UniformToFill" />
                                                </Border>
                                                <!-- Никнейм -->
                                                <TextBlock Grid.Column="1" Text="{Binding Nickname}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <!-- Бейдж ХОСТ (короткая метка капсом по ТЗ) -->
                                                <Border Grid.Column="2" Background="#172C24" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                        Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="ХОСТ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                                </Border>
                                            </Grid>
                                        </ContentControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Отправьте код другу, затем откройте мир для сети в игре."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

                            <!-- Кнопка «Открыть мир» -->
                            <Button Command="{Binding OpenWorldCommand}"
                                    Height="42">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryNeonBtn}">
                                        <Setter Property="Content" Value="Открыть мир" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWorldOpen}" Value="True">
                                                <Setter Property="Content" Value="Мир открыт" />
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Ошибка туннеля с кнопкой копирования лога -->
                            <Border Background="#241416" BorderBrush="#EF444433" BorderThickness="1" CornerRadius="6"
                                    Padding="12,10" Margin="0,12,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowTunnelFailedLogButton}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding TunnelFailureReason}"
                                               FontSize="12" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <Button Command="{Binding CopyTunnelLogCommand}"
                                            Height="32" FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource StandardBtn}">
                                                <Setter Property="Content" Value="Копировать лог" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TunnelLogCopied}" Value="True">
                                                        <Setter Property="Content" Value="Лог скопирован" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Button Command="{Binding LeaveLobbyCommand}"
                                    Style="{StaticResource GhostBtn}"
                                    Content="Выйти из лобби" Height="36" FontSize="13"
                                    Foreground="{StaticResource ErrorBrush}" Margin="0,12,0,0" />
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- 3. В ЛОББИ КАК ГОСТЬ                           -->
                        <!-- ============================================== -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsGuestJoined}" Value="True" />
                                                <Condition Binding="{Binding IsHost}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Код лобби -->
                            <StackPanel VerticalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="Код лобби" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding LobbyCode}"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,16" />

                            <!-- Список игроков с подсветкой слева на ховере -->
                            <TextBlock Text="Игроки в лобби" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding LobbyPlayers}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Style="{StaticResource InteractiveCard}" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Аватарка 32x32 -->
                                                <Border Grid.Column="0" Width="32" Height="32" Background="{StaticResource BgDeepBrush}" CornerRadius="4" ClipToBounds="True" Margin="0,0,12,0">
                                                    <Image Source="{Binding Avatar}" Width="32" Height="32" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="UniformToFill" />
                                                </Border>
                                                <!-- Никнейм -->
                                                <TextBlock Grid.Column="1" Text="{Binding Nickname}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <!-- Бейдж ХОСТ -->
                                                <Border Grid.Column="2" Background="#172C24" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                        Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="ХОСТ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                                </Border>
                                            </Grid>
                                        </ContentControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Кнопка «Подключиться к игре» -->
                            <Button Command="{Binding ConnectToGameCommand}"
                                    Height="42" FontSize="14">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryNeonBtn}">
                                        <Setter Property="Content" Value="Ожидание хоста..." />
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanGuestConnect}" Value="True">
                                                <Setter Property="Content" Value="Подключиться к игре" />
                                                <Setter Property="IsEnabled" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Command="{Binding LeaveLobbyCommand}"
                                    Style="{StaticResource GhostBtn}"
                                    Content="Выйти из лобби" Height="36" FontSize="13"
                                    Foreground="{StaticResource ErrorBrush}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
