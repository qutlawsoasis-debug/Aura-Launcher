<UserControl x:Class="AuraLauncher.Views.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:AuraLauncher.Behaviors"
             mc:Ignorable="d"
             Focusable="False"
             FocusVisualStyle="{x:Null}"
             ClipToBounds="False"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="CodeCellBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Background" Value="{DynamicResource Border}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderThickness" Value="0,0,0,3" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="CompactCodeCellBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="{DynamicResource Border}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDim}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Storyboard x:Key="BlinkingCaretAnim" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.0" Duration="0:0:0.5" AutoReverse="True" />
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="Transparent" Focusable="False" FocusVisualStyle="{x:Null}" ClipToBounds="False">

        <!-- СОСТОЯНИЕ 1: ВНЕ ЛОББИ (Создание / Вход по коду + 3D-превью своего персонажа) -->
        <Grid Focusable="False">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInLobby}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24" Focusable="False">
                <TextBlock Text="Лобби"
                           FontFamily="{StaticResource HeadingFont}"
                           FontSize="60"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}"
                           Height="Auto"
                           LineHeight="66"
                           LineStackingStrategy="BlockLineHeight"
                           Margin="0,6,0,6">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="12" Opacity="0.7" Direction="0" ShadowDepth="0" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="Совместная игра по сети через защищённый туннель"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="15"
                           FontWeight="Normal"
                           Foreground="{StaticResource DimInkBrush}" />
            </StackPanel>

            <Grid Grid.Row="1" Focusable="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="344" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Левая колонка: Создать лобби / Код от друга -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <Button Command="{Binding CreateLobbyCommand}"
                            Style="{StaticResource PrimaryNeonBtn}"
                            Height="48"
                            Content="Создать лобби"
                            HorizontalAlignment="Left"
                            Width="260"
                            Margin="0,0,0,20" />

                    <Grid Width="260" HorizontalAlignment="Left" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="1" Background="{StaticResource LineInkBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="или"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="13"
                                   Foreground="{StaticResource MuteBrush}"
                                   Margin="14,0" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Height="1" Background="{StaticResource LineInkBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="Код от друга"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               Foreground="{StaticResource MuteBrush}"
                               Margin="0,0,0,8" />

                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Grid Margin="0,0,12,8">
                            <StackPanel Orientation="Horizontal">
                                <!-- Cell 0 -->
                                <Border Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CodeCellBorderStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCellFilled0}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentDim}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCellCurrent0}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource EmberBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock Text="{Binding CodeChar0}"
                                                   FontFamily="{StaticResource HeadingFont}"
                                                   FontSize="32" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border Width="2" Height="28" Background="{StaticResource EmberBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding IsCellCurrent0, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>

                                <!-- Cell 1 -->
                                <Border Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CodeCellBorderStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCellFilled1}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentDim}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCellCurrent1}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource EmberBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock Text="{Binding CodeChar1}"
                                                   FontFamily="{StaticResource HeadingFont}"
                                                   FontSize="32" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border Width="2" Height="28" Background="{StaticResource EmberBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding IsCellCurrent1, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>

                                <!-- Cell 2 -->
                                <Border Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CodeCellBorderStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCellFilled2}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentDim}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCellCurrent2}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource EmberBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock Text="{Binding CodeChar2}"
                                                   FontFamily="{StaticResource HeadingFont}"
                                                   FontSize="32" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border Width="2" Height="28" Background="{StaticResource EmberBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding IsCellCurrent2, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>

                                <!-- Cell 3 -->
                                <Border Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CodeCellBorderStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCellFilled3}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentDim}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCellCurrent3}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource EmberBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock Text="{Binding CodeChar3}"
                                                   FontFamily="{StaticResource HeadingFont}"
                                                   FontSize="32" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border Width="2" Height="28" Background="{StaticResource EmberBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding IsCellCurrent3, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>

                                <!-- Cell 4 -->
                                <Border Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CodeCellBorderStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCellFilled4}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentDim}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCellCurrent4}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource EmberBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock Text="{Binding CodeChar4}"
                                                   FontFamily="{StaticResource HeadingFont}"
                                                   FontSize="32" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border Width="2" Height="28" Background="{StaticResource EmberBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding IsCellCurrent4, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>

                                <!-- Cell 5 -->
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CodeCellBorderStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCellFilled5}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentDim}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCellCurrent5}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource EmberBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock Text="{Binding CodeChar5}"
                                                   FontFamily="{StaticResource HeadingFont}"
                                                   FontSize="32" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border Width="2" Height="28" Background="{StaticResource EmberBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding IsCellCurrent5, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <TextBox x:Name="HiddenCodeInputBox"
                                     Text="{Binding GuestCodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="6"
                                     Opacity="0.01"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="Transparent"
                                     CaretBrush="Transparent"
                                     Cursor="IBeam"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch" />
                        </Grid>

                        <Button Command="{Binding JoinLobbyCommand}"
                                Style="{StaticResource StandardBtn}"
                                Height="58"
                                Content="{Binding JoinButtonText}"
                                Margin="0,0,0,8" />
                    </WrapPanel>

                    <StackPanel Orientation="Vertical" Margin="0,0,0,12" Visibility="{Binding HasJoinError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding JoinErrorMessage}"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource Danger}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <Button Command="{Binding SendReportCommand}"
                                Style="{StaticResource BadLinkBtn}"
                                Content="Отправить отчёт об ошибке"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>

                <!-- Правая колонка: 3D-персонаж игрока до входа в лобби (живой и вращаемый мышью) -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">
                    <Grid Width="156" Height="244"
                          Background="Transparent"
                          Cursor="Hand"
                          ToolTip="Потяните мышью, чтобы повернуть персонажа"
                          behaviors:AlivePlayer3D.SourceModel="{Binding LocalPlayerModel3D}"
                          behaviors:AlivePlayer3D.BaseYaw="-14"
                          behaviors:AlivePlayer3D.BasePitch="4"
                          behaviors:AlivePlayer3D.PhaseSeed="{Binding LocalPlayerNickname}">
                        <Viewport3D Width="156" Height="244" ClipToBounds="False" IsHitTestVisible="False">
                            <Viewport3D.Camera>
                                <PerspectiveCamera Position="0,0,27.5"
                                                   LookDirection="0,0,-1"
                                                   UpDirection="0,1,0"
                                                   FieldOfView="45" />
                            </Viewport3D.Camera>
                            <ModelVisual3D />
                        </Viewport3D>
                    </Grid>

                    <TextBlock Text="{Binding LocalPlayerNickname}"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />

                    <TextBlock Text="Готов к лобби"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="12"
                               Foreground="{StaticResource MuteBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- СОСТОЯНИЕ 2: В ЛОББИ (Сцена в стиле CS2 / Brawl Stars: Хост по центру с короной, друзья по бокам) -->
        <Grid Focusable="False">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInLobby}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Верхняя панель: заголовок + статус слева, код лобби справа -->
                <RowDefinition Height="*" />    <!-- Центральная сцена с персонажами -->
                <RowDefinition Height="Auto" /> <!-- Нижняя панель действий -->
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Слева: Заголовок Лобби + Статус -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <TextBlock Text="Лобби"
                               FontFamily="{StaticResource HeadingFont}"
                               FontSize="42"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"
                               LineHeight="46"
                               LineStackingStrategy="BlockLineHeight"
                               Margin="0,2,0,6">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="12" Opacity="0.7" Direction="0" ShadowDepth="0" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource EmberBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStatusWaiting}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource EmberBrush}" />
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="1.0" To="0.3" Duration="0:0:0.7" AutoReverse="True" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsStatusOpen}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource OkBrush}" />
                                            <Setter Property="Opacity" Value="1.0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <TextBlock Text="{Binding CombinedStatusText}"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource InkBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Показатели сети и сервера Minecraft -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <!-- Пинг -->
                        <Border Background="{DynamicResource PanelRaised}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="8,3"
                                Margin="0,0,8,0"
                                ToolTip="Реальный сетевой пинг до сервера">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconWifi}"
                                      Style="{StaticResource IconPath}"
                                      Width="11" Height="11"
                                      Margin="0,0,6,0"
                                      Stroke="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding ServerPingText}"
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                        </Border>

                        <!-- Онлайн в мире -->
                        <Border Background="{DynamicResource PanelRaised}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="8,3"
                                ToolTip="Количество игроков внутри мира Minecraft">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconWorld}"
                                      Style="{StaticResource IconPath}"
                                      Width="11" Height="11"
                                      Margin="0,0,6,0"
                                      Stroke="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{Binding ServerPlayersText}"
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimary}"
                                           Margin="0,0,4,0" />
                                <TextBlock Text="в мире"
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Margin="0,4,0,0"
                            Visibility="{Binding IsSyncNoticeVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SyncNoticeText}"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Accent}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <!-- Справа: Код лобби + кнопки Копировать / Ссылка / Выйти -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Код лобби"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource MuteBrush}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center" />
                        <Button Command="{Binding LeaveLobbyCommand}"
                                Style="{StaticResource BadLinkBtn}"
                                Content="Выйти из лобби"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Style="{StaticResource CompactCodeCellBorderStyle}" Margin="0,0,6,0">
                            <TextBlock Text="{Binding CodeChar0}" FontFamily="{StaticResource HeadingFont}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Style="{StaticResource CompactCodeCellBorderStyle}" Margin="0,0,6,0">
                            <TextBlock Text="{Binding CodeChar1}" FontFamily="{StaticResource HeadingFont}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Style="{StaticResource CompactCodeCellBorderStyle}" Margin="0,0,6,0">
                            <TextBlock Text="{Binding CodeChar2}" FontFamily="{StaticResource HeadingFont}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Style="{StaticResource CompactCodeCellBorderStyle}" Margin="0,0,6,0">
                            <TextBlock Text="{Binding CodeChar3}" FontFamily="{StaticResource HeadingFont}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Style="{StaticResource CompactCodeCellBorderStyle}" Margin="0,0,6,0">
                            <TextBlock Text="{Binding CodeChar4}" FontFamily="{StaticResource HeadingFont}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Style="{StaticResource CompactCodeCellBorderStyle}">
                            <TextBlock Text="{Binding CodeChar5}" FontFamily="{StaticResource HeadingFont}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CopyCodeCommand}"
                                Height="30"
                                Width="98"
                                FontSize="12"
                                Padding="8,0"
                                Style="{StaticResource StandardBtn}"
                                Margin="0,0,6,0">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Копировать" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Opacity" Value="1.0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CodeCopied}" Value="True">
                                                    <Setter Property="Opacity" Value="0.0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Скопировано" FontSize="12" Foreground="{StaticResource OkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Opacity" Value="0.0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CodeCopied}" Value="True">
                                                    <Setter Property="Opacity" Value="1.0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Button>

                        <Button Command="{Binding CopyLinkCommand}"
                                Height="30"
                                Width="106"
                                FontSize="12"
                                Padding="8,0"
                                Style="{StaticResource StandardBtn}">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Ссылка" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Opacity" Value="1.0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLinkCopied}" Value="True">
                                                    <Setter Property="Opacity" Value="0.0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Скопировано" FontSize="12" Foreground="{StaticResource OkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Opacity" Value="0.0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLinkCopied}" Value="True">
                                                    <Setter Property="Opacity" Value="1.0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Центральная сцена с персонажами (CS2 / Brawl Stars раскладка) -->
            <Grid Grid.Row="1" ClipToBounds="True" Margin="0,2,0,2">
                <ItemsControl ItemsSource="{Binding LobbyPlayers}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Bottom" />
                            <Setter Property="Panel.ZIndex" Value="{Binding StageZIndex}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="132"
                                    Background="Transparent"
                                    RenderTransformOrigin="0.5,0.85"
                                    Margin="0,0,0,4">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="{Binding StageScale}" ScaleY="{Binding StageScale}" />
                                        <TranslateTransform X="{Binding StageOffsetX}" Y="{Binding StageOffsetY}" />
                                    </TransformGroup>
                                </Border.RenderTransform>

                                <StackPanel HorizontalAlignment="Center">
                                    <!-- 3D Персонаж (живой и вращаемый мышью, без круглой тени под ногами) -->
                                    <Grid Width="128" Height="210"
                                          Background="Transparent"
                                          Cursor="Hand"
                                          ToolTip="Потяните мышью, чтобы повернуть персонажа"
                                          behaviors:AlivePlayer3D.SourceModel="{Binding PlayerModel3D}"
                                          behaviors:AlivePlayer3D.BaseYaw="{Binding StageYawAngle}"
                                          behaviors:AlivePlayer3D.BasePitch="4"
                                          behaviors:AlivePlayer3D.PhaseSeed="{Binding Nickname}">
                                        <Viewport3D Width="128" Height="210"
                                                    ClipToBounds="False"
                                                    IsHitTestVisible="False">
                                            <Viewport3D.Camera>
                                                <PerspectiveCamera Position="0,0,27.5"
                                                                   LookDirection="0,0,-1"
                                                                   UpDirection="0,1,0"
                                                                   FieldOfView="45" />
                                            </Viewport3D.Camera>
                                            <ModelVisual3D />
                                        </Viewport3D>
                                    </Grid>

                                    <!-- Подпись под персонажем: Ник + Корона у хоста / Статус модов у друзей -->
                                    <StackPanel HorizontalAlignment="Center" Margin="0,2,0,0" MinHeight="38">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="6" Height="6"
                                                    CornerRadius="1.5"
                                                    Background="{StaticResource OkBrush}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding Nickname}"
                                                       FontFamily="{StaticResource MainFont}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding Nickname}" />
                                        </StackPanel>

                                        <!-- Корона под ником у хоста -->
                                        <Path Data="{StaticResource IconCrown}"
                                              Fill="{DynamicResource Accent}"
                                              Width="16" Height="13"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              Margin="0,4,0,0"
                                              ToolTip="Хост лобби"
                                              Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}" />

                                        <!-- Бейдж синхронизации модов под ником у друга -->
                                        <Button Command="{Binding OpenMismatchDialogCommand}"
                                                Cursor="Hand"
                                                HorizontalAlignment="Center"
                                                Margin="0,3,0,0"
                                                ToolTip="{Binding ModSyncTooltip}"
                                                Visibility="{Binding IsGuest, Converter={StaticResource BoolToVis}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding IsModSyncSynced, Converter={StaticResource BoolToVis}}">
                                                    <Path Data="{StaticResource IconCheck}"
                                                          Fill="{StaticResource MuteBrush}"
                                                          Width="10" Height="10"
                                                          Stretch="Uniform"
                                                          Margin="0,0,3,0"
                                                          VerticalAlignment="Center" />
                                                    <TextBlock Text="Моды совпадают"
                                                               FontFamily="{StaticResource MainFont}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource MuteBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding IsModSyncMismatch, Converter={StaticResource BoolToVis}}">
                                                    <Path Data="{StaticResource IconWarning}"
                                                          Fill="{DynamicResource Accent}"
                                                          Width="10" Height="10"
                                                          Stretch="Uniform"
                                                          Margin="0,0,3,0"
                                                          VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ModSyncBadgeText}"
                                                               FontFamily="{StaticResource MainFont}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Accent}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding IsModSyncUnverified, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="В лобби"
                                                               FontFamily="{StaticResource MainFont}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource MuteBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>

                                        <!-- Кнопка исключения игрока хостом -->
                                        <Button Command="{Binding KickPlayerCommand}"
                                                Cursor="Hand"
                                                HorizontalAlignment="Center"
                                                Margin="0,4,0,0"
                                                ToolTip="Исключить из лобби"
                                                FocusVisualStyle="{x:Null}"
                                                Visibility="{Binding CanKick, Converter={StaticResource BoolToVis}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{DynamicResource PanelRaised}"
                                                            BorderBrush="{DynamicResource BorderSubtle}"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="6,2">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Path Data="{StaticResource IconKick}"
                                                                  Style="{StaticResource IconPath}"
                                                                  Width="8" Height="8"
                                                                  Margin="0,0,4,0"
                                                                  Stroke="{DynamicResource Danger}" />
                                                            <TextBlock Text="Кикнуть"
                                                                       FontFamily="{StaticResource MainFont}"
                                                                       FontSize="10"
                                                                       FontWeight="Medium"
                                                                       Foreground="{DynamicResource Danger}" />
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Нижняя панель действий -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="0,4,0,0">
                <!-- Ошибка туннеля: кнопка "Отправить отчёт" -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8"
                            Visibility="{Binding ShowTunnelFailedLogButton, Converter={StaticResource BoolToVis}}">
                    <Button Command="{Binding SendReportCommand}"
                            Style="{StaticResource BadLinkBtn}"
                            Content="Отправить отчёт об ошибке туннеля"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0" />
                    <Button Command="{Binding CopyTunnelLogCommand}"
                            Style="{StaticResource StandardBtn}"
                            Height="28"
                            Padding="12,0"
                            FontSize="12"
                            Content="Копировать лог туннеля"
                            VerticalAlignment="Center" />
                </StackPanel>

                <!-- Главная кнопка действия по центру (как в CS2 / Brawl Stars) -->
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Host: "Открыть мир" -->
                    <Button Command="{Binding OpenWorldCommand}"
                            Style="{StaticResource PrimaryNeonBtn}"
                            Height="44"
                            MinWidth="220"
                            Content="Открыть мир"
                            Margin="6,0"
                            Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}" />

                    <!-- Guest: "Подключиться к игре" -->
                    <Button Command="{Binding ConnectToGameCommand}"
                            Style="{StaticResource LobbyGuestConnectBtn}"
                            Height="44"
                            MinWidth="200"
                            Content="Подключиться к игре"
                            Margin="6,0" />

                    <!-- Guest: "Переподключиться" -->
                    <Button Command="{Binding ReconnectCommand}"
                            Style="{StaticResource LobbyGuestReconnectBtn}"
                            Height="44"
                            Content="Переподключиться"
                            Margin="6,0" />
                </WrapPanel>

                <!-- Предупреждение для хоста -->
                <TextBlock Text="Не показывайте код посторонним: в этом режиме проверка лицензии отключена."
                           FontFamily="{StaticResource MainFont}"
                           FontSize="12"
                           Foreground="{StaticResource MuteBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"
                           Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>

        <!-- Mod mismatch dialog (modal overlay) -->
        <Grid Visibility="{Binding IsModMismatchDialogVisible, Converter={StaticResource BoolToVis}}"
              Background="{DynamicResource DialogBackdrop}"
              KeyboardNavigation.TabNavigation="Cycle">
            <Grid.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CancelMismatchDialogCommand}" />
            </Grid.InputBindings>

            <Border Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="3"
                    MinWidth="420"
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="28,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Title: Oswald 26 -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding ModMismatchTitle}"
                               FontFamily="{StaticResource HeadingFont}"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />

                    <!-- Summary -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding ModMismatchSummary}"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />

                    <!-- Discrepancies List in ScrollViewer (MaxHeight ~280) -->
                    <ScrollViewer Grid.Row="2"
                                  Style="{StaticResource AuraScrollViewer}"
                                  MaxHeight="280"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,0,0,12">
                        <ItemsControl ItemsSource="{Binding ModMismatchItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineInkBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding ModName}"
                                                       FontFamily="{StaticResource MainFont}"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ModName}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayDescription}"
                                                       FontFamily="{StaticResource MainFont}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource MuteBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Warning Notices -->
                    <StackPanel Grid.Row="3" Margin="0,4,0,16">
                        <TextBlock Text="Эти моды нужно обновить в сборке"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Accent}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4"
                                   Visibility="{Binding HasUnfixableMods, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="Изменения вступят в силу после перезапуска игры"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Danger}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding IsGameRunningWarning, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- Buttons Row -->
                    <WrapPanel Grid.Row="4"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center">
                        <Button Command="{Binding FixAndProceedCommand}"
                                Style="{StaticResource LobbyFixAndProceedBtn}"
                                Content="{Binding FixButtonText}"
                                Padding="16,8"
                                Margin="0,0,10,0" />

                        <Button Command="{Binding JoinAsIsCommand}"
                                Style="{StaticResource LobbyJoinAsIsBtn}"
                                Content="Войти как есть"
                                Padding="14,8"
                                Margin="0,0,10,0" />

                        <Button Command="{Binding CancelMismatchDialogCommand}"
                                Content="{Binding CancelButtonText}"
                                Style="{StaticResource StandardBtn}"
                                Padding="14,8" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
