<UserControl x:Class="AuraLauncher.Views.LobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="478" d:DesignWidth="980">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Инвертированный BooleanToVisibility -->
        <Style x:Key="InverseBoolToVisStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль кнопки «Подключиться к игре» с динамическим цветом -->
        <Style x:Key="ConnectGameBtn" TargetType="Button" BasedOn="{StaticResource PrimaryNeonBtn}">
            <Setter Property="Background" Value="#252A33" />
            <Setter Property="IsEnabled" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanGuestConnect}" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="#22C55E" />
                        </Setter.Value>
                    </Setter>
                    <Setter Property="IsEnabled" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#0F1115">
        <!-- Фоновое изображение мира с градиентом -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Фоновое изображение -->
        <Image Source="{StaticResource WorldBackgroundBitmap}" Stretch="UniformToFill" Opacity="0.15"
               VerticalAlignment="Center" HorizontalAlignment="Center" />

        <!-- Основной контент по центру -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                  Width="520" Margin="0,24,0,24">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Заголовок + статус -->
                    <RowDefinition Height="Auto" /> <!-- Начальные кнопки ИЛИ панель хоста/гостя -->
                    <RowDefinition Height="Auto" /> <!-- Кнопка «Покинуть» -->
                </Grid.RowDefinitions>

                <!-- ====== ЗАГОЛОВОК И СТАТУС ====== -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <TextBlock Text="🎮  P2P ЛОББИ" FontSize="22" FontWeight="Bold" Foreground="#E8EAED"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding StatusIcon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="#9AA3B2"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="400" />
                    </StackPanel>
                </StackPanel>

                <!-- ====== НАЧАЛЬНЫЕ КНОПКИ (когда не в лобби) ====== -->
                <StackPanel Grid.Row="1">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInLobby}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Карточка «ХОСТ» -->
                    <Border Background="#171A21" CornerRadius="12" BorderThickness="1" BorderBrush="#252A33"
                            Padding="24,20" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#132B25" Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="👑" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Я — Хост" FontSize="15" FontWeight="SemiBold" Foreground="#E8EAED" />
                                    <TextBlock Text="Создай лобби и пригласи друзей" FontSize="12" Foreground="#9AA3B2" />
                                </StackPanel>
                            </StackPanel>
                            <Button Command="{Binding CreateLobbyCommand}"
                                    Style="{StaticResource PrimaryNeonBtn}"
                                    Height="42" Content="СОЗДАТЬ ЛОББИ" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <!-- Разделитель «ИЛИ» -->
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="1" Background="#252A33" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="ИЛИ" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#525768" Margin="16,0" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Height="1" Background="#252A33" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Карточка «ГОСТЬ» -->
                    <Border Background="#171A21" CornerRadius="12" BorderThickness="1" BorderBrush="#252A33"
                            Padding="24,20" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#1A1D2B" Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="🤝" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="У меня есть код" FontSize="15" FontWeight="SemiBold" Foreground="#E8EAED" />
                                    <TextBlock Text="Введи 6-значный код от хоста" FontSize="12" Foreground="#9AA3B2" />
                                </StackPanel>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}"
                                         Text="{Binding GuestCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="18" FontWeight="SemiBold" FontFamily="Consolas, Courier New"
                                         MaxLength="6" Height="42"
                                         TextAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         CharacterCasing="Upper" />
                                <Button Grid.Column="1" Command="{Binding JoinLobbyCommand}"
                                        Style="{StaticResource StandardBtn}"
                                        Content="ВОЙТИ" Height="42" Width="100" Margin="8,0,0,0"
                                        FontSize="13" FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ====== ПАНЕЛЬ ХОСТА (когда в лобби как хост) ====== -->
                <StackPanel Grid.Row="1">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsInLobby}" Value="True" />
                                        <Condition Binding="{Binding IsHost}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border Background="#171A21" CornerRadius="12" BorderThickness="1" BorderBrush="#252A33"
                            Padding="24,24">
                        <StackPanel>
                            <!-- Статус хоста -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <!-- Индикатор статуса (точка) -->
                                <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F59E0B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWorldOpen}" Value="True">
                                                    <Setter Property="Background" Value="#22C55E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="{Binding HostStatusText}" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#F59E0B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWorldOpen}" Value="True">
                                                    <Setter Property="Foreground" Value="#22C55E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Код лобби -->
                            <TextBlock Text="Код лобби:" FontSize="12" Foreground="#9AA3B2"
                                       HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <Border Background="#0F1115" CornerRadius="10" Padding="20,12"
                                    HorizontalAlignment="Center" Margin="0,0,0,12"
                                    BorderThickness="1" BorderBrush="#252A33">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding LobbyCode}" FontSize="32" FontWeight="Bold"
                                               FontFamily="Consolas, Courier New"
                                               Foreground="#19D3A7" VerticalAlignment="Center" />
                                    <Button Command="{Binding CopyCodeCommand}"
                                            Style="{StaticResource GhostBtn}"
                                            Width="40" Height="40" Margin="12,0,0,0"
                                            VerticalAlignment="Center" Padding="0"
                                            ToolTip="Скопировать код">
                                        <TextBlock FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="📋" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CodeCopied}" Value="True">
                                                            <Setter Property="Text" Value="✅" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Инструкция для хоста -->
                            <Border Background="#132B25" CornerRadius="8" Padding="16,12" Margin="0,0,0,12"
                                    BorderThickness="1" BorderBrush="#19D3A733">
                                <StackPanel>
                                    <TextBlock Text="📌 Инструкция:" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#19D3A7" Margin="0,0,0,6" />
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#9AA3B2" LineHeight="20">
                                        <Run Text="1. Отправь код другу" /><LineBreak />
                                        <Run Text="2. Нажми «ОТКРЫТЬ МИР» (запустится Minecraft)" /><LineBreak />
                                        <Run Text="3. В игре открой мир для сети (Esc → Открыть для сети)" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Предупреждение о безопасности -->
                            <Border Background="#2A171A" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                                    BorderThickness="1" BorderBrush="#EF444455">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠️" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Не показывайте код посторонним: в этом режиме проверка лицензии отключена"
                                               FontSize="11" FontWeight="SemiBold" Foreground="#EF4444"
                                               TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="400" />
                                </StackPanel>
                            </Border>

                            <!-- Кнопка «Открыть мир» -->
                            <Button Command="{Binding OpenWorldCommand}"
                                    Height="44" FontSize="14">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryNeonBtn}">
                                        <Setter Property="Content" Value="ОТКРЫТЬ МИР" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWorldOpen}" Value="True">
                                                <Setter Property="Content" Value="✅ МИР ОТКРЫТ" />
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ====== ПАНЕЛЬ ГОСТЯ (когда в лобби как гость) ====== -->
                <StackPanel Grid.Row="1">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsGuestJoined}" Value="True" />
                                        <Condition Binding="{Binding IsHost}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border Background="#171A21" CornerRadius="12" BorderThickness="1" BorderBrush="#252A33"
                            Padding="24,24">
                        <StackPanel>
                            <!-- Статус гостя -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F59E0B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanGuestConnect}" Value="True">
                                                    <Setter Property="Background" Value="#22C55E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="{Binding GuestStatusText}" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#F59E0B" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanGuestConnect}" Value="True">
                                                    <Setter Property="Foreground" Value="#22C55E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Пульсирующий индикатор ожидания -->
                            <Border HorizontalAlignment="Center" Margin="0,0,0,20">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanGuestConnect}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="⏳" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                    <TextBlock Text="Ожидание хоста..." FontSize="13" Foreground="#9AA3B2"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Кнопка «Подключиться к игре» -->
                            <Button Command="{Binding ConnectToGameCommand}"
                                    Height="48" FontSize="14">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryNeonBtn}">
                                        <Setter Property="Content" Value="ОЖИДАНИЕ ХОСТА..." />
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="#252A33" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanGuestConnect}" Value="True">
                                                <Setter Property="Content" Value="🎮 ПОДКЛЮЧИТЬСЯ К ИГРЕ" />
                                                <Setter Property="IsEnabled" Value="True" />
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <SolidColorBrush Color="#22C55E" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ====== КНОПКА «ПОКИНУТЬ» (когда в лобби) ====== -->
                <Button Grid.Row="2" Command="{Binding LeaveLobbyCommand}"
                        Style="{StaticResource GhostBtn}"
                        Content="Покинуть лобби" Height="36" FontSize="12"
                        Foreground="#EF4444" Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Visibility="{Binding IsInLobby, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
