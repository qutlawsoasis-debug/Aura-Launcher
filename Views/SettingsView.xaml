<UserControl x:Class="AuraLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Focusable="False"
             FocusVisualStyle="{x:Null}"
             ClipToBounds="False"
             Background="Transparent">


    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="TextTabRadioButton" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{DynamicResource MainFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <TextBlock x:Name="TabTitle"
                                   Text="{TemplateBinding Content}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   Foreground="#E8F0F8"
                                   Opacity="0.62"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabTitle" Property="Opacity" Value="1.0" />
                                <Setter TargetName="TabTitle" Property="Foreground" Value="#E8F0F8" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TabTitle"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1.0"
                                                             Duration="0:0:0.150" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TabTitle"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.62"
                                                             Duration="0:0:0.150" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent" Focusable="False" FocusVisualStyle="{x:Null}" ClipToBounds="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Content with ScrollViewer -->
        </Grid.RowDefinitions>

        <!-- Header: Oswald 600 60px on top-left edge, Height=Auto, LineHeight 66, Margin сверху 6px -->
        <Grid Grid.Row="0" Margin="0,0,0,20" Focusable="False">
            <TextBlock Text="Настройки"
                       FontFamily="{StaticResource HeadingFont}"
                       FontSize="60"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}"
                       Height="Auto"
                       LineHeight="66"
                       LineStackingStrategy="BlockLineHeight"
                       Margin="0,6,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="12" Opacity="0.7" Direction="0" ShadowDepth="0" />
                </TextBlock.Effect>
            </TextBlock>

            <!-- Top-right green "Сохранено" feedback on change for 1.4s -->
            <TextBlock Text="Сохранено"
                       FontFamily="{StaticResource MainFont}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource OkBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,8,0,0"
                       Visibility="{Binding IsSavedToastVisible, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- Main Content Area with AuraScrollViewer -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource AuraScrollViewer}">
            <StackPanel Margin="0,0,8,24" Focusable="False">

                <!-- ============================================== -->
                <!-- ГРУППА 1: ИГРА                                 -->
                <!-- ============================================== -->
                <TextBlock Text="Игра"
                           FontFamily="{StaticResource HeadingFont}"
                           FontSize="22"
                           FontWeight="Medium"
                           Foreground="{StaticResource InkBrush}"
                           Margin="0,0,0,6" />
                <Border Height="1" Background="{StaticResource LineInkBrush}" Margin="0,0,0,6" />


                <!-- 1.2 "Память для игры" -->
                <Grid MinHeight="56" Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Память для игры"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource InkBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding RamGb}"
                                       FontFamily="{StaticResource HeadingFont}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource EmberBrush}" />
                            <TextBlock Text=" ГБ"
                                       FontFamily="{StaticResource HeadingFont}"
                                       FontSize="14"
                                       FontWeight="Normal"
                                       Foreground="{StaticResource DimInkBrush}"
                                       VerticalAlignment="Bottom"
                                       Margin="2,0,0,1" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Width="360">
                        <!-- Slider 2..16 GB -->
                        <Slider Minimum="2" Maximum="16"
                                SmallChange="1" LargeChange="2"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Value="{Binding RamGb, Mode=TwoWay}"
                                Style="{StaticResource SettingsRamSlider}"
                                Margin="0,0,0,6" />

                        <!-- Quick links: 4, 6, 8, 12 ГБ -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <RadioButton Content="4 ГБ" IsChecked="{Binding IsRam4, Mode=TwoWay}" Style="{StaticResource RamPillRadio}" />
                            <RadioButton Content="6 ГБ" IsChecked="{Binding IsRam6, Mode=TwoWay}" Style="{StaticResource RamPillRadio}" />
                            <RadioButton Content="8 ГБ" IsChecked="{Binding IsRam8, Mode=TwoWay}" Style="{StaticResource RamPillRadio}" />
                            <RadioButton Content="12 ГБ" IsChecked="{Binding IsRam12, Mode=TwoWay}" Style="{StaticResource RamPillRadio}" Margin="0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 1.3 "Папка игры" -->
                <Grid MinHeight="56" Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Папка игры"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="14"
                               FontWeight="Medium"
                               Foreground="{StaticResource InkBrush}"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding GameDir}"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   Foreground="{StaticResource DimInkBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="260"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0" />

                        <Button Command="{Binding SelectGameFolderCommand}"
                                Style="{StaticResource GhostBtn}"
                                Content="Изменить"
                                Foreground="{StaticResource EmberBrush}"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- ============================================== -->
                <!-- ГРУППА 2: ЛАУНЧЕР                              -->
                <!-- ============================================== -->
                <TextBlock Text="Лаунчер"
                           FontFamily="{StaticResource HeadingFont}"
                           FontSize="22"
                           FontWeight="Medium"
                           Foreground="{StaticResource InkBrush}"
                           Margin="0,16,0,6" />
                <Border Height="1" Background="{StaticResource LineInkBrush}" Margin="0,0,0,6" />

                <!-- 2.1 "Скрывать лаунчер, пока идёт игра" -->
                <Grid Height="56" Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Скрывать лаунчер, пока идёт игра"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="14"
                               FontWeight="Medium"
                               Foreground="{StaticResource InkBrush}"
                               VerticalAlignment="Center" />

                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding HideLauncherWhilePlaying, Mode=TwoWay}"
                              Style="{StaticResource AlexToggleSwitch}"
                              VerticalAlignment="Center" />
                </Grid>

                <!-- 2.2 "Музыка при запуске" -->
                <Grid Height="56" Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Музыка при запуске"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="Играет один раз при открытии лаунчера"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource MuteBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding MusicOnStartup, Mode=TwoWay}"
                              Style="{StaticResource AlexToggleSwitch}"
                              VerticalAlignment="Center" />
                </Grid>

                <!-- 2.3 "Подключаться автоматически после принятия приглашения" -->
                <Grid Height="56" Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Подключаться автоматически после принятия приглашения"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="14"
                               FontWeight="Medium"
                               Foreground="{StaticResource InkBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />

                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding AutoConnectOnInviteAccept, Mode=TwoWay}"
                              Style="{StaticResource AlexToggleSwitch}"
                              VerticalAlignment="Center" />
                </Grid>

                <!-- 2.4 "Уведомления Windows" -->
                <Grid Height="56" Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Уведомления Windows"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="14"
                               FontWeight="Medium"
                               Foreground="{StaticResource InkBrush}"
                               VerticalAlignment="Center" />

                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding WindowsNotificationsEnabled, Mode=TwoWay}"
                              Style="{StaticResource AlexToggleSwitch}"
                              VerticalAlignment="Center" />
                </Grid>

                <!-- 2.5 "Показывать статус в Discord" -->
                <Grid Height="56" Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Показывать статус в Discord"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="14"
                               FontWeight="Medium"
                               Foreground="{StaticResource InkBrush}"
                               VerticalAlignment="Center" />

                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding DiscordRpcEnabled, Mode=TwoWay}"
                              Style="{StaticResource AlexToggleSwitch}"
                              VerticalAlignment="Center" />
                </Grid>

                <!-- 2.6 "Режим запуска" -->
                <Grid Height="56" Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Режим запуска"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="14"
                               FontWeight="Medium"
                               Foreground="{StaticResource InkBrush}"
                               VerticalAlignment="Center" />

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="3" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="StartModeWindowedRadio"
                                         Content="В окне"
                                         GroupName="StartModeTextGroup"
                                         IsChecked="{Binding IsStartModeWindowed, Mode=TwoWay}"
                                         Checked="OnStartModeChecked"
                                         Style="{StaticResource TextTabRadioButton}"
                                         Margin="0,0,28,0" />
                            <RadioButton x:Name="StartModeMaximizedRadio"
                                         Content="На весь экран"
                                         GroupName="StartModeTextGroup"
                                         IsChecked="{Binding IsStartModeMaximized, Mode=TwoWay}"
                                         Checked="OnStartModeChecked"
                                         Style="{StaticResource TextTabRadioButton}" />
                        </StackPanel>

                        <!-- Accent-подчёркивание 3 px (радиус 3, на 6 px ниже текста) -->
                        <Border x:Name="StartModeUnderline"
                                Grid.Row="2"
                                HorizontalAlignment="Left"
                                Height="3"
                                CornerRadius="3"
                                Background="{DynamicResource Accent}"
                                RenderTransformOrigin="0,0">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="StartModeUnderlineScale" ScaleX="1" />
                                    <TranslateTransform x:Name="StartModeUnderlineTrans" X="0" />
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 2.7 "Автосмена фона" -->
                <Grid Height="56" Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Автосмена фона (каждые 60 сек)"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource InkBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Коллекция из 15 арт-пейзажей Minecraft с плавным кроссфейдом"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource MuteBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding NextBackgroundCommand}"
                                Content="Сменить фон"
                                Style="{StaticResource StandardBtn}"
                                Height="30" Padding="12,0" FontSize="12"
                                Margin="0,0,12,0" />
                        <CheckBox IsChecked="{Binding AutoRotateBackgrounds, Mode=TwoWay}"
                                  Style="{StaticResource AlexToggleSwitch}"
                                  VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- ============================================== -->
                <!-- ГРУППА 3: ПОДДЕРЖКА                            -->
                <!-- ============================================== -->
                <TextBlock Text="Поддержка"
                           FontFamily="{StaticResource HeadingFont}"
                           FontSize="22"
                           FontWeight="Medium"
                           Foreground="{StaticResource InkBrush}"
                           Margin="0,16,0,6" />
                <Border Height="1" Background="{StaticResource LineInkBrush}" Margin="0,0,0,12" />

                <!-- 3.1 "Отправить отчёт" и "Сохранить на рабочий стол" -->
                <Grid Margin="0,4,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Диагностические данные и логи"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource InkBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Логи лаунчера, игры и системная информация"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource MuteBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding OpenSendReportCommand}"
                                Style="{StaticResource PrimaryNeonBtn}"
                                Height="40"
                                Padding="18,0"
                                FontSize="13"
                                Content="Отправить отчёт"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center" />

                        <Button Command="{Binding GenerateReportCommand}"
                                Style="{StaticResource StandardBtn}"
                                Height="40"
                                Padding="16,0"
                                FontSize="13"
                                Content="Сохранить на рабочий стол"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
