<UserControl x:Class="AuraLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="512" d:DesignWidth="584"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Header: Oswald 600 60px on top-left edge, 15px dim subtitle, top-right "Сохранено" -->
        <Grid Grid.Row="0" Margin="0,0,0,28">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Настройки"
                           FontFamily="{StaticResource HeadingFont}"
                           FontSize="60"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}"
                           LineHeight="54"
                           LineStackingStrategy="BlockLineHeight"
                           Margin="-2,-6,0,6">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="12" Opacity="0.7" Direction="270" ShadowDepth="2" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="Параметры запуска и игровые настройки"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="15"
                           FontWeight="Normal"
                           Foreground="{StaticResource DimInkBrush}" />
            </StackPanel>

            <!-- Top-right green "Сохранено" feedback on change for 1.4s -->
            <TextBlock Text="Сохранено"
                       FontFamily="{StaticResource MainFont}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource OkBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,8,0,0"
                       Visibility="{Binding IsSavedToastVisible, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- Main Content: Three rows with 14px dim label on left (150px col), content on right, 1px lines between -->
        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            
            <!-- ROW 1: "Ник в игре" -->
            <!-- borderless box with 2px bottom line (focus ember, error bad), 20px text, error note -->
            <Grid MinHeight="70" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Ник в игре"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="14"
                           FontWeight="Normal"
                           Foreground="{StaticResource DimInkBrush}"
                           VerticalAlignment="Top"
                           Margin="0,6,0,0" />

                <StackPanel Grid.Column="1" VerticalAlignment="Top" MaxWidth="360" HorizontalAlignment="Left">
                    <!-- Borderless box with 2px bottom line -->
                    <Border x:Name="NickBorder"
                            BorderBrush="{StaticResource LineInkBrush}"
                            BorderThickness="0,0,0,2"
                            Background="Transparent"
                            Padding="0,0,0,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource LineInkBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNicknameError}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource BadBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBox x:Name="NickInputBox"
                                 Text="{Binding Nickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource MainFont}"
                                 FontSize="20"
                                 FontWeight="Medium"
                                 Foreground="{StaticResource InkBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="{StaticResource EmberBrush}"
                                 MaxLength="16"
                                 KeyDown="OnTextBoxKeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <!-- Parent border highlight handled via focus trigger -->
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Border>

                    <!-- Error note in bad color -->
                    <TextBlock Text="{Binding NicknameErrorText}"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="12"
                               Foreground="{StaticResource BadBrush}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasNicknameError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>

            <!-- 1px line separator -->
            <Border Height="1" Background="{StaticResource LineInkBrush}" Margin="0,0,0,20" />

            <!-- ROW 2: "Память для игры" -->
            <!-- Oswald 600 52px with "ГБ" 20px, slider 2..16 GB (track 6px, ember, thumb 14x22 radius 3), quick links 4, 6, 8, 12 ГБ -->
            <Grid MinHeight="110" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Память для игры"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="14"
                           FontWeight="Normal"
                           Foreground="{StaticResource DimInkBrush}"
                           VerticalAlignment="Top"
                           Margin="0,8,0,0" />

                <StackPanel Grid.Column="1" VerticalAlignment="Top" MaxWidth="380" HorizontalAlignment="Left">
                    <!-- Memory display: Oswald 600 52px + "ГБ" 20px -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                        <TextBlock Text="{Binding RamGb}"
                                   FontFamily="{StaticResource HeadingFont}"
                                   FontSize="52"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}"
                                   LineHeight="48"
                                   LineStackingStrategy="BlockLineHeight" />
                        <TextBlock Text=" ГБ"
                                   FontFamily="{StaticResource HeadingFont}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource DimInkBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="2,0,0,6" />
                    </StackPanel>

                    <!-- Slider 2..16 GB (track 6px ember, thumb 14x22 radius 3) -->
                    <Slider Minimum="2" Maximum="16"
                            SmallChange="1" LargeChange="2"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding RamGb, Mode=TwoWay}"
                            Style="{StaticResource SettingsRamSlider}"
                            Margin="0,0,0,14" />

                    <!-- Quick links: 4 ГБ, 6 ГБ, 8 ГБ, 12 ГБ -->
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="4 ГБ" IsChecked="{Binding IsRam4, Mode=TwoWay}" Style="{StaticResource RamPillRadio}" />
                        <RadioButton Content="6 ГБ" IsChecked="{Binding IsRam6, Mode=TwoWay}" Style="{StaticResource RamPillRadio}" />
                        <RadioButton Content="8 ГБ" IsChecked="{Binding IsRam8, Mode=TwoWay}" Style="{StaticResource RamPillRadio}" />
                        <RadioButton Content="12 ГБ" IsChecked="{Binding IsRam12, Mode=TwoWay}" Style="{StaticResource RamPillRadio}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 1px line separator -->
            <Border Height="1" Background="{StaticResource LineInkBrush}" Margin="0,0,0,20" />

            <!-- ROW 3: "Папка игры" -->
            <!-- path and "Изменить" link -->
            <Grid MinHeight="50" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Папка игры"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="14"
                           FontWeight="Normal"
                           Foreground="{StaticResource DimInkBrush}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GameDir}"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="14"
                               FontWeight="Normal"
                               Foreground="{StaticResource InkBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="300"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />

                    <!-- "Изменить" link -->
                    <Button Command="{Binding SelectGameFolderCommand}"
                            Style="{StaticResource GhostBtn}"
                            Content="Изменить"
                            Foreground="{StaticResource EmberBrush}"
                            VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
