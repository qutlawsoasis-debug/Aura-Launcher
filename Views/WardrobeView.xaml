<UserControl x:Class="AuraLauncher.Views.WardrobeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="512" d:DesignWidth="584"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Header: Oswald 600 60px on top-left edge, 15px dim subtitle -->
        <StackPanel Grid.Row="0" Margin="0,0,0,28">
            <TextBlock Text="Скин"
                       FontFamily="{StaticResource HeadingFont}"
                       FontSize="60"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}"
                       LineHeight="54"
                       LineStackingStrategy="BlockLineHeight"
                       Margin="-2,-6,0,6">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="12" Opacity="0.7" Direction="270" ShadowDepth="2" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="Внешний вид персонажа в сетевой игре"
                       FontFamily="{StaticResource MainFont}"
                       FontSize="15"
                       FontWeight="Normal"
                       Foreground="{StaticResource DimInkBrush}" />
        </StackPanel>

        <!-- Main Content: Left figure 144x288, Right controls -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="384" />
            </Grid.ColumnDefinitions>

            <!-- ============================================== -->
            <!-- LEFT: 144x288 figure (front/back with drag     -->
            <!-- rotation), soft oval shadow, caption           -->
            <!-- ============================================== -->
            <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid x:Name="SkinDragArea"
                      Width="144" Height="300"
                      Background="Transparent"
                      Cursor="Hand"
                      MouseDown="Skin_MouseDown"
                      MouseMove="Skin_MouseMove"
                      MouseUp="Skin_MouseUp">
                    
                    <!-- Soft oval shadow under feet -->
                    <Ellipse Width="110" Height="10"
                             Fill="#40000000"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Bottom"
                             Margin="0,0,0,8" />

                    <!-- Rotating Figure Container with ScaleX RenderTransform -->
                    <Grid Width="144" Height="288"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="FigureScale" ScaleX="1.0" />
                        </Grid.RenderTransform>

                        <!-- Front View -->
                        <Image x:Name="ImgFront"
                               Source="{Binding SkinFrontPreview}"
                               Width="144" Height="288"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               RenderOptions.EdgeMode="Aliased"
                               Stretch="Fill" />

                        <!-- Back View (shown when rotated past 90 degrees) -->
                        <Image x:Name="ImgBack"
                               Source="{Binding SkinBackPreview}"
                               Width="144" Height="288"
                               Opacity="0"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               RenderOptions.EdgeMode="Aliased"
                               Stretch="Fill" />
                    </Grid>
                </Grid>

                <!-- Label "Потяните, чтобы повернуть" 12px mute -->
                <TextBlock Text="Потяните, чтобы повернуть"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="12"
                           FontWeight="Normal"
                           Foreground="{StaticResource MuteBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>

            <!-- ============================================== -->
            <!-- RIGHT: filename, "Выбрать файл", "Сбросить",   -->
            <!-- toggle "Тонкие руки (Alex)", notes, error      -->
            <!-- ============================================== -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="20,0,0,0">
                
                <!-- Filename 14px dim -->
                <TextBlock Text="{Binding SkinDisplayName}"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="{StaticResource DimInkBrush}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,16" />

                <!-- Buttons: "Выбрать файл" (StandardBtn) + "Сбросить" (GhostBtn) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,24">
                    <Button Command="{Binding SelectSkinCommand}"
                            Style="{StaticResource StandardBtn}"
                            Height="48"
                            Content="Выбрать файл"
                            Margin="0,0,16,0" />

                    <Button Command="{Binding ResetSkinCommand}"
                            Style="{StaticResource GhostBtn}"
                            Height="48"
                            Content="Сбросить"
                            VerticalAlignment="Center" />
                </StackPanel>

                <!-- 1px separator line -->
                <Border Height="1" Background="{StaticResource LineInkBrush}" Margin="0,0,0,20" />

                <!-- Toggle "Тонкие руки (Alex)" (46x26, radius 3, knob 20x20, ember when checked) -->
                <CheckBox IsChecked="{Binding IsSlimModel, Mode=TwoWay}"
                          Style="{StaticResource AlexToggleSwitch}"
                          Margin="0,0,0,20">
                    <TextBlock Text="Тонкие руки (Alex)"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="14"
                               FontWeight="Medium"
                               Foreground="{StaticResource InkBrush}" />
                </CheckBox>

                <!-- Note 13px mute: "PNG 64×64 или 64×32. Остальные игроки в лобби увидят этот скин." -->
                <TextBlock Text="PNG 64×64 или 64×32. Остальные игроки в лобби увидят этот скин."
                           FontFamily="{StaticResource MainFont}"
                           FontSize="13"
                           FontWeight="Normal"
                           Foreground="{StaticResource MuteBrush}"
                           TextWrapping="Wrap"
                           LineHeight="18"
                           Margin="0,0,0,14" />

                <!-- Error message in bad color if invalid size -->
                <TextBlock Text="{Binding StatusMessage}"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{StaticResource BadBrush}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
