<UserControl x:Class="AuraLauncher.Views.WardrobeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Focusable="False"
             FocusVisualStyle="{x:Null}"
             ClipToBounds="False"
             Background="Transparent">

    <UserControl.CacheMode>
        <BitmapCache EnableClearType="False" RenderAtScale="1" SnapsToDevicePixels="True" />
    </UserControl.CacheMode>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="Transparent" Focusable="False" FocusVisualStyle="{x:Null}" ClipToBounds="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Header: Oswald 600 60px on top-left edge, 15px dim subtitle (Height=Auto, LineHeight 66, Margin сверху 6px) -->
        <StackPanel Grid.Row="0" Margin="0,0,0,28" Focusable="False">
            <TextBlock Text="Скин"
                       FontFamily="{StaticResource HeadingFont}"
                       FontSize="60"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}"
                       Height="Auto"
                       LineHeight="66"
                       LineStackingStrategy="BlockLineHeight"
                       Margin="0,6,0,6">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="12" Opacity="0.7" Direction="0" ShadowDepth="0" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="Внешний вид персонажа в сетевой игре"
                       FontFamily="{StaticResource MainFont}"
                       FontSize="15"
                       FontWeight="Normal"
                       Foreground="{StaticResource DimInkBrush}" />
        </StackPanel>

        <!-- Main Content: Left figure 144x288, Right controls -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="384" />
            </Grid.ColumnDefinitions>

            <!-- ============================================== -->
            <!-- LEFT: 170x290 3D Viewport figure, soft oval    -->
            <!-- shadow, caption                                -->
            <!-- ============================================== -->
            <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid x:Name="SkinDragArea"
                      Width="170" Height="290"
                      Background="Transparent"
                      Cursor="Hand"
                      MouseDown="Skin_MouseDown"
                      MouseMove="Skin_MouseMove"
                      MouseUp="Skin_MouseUp">

                    <!-- Soft oval shadow under feet -->
                    <Ellipse Width="96" Height="8"
                             Fill="#40000000"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Bottom"
                             Margin="0,0,0,14" />

                    <!-- 3D Viewport for Player Model -->
                    <Viewport3D x:Name="SkinViewport"
                                Width="170" Height="290"
                                ClipToBounds="False">
                        <Viewport3D.Camera>
                            <PerspectiveCamera Position="0,0,27"
                                               LookDirection="0,0,-1"
                                               UpDirection="0,1,0"
                                               FieldOfView="45" />
                        </Viewport3D.Camera>
                        <ModelVisual3D x:Name="PlayerModelVisual" />
                    </Viewport3D>
                </Grid>

                <!-- Label "Потяните, чтобы повернуть" 12px mute -->
                <TextBlock Text="Потяните, чтобы повернуть"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="12"
                           FontWeight="Normal"
                           Foreground="{StaticResource MuteBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>

            <!-- ============================================== -->
            <!-- RIGHT: filename, "Выбрать файл", "Сбросить",   -->
            <!-- toggle "Тонкие руки (Alex)", notes, error      -->
            <!-- ============================================== -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="20,0,0,0">
                
                <!-- Filename 14px dim -->
                <TextBlock Text="{Binding SkinDisplayName}"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="{StaticResource DimInkBrush}"
                           TextWrapping="Wrap"
                           MaxWidth="360"
                           Margin="0,0,0,16" />

                <!-- Buttons: "Выбрать файл" (StandardBtn) + "Сбросить" (GhostBtn) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,24">
                    <Button Command="{Binding SelectSkinCommand}"
                            Style="{StaticResource StandardBtn}"
                            Height="48"
                            Content="Выбрать файл"
                            Margin="0,0,16,0" />

                    <Button Command="{Binding ResetSkinCommand}"
                            Style="{StaticResource GhostBtn}"
                            Height="48"
                            Content="Сбросить"
                            VerticalAlignment="Center" />
                </StackPanel>

                <!-- 1px separator line -->
                <Border Height="1" Background="{StaticResource LineInkBrush}" Margin="0,0,0,20" />

                <!-- Toggle "Тонкие руки (Alex)" (46x26, radius 3, knob 20x20, ember when checked) -->
                <CheckBox IsChecked="{Binding IsSlimModel, Mode=TwoWay}"
                          Style="{StaticResource AlexToggleSwitch}"
                          Margin="0,0,0,20">
                    <TextBlock Text="Тонкие руки (Alex)"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="14"
                               FontWeight="Medium"
                               Foreground="{StaticResource InkBrush}" />
                </CheckBox>

                <!-- Note 13px mute: "PNG 64×64 или 64×32. Остальные игроки в лобби увидят этот скин." -->
                <TextBlock Text="PNG 64×64 или 64×32. Остальные игроки в лобби увидят этот скин."
                           FontFamily="{StaticResource MainFont}"
                           FontSize="13"
                           FontWeight="Normal"
                           Foreground="{StaticResource MuteBrush}"
                           TextWrapping="Wrap"
                           LineHeight="18"
                           Margin="0,0,0,14" />

                <!-- Status message in OkBrush (#5FD39A) for success or BadBrush (#FF8A7A) for error, 13px -->
                <TextBlock Text="{Binding StatusMessage}"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{Binding StatusBrush}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
