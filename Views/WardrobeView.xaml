<UserControl x:Class="AuraLauncher.Views.WardrobeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Focusable="False"
             FocusVisualStyle="{x:Null}"
             ClipToBounds="False"
             Background="Transparent">


    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="Transparent" Focusable="False" FocusVisualStyle="{x:Null}" ClipToBounds="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Header: Oswald 600 60px on top-left edge, 15px dim subtitle (Height=Auto, LineHeight 66, Margin сверху 6px) -->
        <StackPanel Grid.Row="0" Margin="0,0,0,28" Focusable="False">
            <TextBlock Text="Профиль"
                       FontFamily="{StaticResource HeadingFont}"
                       FontSize="60"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}"
                       Height="Auto"
                       LineHeight="66"
                       LineStackingStrategy="BlockLineHeight"
                       Margin="0,6,0,6">
                <TextBlock.Effect>
                    <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="12" Opacity="0.7" Direction="0" ShadowDepth="0" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="Управление профилем и внешним видом персонажа"
                       FontFamily="{StaticResource MainFont}"
                       FontSize="15"
                       FontWeight="Normal"
                       Foreground="{StaticResource DimInkBrush}" />
        </StackPanel>

        <!-- Main Content: Left figure 144x288, Right controls -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="384" />
            </Grid.ColumnDefinitions>

            <!-- Left: 170x290 3D Viewport figure (живой и вращаемый мышью, без круглой тени) -->
            <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid x:Name="SkinDragArea"
                      Width="170" Height="290"
                      Background="Transparent"
                      Cursor="Hand">

                    <!-- 3D Viewport for Player Model -->
                    <Viewport3D x:Name="SkinViewport"
                                Width="170" Height="290"
                                ClipToBounds="False"
                                IsHitTestVisible="False">
                        <Viewport3D.Camera>
                            <PerspectiveCamera Position="0,0,27"
                                               LookDirection="0,0,-1"
                                               UpDirection="0,1,0"
                                               FieldOfView="45" />
                        </Viewport3D.Camera>
                        <ModelVisual3D x:Name="PlayerModelVisual" />
                    </Viewport3D>
                </Grid>

                <!-- Label "Потяните, чтобы повернуть" 12px mute -->
                <TextBlock Text="Потяните, чтобы повернуть"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="12"
                           FontWeight="Normal"
                           Foreground="{StaticResource MuteBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>

            <!-- Right: Nickname, Profile ID, Skin controls -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="20,0,0,0">

                <!-- 1. Ник в игре -->
                <TextBlock Text="Ник в игре"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="{StaticResource InkBrush}"
                           Margin="0,0,0,4" />

                <Border BorderBrush="{StaticResource LineInkBrush}"
                        BorderThickness="0,0,0,2"
                        Background="Transparent"
                        MaxWidth="360"
                        HorizontalAlignment="Left"
                        Width="360"
                        Padding="0,0,0,4"
                        Margin="0,0,0,4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource LineInkBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFocused, ElementName=NickInputBox}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource EmberBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasNicknameError}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource BadBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBox x:Name="NickInputBox"
                             Text="{Binding NicknameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource MainFont}"
                             FontSize="16"
                             FontWeight="Medium"
                             Foreground="{StaticResource InkBrush}"
                             Background="Transparent"
                             BorderThickness="0"
                             CaretBrush="{StaticResource EmberBrush}"
                             MaxLength="16"
                             KeyDown="OnNickInputKeyDown"
                             LostFocus="OnNickInputLostFocus" />
                </Border>

                <!-- Ошибка валидации ника -->
                <TextBlock Text="{Binding NicknameErrorText}"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="12"
                           Foreground="{StaticResource BadBrush}"
                           Margin="0,0,0,12"
                           TextWrapping="Wrap"
                           MaxWidth="360"
                           Visibility="{Binding HasNicknameError, Converter={StaticResource BoolToVis}}" />

                <!-- 2. ID профиля (Код друга, 8 символов + кнопка Копировать) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,18">
                    <TextBlock Text="ID профиля:"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="14"
                               FontWeight="Normal"
                               Foreground="{StaticResource DimInkBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />

                    <TextBlock Text="{Binding ProfileId}"
                               FontFamily="{StaticResource HeadingFont}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource EmberBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <Button Command="{Binding CopyProfileIdCommand}"
                            Style="{StaticResource GhostBtn}"
                            Height="32"
                            Width="130"
                            VerticalAlignment="Center">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Копировать" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="1.0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProfileIdCopied}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.15" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.15" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Скопировано!" Foreground="{StaticResource OkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="0.0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProfileIdCopied}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.15" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.15" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- 1px separator line -->
                <Border Height="1" Background="{StaticResource LineInkBrush}" Margin="0,0,0,16" />

                <!-- Filename 13px dim -->
                <TextBlock Text="{Binding SkinDisplayName}"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{StaticResource DimInkBrush}"
                           TextWrapping="Wrap"
                           MaxWidth="360"
                           Margin="0,0,0,12" />

                <!-- Buttons: "Выбрать файл" (StandardBtn) + "Сбросить" (GhostBtn) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,20">
                    <Button Command="{Binding SelectSkinCommand}"
                            Style="{StaticResource StandardBtn}"
                            Height="44"
                            Content="Выбрать файл"
                            Margin="0,0,14,0" />

                    <Button Command="{Binding ResetSkinCommand}"
                            Style="{StaticResource GhostBtn}"
                            Height="44"
                            Content="Сбросить"
                            VerticalAlignment="Center" />
                </StackPanel>

                <!-- Toggle "Тонкие руки (Alex)" -->
                <CheckBox IsChecked="{Binding IsSlimModel, Mode=TwoWay}"
                          Style="{StaticResource AlexToggleSwitch}"
                          Margin="0,0,0,16">
                    <TextBlock Text="Тонкие руки (Alex)"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="14"
                               FontWeight="Medium"
                               Foreground="{StaticResource InkBrush}" />
                </CheckBox>

                <!-- Note 13px mute: "PNG 64×64 или 64×32. Остальные игроки в лобби увидят этот скин." -->
                <TextBlock Text="PNG 64×64 или 64×32. Остальные игроки в лобби увидят этот скин."
                           FontFamily="{StaticResource MainFont}"
                           FontSize="13"
                           FontWeight="Normal"
                           Foreground="{StaticResource MuteBrush}"
                           TextWrapping="Wrap"
                           LineHeight="18"
                           Margin="0,0,0,12" />

                <!-- Status message in OkBrush for success or BadBrush for error, 13px -->
                <TextBlock Text="{Binding StatusMessage}"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{Binding StatusBrush}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
