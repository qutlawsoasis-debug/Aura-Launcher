<UserControl x:Class="AuraLauncher.Views.WardrobeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="478" d:DesignWidth="980"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="Transparent">
        <!-- Блок превью + блок управления в CardPanel -->
        <Border Style="{StaticResource CardPanel}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,28" Margin="0,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                
                <!-- 1. Блок 2D-превью (вид спереди и сзади рядом, масштаб 10x, NearestNeighbor) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Вид спереди (10x: 160x320) -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,28,0">
                        <Grid Width="160" Height="330">
                            <!-- Тень под ногами -->
                            <Ellipse Width="110" Height="8" Fill="#101318"
                                     HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" />

                            <!-- Превью спереди -->
                            <Image Source="{Binding SkinFrontPreview}"
                                   Width="160" Height="320"
                                   VerticalAlignment="Top"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   RenderOptions.EdgeMode="Aliased"
                                   Stretch="Fill" />
                        </Grid>
                        <TextBlock Text="Спереди" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Вид сзади (10x: 160x320) -->
                    <StackPanel HorizontalAlignment="Center">
                        <Grid Width="160" Height="330">
                            <!-- Тень под ногами -->
                            <Ellipse Width="110" Height="8" Fill="#101318"
                                     HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" />

                            <!-- Превью сзади -->
                            <Image Source="{Binding SkinBackPreview}"
                                   Width="160" Height="320"
                                   VerticalAlignment="Top"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   RenderOptions.EdgeMode="Aliased"
                                   Stretch="Fill" />
                        </Grid>
                        <TextBlock Text="Сзади" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 2. Блок управления -->
                <StackPanel Margin="56,0,0,0" VerticalAlignment="Center" MaxWidth="320">
                    <!-- Заголовок -->
                    <TextBlock Text="Скин персонажа" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />

                    <!-- Исходное имя файла или 'Стандартный' -->
                    <TextBlock Text="{Binding SkinDisplayName}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,24" TextTrimming="CharacterEllipsis" />

                    <!-- Кнопки: 'Выбрать файл…' и 'Сбросить' -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                        <Button Command="{Binding SelectSkinCommand}"
                                Style="{StaticResource StandardBtn}"
                                Content="Выбрать файл…"
                                Height="38" Padding="18,0" Margin="0,0,12,0" />

                        <Button Command="{Binding ResetSkinCommand}"
                                Style="{StaticResource GhostBtn}"
                                Content="Сбросить"
                                Height="38" Padding="14,0" />
                    </StackPanel>

                    <TextBlock Text="Поддерживаются файлы PNG 64×64 и 64×32" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16" />

                    <!-- Переключатель модели: Тонкие руки (slim) -->
                    <CheckBox Content="Тонкие руки (Alex / Slim)"
                              IsChecked="{Binding IsSlimModel, Mode=TwoWay}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              FontSize="13"
                              Margin="0,0,0,16" />

                    <!-- Сообщение об ошибке или успехе -->
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{Binding StatusBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
