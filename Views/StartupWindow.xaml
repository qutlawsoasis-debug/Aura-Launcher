<Window x:Class="AuraLauncher.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:AuraLauncher.Core"
        Title="Aura"
        Width="340" Height="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/Resources/aura-icon.ico"
        FontFamily="{DynamicResource MainFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <core:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Плавная пульсация индикатора статуса -->
                    <DoubleAnimation Storyboard.TargetName="StatusDot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="1.0" To="0.35"
                                     Duration="0:0:0.8"
                                     AutoReverse="True"
                                     RepeatBehavior="Forever" />

                    <!-- Бегущая Accent-полоска 2px внизу окна (когда нет явного прогресс-бара) -->
                    <DoubleAnimation Storyboard.TargetName="ActivityBar"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="-80" To="340"
                                     Duration="0:0:2.0"
                                     RepeatBehavior="Forever" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- Внешняя рамка: 340x400, BgBase, BorderSubtle 1px, CornerRadius 3 -->
    <Border Background="{DynamicResource BgBase}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="1"
            CornerRadius="3"
            ClipToBounds="True">
        <Grid ClipToBounds="True">

            <!-- Слой 0: атмосферный арт лаунчера с тёмным градиентным переходом в BgBase -->
            <Image Source="{StaticResource WorldBackgroundBitmap}"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Height="280"
                   Opacity="0.45"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <Border IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{DynamicResource ColorShadeOverlay}" Offset="0.0" />
                        <GradientStop Color="{DynamicResource ColorDialogBackdrop}" Offset="0.36" />
                        <GradientStop Color="{DynamicResource ColorBgBase}" Offset="0.68" />
                        <GradientStop Color="{DynamicResource ColorBgBase}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Слой 1: типографика и блок статуса -->
            <Grid>
                <!-- 1. Логотип Aura и строгая акцентная риска -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,78,0,0">
                    <TextBlock Text="Aura"
                               FontFamily="{DynamicResource HeadingFont}"
                               FontWeight="SemiBold"
                               FontSize="86"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               LineHeight="82"
                               LineStackingStrategy="BlockLineHeight" />
                    <Border Width="28" Height="2"
                            CornerRadius="1"
                            Background="{DynamicResource Accent}"
                            HorizontalAlignment="Center"
                            Margin="0,14,0,0" />
                </StackPanel>

                <!-- 2. Нижний блок: карточка статуса/загрузки + версия -->
                <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,18">
                    <Border Background="{DynamicResource Panel}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="16,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Статус + анимированные точки -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="StatusDot"
                                            Width="8" Height="8"
                                            CornerRadius="2"
                                            Background="{DynamicResource Accent}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding StatusText}"
                                               FontFamily="{DynamicResource MainFont}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{Binding StatusForeground}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DotsText}"
                                               FontFamily="{DynamicResource MainFont}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{Binding StatusForeground}"
                                               MinWidth="16"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Процент скачивания справа -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ProgressPercentText}"
                                           FontFamily="{DynamicResource HeadingFont}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <!-- Полоса прогресса скачивания обновления -->
                            <Grid x:Name="ProgressTrack"
                                  Height="3"
                                  Margin="0,10,0,0"
                                  Background="{DynamicResource TrackSubtle}"
                                  Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}">
                                <Border x:Name="ProgressBarFill"
                                        HorizontalAlignment="Left"
                                        Height="3"
                                        CornerRadius="1.5"
                                        Background="{DynamicResource Accent}"
                                        Width="0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Версия лаунчера -->
                    <TextBlock Text="{Binding VersionText}"
                               FontFamily="{DynamicResource MainFont}"
                               FontSize="11"
                               Foreground="{DynamicResource StoriesTextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                </StackPanel>

                <!-- 3. Бегущая полоса активности 2px по нижнему краю (скрывается при показе прогресс-бара) -->
                <Grid VerticalAlignment="Bottom"
                      Height="2"
                      ClipToBounds="True"
                      Background="Transparent"
                      Visibility="{Binding IsProgressVisible, Converter={StaticResource InverseBoolToVis}}">
                    <Rectangle x:Name="ActivityBar"
                               Width="80" Height="2"
                               Fill="{DynamicResource Accent}"
                               HorizontalAlignment="Left">
                        <Rectangle.RenderTransform>
                            <TranslateTransform X="-80" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
