<Window x:Class="AuraLauncher.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aura"
        Width="340" Height="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/Resources/aura-icon.ico"
        FontFamily="{DynamicResource MainFont}"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- 1. Дальний слой гор (44s, влево от 0 до -340) -->
                    <DoubleAnimation Storyboard.TargetName="DistantMountainCanvas"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="0" To="-340"
                                     Duration="0:0:44"
                                     RepeatBehavior="Forever" />

                    <!-- 2. Средний слой гор (28s, влево от 0 до -340) -->
                    <DoubleAnimation Storyboard.TargetName="MiddleMountainCanvas"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="0" To="-340"
                                     Duration="0:0:28"
                                     RepeatBehavior="Forever" />

                    <!-- 3. Ближний слой гор (17s, влево от 0 до -340) -->
                    <DoubleAnimation Storyboard.TargetName="NearMountainCanvas"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="0" To="-340"
                                     Duration="0:0:17"
                                     RepeatBehavior="Forever" />

                    <!-- 4. Мерцание 6 звёзд (3s цикл, задержки BeginTime) -->
                    <DoubleAnimation Storyboard.TargetName="Star1" Storyboard.TargetProperty="Opacity"
                                     From="0" To="0.9" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:0.0" />
                    <DoubleAnimation Storyboard.TargetName="Star2" Storyboard.TargetProperty="Opacity"
                                     From="0" To="0.9" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:0.5" />
                    <DoubleAnimation Storyboard.TargetName="Star3" Storyboard.TargetProperty="Opacity"
                                     From="0" To="0.9" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:1.0" />
                    <DoubleAnimation Storyboard.TargetName="Star4" Storyboard.TargetProperty="Opacity"
                                     From="0" To="0.9" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:1.5" />
                    <DoubleAnimation Storyboard.TargetName="Star5" Storyboard.TargetProperty="Opacity"
                                     From="0" To="0.9" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:2.0" />
                    <DoubleAnimation Storyboard.TargetName="Star6" Storyboard.TargetProperty="Opacity"
                                     From="0" To="0.9" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever" BeginTime="0:0:2.5" />

                    <!-- 5. Подъём и затухание 6 светлячков (6s) -->
                    <DoubleAnimation Storyboard.TargetName="Firefly1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="0" To="-110" Duration="0:0:6" RepeatBehavior="Forever" BeginTime="0:0:0.0" />
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Firefly1" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:0.0">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.0" />
                        <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.85" />
                        <LinearDoubleKeyFrame KeyTime="0:0:4.5" Value="0.85" />
                        <LinearDoubleKeyFrame KeyTime="0:0:6.0" Value="0.0" />
                    </DoubleAnimationUsingKeyFrames>

                    <DoubleAnimation Storyboard.TargetName="Firefly2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="0" To="-110" Duration="0:0:6" RepeatBehavior="Forever" BeginTime="0:0:1.0" />
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Firefly2" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:1.0">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.0" />
                        <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.85" />
                        <LinearDoubleKeyFrame KeyTime="0:0:4.5" Value="0.85" />
                        <LinearDoubleKeyFrame KeyTime="0:0:6.0" Value="0.0" />
                    </DoubleAnimationUsingKeyFrames>

                    <DoubleAnimation Storyboard.TargetName="Firefly3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="0" To="-110" Duration="0:0:6" RepeatBehavior="Forever" BeginTime="0:0:2.0" />
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Firefly3" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:2.0">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.0" />
                        <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.85" />
                        <LinearDoubleKeyFrame KeyTime="0:0:4.5" Value="0.85" />
                        <LinearDoubleKeyFrame KeyTime="0:0:6.0" Value="0.0" />
                    </DoubleAnimationUsingKeyFrames>

                    <DoubleAnimation Storyboard.TargetName="Firefly4" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="0" To="-110" Duration="0:0:6" RepeatBehavior="Forever" BeginTime="0:0:3.0" />
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Firefly4" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:3.0">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.0" />
                        <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.85" />
                        <LinearDoubleKeyFrame KeyTime="0:0:4.5" Value="0.85" />
                        <LinearDoubleKeyFrame KeyTime="0:0:6.0" Value="0.0" />
                    </DoubleAnimationUsingKeyFrames>

                    <DoubleAnimation Storyboard.TargetName="Firefly5" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="0" To="-110" Duration="0:0:6" RepeatBehavior="Forever" BeginTime="0:0:4.0" />
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Firefly5" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:4.0">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.0" />
                        <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.85" />
                        <LinearDoubleKeyFrame KeyTime="0:0:4.5" Value="0.85" />
                        <LinearDoubleKeyFrame KeyTime="0:0:6.0" Value="0.0" />
                    </DoubleAnimationUsingKeyFrames>

                    <DoubleAnimation Storyboard.TargetName="Firefly6" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="0" To="-110" Duration="0:0:6" RepeatBehavior="Forever" BeginTime="0:0:5.0" />
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Firefly6" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:5.0">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.0" />
                        <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.85" />
                        <LinearDoubleKeyFrame KeyTime="0:0:4.5" Value="0.85" />
                        <LinearDoubleKeyFrame KeyTime="0:0:6.0" Value="0.0" />
                    </DoubleAnimationUsingKeyFrames>

                    <!-- 6. Вращающийся кубик 14x14 под Aura (90° за 1.2s, EaseInOut, бесконечно) -->
                    <DoubleAnimation Storyboard.TargetName="AmberCube"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                     From="0" To="90"
                                     Duration="0:0:1.2"
                                     RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- 7. Бегущая полоска активности внизу окна (2s, влево-вправо) -->
                    <DoubleAnimation Storyboard.TargetName="ActivityBar"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="-80" To="340"
                                     Duration="0:0:2.0"
                                     RepeatBehavior="Forever" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- Внешняя рамка: 340x400, BgBase, Border 1px, CornerRadius 3 -->
    <Border Background="{DynamicResource BgBase}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="3"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="240" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============================================== -->
            <!-- РЯД 0: СЦЕНА-ПЕЙЗАЖ (340x240, ClipToBounds)    -->
            <!-- ============================================== -->
            <Grid Grid.Row="0" Width="340" Height="240" ClipToBounds="True">
                <!-- 1. Небо: 6 горизонтальных полос -->
                <StackPanel Orientation="Vertical" Width="340" Height="240">
                    <Rectangle Width="340" Height="90" Fill="#0A131A" />
                    <Rectangle Width="340" Height="50" Fill="#0F1C26" />
                    <Rectangle Width="340" Height="40" Fill="#162733" />
                    <Rectangle Width="340" Height="25" Fill="#22323C" />
                    <Rectangle Width="340" Height="15" Fill="#3B3A38" />
                    <Rectangle Width="340" Height="20" Fill="#6B4A2E" />
                </StackPanel>

                <!-- 2. Звёзды: 6 квадратиков 2x2 цвета текста -->
                <Canvas Width="340" Height="240">
                    <Rectangle x:Name="Star1" Canvas.Left="42" Canvas.Top="24" Width="2" Height="2" Fill="{DynamicResource TextPrimary}" Opacity="0" />
                    <Rectangle x:Name="Star2" Canvas.Left="118" Canvas.Top="52" Width="2" Height="2" Fill="{DynamicResource TextPrimary}" Opacity="0" />
                    <Rectangle x:Name="Star3" Canvas.Left="175" Canvas.Top="15" Width="2" Height="2" Fill="{DynamicResource TextPrimary}" Opacity="0" />
                    <Rectangle x:Name="Star4" Canvas.Left="238" Canvas.Top="65" Width="2" Height="2" Fill="{DynamicResource TextPrimary}" Opacity="0" />
                    <Rectangle x:Name="Star5" Canvas.Left="290" Canvas.Top="32" Width="2" Height="2" Fill="{DynamicResource TextPrimary}" Opacity="0" />
                    <Rectangle x:Name="Star6" Canvas.Left="78" Canvas.Top="78" Width="2" Height="2" Fill="{DynamicResource TextPrimary}" Opacity="0" />
                </Canvas>

                <!-- 3. Дальний слой гор (#16262F, 44s) -->
                <Canvas x:Name="DistantMountainCanvas" Width="680" Height="190" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                    <Canvas.RenderTransform>
                        <TranslateTransform X="0" />
                    </Canvas.RenderTransform>
                    <Path Canvas.Left="0" Canvas.Top="0" Fill="#16262F"
                          Data="M0 80 H30 V60 H55 V40 H85 V25 H110 V45 H140 V65 H165 V50 H195 V30 H225 V20 H250 V40 H280 V60 H310 V80 H340 V190 H0Z" />
                    <Path Canvas.Left="340" Canvas.Top="0" Fill="#16262F"
                          Data="M0 80 H30 V60 H55 V40 H85 V25 H110 V45 H140 V65 H165 V50 H195 V30 H225 V20 H250 V40 H280 V60 H310 V80 H340 V190 H0Z" />
                </Canvas>

                <!-- 4. Средний слой гор (#0F1B23, 28s) -->
                <Canvas x:Name="MiddleMountainCanvas" Width="680" Height="190" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                    <Canvas.RenderTransform>
                        <TranslateTransform X="0" />
                    </Canvas.RenderTransform>
                    <Path Canvas.Left="0" Canvas.Top="0" Fill="#0F1B23"
                          Data="M0 110 H25 V95 H50 V80 H80 V95 H105 V70 H135 V55 H160 V75 H190 V90 H215 V105 H245 V85 H275 V65 H300 V90 H325 V110 H340 V190 H0Z" />
                    <Path Canvas.Left="340" Canvas.Top="0" Fill="#0F1B23"
                          Data="M0 110 H25 V95 H50 V80 H80 V95 H105 V70 H135 V55 H160 V75 H190 V90 H215 V105 H245 V85 H275 V65 H300 V90 H325 V110 H340 V190 H0Z" />
                </Canvas>

                <!-- 5. Ближний слой гор (#070D12, 17s) -->
                <Canvas x:Name="NearMountainCanvas" Width="680" Height="190" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                    <Canvas.RenderTransform>
                        <TranslateTransform X="0" />
                    </Canvas.RenderTransform>
                    <Path Canvas.Left="0" Canvas.Top="0" Fill="#070D12"
                          Data="M0 150 H35 V135 H60 V120 H95 V135 H125 V150 H160 V140 H190 V125 H220 V110 H250 V125 H285 V140 H315 V150 H340 V190 H0Z" />
                    <Path Canvas.Left="340" Canvas.Top="0" Fill="#070D12"
                          Data="M0 150 H35 V135 H60 V120 H95 V135 H125 V150 H160 V140 H190 V125 H220 V110 H250 V125 H285 V140 H315 V150 H340 V190 H0Z" />
                </Canvas>

                <!-- 6. Квадратное солнце (pixel-art стиль): 36x36, Accent (#F2A63C), позиция X=206, Y=196 -->
                <Canvas Width="340" Height="240">
                    <Rectangle Canvas.Left="206" Canvas.Top="196" Width="36" Height="36" Fill="{DynamicResource Accent}" />
                </Canvas>

                <!-- 7. Светлячки: 6 квадратиков 3x3 Accent -->
                <Canvas Width="340" Height="240">
                    <Rectangle x:Name="Firefly1" Canvas.Left="55" Canvas.Top="220" Width="3" Height="3" Fill="{DynamicResource Accent}" Opacity="0">
                        <Rectangle.RenderTransform>
                            <TranslateTransform Y="0" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="Firefly2" Canvas.Left="110" Canvas.Top="225" Width="3" Height="3" Fill="{DynamicResource Accent}" Opacity="0">
                        <Rectangle.RenderTransform>
                            <TranslateTransform Y="0" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="Firefly3" Canvas.Left="165" Canvas.Top="215" Width="3" Height="3" Fill="{DynamicResource Accent}" Opacity="0">
                        <Rectangle.RenderTransform>
                            <TranslateTransform Y="0" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="Firefly4" Canvas.Left="220" Canvas.Top="228" Width="3" Height="3" Fill="{DynamicResource Accent}" Opacity="0">
                        <Rectangle.RenderTransform>
                            <TranslateTransform Y="0" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="Firefly5" Canvas.Left="275" Canvas.Top="218" Width="3" Height="3" Fill="{DynamicResource Accent}" Opacity="0">
                        <Rectangle.RenderTransform>
                            <TranslateTransform Y="0" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="Firefly6" Canvas.Left="310" Canvas.Top="222" Width="3" Height="3" Fill="{DynamicResource Accent}" Opacity="0">
                        <Rectangle.RenderTransform>
                            <TranslateTransform Y="0" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>

                <!-- 8. По центру: крупная надпись «Aura» и вращающийся янтарный кубик -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Aura"
                               FontFamily="{DynamicResource HeadingFont}"
                               FontWeight="SemiBold"
                               FontSize="92"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               LineHeight="92"
                               LineStackingStrategy="BlockLineHeight" />
                    <Border x:Name="AmberCube"
                            Width="14" Height="14"
                            CornerRadius="3"
                            Background="{DynamicResource Accent}"
                            HorizontalAlignment="Center"
                            Margin="0,4,0,0"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Border.RenderTransform>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ============================================== -->
            <!-- РЯД 1: СТАТУС, ПРОГРЕСС И НИЖНИЙ БЛОК          -->
            <!-- ============================================== -->
            <Grid Grid.Row="1">
                <!-- Прогресс-бар скачивания обновления (2px) под сценой -->
                <Grid VerticalAlignment="Top" Height="2"
                      Background="{DynamicResource Border}"
                      Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}">
                    <Border x:Name="ProgressBarFill"
                            HorizontalAlignment="Left"
                            Height="2"
                            Background="{DynamicResource Accent}"
                            Width="{Binding ProgressBarWidth}" />
                </Grid>

                <!-- Процент скачивания числом под полосой -->
                <TextBlock Text="{Binding ProgressPercentText}"
                           FontFamily="{DynamicResource MainFont}"
                           FontSize="12"
                           Foreground="{DynamicResource Accent}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,6,0,0"
                           Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}" />

                <!-- Строка статуса по центру (Onest 15pt, не прыгает при смене точек) -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="20,0,20,0">
                    <TextBlock Text="{Binding StatusText}"
                               FontFamily="{DynamicResource MainFont}"
                               FontSize="15"
                               FontWeight="Normal"
                               Foreground="{Binding StatusForeground}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <TextBlock Text="{Binding DotsText}"
                               FontFamily="{DynamicResource MainFont}"
                               FontSize="15"
                               FontWeight="Normal"
                               Foreground="{Binding StatusForeground}"
                               MinWidth="22"
                               TextAlignment="Left" />
                </StackPanel>

                <!-- В самом низу: надпись «beta 1.0.N» и тонкая бегущая полоска активности -->
                <Grid VerticalAlignment="Bottom">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding VersionText}"
                               FontFamily="{DynamicResource MainFont}"
                               FontSize="11"
                               Foreground="{DynamicResource AccentFaint}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />

                    <!-- Бегущая Accent-полоска 2px -->
                    <Grid Grid.Row="1" Height="2" ClipToBounds="True" Background="Transparent">
                        <Rectangle x:Name="ActivityBar"
                                   Width="80" Height="2"
                                   Fill="{DynamicResource Accent}"
                                   HorizontalAlignment="Left">
                            <Rectangle.RenderTransform>
                                <TranslateTransform X="-80" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
