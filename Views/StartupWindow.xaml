<Window x:Class="AuraLauncher.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aura"
        Width="340" Height="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/Resources/aura-icon.ico"
        FontFamily="{StaticResource MainFont}"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- Внешняя рамка: 340x400, BgBase, Border 1px, CornerRadius 3 -->
    <Border Background="{DynamicResource BgBase}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="3"
            ClipToBounds="True">
        <Grid>
            <!-- Верхняя зона: перетаскивание -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Центральный блок: Логотип + вращающееся кольцо-спиннер + статус -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,20,0,0">

                <!-- Контейнер спиннера и логотипа (120x120) -->
                <Grid Width="120" Height="120" HorizontalAlignment="Center">
                    <!-- Кольцо-спиннер (вращающаяся дуга amber) -->
                    <Path x:Name="SpinnerArc"
                          Width="120" Height="120"
                          Stroke="{DynamicResource Accent}"
                          StrokeThickness="2.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          RenderTransformOrigin="0.5,0.5"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Path.Data>
                            <!-- Дуга 120 градусов радиусом 46 px вокруг центра (60,60) -->
                            <PathGeometry>
                                <PathFigure StartPoint="60,14">
                                    <ArcSegment Point="99.8,83"
                                                Size="46,46"
                                                SweepDirection="Clockwise"
                                                IsLargeArc="False" />
                                </PathFigure>
                            </PathGeometry>
                        </Path.Data>
                        <Path.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" Angle="0" />
                        </Path.RenderTransform>
                    </Path>

                    <!-- Логотип Aura по центру: иконка приложения или Oswald с amber-точкой -->
                    <Image Source="pack://application:,,,/Resources/aura-icon.ico"
                           Width="52" Height="52"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>

                <!-- Строка статуса: фиксированная ширина 260px чтобы текст не прыгал -->
                <TextBlock x:Name="StatusTextBlock"
                           Text="{Binding StatusText}"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimary}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Width="260"
                           Margin="0,24,0,0" />

                <!-- Прогресс-бар скачивания обновления (тонкая полоса amber, видна при наличии прогресса) -->
                <Grid Width="220" Height="3" Margin="0,12,0,0"
                      Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}"
                      HorizontalAlignment="Center"
                      Background="{DynamicResource Border}">
                    <Border x:Name="ProgressBarFill"
                            HorizontalAlignment="Left"
                            Height="3"
                            Background="{DynamicResource Accent}"
                            Width="0" />
                </Grid>

                <!-- Процент скачивания (если обновление загружается) -->
                <TextBlock Text="{Binding ProgressPercentText}"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="12"
                           Foreground="{DynamicResource Accent}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"
                           Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <!-- Внизу мелко версия лаунчера: «beta 1.0.N» -->
            <TextBlock Grid.Row="1"
                       Text="{Binding VersionText}"
                       FontFamily="{StaticResource MainFont}"
                       FontSize="11"
                       Foreground="{DynamicResource AccentFaint}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16" />
        </Grid>
    </Border>
</Window>
