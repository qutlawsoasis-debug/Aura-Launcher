<Window x:Class="AuraLauncher.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:AuraLauncher.Core"
        Title="Aura"
        Width="340" Height="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/Resources/aura-icon.ico"
        FontFamily="{DynamicResource MainFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseDown="Window_MouseDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <core:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Плавная пульсация индикатора статуса -->
                    <DoubleAnimation Storyboard.TargetName="StatusDot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="1.0" To="0.35"
                                     Duration="0:0:0.8"
                                     AutoReverse="True"
                                     RepeatBehavior="Forever" />

                    <!-- Бегущий блик 3px (indeterminate) при проверке обновления -->
                    <DoubleAnimation Storyboard.TargetName="ShimmerTransform"
                                     Storyboard.TargetProperty="X"
                                     From="-80" To="340"
                                     Duration="0:0:1.6"
                                     RepeatBehavior="Forever" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- Внешняя рамка: 340x400, BgBase, BorderSubtle 1px, CornerRadius 3 -->
    <Border Background="{DynamicResource BgBase}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="1"
            CornerRadius="3"
            ClipToBounds="True">
        <Grid ClipToBounds="True">

            <!-- Слой 0: атмосферный арт лаунчера с тёмным градиентным переходом в BgBase -->
            <Image Source="{StaticResource WorldBackgroundBitmap}"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Height="280"
                   Opacity="0.45"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <Border IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{DynamicResource ColorShadeOverlay}" Offset="0.0" />
                        <GradientStop Color="{DynamicResource ColorDialogBackdrop}" Offset="0.36" />
                        <GradientStop Color="{DynamicResource ColorBgBase}" Offset="0.68" />
                        <GradientStop Color="{DynamicResource ColorBgBase}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Слой 1: типографика и блок статуса -->
            <Grid>
                <!-- 1. Логотип Aura и строгая акцентная риска (плавное появление fade-in + подъём 10px, 500мс) -->
                <StackPanel x:Name="AuraLogoHost"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,78,0,0" Opacity="0.0"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="AuraLogoTranslate" Y="10" />
                    </StackPanel.RenderTransform>
                    <TextBlock Text="Aura"
                               FontFamily="{DynamicResource HeadingFont}"
                               FontWeight="SemiBold"
                               FontSize="86"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               LineHeight="82"
                               LineStackingStrategy="BlockLineHeight" />
                    <Border Width="28" Height="2"
                            CornerRadius="1"
                            Background="{DynamicResource Accent}"
                            HorizontalAlignment="Center"
                            Margin="0,14,0,0" />
                </StackPanel>

                <!-- 2. Нижний блок: карточка статуса/загрузки + версия -->
                <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,18">
                    <Border Background="{DynamicResource Panel}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="16,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Статус с плавным Crossfade 200 мс -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="StatusDot"
                                            Width="8" Height="8"
                                            CornerRadius="2"
                                            Background="{DynamicResource Accent}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0" />
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock x:Name="OldStatusTextBlock"
                                                   Text=""
                                                   FontFamily="{DynamicResource MainFont}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{Binding StatusForeground}"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="StatusTextBlock"
                                                   Text="{Binding StatusText, NotifyOnTargetUpdated=True}"
                                                   TargetUpdated="OnStatusTextTargetUpdated"
                                                   FontFamily="{DynamicResource MainFont}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{Binding StatusForeground}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <TextBlock Text="{Binding DotsText}"
                                               FontFamily="{DynamicResource MainFont}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{Binding StatusForeground}"
                                               MinWidth="16"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Процент скачивания + Скорость (МБ/с) справа -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                                            Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ProgressPercentText}"
                                               FontFamily="{DynamicResource HeadingFont}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Accent}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SpeedText}"
                                               FontFamily="{DynamicResource MainFont}"
                                               FontSize="11"
                                               FontWeight="Normal"
                                               Foreground="{DynamicResource StoriesTextSecondary}"
                                               VerticalAlignment="Center"
                                               Margin="6,1,0,0"
                                               Visibility="{Binding HasSpeedText, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>

                            <!-- Тонкая полоска прогресса (3px, Accent): бегущий блик при проверке, реальный прогресс при скачивании -->
                            <Grid x:Name="ProgressTrack"
                                  Height="3"
                                  Margin="0,10,0,0"
                                  Background="{DynamicResource TrackSubtle}"
                                  ClipToBounds="True">
                                <!-- Индетерминантный блик (при проверке) -->
                                <Rectangle x:Name="IndeterminateShimmer"
                                           Width="80" Height="3"
                                           Fill="{DynamicResource Accent}"
                                           HorizontalAlignment="Left"
                                           Visibility="{Binding IsProgressVisible, Converter={StaticResource InverseBoolToVis}}">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="ShimmerTransform" X="-80" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>

                                <!-- Реальный прогресс-бар при скачивании -->
                                <Border x:Name="ProgressBarFill"
                                        HorizontalAlignment="Left"
                                        Height="3"
                                        CornerRadius="1.5"
                                        Background="{DynamicResource Accent}"
                                        Width="0"
                                        Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <!-- Кнопки Повторить / Пропустить при ошибке сети -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"
                                        Visibility="{Binding IsErrorState, Converter={StaticResource BoolToVis}}">
                                <Button Command="{Binding RetryCommand}"
                                        Content="Повторить"
                                        Style="{StaticResource PrimaryActionBtn}"
                                        Height="28" Padding="12,0" FontSize="12"
                                        Margin="0,0,8,0" />
                                <Button Command="{Binding SkipCommand}"
                                        Content="Пропустить"
                                        Style="{StaticResource SettingsActionBtn}"
                                        Height="28" Padding="12,0" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Версия лаунчера -->
                    <TextBlock Text="{Binding VersionText}"
                               FontFamily="{DynamicResource MainFont}"
                               FontSize="11"
                               Foreground="{DynamicResource StoriesTextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
