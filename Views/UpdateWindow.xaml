<Window x:Class="AuraLauncher.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:AuraLauncher.Core"
        Title="Aura Launcher Update"
        Width="320" Height="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/app_icon.ico"
        FontFamily="{StaticResource MainFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <core:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />

        <Style x:Key="ProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Width" Value="220" />
            <Setter Property="Background" Value="#1FFFFFFF" /> <!-- белый 12% -->
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource EmberBrush}"
                                        CornerRadius="3" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Card: 320x360, radius 8px, background #0B141A, shadow -->
    <Border Margin="14"
            Background="#0B141A"
            CornerRadius="8"
            BorderBrush="{StaticResource LineInkBrush}"
            BorderThickness="1"
            MouseDown="Border_MouseDown">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" Opacity="0.8" Direction="270" ShadowDepth="4" />
        </Border.Effect>

        <Grid>
            <!-- Content layout -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,10">
                
                <!-- Logo & 8 orbiting squares container (120x120) -->
                <Grid Width="120" Height="120" HorizontalAlignment="Center">
                    <!-- Central App Icon (72x72) -->
                    <Border Width="72" Height="72"
                            CornerRadius="16"
                            ClipToBounds="True"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/app_icon.png"
                               Width="72" Height="72"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Stretch="UniformToFill" />
                    </Border>

                    <!-- 8 Stepping Squares 6x6 on circle radius R=50 -->
                    <!-- Center is (60,60). For angle a: X = 60 + 50*sin(a) - 3, Y = 60 - 50*cos(a) - 3 -->
                    <!-- k=0 (0 deg, top): X=57, Y=7 -->
                    <!-- k=1 (45 deg): X=92, Y=15 -->
                    <!-- k=2 (90 deg, right): X=107, Y=57 -->
                    <!-- k=3 (135 deg): X=92, Y=92 -->
                    <!-- k=4 (180 deg, bottom): X=57, Y=107 -->
                    <!-- k=5 (225 deg): X=15, Y=92 -->
                    <!-- k=6 (270 deg, left): X=7, Y=57 -->
                    <!-- k=7 (315 deg): X=15, Y=15 -->
                    <Canvas x:Name="OrbitCanvas" Width="120" Height="120"
                            Visibility="{Binding HasError, Converter={StaticResource InvBoolToVis}}">
                        <Rectangle x:Name="Dot0" Canvas.Left="57" Canvas.Top="7" Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="{StaticResource EmberBrush}" Opacity="0.15" />
                        <Rectangle x:Name="Dot1" Canvas.Left="92" Canvas.Top="15" Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="{StaticResource EmberBrush}" Opacity="0.15" />
                        <Rectangle x:Name="Dot2" Canvas.Left="107" Canvas.Top="57" Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="{StaticResource EmberBrush}" Opacity="0.15" />
                        <Rectangle x:Name="Dot3" Canvas.Left="92" Canvas.Top="92" Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="{StaticResource EmberBrush}" Opacity="0.15" />
                        <Rectangle x:Name="Dot4" Canvas.Left="57" Canvas.Top="107" Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="{StaticResource EmberBrush}" Opacity="0.15" />
                        <Rectangle x:Name="Dot5" Canvas.Left="15" Canvas.Top="92" Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="{StaticResource EmberBrush}" Opacity="0.15" />
                        <Rectangle x:Name="Dot6" Canvas.Left="7" Canvas.Top="57" Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="{StaticResource EmberBrush}" Opacity="0.15" />
                        <Rectangle x:Name="Dot7" Canvas.Left="15" Canvas.Top="15" Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="{StaticResource EmberBrush}" Opacity="0.15" />
                    </Canvas>
                </Grid>

                <!-- Status Text (Onest 500 15px) -->
                <TextBlock x:Name="TxtStatus"
                           Text="{Binding StatusText}"
                           FontFamily="{StaticResource MainFont}"
                           FontWeight="Medium"
                           FontSize="15"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,18,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="#FF8A7A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Normal / Downloading State: Progress Bar 220x6 -->
                <Grid Margin="0,16,0,0"
                      Visibility="{Binding HasError, Converter={StaticResource InvBoolToVis}}">
                    <ProgressBar x:Name="UpdateProgressBar"
                                 Style="{StaticResource ProgressBarStyle}"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding ProgressValue}" />
                </Grid>

                <!-- Error State: Retry Countdown & Links -->
                <StackPanel Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <!-- Countdown Text -->
                    <TextBlock Text="{Binding RetryCountdownText}"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               Foreground="{StaticResource DimInkBrush}"
                               HorizontalAlignment="Center" />

                    <!-- Retry Now Link -->
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center">
                        <Hyperlink Command="{Binding RetryNowCommand}"
                                   Foreground="{StaticResource EmberBrush}"
                                   TextDecorations="None">
                            <Run Text="Повторить сейчас" FontSize="13" FontFamily="{StaticResource MainFont}" FontWeight="Medium" />
                        </Hyperlink>
                    </TextBlock>

                    <!-- Launch Current Version Link (shown after 3 fails) -->
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Visibility="{Binding CanLaunchCurrentVersion, Converter={StaticResource BoolToVis}}">
                        <Hyperlink Command="{Binding LaunchCurrentVersionCommand}"
                                   Foreground="{StaticResource MuteBrush}"
                                   TextDecorations="None">
                            <Run Text="Запустить текущую версию" FontSize="12" FontFamily="{StaticResource MainFont}" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Border>
</Window>
