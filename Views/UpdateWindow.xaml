<Window x:Class="AuraLauncher.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:AuraLauncher.Core"
        Title="Aura"
        Width="472" Height="212"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/Resources/aura-icon.ico"
        FontFamily="{StaticResource MainFont}"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <core:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
    </Window.Resources>

    <!-- Outer container: 440x180 card with 16px margins for drop shadow (472x212 total) -->
    <Grid>
        <Border Width="440" Height="180"
                CornerRadius="8"
                ClipToBounds="True"
                BorderBrush="{StaticResource LineInkBrush}"
                BorderThickness="1"
                Background="#071017">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" Opacity="0.8" Direction="270" ShadowDepth="4" />
            </Border.Effect>

            <Grid>
                <!-- 1. Background image (bg_world.png) -->
                <Image Source="pack://application:,,,/bg_world.png"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

                <!-- 2. Dark gradient overlay: left-to-right rgba(7,16,23,.88) -> rgba(7,16,23,.55) -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#E0071017" Offset="0" />
                            <GradientStop Color="#8C071017" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 3. Top-left titles: "Aura" + version transition -->
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,20,0,0">
                    <!-- Title: Oswald 600, 40px, белый (#FFFFFF) -->
                    <TextBlock Text="Aura"
                               FontFamily="{StaticResource HeadingFont}"
                               FontWeight="SemiBold"
                               FontSize="40"
                               Foreground="#FFFFFF"
                               LineHeight="38"
                               LineStackingStrategy="BlockLineHeight" />

                    <!-- Version transition: Onest 13px mute -->
                    <TextBlock Text="{Binding VersionTransitionText}"
                               FontFamily="{StaticResource MainFont}"
                               FontWeight="Normal"
                               FontSize="13"
                               Foreground="{StaticResource MuteBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- 4. Bottom-left status & error controls -->
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,16">
                    <!-- Status: Onest 500 14px (Normal/Ember/Ink or #FF8A7A on error) -->
                    <TextBlock Text="{Binding StatusText}"
                               FontFamily="{StaticResource MainFont}"
                               FontWeight="Medium"
                               FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Foreground" Value="#FF8A7A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Error state extra rows: Countdown + Links -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <!-- Countdown text -->
                        <TextBlock Text="{Binding RetryCountdownText}"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource DimInkBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />

                        <!-- Retry Now Link -->
                        <TextBlock VerticalAlignment="Center" Margin="0,0,12,0">
                            <Hyperlink Command="{Binding RetryNowCommand}"
                                       Foreground="{StaticResource EmberBrush}"
                                       TextDecorations="None">
                                <Run Text="Повторить сейчас" FontSize="12" FontFamily="{StaticResource MainFont}" FontWeight="Medium" />
                            </Hyperlink>
                        </TextBlock>

                        <!-- Launch Current Version Link (shown after 3 fails) -->
                        <TextBlock VerticalAlignment="Center"
                                   Visibility="{Binding CanLaunchCurrentVersion, Converter={StaticResource BoolToVis}}">
                            <Hyperlink Command="{Binding LaunchCurrentVersionCommand}"
                                       Foreground="{StaticResource MuteBrush}"
                                       TextDecorations="None">
                                <Run Text="Запустить текущую версию" FontSize="12" FontFamily="{StaticResource MainFont}" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- 5. Bottom 4px progress line across entire window width -->
                <Grid Height="4" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Background="#1FFFFFFF">
                    <!-- A. Definite progress bar (ember fill, smooth transitions) -->
                    <Border x:Name="DefiniteProgressBar"
                            HorizontalAlignment="Left"
                            Height="4"
                            Background="{StaticResource EmberBrush}"
                            Visibility="{Binding HasDefiniteProgress, Converter={StaticResource BoolToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Background" Value="#FF8A7A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- B. Indeterminate sliding segment (120px, 2s EaseInOut) when progress is 0% and no error -->
                    <Canvas x:Name="IndeterminateCanvas" Height="4" HorizontalAlignment="Stretch" ClipToBounds="True">
                        <Canvas.Style>
                            <Style TargetType="Canvas">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasDefiniteProgress}" Value="False" />
                                            <Condition Binding="{Binding HasError}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Canvas.Style>
                        <Border x:Name="SlidingChunk" Width="120" Height="4"
                                Background="{StaticResource EmberBrush}"
                                CornerRadius="1">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ChunkTranslate" X="-120" />
                            </Border.RenderTransform>
                        </Border>
                    </Canvas>

                    <!-- C. Error state progress line: #FF8A7A across full width -->
                    <Border x:Name="ErrorProgressBar"
                            HorizontalAlignment="Stretch"
                            Height="4"
                            Background="#FF8A7A"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
