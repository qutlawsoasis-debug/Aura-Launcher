<UserControl x:Class="AuraLauncher.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Focusable="False"
             FocusVisualStyle="{x:Null}"
             ClipToBounds="False"
             Background="Transparent">


    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="Transparent" Focusable="False" FocusVisualStyle="{x:Null}" ClipToBounds="False">
        <!-- Main StackPanel anchored to the bottom-left of the content area -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Focusable="False" FocusVisualStyle="{x:Null}">
            
            <!-- 1) Line "Minecraft 1.20.1, Fabric 0.19.5, 93 мода" and "Список изменений" link -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="{Binding SpecLine}"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="15"
                           FontWeight="Normal"
                           Foreground="{StaticResource DimInkBrush}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="12" Opacity="0.7" Direction="0" ShadowDepth="0" />
                    </TextBlock.Effect>
                </TextBlock>
                <Border Width="1" Height="12" Background="{StaticResource LineInkBrush}" Margin="10,0,10,0" VerticalAlignment="Center" />
                <Button Command="{Binding DataContext.OpenChangelogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource GhostBtn}"
                        Padding="0" VerticalAlignment="Center">
                    <TextBlock Text="Список изменений"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               Foreground="{StaticResource EmberBrush}"
                               TextDecorations="Underline">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="8" Opacity="0.6" Direction="0" ShadowDepth="0" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Button>
            </StackPanel>

            <!-- Playtime & launches statistic badge -->
            <TextBlock Text="{Binding PlaytimeSummaryText}"
                       FontFamily="{StaticResource MainFont}"
                       FontSize="13"
                       FontWeight="Normal"
                       Foreground="{StaticResource MuteBrush}"
                       Margin="0,0,0,14">
                <TextBlock.Effect>
                    <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="8" Opacity="0.6" Direction="0" ShadowDepth="0" />
                </TextBlock.Effect>
            </TextBlock>

            <!-- 3) Button "Играть" 260x70 with bottom progress bar, right of it label MaxWidth 300 wrap -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="260" Height="70">
                    <Button Command="{Binding DataContext.LaunchOrCancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource OverviewPlayBtn}"
                            Content="{Binding DataContext.LaunchButtonText, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <!-- Bottom 5px launch progress bar within button bounds -->
                    <ProgressBar Height="5" VerticalAlignment="Bottom"
                                 HorizontalAlignment="Stretch"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource EmberDarkBrush}"
                                 Value="{Binding DataContext.ProgressPercentage, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Visibility="{Binding DataContext.IsProgressVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- Right of button: MaxWidth 300, TextWrapping=Wrap, no clipping -->
                <StackPanel VerticalAlignment="Center" Margin="18,0,0,0" MaxWidth="300">
                    <!-- Extra state indicator when launching or running -->
                    <TextBlock Text="{Binding DataContext.StateTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource EmberBrush}"
                               Margin="0,0,0,2"
                               MaxWidth="300"
                               TextWrapping="Wrap"
                               Visibility="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding DataContext.AllocatedRamText, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               FontWeight="Normal"
                               Foreground="{StaticResource MuteBrush}"
                               MaxWidth="300"
                               TextWrapping="Wrap">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="12" Opacity="0.7" Direction="0" ShadowDepth="0" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Правая колонка: растянута сверху вниз, отображает 3-4 карточки с картинками в зависимости от разрешения -->
        <Border x:Name="StoriesRail"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Width="320"
                MinWidth="280"
                MaxWidth="360"
                Margin="0,0,0,0"
                Padding="14"
                CornerRadius="3"
                Background="{DynamicResource StoriesDim55}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                ClipToBounds="True"
                UseLayoutRounding="True"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="StoriesRailTranslate" X="0" />
            </Border.RenderTransform>

            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <!-- Карточка 1: Последний скриншот -->
                    <RowDefinition Height="*" MinHeight="64" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />

                    <!-- Карточка 2: Достижение -->
                    <RowDefinition Height="*" MinHeight="64" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />

                    <!-- Карточка 3: Следующая цель (включается на экранах с достаточной высотой — 4 карточки) -->
                    <RowDefinition x:Name="CardNextGoalImageRow" Height="*" MinHeight="64" />
                    <RowDefinition x:Name="CardNextGoalTextRow" Height="Auto" />
                    <RowDefinition x:Name="CardNextGoalDividerRow" Height="Auto" />

                    <!-- Карточка 4: Что нового -->
                    <RowDefinition Height="*" MinHeight="64" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. ПОСЛЕДНИЙ СКРИНШОТ: Картинка или пустое состояние -->
                <Border Grid.Row="0"
                        CornerRadius="3"
                        ClipToBounds="True"
                        Background="{DynamicResource Panel}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid Visibility="{Binding HasLatestScreenshot, Converter={StaticResource BoolToVis}}">
                            <Image Source="{Binding FeedImage0}"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <Rectangle Fill="{DynamicResource BgBase}" Opacity="0.14" IsHitTestVisible="False" />
                        </Grid>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="12,8"
                                    Visibility="{Binding HasLatestScreenshot, Converter={StaticResource InverseBoolToVis}}">
                            <Path Style="{StaticResource IconPath}"
                                  Data="{StaticResource IconCamera}"
                                  Width="20"
                                  Height="20"
                                  Stroke="{DynamicResource StoriesTextSecondary}"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,6" />
                            <TextBlock Text="Последних скриншотов нет"
                                       FontFamily="{StaticResource MainFont}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource StoriesTextSecondary}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 1. ПОСЛЕДНИЙ СКРИНШОТ: Текст -->
                <StackPanel Grid.Row="1">
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="ПОСЛЕДНИЙ СКРИНШОТ"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource StoriesTextSecondary}"
                                   VerticalAlignment="Center" />

                        <Button Grid.Column="1"
                                Command="{Binding DataContext.OpenOverviewScreenshotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding LatestScreenshot}"
                                Style="{StaticResource GhostBtn}"
                                Padding="0"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0"
                                Cursor="Hand"
                                Visibility="{Binding HasLatestScreenshot, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Открыть"
                                       FontFamily="{StaticResource MainFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Accent}"
                                       TextDecorations="Underline" />
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding LatestScreenshotDateText}"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasLatestScreenshot, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="Нажмите F2 в игре, чтобы сделать скриншот"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="12"
                               Foreground="{DynamicResource StoriesTextSecondary}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasLatestScreenshot, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>

                <Border Grid.Row="2" Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,10,0,10" />

                <!-- 2. ДОСТИЖЕНИЕ: Картинка -->
                <Border Grid.Row="3"
                        CornerRadius="3"
                        ClipToBounds="True"
                        Background="{DynamicResource Panel}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1"
                        Margin="0,0,0,8">
                    <Grid>
                        <Image Source="{Binding FeedImage1}"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Rectangle Fill="{DynamicResource BgBase}" Opacity="0.18" IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <!-- 2. ДОСТИЖЕНИЕ: Текст -->
                <StackPanel Grid.Row="4">
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="ДОСТИЖЕНИЕ"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource StoriesTextSecondary}"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding AchievementDateOrProgress}"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                    </Grid>

                    <TextBlock Text="{Binding AchievementTitle}"
                               FontFamily="{StaticResource HeadingFont}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,2" />

                    <TextBlock Text="{Binding AchievementDescription}"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="12"
                               Foreground="{DynamicResource StoriesTextSecondary}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Row="5" Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,10,0,10" />

                <!-- 3. СЛЕДУЮЩАЯ ЦЕЛЬ (адаптивный 4-й блок для высоких разрешений): Картинка -->
                <Border x:Name="CardNextGoalImage"
                        Grid.Row="6"
                        CornerRadius="3"
                        ClipToBounds="True"
                        Background="{DynamicResource Panel}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1"
                        Margin="0,0,0,8">
                    <Grid>
                        <Image Source="{Binding FeedImage2}"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Rectangle Fill="{DynamicResource BgBase}" Opacity="0.18" IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <!-- 3. СЛЕДУЮЩАЯ ЦЕЛЬ: Текст -->
                <StackPanel x:Name="CardNextGoalText" Grid.Row="7">
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="СЛЕДУЮЩАЯ ЦЕЛЬ"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource StoriesTextSecondary}"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding NextAchievementProgress}"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Accent}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                    </Grid>

                    <TextBlock Text="{Binding NextAchievementTitle}"
                               FontFamily="{StaticResource HeadingFont}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,2" />

                    <TextBlock Text="{Binding NextAchievementDescription}"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="12"
                               Foreground="{DynamicResource StoriesTextSecondary}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border x:Name="CardNextGoalDivider" Grid.Row="8" Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,10,0,10" />

                <!-- 4. ЧТО НОВОГО: Картинка -->
                <Border Grid.Row="9"
                        CornerRadius="3"
                        ClipToBounds="True"
                        Background="{DynamicResource Panel}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1"
                        Margin="0,0,0,8">
                    <Grid>
                        <Image Source="{Binding FeedImage3}"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Rectangle Fill="{DynamicResource BgBase}" Opacity="0.18" IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <!-- 4. ЧТО НОВОГО: Текст -->
                <StackPanel Grid.Row="10">
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ЧТО НОВОГО · "
                                       FontFamily="{StaticResource MainFont}"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource StoriesTextSecondary}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding WhatsNewVersion}"
                                       FontFamily="{StaticResource MainFont}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Accent}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Command="{Binding DataContext.OpenChangelogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource GhostBtn}"
                                Padding="0"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0"
                                Cursor="Hand">
                            <TextBlock Text="Все изменения"
                                       FontFamily="{StaticResource MainFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Accent}"
                                       TextDecorations="Underline" />
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding WhatsNewPrimaryLine}"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="12"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
