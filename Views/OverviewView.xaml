<UserControl x:Class="AuraLauncher.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:AuraLauncher.Controls"
             mc:Ignorable="d"
             Focusable="False"
             FocusVisualStyle="{x:Null}"
             ClipToBounds="False"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <core:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" xmlns:core="clr-namespace:AuraLauncher.Core" />
    </UserControl.Resources>

    <Grid Background="Transparent" Focusable="False" FocusVisualStyle="{x:Null}" ClipToBounds="False">
        <!-- Main StackPanel anchored to the bottom-left of the content area -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Focusable="False" FocusVisualStyle="{x:Null}">
            
            <!-- 1) Line "Minecraft 1.20.1, Fabric 0.19.5, 93 мода" and "Список изменений" link -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="{Binding SpecLine}"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="15"
                           FontWeight="Normal"
                           Foreground="{StaticResource DimInkBrush}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="12" Opacity="0.7" Direction="0" ShadowDepth="0" />
                    </TextBlock.Effect>
                </TextBlock>
                <Border Width="1" Height="12" Background="{StaticResource LineInkBrush}" Margin="10,0,10,0" VerticalAlignment="Center" />
                <Button Command="{Binding DataContext.OpenChangelogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource GhostBtn}"
                        Padding="0" VerticalAlignment="Center">
                    <TextBlock Text="Список изменений"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               Foreground="{StaticResource EmberBrush}"
                               TextDecorations="Underline">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="8" Opacity="0.6" Direction="0" ShadowDepth="0" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Button>
            </StackPanel>

            <!-- Playtime & launches statistic badge -->
            <TextBlock Text="{Binding PlaytimeSummaryText}"
                       FontFamily="{StaticResource MainFont}"
                       FontSize="13"
                       FontWeight="Normal"
                       Foreground="{StaticResource MuteBrush}"
                       Margin="0,0,0,14">
                <TextBlock.Effect>
                    <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="8" Opacity="0.6" Direction="0" ShadowDepth="0" />
                </TextBlock.Effect>
            </TextBlock>

            <!-- Карточка официального сервера 24/7 -->
            <Border Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="14,10"
                    Margin="0,0,0,16"
                    MaxWidth="360"
                    HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <!-- Статус и название сервера -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource BorderStrong}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOfficialServerOnline}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="Сервер Aura 24/7"
                                       FontFamily="{StaticResource HeadingFont}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>

                        <!-- Пинг и онлайн игроков -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding OfficialServerStatusText}"
                                       FontFamily="{StaticResource MainFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Text=" • "
                                       FontFamily="{StaticResource MainFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMuted}"
                                       Visibility="{Binding IsOfficialServerOnline, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding OfficialServerPingText}"
                                       FontFamily="{StaticResource MainFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMuted}"
                                       Visibility="{Binding IsOfficialServerOnline, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text=" • "
                                       FontFamily="{StaticResource MainFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMuted}"
                                       Visibility="{Binding IsOfficialServerOnline, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding OfficialServerPlayersText}"
                                       FontFamily="{StaticResource MainFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMuted}"
                                       Visibility="{Binding IsOfficialServerOnline, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Кнопка быстрого подключения к серверу -->
                    <Button Grid.Column="1"
                            Command="{Binding LaunchOfficialServerCommand}"
                            Style="{StaticResource StandardBtn}"
                            Padding="16,6"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Content="Войти"
                            IsEnabled="{Binding IsOfficialServerOnline}" />
                </Grid>
            </Border>

            <!-- 3) Button "Играть" 260x70 with bottom progress bar -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="260" Height="70">
                    <Button Command="{Binding DataContext.LaunchOrCancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource OverviewPlayBtn}"
                            Content="{Binding DataContext.LaunchButtonText, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <!-- Bottom 5px launch progress bar within button bounds -->
                    <ProgressBar Height="5" VerticalAlignment="Bottom"
                                 HorizontalAlignment="Stretch"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource EmberDarkBrush}"
                                 Value="{Binding DataContext.ProgressPercentage, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Visibility="{Binding DataContext.IsProgressVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- Right of button: MaxWidth 300, TextWrapping=Wrap -->
                <StackPanel VerticalAlignment="Center" Margin="18,0,0,0" MaxWidth="300">
                    <TextBlock Text="{Binding DataContext.StateTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource EmberBrush}"
                               Margin="0,0,0,2"
                               MaxWidth="300"
                               TextWrapping="Wrap"
                               Visibility="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding DataContext.AllocatedRamText, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               FontWeight="Normal"
                               Foreground="{StaticResource MuteBrush}"
                               MaxWidth="300"
                               TextWrapping="Wrap">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="12" Opacity="0.7" Direction="0" ShadowDepth="0" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Правая колонка: Матовое стекло с каруселью историй -->
        <Border x:Name="StoriesRail"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Width="330"
                MinWidth="280"
                MaxWidth="360"
                CornerRadius="3"
                Background="{DynamicResource StoriesPanelBg}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                ClipToBounds="True"
                UseLayoutRounding="True">
            <controls:StoriesCarousel />
        </Border>
    </Grid>
</UserControl>
