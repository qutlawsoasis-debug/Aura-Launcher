<UserControl x:Class="AuraLauncher.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Focusable="False"
             FocusVisualStyle="{x:Null}"
             ClipToBounds="False"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <core:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" xmlns:core="clr-namespace:AuraLauncher.Core" />
    </UserControl.Resources>

    <Grid Background="Transparent" Focusable="False" FocusVisualStyle="{x:Null}" ClipToBounds="False">
        <!-- Main StackPanel anchored to the bottom-left of the content area -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Focusable="False" FocusVisualStyle="{x:Null}">
            
            <!-- 1) Line "Minecraft 1.20.1, Fabric 0.19.5, 93 мода" and "Список изменений" link -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="{Binding SpecLine}"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="15"
                           FontWeight="Normal"
                           Foreground="{StaticResource DimInkBrush}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="12" Opacity="0.7" Direction="0" ShadowDepth="0" />
                    </TextBlock.Effect>
                </TextBlock>
                <Border Width="1" Height="12" Background="{StaticResource LineInkBrush}" Margin="10,0,10,0" VerticalAlignment="Center" />
                <Button Command="{Binding DataContext.OpenChangelogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource GhostBtn}"
                        Padding="0" VerticalAlignment="Center">
                    <TextBlock Text="Список изменений"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               Foreground="{StaticResource EmberBrush}"
                               TextDecorations="Underline">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="8" Opacity="0.6" Direction="0" ShadowDepth="0" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Button>
            </StackPanel>

            <!-- Playtime & launches statistic badge -->
            <TextBlock Text="{Binding PlaytimeSummaryText}"
                       FontFamily="{StaticResource MainFont}"
                       FontSize="13"
                       FontWeight="Normal"
                       Foreground="{StaticResource MuteBrush}"
                       Margin="0,0,0,14">
                <TextBlock.Effect>
                    <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="8" Opacity="0.6" Direction="0" ShadowDepth="0" />
                </TextBlock.Effect>
            </TextBlock>

            <!-- 3) Button "Играть" 260x70 with bottom progress bar -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="260" Height="70">
                    <Button Command="{Binding DataContext.LaunchOrCancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource OverviewPlayBtn}"
                            Content="{Binding DataContext.LaunchButtonText, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <!-- Bottom 5px launch progress bar within button bounds -->
                    <ProgressBar Height="5" VerticalAlignment="Bottom"
                                 HorizontalAlignment="Stretch"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource EmberDarkBrush}"
                                 Value="{Binding DataContext.ProgressPercentage, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Visibility="{Binding DataContext.IsProgressVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- Right of button: MaxWidth 300, TextWrapping=Wrap -->
                <StackPanel VerticalAlignment="Center" Margin="18,0,0,0" MaxWidth="300">
                    <TextBlock Text="{Binding DataContext.StateTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource EmberBrush}"
                               Margin="0,0,0,2"
                               MaxWidth="300"
                               TextWrapping="Wrap"
                               Visibility="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding DataContext.AllocatedRamText, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               FontWeight="Normal"
                               Foreground="{StaticResource MuteBrush}"
                               MaxWidth="300"
                               TextWrapping="Wrap">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="12" Opacity="0.7" Direction="0" ShadowDepth="0" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Правая колонка: Матовое стекло с каруселью историй -->
        <Border x:Name="StoriesRail"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Width="330"
                MinWidth="280"
                MaxWidth="360"
                CornerRadius="3"
                Background="{DynamicResource StoriesPanelBg}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                ClipToBounds="True"
                UseLayoutRounding="True"
                MouseEnter="StoriesRail_MouseEnter"
                MouseLeave="StoriesRail_MouseLeave">

            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- 1. Верхние 3 полоски индикатора -->
                    <RowDefinition Height="*" />    <!-- 2. Слайды карусели -->
                </Grid.RowDefinitions>

                <!-- 1. ИНДИКАТОРЫ ИСТОРИЙ (3 полоски: StoriesTrack, высота 3px, отступ 4px) -->
                <Grid Grid.Row="0" Margin="16,14,16,10" Panel.ZIndex="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Полоска 0: Скриншот -->
                    <Button Grid.Column="0" Click="OnStoryBar0Click" Style="{StaticResource StoryBarBtn}" ToolTip="Скриншот">
                        <Border Height="3" Background="{DynamicResource StoriesTrack}" CornerRadius="1.5" ClipToBounds="False">
                            <Border x:Name="Story0Fill" Background="{StaticResource EmberBrush}" CornerRadius="1.5" RenderTransformOrigin="0,0">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="Story0Scale" ScaleX="0" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Button>

                    <!-- Полоска 1: Достижения -->
                    <Button Grid.Column="2" Click="OnStoryBar1Click" Style="{StaticResource StoryBarBtn}" ToolTip="Достижения и цели">
                        <Border Height="3" Background="{DynamicResource StoriesTrack}" CornerRadius="1.5" ClipToBounds="False">
                            <Border x:Name="Story1Fill" Background="{StaticResource EmberBrush}" CornerRadius="1.5" RenderTransformOrigin="0,0">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="Story1Scale" ScaleX="0" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Button>

                    <!-- Полоска 2: Что нового -->
                    <Button Grid.Column="4" Click="OnStoryBar2Click" Style="{StaticResource StoryBarBtn}" ToolTip="Что нового">
                        <Border Height="3" Background="{DynamicResource StoriesTrack}" CornerRadius="1.5" ClipToBounds="False">
                            <Border x:Name="Story2Fill" Background="{StaticResource EmberBrush}" CornerRadius="1.5" RenderTransformOrigin="0,0">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="Story2Scale" ScaleX="0" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Button>
                </Grid>

                <!-- 2. АНИМИРОВАННЫЙ КОНТЕЙНЕР СЛАЙДОВ (350 мс, 24px сдвиг, fade) -->
                <Grid Grid.Row="1" ClipToBounds="True">

                    <!-- СЛАЙД 0: ПОСЛЕДНИЙ СКРИНШОТ (на всю панель, slow zoom 1.0 -> 1.06 за 6с) -->
                    <Grid x:Name="Slide0View" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="Slide0Translate" X="0" />
                        </Grid.RenderTransform>

                        <!-- Фоновая картинка скриншота с медленным зумом -->
                        <Image Source="{Binding FeedImage0}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <ScaleTransform x:Name="ScreenshotZoomTransform" ScaleX="1.0" ScaleY="1.0" />
                            </Image.RenderTransform>
                        </Image>

                        <!-- Тёмный нижний градиент для читаемости текста -->
                        <Border IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="{DynamicResource ColorStoriesShadeTransparent}" Offset="0.0" />
                                    <GradientStop Color="{DynamicResource ColorStoriesShadeBottom}" Offset="0.5" />
                                    <GradientStop Color="{DynamicResource ColorNight}" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Текстовая подпись снизу "Скриншот · дата" -->
                        <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,16">
                            <TextBlock x:Name="Slide0Sub1"
                                       Text="ПОСЛЕДНИЙ СКРИНШОТ"
                                       FontFamily="{StaticResource MainFont}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource EmberBrush}"
                                       Margin="0,0,0,2" />
                            <TextBlock x:Name="Slide0Sub2"
                                       Text="{Binding LatestScreenshotDateText, StringFormat='{}Скриншот · {0}'}"
                                       FontFamily="{StaticResource HeadingFont}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextWhite}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <!-- СЛАЙД 1: ДОСТИЖЕНИЯ И СЛЕДУЮЩАЯ ЦЕЛЬ -->
                    <Grid x:Name="Slide1View" Visibility="Visible" Margin="16,8,16,16" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="Slide1Translate" X="0" />
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />  <!-- 0: Заголовок достижения и иконка -->
                            <RowDefinition Height="*" />     <!-- 1: Равномерное гибкое пространство -->
                            <RowDefinition Height="Auto" />  <!-- 2: Блок "Следующая цель" -->
                            <RowDefinition Height="*" />     <!-- 3: Равномерное гибкое пространство -->
                            <RowDefinition Height="Auto" />  <!-- 4: Нижний ряд иконок -->
                        </Grid.RowDefinitions>

                        <!-- Заголовок достижения и большая иконка со свечением -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                            <Border x:Name="Slide1IconBorder"
                                    Width="56" Height="56"
                                    CornerRadius="28"
                                    Background="{StaticResource EmberBrush}"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,10">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCrown}" Width="26" Height="26" Stroke="{DynamicResource PrimaryActionText}" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock x:Name="Slide1Title"
                                       Text="{Binding AchievementTitle}"
                                       FontFamily="{StaticResource HeadingFont}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextWhite}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="{StaticResource ColorShade}" BlurRadius="6" Opacity="0.55" ShadowDepth="1" Direction="270" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock x:Name="Slide1Desc"
                                       Text="{Binding AchievementDescription}"
                                       FontFamily="{StaticResource MainFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Text90}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Блок "Следующая цель" в стиле панели (StoriesCardGlass, StoriesCardBorder) -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource StoriesCardGlass}"
                                BorderBrush="{DynamicResource StoriesCardBorder}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="14,12">
                            <StackPanel x:Name="Slide1NextBlock">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="СЛЕДУЮЩАЯ ЦЕЛЬ" FontFamily="{StaticResource MainFont}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource EmberBrush}" />
                                    <TextBlock Text="{Binding NextAchievementProgress}" FontFamily="{StaticResource MainFont}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextWhite}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{Binding NextAchievementTitle}" FontFamily="{StaticResource HeadingFont}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextWhite}" TextWrapping="Wrap" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding NextAchievementDescription}" FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{DynamicResource Text90}" TextWrapping="Wrap" Margin="0,0,10,0" />

                                <!-- Толстая полоса прогресса (8px, CornerRadius 4) -->
                                <Border Height="8" Background="{DynamicResource TrackSubtle}" CornerRadius="4" ClipToBounds="True">
                                    <Border x:Name="NextAchProgressBar" Height="8" CornerRadius="4" Background="{StaticResource EmberBrush}" HorizontalAlignment="Left" Width="100" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Нижний ряд маленьких иконок остальных достижений -->
                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource PanelRaised}" Margin="0,0,8,0">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCheck}" Width="13" Height="13" Stroke="{StaticResource EmberBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource PanelRaised}" Margin="0,0,8,0">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCrown}" Width="13" Height="13" Stroke="{StaticResource EmberBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource PanelRaised}" Opacity="0.4" Margin="0,0,8,0">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconUser}" Width="13" Height="13" Stroke="{DynamicResource DimInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource PanelRaised}" Opacity="0.4" Margin="0,0,8,0">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconWorld}" Width="13" Height="13" Stroke="{DynamicResource DimInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource PanelRaised}" Opacity="0.4">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCamera}" Width="13" Height="13" Stroke="{DynamicResource DimInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- СЛАЙД 2: ЧТО НОВОГО -->
                    <Grid x:Name="Slide2View" Visibility="Collapsed" Margin="16,8,16,16" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="Slide2Translate" X="0" />
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Заголовок + плашка версии -->
                        <StackPanel Grid.Row="0" Margin="0,4,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock Text="ЧТО НОВОГО" FontFamily="{StaticResource HeadingFont}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextWhite}" VerticalAlignment="Center" />
                                <Border Background="{StaticResource EmberBrush}" CornerRadius="3" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding WhatsNewVersion}" FontFamily="{StaticResource MainFont}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryActionText}" />
                                </Border>
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource BorderSubtle}" />
                        </StackPanel>

                        <!-- 3 главных пункта -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding TopWhatsNewLines}" VerticalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Style="{StaticResource IconPath}" Data="{StaticResource IconCheck}" Width="12" Height="12" Stroke="{StaticResource EmberBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" FontFamily="{StaticResource MainFont}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Text90}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Кнопка "Все изменения" -->
                        <Button Grid.Row="2"
                                Command="{Binding DataContext.OpenChangelogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource SettingsActionBtn}"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconInfo}" Width="14" Height="14" Margin="0,0,6,0" Stroke="{StaticResource InkBrush}" />
                                <TextBlock Text="Все изменения" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
