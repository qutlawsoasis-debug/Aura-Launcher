<UserControl x:Class="AuraLauncher.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Focusable="False"
             FocusVisualStyle="{x:Null}"
             ClipToBounds="False"
             Background="Transparent">


    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="Transparent" Focusable="False" FocusVisualStyle="{x:Null}" ClipToBounds="False">
        <!-- Main StackPanel anchored to the bottom-left of the content area -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Focusable="False" FocusVisualStyle="{x:Null}">
            
            <!-- 1) Line "Minecraft 1.20.1, Fabric 0.19.5, 93 мода" and "Список изменений" link -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="{Binding SpecLine}"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="15"
                           FontWeight="Normal"
                           Foreground="{StaticResource DimInkBrush}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="12" Opacity="0.7" Direction="0" ShadowDepth="0" />
                    </TextBlock.Effect>
                </TextBlock>
                <Border Width="1" Height="12" Background="{StaticResource LineInkBrush}" Margin="10,0,10,0" VerticalAlignment="Center" />
                <Button Command="{Binding DataContext.OpenChangelogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource GhostBtn}"
                        Padding="0" VerticalAlignment="Center">
                    <TextBlock Text="Список изменений"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               Foreground="{StaticResource EmberBrush}"
                               TextDecorations="Underline">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="8" Opacity="0.6" Direction="0" ShadowDepth="0" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Button>
            </StackPanel>

            <!-- Playtime & launches statistic badge -->
            <TextBlock Text="{Binding PlaytimeSummaryText}"
                       FontFamily="{StaticResource MainFont}"
                       FontSize="13"
                       FontWeight="Normal"
                       Foreground="{StaticResource MuteBrush}"
                       Margin="0,0,0,14">
                <TextBlock.Effect>
                    <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="8" Opacity="0.6" Direction="0" ShadowDepth="0" />
                </TextBlock.Effect>
            </TextBlock>

            <!-- 3) Button "Играть" 260x70 with bottom progress bar, right of it label MaxWidth 300 wrap -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="260" Height="70">
                    <Button Command="{Binding DataContext.LaunchOrCancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource OverviewPlayBtn}"
                            Content="{Binding DataContext.LaunchButtonText, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <!-- Bottom 5px launch progress bar within button bounds -->
                    <ProgressBar Height="5" VerticalAlignment="Bottom"
                                 HorizontalAlignment="Stretch"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource EmberDarkBrush}"
                                 Value="{Binding DataContext.ProgressPercentage, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Visibility="{Binding DataContext.IsProgressVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- Right of button: MaxWidth 300, TextWrapping=Wrap, no clipping -->
                <StackPanel VerticalAlignment="Center" Margin="18,0,0,0" MaxWidth="300">
                    <!-- Extra state indicator when launching or running -->
                    <TextBlock Text="{Binding DataContext.StateTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource EmberBrush}"
                               Margin="0,0,0,2"
                               MaxWidth="300"
                               TextWrapping="Wrap"
                               Visibility="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding DataContext.AllocatedRamText, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               FontWeight="Normal"
                               Foreground="{StaticResource MuteBrush}"
                               MaxWidth="300"
                               TextWrapping="Wrap">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="12" Opacity="0.7" Direction="0" ShadowDepth="0" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- ============================================== -->
        <!-- STORIES RAIL (ПРАВАЯ КОЛОНКА В ФОРМАТЕ STORIES) -->
        <!-- ============================================== -->
        <Grid x:Name="StoriesRail"
              HorizontalAlignment="Right"
              VerticalAlignment="Stretch"
              Width="320"
              MinWidth="280"
              MaxWidth="360"
              Margin="0,-64,-56,-44"
              ClipToBounds="True"
              UseLayoutRounding="True"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="StoriesRailTranslate" X="0" />
            </Grid.RenderTransform>

            <!-- СЛОЙ 1: СЛАЙДЫ (Слайд занимает колонку целиком, Stretch=UniformToFill) -->
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
                <!-- СЛАЙД 0: «Скриншоты» -->
                <Grid x:Name="SlideScreenshots" Opacity="1.0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
                    <!-- Фон: скриншот если есть, иначе арт-фон лаунчера -->
                    <Image Source="{Binding LatestScreenshot.Thumbnail}"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasLatestScreenshot, Converter={StaticResource BoolToVis}}" />
                    <Image Source="{Binding LauncherBackground}"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasLatestScreenshot, Converter={StaticResource InverseBoolToVis}}" />

                    <!-- Локальное затемнение снизу вверх на нижних 55% высоты -->
                    <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="{StaticResource ColorStoriesShadeTransparent}" Offset="0.45" />
                                <GradientStop Color="{StaticResource ColorStoriesShadeBottom}" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- СЛОЙ ЗОН КЛИКА (Panel.ZIndex 5, под текстом со ссылками ZIndex 10) -->
                    <Grid Panel.ZIndex="5"
                          Background="Transparent"
                          PreviewMouseLeftButtonDown="StoriesRail_MouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="StoriesRail_MouseLeftButtonUp"
                          LostMouseCapture="StoriesRail_LostMouseCapture">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30*" />
                            <ColumnDefinition Width="70*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="Transparent" />
                        <Border Grid.Column="1" Background="Transparent" />
                    </Grid>

                    <!-- Текстовое содержимое внизу слайда (Panel.ZIndex 10 чтобы ссылки были выше зон клика) -->
                    <Grid VerticalAlignment="Bottom" Margin="20,0,20,24" Panel.ZIndex="10">
                        <!-- Если скриншот есть -->
                        <StackPanel Visibility="{Binding HasLatestScreenshot, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="ПОСЛЕДНИЙ СКРИНШОТ"
                                       FontFamily="{StaticResource MainFont}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource StoriesTextSecondary}"
                                       Margin="0,0,0,6" />

                            <TextBlock Text="{Binding LatestScreenshotDateText}"
                                       FontFamily="{StaticResource MainFont}"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />

                            <Button Command="{Binding DataContext.OpenOverviewScreenshotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding LatestScreenshot}"
                                    Style="{StaticResource GhostBtn}"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    Cursor="Hand">
                                <TextBlock Text="Открыть"
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="14"
                                           Foreground="{DynamicResource Accent}"
                                           TextDecorations="Underline" />
                            </Button>
                        </StackPanel>

                        <!-- Если скриншотов нет -->
                        <StackPanel Visibility="{Binding HasLatestScreenshot, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="Нажмите F2 в игре, чтобы сделать скриншот"
                                       FontFamily="{StaticResource MainFont}"
                                       FontSize="14"
                                       Foreground="{DynamicResource StoriesTextSecondary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- СЛАЙД 1: «Достижения» -->
                <Grid x:Name="SlideAchievements" Opacity="0.0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
                    <!-- Фон: арт-фон лаунчера другим кропом (HorizontalAlignment=Left) -->
                    <Image Source="{Binding LauncherBackground}"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <!-- Затемнение BgBase 55% -->
                    <Rectangle Fill="{DynamicResource BgBase}" Opacity="0.55" IsHitTestVisible="False" />

                    <!-- Локальное затемнение снизу вверх на нижних 55% высоты -->
                    <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="{StaticResource ColorStoriesShadeTransparent}" Offset="0.45" />
                                <GradientStop Color="{StaticResource ColorStoriesShadeBottom}" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- СЛОЙ ЗОН КЛИКА (Panel.ZIndex 5, под текстом со ссылками ZIndex 10) -->
                    <Grid Panel.ZIndex="5"
                          Background="Transparent"
                          PreviewMouseLeftButtonDown="StoriesRail_MouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="StoriesRail_MouseLeftButtonUp"
                          LostMouseCapture="StoriesRail_LostMouseCapture">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30*" />
                            <ColumnDefinition Width="70*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="Transparent" />
                        <Border Grid.Column="1" Background="Transparent" />
                    </Grid>

                    <!-- Текстовое содержимое внизу слайда -->
                    <Grid VerticalAlignment="Bottom" Margin="20,0,20,24" Panel.ZIndex="10">
                        <StackPanel>
                            <TextBlock Text="ДОСТИЖЕНИЕ"
                                       FontFamily="{StaticResource MainFont}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource StoriesTextSecondary}"
                                       Margin="0,0,0,6" />

                            <TextBlock Text="{Binding AchievementTitle}"
                                       FontFamily="{StaticResource HeadingFont}"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxHeight="76"
                                       ToolTip="{Binding AchievementTitle}"
                                       Margin="0,0,0,6" />

                            <TextBlock Text="{Binding AchievementDescription}"
                                       FontFamily="{StaticResource MainFont}"
                                       FontSize="14"
                                       Foreground="{DynamicResource StoriesTextSecondary}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxHeight="62"
                                       ToolTip="{Binding AchievementDescription}"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="{Binding AchievementDateOrProgress}"
                                       FontFamily="{StaticResource MainFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap"
                                       ToolTip="{Binding AchievementDateOrProgress}"
                                       Margin="0,0,0,4" />

                            <Button Command="{Binding OpenAchievementsCommand}"
                                    Style="{StaticResource GhostBtn}"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    Cursor="Hand"
                                    Visibility="{Binding HasAchievementsPage, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Открыть"
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="14"
                                           Foreground="{DynamicResource Accent}"
                                           TextDecorations="Underline" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- СЛАЙД 2: «Обновления» -->
                <Grid x:Name="SlideUpdates" Opacity="0.0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
                    <!-- Фон: арт-фон лаунчера другим кропом (HorizontalAlignment=Right) -->
                    <Image Source="{Binding LauncherBackground}"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <!-- Затемнение 55% -->
                    <Rectangle Fill="{DynamicResource BgBase}" Opacity="0.55" IsHitTestVisible="False" />

                    <!-- Локальное затемнение снизу вверх на нижних 55% высоты -->
                    <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="{StaticResource ColorStoriesShadeTransparent}" Offset="0.45" />
                                <GradientStop Color="{StaticResource ColorStoriesShadeBottom}" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- СЛОЙ ЗОН КЛИКА (Panel.ZIndex 5, под текстом со ссылками ZIndex 10) -->
                    <Grid Panel.ZIndex="5"
                          Background="Transparent"
                          PreviewMouseLeftButtonDown="StoriesRail_MouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="StoriesRail_MouseLeftButtonUp"
                          LostMouseCapture="StoriesRail_LostMouseCapture">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30*" />
                            <ColumnDefinition Width="70*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="Transparent" />
                        <Border Grid.Column="1" Background="Transparent" />
                    </Grid>

                    <!-- Текстовое содержимое внизу слайда -->
                    <Grid VerticalAlignment="Bottom" Margin="20,0,20,24" Panel.ZIndex="10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="ЧТО НОВОГО · "
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource StoriesTextSecondary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding WhatsNewVersion}"
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- 3 строки изменений текущей версии (Onest 14, суммарно MaxLines 5) -->
                            <ItemsControl ItemsSource="{Binding WhatsNewLines}" MaxHeight="105" ClipToBounds="True" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="{StaticResource MainFont}"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}"
                                                   Margin="0,0,0,6" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Command="{Binding DataContext.OpenChangelogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource GhostBtn}"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    Cursor="Hand">
                                <TextBlock Text="Все изменения"
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="14"
                                           Foreground="{DynamicResource Accent}"
                                           TextDecorations="Underline" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- СЛОЙ 3: ВЕРТИКАЛЬНОЕ ЗАТЕМНЕНИЕ ВЕРХНИХ 56 PX (Panel.ZIndex 15) -->
            <Border Height="56" VerticalAlignment="Top" IsHitTestVisible="False" Panel.ZIndex="15">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{StaticResource ColorStoriesHeaderShade}" Offset="0.0" />
                        <GradientStop Color="{StaticResource ColorStoriesShadeTransparent}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- СЛОЙ 4: ПОЛОСЫ ПРОГРЕССА (3 СЕГМЕНТА) (Panel.ZIndex 20) -->
            <Grid VerticalAlignment="Top" Margin="12,12,12,0" Panel.ZIndex="20" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Height="3" CornerRadius="3" Background="{DynamicResource StoriesTrack}" ClipToBounds="True">
                    <Border x:Name="ProgressFill0" Height="3" CornerRadius="3" Background="{DynamicResource StoriesFill}"
                            RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressScale0" ScaleX="0" />
                        </Border.RenderTransform>
                    </Border>
                </Border>

                <Border Grid.Column="2" Height="3" CornerRadius="3" Background="{DynamicResource StoriesTrack}" ClipToBounds="True">
                    <Border x:Name="ProgressFill1" Height="3" CornerRadius="3" Background="{DynamicResource StoriesFill}"
                            RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressScale1" ScaleX="0" />
                        </Border.RenderTransform>
                    </Border>
                </Border>

                <Border Grid.Column="4" Height="3" CornerRadius="3" Background="{DynamicResource StoriesTrack}" ClipToBounds="True">
                    <Border x:Name="ProgressFill2" Height="3" CornerRadius="3" Background="{DynamicResource StoriesFill}"
                            RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ProgressScale2" ScaleX="0" />
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
