<UserControl x:Class="AuraLauncher.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Focusable="False"
             FocusVisualStyle="{x:Null}"
             ClipToBounds="False"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="Transparent" Focusable="False" FocusVisualStyle="{x:Null}" ClipToBounds="False">
        <!-- Main StackPanel anchored to the bottom-left of the content area -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Focusable="False" FocusVisualStyle="{x:Null}">
            
            <!-- 1) Line "Minecraft 1.20.1, Fabric 0.19.5, 93 мода" and "Список изменений" link -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="{Binding SpecLine}"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="15"
                           FontWeight="Normal"
                           Foreground="{StaticResource DimInkBrush}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="12" Opacity="0.7" Direction="0" ShadowDepth="0" />
                    </TextBlock.Effect>
                </TextBlock>
                <Border Width="1" Height="12" Background="{StaticResource LineInkBrush}" Margin="10,0,10,0" VerticalAlignment="Center" />
                <Button Command="{Binding DataContext.OpenChangelogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource GhostBtn}"
                        Padding="0" VerticalAlignment="Center">
                    <TextBlock Text="Список изменений"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               Foreground="{StaticResource EmberBrush}"
                               TextDecorations="Underline">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="8" Opacity="0.6" Direction="0" ShadowDepth="0" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Button>
            </StackPanel>

            <!-- Playtime & launches statistic badge -->
            <TextBlock Text="{Binding PlaytimeSummaryText}"
                       FontFamily="{StaticResource MainFont}"
                       FontSize="13"
                       FontWeight="Normal"
                       Foreground="{StaticResource MuteBrush}"
                       Margin="0,0,0,14">
                <TextBlock.Effect>
                    <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="8" Opacity="0.6" Direction="0" ShadowDepth="0" />
                </TextBlock.Effect>
            </TextBlock>

            <!-- 3) Button "Играть" 260x70 with bottom progress bar, right of it label MaxWidth 300 wrap -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="260" Height="70">
                    <Button Command="{Binding DataContext.LaunchOrCancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource OverviewPlayBtn}"
                            Content="{Binding DataContext.LaunchButtonText, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <!-- Bottom 5px launch progress bar within button bounds -->
                    <ProgressBar Height="5" VerticalAlignment="Bottom"
                                 HorizontalAlignment="Stretch"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource EmberDarkBrush}"
                                 Value="{Binding DataContext.ProgressPercentage, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Visibility="{Binding DataContext.IsProgressVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- Right of button: MaxWidth 300, TextWrapping=Wrap, no clipping -->
                <StackPanel VerticalAlignment="Center" Margin="18,0,0,0" MaxWidth="300">
                    <!-- Extra state indicator when launching or running -->
                    <TextBlock Text="{Binding DataContext.StateTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource EmberBrush}"
                               Margin="0,0,0,2"
                               MaxWidth="300"
                               TextWrapping="Wrap"
                               Visibility="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding DataContext.AllocatedRamText, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               FontWeight="Normal"
                               Foreground="{StaticResource MuteBrush}"
                               MaxWidth="300"
                               TextWrapping="Wrap">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="12" Opacity="0.7" Direction="0" ShadowDepth="0" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Правая колонка: Единая стеклянная карточка карусели историй (Скриншот, Достижения, Что нового) -->
        <Border x:Name="StoriesRail"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Width="320"
                MinWidth="280"
                MaxWidth="360"
                Margin="0,0,0,0"
                Padding="16"
                CornerRadius="3"
                Background="{DynamicResource ShadeOverlay}"
                BorderBrush="{StaticResource LineInkBrush}"
                BorderThickness="1"
                ClipToBounds="True"
                UseLayoutRounding="True"
                MouseEnter="StoriesRail_MouseEnter"
                MouseLeave="StoriesRail_MouseLeave">

            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- 1. Верхний прогресс-бар из 3 сегментов -->
                    <RowDefinition Height="*" />    <!-- 2. Активный слайд истории -->
                </Grid.RowDefinitions>

                <!-- 1. ИНДИКАТОРЫ ИСТОРИЙ (3 сегмента: Скриншот, Достижения, Что нового) -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Сегмент 0: Скриншот -->
                    <Button Grid.Column="0" Click="OnStoryBar0Click" Style="{StaticResource StoryBarBtn}" ToolTip="Скриншот">
                        <Border Height="4" Background="{StaticResource TrackSubtle}" CornerRadius="2" ClipToBounds="True">
                            <Border x:Name="Story0Fill" Background="{StaticResource EmberBrush}" CornerRadius="2" RenderTransformOrigin="0,0">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="Story0Scale" ScaleX="0" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Button>

                    <!-- Сегмент 1: Достижения -->
                    <Button Grid.Column="2" Click="OnStoryBar1Click" Style="{StaticResource StoryBarBtn}" ToolTip="Достижения и цели">
                        <Border Height="4" Background="{StaticResource TrackSubtle}" CornerRadius="2" ClipToBounds="True">
                            <Border x:Name="Story1Fill" Background="{StaticResource EmberBrush}" CornerRadius="2" RenderTransformOrigin="0,0">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="Story1Scale" ScaleX="0" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Button>

                    <!-- Сегмент 2: Что нового -->
                    <Button Grid.Column="4" Click="OnStoryBar2Click" Style="{StaticResource StoryBarBtn}" ToolTip="Что нового">
                        <Border Height="4" Background="{StaticResource TrackSubtle}" CornerRadius="2" ClipToBounds="True">
                            <Border x:Name="Story2Fill" Background="{StaticResource EmberBrush}" CornerRadius="2" RenderTransformOrigin="0,0">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="Story2Scale" ScaleX="0" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Button>
                </Grid>

                <!-- 2. СЛАЙДЫ ИСТОРИЙ (На всю оставшуюся высоту панели) -->
                <Grid Grid.Row="1">

                    <!-- СЛАЙД 0: ПОСЛЕДНИЙ СКРИНШОТ -->
                    <Grid Visibility="{Binding IsStory0Active, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCamera}" Width="14" Height="14" Stroke="{StaticResource DimInkBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="ПОСЛЕДНИЙ СКРИНШОТ" FontFamily="{StaticResource MainFont}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource MuteBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Картинка скриншота или пустое состояние -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Border Visibility="{Binding HasLatestScreenshot, Converter={StaticResource BoolToVis}}"
                                    CornerRadius="3" ClipToBounds="True" Background="{DynamicResource PanelCard}" BorderBrush="{StaticResource LineInkBrush}" BorderThickness="1">
                                <Grid>
                                    <Image Source="{Binding FeedImage0}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Border VerticalAlignment="Bottom" Background="{DynamicResource DialogBackdrop}" Padding="10,8">
                                        <TextBlock Text="{Binding LatestScreenshotDateText}" FontFamily="{StaticResource MainFont}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextWhite}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Visibility="{Binding HasLatestScreenshot, Converter={StaticResource InverseBoolToVis}}"
                                    CornerRadius="3" Background="{DynamicResource PanelCard}" BorderBrush="{StaticResource LineInkBrush}" BorderThickness="1" Padding="16">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCamera}" Width="32" Height="32" Stroke="{StaticResource MuteBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                    <TextBlock Text="Скриншотов пока нет" FontFamily="{StaticResource MainFont}" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextWhite}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                    <TextBlock Text="Нажмите F2 во время игры, чтобы сделать скриншот" FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource DimInkBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Кнопка "Открыть скриншот" -->
                        <Button Grid.Row="2"
                                Command="{Binding DataContext.OpenOverviewScreenshotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding LatestScreenshot}"
                                Style="{StaticResource SettingsActionBtn}"
                                HorizontalAlignment="Stretch"
                                Visibility="{Binding HasLatestScreenshot, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconFolderOpen}" Width="14" Height="14" Margin="0,0,6,0" Stroke="{StaticResource InkBrush}" />
                                <TextBlock Text="Открыть скриншот" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- СЛАЙД 1: ДОСТИЖЕНИЯ И СЛЕДУЮЩАЯ ЦЕЛЬ -->
                    <Grid Visibility="{Binding IsStory1Active, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCrown}" Width="14" Height="14" Stroke="{StaticResource EmberBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="ДОСТИЖЕНИЯ И ЦЕЛИ" FontFamily="{StaticResource MainFont}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource MuteBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{StaticResource AuraScrollViewer}">
                            <StackPanel>
                                <!-- Последнее полученное достижение -->
                                <Border Background="{DynamicResource PanelCard}" BorderBrush="{StaticResource LineInkBrush}" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="ПОСЛЕДНЕЕ ДОСТИЖЕНИЕ" FontFamily="{StaticResource MainFont}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource EmberBrush}" />
                                            <TextBlock Text="{Binding AchievementDateOrProgress}" FontFamily="{StaticResource MainFont}" FontSize="11" Foreground="{StaticResource EmberBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <TextBlock Text="{Binding AchievementTitle}" FontFamily="{StaticResource HeadingFont}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextWhite}" TextWrapping="Wrap" Margin="0,2,0,4" />
                                        <TextBlock Text="{Binding AchievementDescription}" FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource DimInkBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Следующая цель -->
                                <Border Background="{DynamicResource PanelCard}" BorderBrush="{StaticResource LineInkBrush}" BorderThickness="1" CornerRadius="3" Padding="12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="СЛЕДУЮЩАЯ ЦЕЛЬ" FontFamily="{StaticResource MainFont}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MuteBrush}" />
                                            <TextBlock Text="{Binding NextAchievementProgress}" FontFamily="{StaticResource MainFont}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource EmberBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <TextBlock Text="{Binding NextAchievementTitle}" FontFamily="{StaticResource HeadingFont}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextWhite}" TextWrapping="Wrap" Margin="0,2,0,4" />
                                        <TextBlock Text="{Binding NextAchievementDescription}" FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource DimInkBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <TextBlock Grid.Row="2" Text="Выполняйте цели во время игры!" FontFamily="{StaticResource MainFont}" FontSize="11" Foreground="{StaticResource MuteBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </Grid>

                    <!-- СЛАЙД 2: ЧТО НОВОГО -->
                    <Grid Visibility="{Binding IsStory2Active, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconInfo}" Width="14" Height="14" Stroke="{StaticResource EmberBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="ОБНОВЛЕНИЕ" FontFamily="{StaticResource MainFont}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource MuteBrush}" VerticalAlignment="Center" />
                            <Border Background="{StaticResource EmberBrush}" CornerRadius="2" Padding="6,1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding WhatsNewVersion}" FontFamily="{StaticResource MainFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryActionText}" />
                            </Border>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{StaticResource AuraScrollViewer}" Margin="0,0,0,10">
                            <ItemsControl ItemsSource="{Binding WhatsNewLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="•" FontFamily="{StaticResource MainFont}" FontSize="14" Foreground="{StaticResource EmberBrush}" VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1" Text="{Binding}" FontFamily="{StaticResource MainFont}" FontSize="12" Foreground="{StaticResource TextWhite}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button Grid.Row="2"
                                Command="{Binding DataContext.OpenChangelogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Style="{StaticResource SettingsActionBtn}"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconInfo}" Width="14" Height="14" Margin="0,0,6,0" Stroke="{StaticResource InkBrush}" />
                                <TextBlock Text="Все изменения" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
