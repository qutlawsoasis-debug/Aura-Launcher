<UserControl x:Class="AuraLauncher.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Focusable="False"
             FocusVisualStyle="{x:Null}"
             ClipToBounds="False"
             Background="Transparent">


    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="FeedTextPrimary" Color="#E8F0F8" />
        <SolidColorBrush x:Key="FeedTextSecondary" Color="#B8E8F0F8" />
    </UserControl.Resources>

    <Grid Background="Transparent" Focusable="False" FocusVisualStyle="{x:Null}" ClipToBounds="False">
        <!-- Main StackPanel anchored to the bottom-left of the content area -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Focusable="False" FocusVisualStyle="{x:Null}">
            
            <!-- 1) Line "Minecraft 1.20.1, Fabric 0.19.5, 93 мода" and "Список изменений" link -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="{Binding SpecLine}"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="15"
                           FontWeight="Normal"
                           Foreground="{StaticResource DimInkBrush}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="12" Opacity="0.7" Direction="0" ShadowDepth="0" />
                    </TextBlock.Effect>
                </TextBlock>
                <Border Width="1" Height="12" Background="{StaticResource LineInkBrush}" Margin="10,0,10,0" VerticalAlignment="Center" />
                <Button Command="{Binding DataContext.OpenChangelogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource GhostBtn}"
                        Padding="0" VerticalAlignment="Center">
                    <TextBlock Text="Список изменений"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               Foreground="{StaticResource EmberBrush}"
                               TextDecorations="Underline">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="8" Opacity="0.6" Direction="0" ShadowDepth="0" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Button>
            </StackPanel>

            <!-- Playtime & launches statistic badge -->
            <TextBlock Text="{Binding PlaytimeSummaryText}"
                       FontFamily="{StaticResource MainFont}"
                       FontSize="13"
                       FontWeight="Normal"
                       Foreground="{StaticResource MuteBrush}"
                       Margin="0,0,0,14">
                <TextBlock.Effect>
                    <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="8" Opacity="0.6" Direction="0" ShadowDepth="0" />
                </TextBlock.Effect>
            </TextBlock>

            <!-- 3) Button "Играть" 260x70 with bottom progress bar, right of it label MaxWidth 300 wrap -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="260" Height="70">
                    <Button Command="{Binding DataContext.LaunchOrCancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource OverviewPlayBtn}"
                            Content="{Binding DataContext.LaunchButtonText, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <!-- Bottom 5px launch progress bar within button bounds -->
                    <ProgressBar Height="5" VerticalAlignment="Bottom"
                                 HorizontalAlignment="Stretch"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource EmberDarkBrush}"
                                 Value="{Binding DataContext.ProgressPercentage, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Visibility="{Binding DataContext.IsProgressVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- Right of button: MaxWidth 300, TextWrapping=Wrap, no clipping -->
                <StackPanel VerticalAlignment="Center" Margin="18,0,0,0" MaxWidth="300">
                    <!-- Extra state indicator when launching or running -->
                    <TextBlock Text="{Binding DataContext.StateTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource EmberBrush}"
                               Margin="0,0,0,2"
                               MaxWidth="300"
                               TextWrapping="Wrap"
                               Visibility="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding DataContext.AllocatedRamText, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               FontWeight="Normal"
                               Foreground="{StaticResource MuteBrush}"
                               MaxWidth="300"
                               TextWrapping="Wrap">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="12" Opacity="0.7" Direction="0" ShadowDepth="0" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- ПРАВАЯ КОЛОНКА (ЛЕНТА НА ГЛАВНОМ ЭКРАНЕ) -->
        <Grid HorizontalAlignment="Right"
              VerticalAlignment="Stretch"
              Width="340"
              MinWidth="300"
              MaxWidth="380"
              Margin="0,160,0,135"
              ClipToBounds="False"
              Visibility="{Binding HasRightFeed, Converter={StaticResource BoolToVis}}">

            <!-- Мягкое затемнение фона под колонкой для читаемости текста на арт-фонах -->
            <Border HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsHitTestVisible="False"
                    Margin="-16,-16,-16,-16"
                    CornerRadius="3">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00091015" Offset="0.0" />
                        <GradientStop Color="#60091015" Offset="0.25" />
                        <GradientStop Color="#8C091015" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- ScrollViewer на случай нехватки вертикального места -->
            <ScrollViewer Style="{StaticResource AuraScrollViewer}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Focusable="False">
                <StackPanel Focusable="False">
                    <!-- 1. Блок «Последний скриншот» -->
                    <Border x:Name="FeedBlockScreenshot"
                            Opacity="0"
                            Margin="0,0,0,28"
                            Visibility="{Binding HasLatestScreenshot, Converter={StaticResource BoolToVis}}">
                        <Border.RenderTransform>
                            <TranslateTransform X="16" />
                        </Border.RenderTransform>
                        <StackPanel>
                            <TextBlock Text="ПОСЛЕДНИЙ СКРИНШОТ"
                                       FontFamily="{StaticResource MainFont}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource FeedTextSecondary}"
                                       Margin="0,0,0,8" />

                            <Button Command="{Binding DataContext.OpenOverviewScreenshotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding LatestScreenshot}"
                                    Style="{StaticResource GhostBtn}"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Cursor="Hand">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <Border CornerRadius="3"
                                            ClipToBounds="True"
                                            MaxHeight="190"
                                            Background="#0C141A"
                                            HorizontalAlignment="Stretch">
                                        <Image Source="{Binding LatestScreenshot.Thumbnail}"
                                               Stretch="UniformToFill"
                                               MaxHeight="190"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               SizeChanged="ScreenshotImage_SizeChanged" />
                                    </Border>

                                    <TextBlock Text="{Binding LatestScreenshotDateText}"
                                               FontFamily="{StaticResource MainFont}"
                                               FontSize="12"
                                               Foreground="{StaticResource FeedTextSecondary}"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 2. Блок «Достижение» -->
                    <Border x:Name="FeedBlockAchievement"
                            Opacity="0"
                            Margin="0,0,0,28"
                            Visibility="{Binding HasAchievementBlock, Converter={StaticResource BoolToVis}}">
                        <Border.RenderTransform>
                            <TranslateTransform X="16" />
                        </Border.RenderTransform>
                        <Button Command="{Binding OpenAchievementsCommand}"
                                Style="{StaticResource GhostBtn}"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Cursor="Hand">
                            <StackPanel HorizontalAlignment="Stretch">
                                <TextBlock Text="ДОСТИЖЕНИЕ"
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource FeedTextSecondary}"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="{Binding AchievementTitle}"
                                           FontFamily="{StaticResource HeadingFont}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource FeedTextPrimary}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,4" />

                                <TextBlock Text="{Binding AchievementDescription}"
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="14"
                                           Foreground="{StaticResource FeedTextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6" />

                                <TextBlock Text="{Binding AchievementDateOrProgress}"
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource FeedTextSecondary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- 3. Блок «Что нового» -->
                    <Border x:Name="FeedBlockWhatsNew"
                            Opacity="0"
                            Margin="0,0,0,16"
                            Visibility="{Binding HasWhatsNewBlock, Converter={StaticResource BoolToVis}}">
                        <Border.RenderTransform>
                            <TranslateTransform X="16" />
                        </Border.RenderTransform>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="ЧТО НОВОГО • "
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource FeedTextSecondary}" />
                                <TextBlock Text="{Binding WhatsNewVersion}"
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Accent}" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding WhatsNewLines}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="{StaticResource MainFont}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource FeedTextPrimary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Command="{Binding DataContext.OpenChangelogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource GhostBtn}"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    Cursor="Hand">
                                <TextBlock Text="Все изменения"
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="13"
                                           Foreground="{StaticResource Accent}"
                                           TextDecorations="Underline" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
