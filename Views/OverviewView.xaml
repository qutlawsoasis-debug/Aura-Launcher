<UserControl x:Class="AuraLauncher.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="620" d:DesignWidth="908"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="Transparent">
        <!-- Main Overlay Layout: Bottom area contains bottom-left play section and bottom-right "What's New" row -->
        <Grid VerticalAlignment="Bottom" Margin="40,0,40,36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ============================================== -->
            <!-- BOTTOM-LEFT: Pack title, spec line, button, RAM -->
            <!-- ============================================== -->
            <StackPanel Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                <!-- Pack Title (Unbounded Bold) -->
                <TextBlock Text="{Binding BuildName}"
                           FontFamily="{StaticResource HeadingFont}"
                           FontSize="40"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,4">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="12" Opacity="0.7" Direction="270" ShadowDepth="2" />
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Spec Line in One Line: "Minecraft 1.20.1 • Fabric • 68 модов" -->
                <TextBlock Text="{Binding SpecLine}"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,24">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="8" Opacity="0.7" Direction="270" ShadowDepth="1" />
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Status & Progress Bar (when busy/installing/launching) -->
                <StackPanel Margin="0,0,0,12"
                            Visibility="{Binding DataContext.IsProgressVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding DataContext.StatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,6" />
                    <ProgressBar Height="4" Width="220" HorizontalAlignment="Left"
                                 Style="{StaticResource NeonProgressBar}"
                                 Value="{Binding DataContext.ProgressPercentage, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>

                <!-- Status text when busy but without progress bar -->
                <TextBlock Text="{Binding DataContext.StateTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="SemiBold"
                           Margin="0,0,0,10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.IsGameRunning, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Large "Играть" Button -->
                <Button Command="{Binding DataContext.LaunchOrCancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource PrimaryNeonBtn}"
                        Width="220" Height="48"
                        Content="{Binding DataContext.LaunchButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                        FontSize="15"
                        FontWeight="Bold"
                        Margin="0,0,0,8" />

                <!-- Small RAM Text below button: "Выделено 6 ГБ ОЗУ" -->
                <TextBlock Text="{Binding DataContext.AllocatedRamText, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="4,0,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="6" Opacity="0.5" Direction="270" ShadowDepth="1" />
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>

            <!-- ============================================== -->
            <!-- BOTTOM-RIGHT: Horizontal row of 3 "Что нового" cards -->
            <!-- ============================================== -->
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <TextBlock Text="Что нового"
                           FontFamily="{StaticResource HeadingFont}"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,10"
                           HorizontalAlignment="Right" />

                <ItemsControl ItemsSource="{Binding WhatsNewCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.OpenPatchNotesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Cursor="Hand" Margin="0,0,12,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CardBrd"
                                                Width="148" Height="106"
                                                Background="#D8181C24"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12,10">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="CardTrans" Y="0" />
                                            </Border.RenderTransform>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <!-- Version Tag -->
                                                <Border Grid.Row="0" HorizontalAlignment="Left"
                                                        Background="#172C24" CornerRadius="3" Padding="5,2" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Version}"
                                                               FontSize="10" FontWeight="Bold"
                                                               Foreground="{StaticResource AccentBrush}" />
                                                </Border>

                                                <!-- Date -->
                                                <TextBlock Grid.Row="1" Text="{Binding Date}"
                                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="0,0,0,4" />

                                                <!-- Title / Summary -->
                                                <TextBlock Grid.Row="2" Text="{Binding Title}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBrd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter TargetName="CardBrd" Property="Background" Value="#E01F242E" />
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="CardTrans" Storyboard.TargetProperty="Y"
                                                                             To="-1" Duration="0:0:0.120">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="CardTrans" Storyboard.TargetProperty="Y"
                                                                             To="0" Duration="0:0:0.120">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
