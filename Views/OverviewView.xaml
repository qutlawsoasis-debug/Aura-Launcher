<UserControl x:Class="AuraLauncher.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Focusable="False"
             FocusVisualStyle="{x:Null}"
             ClipToBounds="False"
             Background="Transparent">


    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="Transparent" Focusable="False" FocusVisualStyle="{x:Null}" ClipToBounds="False">
        <!-- Main StackPanel anchored to the bottom-left of the content area -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Focusable="False" FocusVisualStyle="{x:Null}">
            
            <!-- 1) Line "Minecraft 1.20.1, Fabric 0.19.5, 93 мода" and "Список изменений" link -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="{Binding SpecLine}"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="15"
                           FontWeight="Normal"
                           Foreground="{StaticResource DimInkBrush}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="12" Opacity="0.7" Direction="0" ShadowDepth="0" />
                    </TextBlock.Effect>
                </TextBlock>
                <Border Width="1" Height="12" Background="{StaticResource LineInkBrush}" Margin="10,0,10,0" VerticalAlignment="Center" />
                <Button Command="{Binding DataContext.OpenChangelogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource GhostBtn}"
                        Padding="0" VerticalAlignment="Center">
                    <TextBlock Text="Список изменений"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               Foreground="{StaticResource EmberBrush}"
                               TextDecorations="Underline">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="8" Opacity="0.6" Direction="0" ShadowDepth="0" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Button>
            </StackPanel>

            <!-- Playtime & launches statistic badge -->
            <TextBlock Text="{Binding PlaytimeSummaryText}"
                       FontFamily="{StaticResource MainFont}"
                       FontSize="13"
                       FontWeight="Normal"
                       Foreground="{StaticResource MuteBrush}"
                       Margin="0,0,0,14">
                <TextBlock.Effect>
                    <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="8" Opacity="0.6" Direction="0" ShadowDepth="0" />
                </TextBlock.Effect>
            </TextBlock>

            <!-- 3) Button "Играть" 260x70 with bottom progress bar, right of it label MaxWidth 300 wrap -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="260" Height="70">
                    <Button Command="{Binding DataContext.LaunchOrCancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource OverviewPlayBtn}"
                            Content="{Binding DataContext.LaunchButtonText, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <!-- Bottom 5px launch progress bar within button bounds -->
                    <ProgressBar Height="5" VerticalAlignment="Bottom"
                                 HorizontalAlignment="Stretch"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource EmberDarkBrush}"
                                 Value="{Binding DataContext.ProgressPercentage, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Visibility="{Binding DataContext.IsProgressVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- Right of button: MaxWidth 300, TextWrapping=Wrap, no clipping -->
                <StackPanel VerticalAlignment="Center" Margin="18,0,0,0" MaxWidth="300">
                    <!-- Extra state indicator when launching or running -->
                    <TextBlock Text="{Binding DataContext.StateTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource EmberBrush}"
                               Margin="0,0,0,2"
                               MaxWidth="300"
                               TextWrapping="Wrap"
                               Visibility="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding DataContext.AllocatedRamText, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="13"
                               FontWeight="Normal"
                               Foreground="{StaticResource MuteBrush}"
                               MaxWidth="300"
                               TextWrapping="Wrap">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{DynamicResource ColorShade}" BlurRadius="12" Opacity="0.7" Direction="0" ShadowDepth="0" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- ============================================== -->
        <!-- STORIES RAIL (КОМПАКТНЫЙ БЛОК STORIES СПРАВА)  -->
        <!-- ============================================== -->
        <Border x:Name="StoriesRail"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Width="320"
                MinWidth="280"
                MaxWidth="360"
                Margin="0,24,0,0"
                Padding="16"
                CornerRadius="3"
                Background="{DynamicResource StoriesDim55}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                ClipToBounds="True"
                UseLayoutRounding="True"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="StoriesRailTranslate" X="0" />
            </Border.RenderTransform>

            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ПОЛОСЫ ПРОГРЕССА (3 СЕГМЕНТА СВЕРХУ БЛОКА) -->
                <Grid Grid.Row="0" Margin="0,0,0,12" Panel.ZIndex="20" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Height="3" CornerRadius="3" Background="{DynamicResource StoriesTrack}" ClipToBounds="True">
                        <Border x:Name="ProgressFill0" Height="3" CornerRadius="3" Background="{DynamicResource StoriesFill}"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ProgressScale0" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>

                    <Border Grid.Column="2" Height="3" CornerRadius="3" Background="{DynamicResource StoriesTrack}" ClipToBounds="True">
                        <Border x:Name="ProgressFill1" Height="3" CornerRadius="3" Background="{DynamicResource StoriesFill}"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ProgressScale1" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>

                    <Border Grid.Column="4" Height="3" CornerRadius="3" Background="{DynamicResource StoriesTrack}" ClipToBounds="True">
                        <Border x:Name="ProgressFill2" Height="3" CornerRadius="3" Background="{DynamicResource StoriesFill}"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ProgressScale2" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                </Grid>

                <!-- СЛАЙДЫ (Картинка 16:9 внутри слайда + текст снизу) -->
                <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <!-- СЛАЙД 0: «Скриншоты» -->
                    <Grid x:Name="SlideScreenshots" Opacity="1.0" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                        <!-- СЛОЙ ЗОН КЛИКА (Panel.ZIndex 5, под кнопкой со ссылкой ZIndex 10) -->
                        <Grid Panel.ZIndex="5"
                              Background="Transparent"
                              PreviewMouseLeftButtonDown="StoriesRail_MouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="StoriesRail_MouseLeftButtonUp"
                              LostMouseCapture="StoriesRail_LostMouseCapture">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30*" />
                                <ColumnDefinition Width="70*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="Transparent" />
                            <Border Grid.Column="1" Background="Transparent" />
                        </Grid>

                        <StackPanel>
                            <!-- Горизонтальная картинка 16:9 -->
                            <Border Height="162"
                                    CornerRadius="3"
                                    ClipToBounds="True"
                                    Background="{DynamicResource Panel}"
                                    BorderBrush="{DynamicResource BorderSubtle}"
                                    BorderThickness="1"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Image Source="{Binding LatestScreenshot.Thumbnail}"
                                           Stretch="UniformToFill"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasLatestScreenshot, Converter={StaticResource BoolToVis}}" />
                                    <Image Source="{Binding LauncherBackground}"
                                           Stretch="UniformToFill"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasLatestScreenshot, Converter={StaticResource InverseBoolToVis}}" />
                                </Grid>
                            </Border>

                            <!-- Если скриншот есть -->
                            <StackPanel Visibility="{Binding HasLatestScreenshot, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10">
                                <TextBlock Text="ПОСЛЕДНИЙ СКРИНШОТ"
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource StoriesTextSecondary}"
                                           Margin="0,0,0,4" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding LatestScreenshotDateText}"
                                               FontFamily="{StaticResource MainFont}"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />

                                    <Button Grid.Column="1"
                                            Command="{Binding DataContext.OpenOverviewScreenshotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding LatestScreenshot}"
                                            Style="{StaticResource GhostBtn}"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0"
                                            Cursor="Hand">
                                        <TextBlock Text="Открыть"
                                                   FontFamily="{StaticResource MainFont}"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource Accent}"
                                                   TextDecorations="Underline" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Если скриншотов нет -->
                            <StackPanel Visibility="{Binding HasLatestScreenshot, Converter={StaticResource InverseBoolToVis}}" Panel.ZIndex="10">
                                <TextBlock Text="ПОСЛЕДНИЙ СКРИНШОТ"
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource StoriesTextSecondary}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="Нажмите F2 в игре, чтобы сделать скриншот"
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="14"
                                           Foreground="{DynamicResource StoriesTextSecondary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- СЛАЙД 1: «Достижения» -->
                    <Grid x:Name="SlideAchievements" Opacity="0.0" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                        <!-- СЛОЙ ЗОН КЛИКА -->
                        <Grid Panel.ZIndex="5"
                              Background="Transparent"
                              PreviewMouseLeftButtonDown="StoriesRail_MouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="StoriesRail_MouseLeftButtonUp"
                              LostMouseCapture="StoriesRail_LostMouseCapture">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30*" />
                                <ColumnDefinition Width="70*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="Transparent" />
                            <Border Grid.Column="1" Background="Transparent" />
                        </Grid>

                        <StackPanel>
                            <!-- Горизонтальная картинка 16:9 -->
                            <Border Height="162"
                                    CornerRadius="3"
                                    ClipToBounds="True"
                                    Background="{DynamicResource Panel}"
                                    BorderBrush="{DynamicResource BorderSubtle}"
                                    BorderThickness="1"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Image Source="{Binding LauncherBackground}"
                                           Stretch="UniformToFill"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Rectangle Fill="{DynamicResource BgBase}" Opacity="0.25" IsHitTestVisible="False" />
                                </Grid>
                            </Border>

                            <StackPanel Panel.ZIndex="10">
                                <TextBlock Text="ДОСТИЖЕНИЕ"
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource StoriesTextSecondary}"
                                           Margin="0,0,0,4" />

                                <TextBlock Text="{Binding AchievementTitle}"
                                           FontFamily="{StaticResource HeadingFont}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="58"
                                           ToolTip="{Binding AchievementTitle}"
                                           Margin="0,0,0,4" />

                                <TextBlock Text="{Binding AchievementDescription}"
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="13"
                                           Foreground="{DynamicResource StoriesTextSecondary}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="42"
                                           ToolTip="{Binding AchievementDescription}"
                                           Margin="0,0,0,6" />

                                <TextBlock Text="{Binding AchievementDateOrProgress}"
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextWrapping="Wrap"
                                           ToolTip="{Binding AchievementDateOrProgress}" />

                                <Button Command="{Binding OpenAchievementsCommand}"
                                        Style="{StaticResource GhostBtn}"
                                        Padding="0"
                                        Margin="0,6,0,0"
                                        HorizontalAlignment="Left"
                                        Cursor="Hand"
                                        Visibility="{Binding HasAchievementsPage, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Открыть"
                                               FontFamily="{StaticResource MainFont}"
                                               FontSize="14"
                                               Foreground="{DynamicResource Accent}"
                                               TextDecorations="Underline" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- СЛАЙД 2: «Обновления» -->
                    <Grid x:Name="SlideUpdates" Opacity="0.0" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                        <!-- СЛОЙ ЗОН КЛИКА -->
                        <Grid Panel.ZIndex="5"
                              Background="Transparent"
                              PreviewMouseLeftButtonDown="StoriesRail_MouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="StoriesRail_MouseLeftButtonUp"
                              LostMouseCapture="StoriesRail_LostMouseCapture">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30*" />
                                <ColumnDefinition Width="70*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="Transparent" />
                            <Border Grid.Column="1" Background="Transparent" />
                        </Grid>

                        <StackPanel>
                            <!-- Горизонтальная картинка 16:9 -->
                            <Border Height="162"
                                    CornerRadius="3"
                                    ClipToBounds="True"
                                    Background="{DynamicResource Panel}"
                                    BorderBrush="{DynamicResource BorderSubtle}"
                                    BorderThickness="1"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Image Source="{Binding LauncherBackground}"
                                           Stretch="UniformToFill"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Rectangle Fill="{DynamicResource BgBase}" Opacity="0.25" IsHitTestVisible="False" />
                                </Grid>
                            </Border>

                            <StackPanel Panel.ZIndex="10">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="ЧТО НОВОГО · "
                                               FontFamily="{StaticResource MainFont}"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource StoriesTextSecondary}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding WhatsNewVersion}"
                                               FontFamily="{StaticResource MainFont}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Accent}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding WhatsNewLines}" MaxHeight="96" ClipToBounds="True" Margin="0,0,0,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       FontFamily="{StaticResource MainFont}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding}"
                                                       Margin="0,0,0,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Command="{Binding DataContext.OpenChangelogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Style="{StaticResource GhostBtn}"
                                        Padding="0"
                                        HorizontalAlignment="Left"
                                        Cursor="Hand">
                                    <TextBlock Text="Все изменения"
                                               FontFamily="{StaticResource MainFont}"
                                               FontSize="14"
                                               Foreground="{DynamicResource Accent}"
                                               TextDecorations="Underline" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
