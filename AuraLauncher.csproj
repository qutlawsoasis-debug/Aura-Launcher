<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\aura-icon.ico</ApplicationIcon>
    <Version>1.2.164</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;spikes\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app_icon.png" />
    <Resource Include="app_icon.ico" />
    <Resource Include="Resources\aura-icon.ico" />
    <Resource Include="Resources\aura_logo.png" />
    <Resource Include="bg_world.png" />
    <Resource Include="Resources\Backgrounds\*.jpg" />
    <Resource Include="steve.png" />
    <Resource Include="Resources\Fonts\Manrope-*.ttf" />
    <Resource Include="Resources\Fonts\Oswald.ttf" />
    <Resource Include="Resources\Fonts\Onest.ttf" />
  </ItemGroup>

  <ItemGroup>
    <None Update="app_icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\aura-icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\aura_logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="version.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <Content Include="Data\achievements.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Data\presets.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="fNbt" Version="2.1.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.0" />
  </ItemGroup>

  <!-- Build UI distribution for WebShell on Release -->
  <Target Name="BuildWebUi" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="node -v" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="NodeExitCode" />
    </Exec>
    <Error Condition="'$(NodeExitCode)' != '0'" Text="Node.js не найден в PATH. Для сборки Release требуется Node.js." />
    
    <Message Importance="high" Text="==> Building UI distribution (npm run build)..." />
    <Exec Command="npm ci" WorkingDirectory="docs\redesign\v3" Condition="!Exists('docs\redesign\v3\node_modules')"
          ContinueOnError="false" />
    <Exec Command="npm run build" WorkingDirectory="docs\redesign\v3" />
    
    <ItemGroup>
      <UiDistFiles Include="docs\redesign\v3\dist\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(UiDistFiles)" DestinationFolder="$(TargetDir)ui\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- dotnet publish (build-release.ps1 → Velopack) пишет в PublishDir: интерфейс нужен и там -->
  <Target Name="PublishWebUi" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <UiPublishFiles Include="docs\redesign\v3\dist\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(UiPublishFiles)" DestinationFolder="$(PublishDir)ui\%(RecursiveDir)" />
    <Error Condition="!Exists('$(PublishDir)ui\index.html')" Text="Интерфейс не попал в публикацию: нет ui\index.html" />
  </Target>

</Project>
