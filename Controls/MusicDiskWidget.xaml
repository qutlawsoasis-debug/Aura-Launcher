<UserControl x:Class="AuraLauncher.Controls.MusicDiskWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Foreground="{StaticResource TextWhite}"
             FontFamily="{StaticResource MainFont}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- Белая иконка со скруглёнными углами и свечением -->
        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Fill" Value="{StaticResource TextWhite}"/>
            <Setter Property="Stroke" Value="{StaticResource TextWhite}"/>
            <Setter Property="StrokeThickness" Value="4"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect Color="{StaticResource ColorTextWhite}" BlurRadius="10" ShadowDepth="0" Opacity=".55"/></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PauseIcon" TargetType="Path" BasedOn="{StaticResource Icon}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying, ElementName=Root}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlayIcon" TargetType="Path" BasedOn="{StaticResource Icon}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying, ElementName=Root}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Дизайн-размер 660x300, дальше масштабируется Viewbox'ом -->
    <Viewbox Stretch="Uniform">
        <Grid Width="660" Height="300">
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,660,300" RadiusX="72" RadiusY="72"/>
            </Grid.Clip>

            <!-- Фон: запасной градиент + размытая обложка -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,.3" EndPoint="1,.7">
                        <GradientStop Color="{StaticResource ColorMusicDiskGrad1}" Offset="0"/>
                        <GradientStop Color="{StaticResource ColorMusicDiskGrad2}" Offset=".55"/>
                        <GradientStop Color="{StaticResource ColorMusicDiskGrad3}" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Image Source="{Binding Cover, ElementName=Root}" Stretch="UniformToFill"
                   Margin="-90" Opacity=".85" IsHitTestVisible="False">
                <Image.Effect><BlurEffect Radius="90" KernelType="Gaussian"/></Image.Effect>
                <!-- Эффект считается один раз, а не на каждом кадре вращения -->
                <Image.CacheMode><BitmapCache/></Image.CacheMode>
            </Image>
            <Rectangle Fill="{StaticResource MusicDiskPanelGlassBrush}"/>

            <Grid Margin="18,0,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Проигрыватель -->
                <Viewbox Grid.Column="0" Stretch="Uniform">
                    <Canvas Width="270" Height="280">

                        <Grid x:Name="Vinyl" Canvas.Left="3" Canvas.Top="35" Width="230" Height="230"
                              RenderTransformOrigin=".5,.5">
                            <Grid.RenderTransform><RotateTransform x:Name="SpinRotate"/></Grid.RenderTransform>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="{StaticResource ColorMusicDiskVinylRadial1}" Offset=".6"/>
                                        <GradientStop Color="{StaticResource ColorMusicDiskVinylRadial2}" Offset=".78"/>
                                        <GradientStop Color="{StaticResource ColorMusicDiskVinylRadial3}" Offset=".9"/>
                                        <GradientStop Color="{StaticResource ColorMusicDiskVinylRadial4}" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Stroke="{StaticResource MusicDiskVinylGrooveBrush}" StrokeThickness="2"/>
                            <Ellipse Margin="15" Stroke="{StaticResource MusicDiskVinylGrooveLightBrush}"/>
                            <Ellipse Margin="23" Stroke="{StaticResource MusicDiskVinylGrooveLightBrush}"/>
                            <Ellipse Margin="31" Stroke="{StaticResource MusicDiskVinylGrooveLightBrush}"/>
                            <!-- Обложка в центре пластинки -->
                            <Ellipse Width="148" Height="148" Fill="{StaticResource MusicDiskCenterDefaultBrush}"/>
                            <Ellipse Width="148" Height="148">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding Cover, ElementName=Root}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="9" Height="9" Fill="{StaticResource MusicDiskSpindleBrush}"/>
                        </Grid>

                        <!-- Статичные блики (не вращаются) -->
                        <Path Fill="{StaticResource MusicDiskGlareBrush}" IsHitTestVisible="False"
                              Data="M118,150 L175.5,50.4 A115,115 0 0 1 217.6,92.5 Z M118,150 L60.5,249.6 A115,115 0 0 1 18.4,207.5 Z"/>

                        <!-- Тонарм: поворот вокруг оси (243,92) -->
                        <Canvas Width="270" Height="280" IsHitTestVisible="False">
                            <Canvas.RenderTransform>
                                <RotateTransform x:Name="ArmRotate" Angle="-24" CenterX="243" CenterY="92"/>
                            </Canvas.RenderTransform>
                            <Path Data="M243,92 C238,150 220,200 196,236" Stroke="{StaticResource MusicDiskTonearmBrush}" StrokeThickness="7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Rectangle Canvas.Left="183" Canvas.Top="226" Width="22" Height="34"
                                       RadiusX="6" RadiusY="6" Fill="{StaticResource MusicDiskTonearmHeadBrush}" RenderTransformOrigin=".5,.5">
                                <Rectangle.RenderTransform><RotateTransform Angle="32"/></Rectangle.RenderTransform>
                            </Rectangle>
                        </Canvas>
                        <Ellipse Canvas.Left="221" Canvas.Top="70" Width="44" Height="44" Fill="{StaticResource MusicDiskPivotOuterBrush}"/>
                        <Ellipse Canvas.Left="231" Canvas.Top="80" Width="24" Height="24" Fill="{StaticResource MusicDiskPivotInnerBrush}"/>
                        <Ellipse Canvas.Left="237.5" Canvas.Top="86.5" Width="11" Height="11" Fill="{StaticResource TextWhite}"/>
                    </Canvas>
                </Viewbox>

                <!-- Текст, прогресс, управление -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="26,0,0,0">
                    <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="38" FontWeight="Bold"
                               FontFamily="{StaticResource HeadingFont}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Artist, ElementName=Root}" FontSize="35" FontWeight="Bold"
                               FontFamily="{StaticResource MainFont}"
                               Foreground="{StaticResource MusicDiskArtistBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>

                    <ProgressBar Height="8" Margin="0,26,0,0" Minimum="0"
                                 Maximum="{Binding Duration.TotalSeconds, ElementName=Root}"
                                 Value="{Binding Position.TotalSeconds, ElementName=Root, Mode=OneWay}">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Grid>
                                    <Border x:Name="PART_Track" CornerRadius="4" Background="{StaticResource MusicDiskTrackBarBrush}"/>
                                    <Border x:Name="PART_Indicator" CornerRadius="4" Background="{StaticResource TextWhite}"
                                            HorizontalAlignment="Left"/>
                                </Grid>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>

                    <Grid Margin="0,8,0,0">
                        <TextBlock FontSize="27" FontWeight="Medium" FontFamily="{StaticResource MainFont}" HorizontalAlignment="Left"
                                   Text="{Binding Position, ElementName=Root, StringFormat={}{0:m\\:ss}}"/>
                        <TextBlock FontSize="27" FontWeight="Medium" FontFamily="{StaticResource MainFont}" HorizontalAlignment="Right"
                                   Text="{Binding Duration, ElementName=Root, StringFormat={}{0:m\\:ss}}"/>
                    </Grid>

                    <Grid Margin="4,10,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" HorizontalAlignment="Left" Width="46" Height="46"
                                Style="{StaticResource MusicDiskIconButton}" AutomationProperties.Name="Previous"
                                Command="{Binding PreviousCommand, ElementName=Root}">
                            <Path Width="40" Height="40" Style="{StaticResource Icon}"
                                  Data="M8,8 H13 V40 H8 Z M40,10 L18,24 L40,38 Z"/>
                        </Button>

                        <Button Grid.Column="1" HorizontalAlignment="Center" Width="52" Height="56"
                                Style="{StaticResource MusicDiskIconButton}" AutomationProperties.Name="Play / Pause"
                                Command="{Binding PlayPauseCommand, ElementName=Root}">
                            <Grid Width="40" Height="46">
                                <Path Style="{StaticResource PauseIcon}"
                                      Data="M8,6 H18 V42 H8 Z M30,6 H40 V42 H30 Z" StrokeThickness="6"/>
                                <Path Style="{StaticResource PlayIcon}" Width="34" Data="M13,8 L40,24 L13,40 Z"/>
                            </Grid>
                        </Button>

                        <Button Grid.Column="2" HorizontalAlignment="Right" Width="46" Height="46"
                                Style="{StaticResource MusicDiskIconButton}" AutomationProperties.Name="Next"
                                Command="{Binding NextCommand, ElementName=Root}">
                            <Path Width="40" Height="40" Style="{StaticResource Icon}"
                                  Data="M40,8 H35 V40 H40 Z M8,10 L30,24 L8,38 Z"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
