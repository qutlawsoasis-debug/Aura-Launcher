<UserControl x:Class="AuraLauncher.Controls.ScreenshotsSlide"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:core="clr-namespace:AuraLauncher.Core"
             mc:Ignorable="d" 
             Focusable="False"
             FocusVisualStyle="{x:Null}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <core:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <Grid Margin="16,8,16,16" RenderTransformOrigin="0.5,0.5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,4,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                <TextBlock Text="СКРИНШОТЫ"
                           FontFamily="{StaticResource HeadingFont}"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextWhite}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <Border Height="1" Background="{DynamicResource BorderSubtle}" />
        </StackPanel>

        <!-- 1. Контент: Скриншот или Заглушка -->
        <Grid Grid.Row="1">
            <!-- 1a. Заглушка, когда скриншотов нет -->
            <StackPanel Visibility="{Binding HasLatestScreenshot, Converter={StaticResource InverseBoolToVis}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border Width="56" Height="56"
                        CornerRadius="28"
                        Background="{DynamicResource PanelRaised}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,14">
                    <Path Style="{StaticResource IconPath}"
                          Data="{StaticResource IconCamera}"
                          Width="24" Height="24"
                          Stroke="{DynamicResource DimInkBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="НЕТ СКРИНШОТОВ"
                           FontFamily="{StaticResource HeadingFont}"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextWhite}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6" />
                <TextBlock Text="Нажмите F2 в игре, чтобы сделать снимок"
                           FontFamily="{StaticResource MainFont}"
                           FontSize="12"
                           Foreground="{DynamicResource Text90}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- 1b. Список скриншотов (начинается сверху, 16:9 картинки, 2-3 штуки) -->
            <ScrollViewer Visibility="{Binding HasLatestScreenshot, Converter={StaticResource BoolToVis}}"
                          Style="{StaticResource AuraScrollViewer}"
                          VerticalAlignment="Top"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding RecentScreenshots}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.OpenOverviewScreenshotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource StoryCardBtn}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,10">
                                <Border Background="{DynamicResource StoriesCardGlass}"
                                        BorderBrush="{DynamicResource StoriesCardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 16:9 превью скриншота -->
                                        <Border Grid.Row="0"
                                                Height="114"
                                                Background="{DynamicResource MediaPlaceholder}"
                                                ClipToBounds="True">
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Инфо-полоса внизу карточки -->
                                        <Border Grid.Row="1"
                                                Background="{DynamicResource PanelRaised}"
                                                BorderBrush="{DynamicResource BorderSubtle}"
                                                BorderThickness="0,1,0,0"
                                                Padding="8,5">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Style="{StaticResource IconPath}"
                                                      Data="{StaticResource IconCamera}"
                                                      Width="11" Height="11"
                                                      Stroke="{StaticResource EmberBrush}"
                                                      Margin="0,0,6,0"
                                                      VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DateFormatted}"
                                                           FontFamily="{StaticResource MainFont}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Text90}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- 2. Кнопка действия снизу -->
        <Grid Grid.Row="2">
            <!-- Кнопка, когда есть скриншот -->
            <Button Visibility="{Binding HasLatestScreenshot, Converter={StaticResource BoolToVis}}"
                    Command="{Binding DataContext.OpenOverviewScreenshotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding LatestScreenshot}"
                    Style="{StaticResource SettingsActionBtn}"
                    HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Style="{StaticResource IconPath}"
                          Data="{StaticResource IconImage}"
                          Width="14" Height="14"
                          Margin="0,0,6,0"
                          Stroke="{StaticResource InkBrush}" />
                    <TextBlock Text="Открыть в Мастерской" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Кнопка, когда скриншотов нет -->
            <Button Visibility="{Binding HasLatestScreenshot, Converter={StaticResource InverseBoolToVis}}"
                    Command="{Binding DataContext.OpenOverviewScreenshotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource SettingsActionBtn}"
                    HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Style="{StaticResource IconPath}"
                          Data="{StaticResource IconFolder}"
                          Width="14" Height="14"
                          Margin="0,0,6,0"
                          Stroke="{StaticResource InkBrush}" />
                    <TextBlock Text="Перейти в Мастерскую" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
