<UserControl x:Class="AuraLauncher.Controls.WhatsNewSlide"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Focusable="False"
             FocusVisualStyle="{x:Null}">

    <Grid Margin="16,8,16,16" RenderTransformOrigin="0.5,0.5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок + плашка версии -->
        <StackPanel Grid.Row="0" Margin="0,4,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                <TextBlock Text="ЧТО НОВОГО" FontFamily="{StaticResource HeadingFont}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextWhite}" VerticalAlignment="Center" />
                <Border Background="{StaticResource EmberBrush}" CornerRadius="3" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WhatsNewVersion}" FontFamily="{StaticResource MainFont}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryActionText}" />
                </Border>
            </StackPanel>
            <Border Height="1" Background="{DynamicResource BorderSubtle}" />
        </StackPanel>

        <!-- 3 главных пункта -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding TopWhatsNewLines}" VerticalAlignment="Center">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Style="{StaticResource IconPath}" Data="{StaticResource IconCheck}" Width="12" Height="12" Stroke="{StaticResource EmberBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                        <TextBlock Grid.Column="1" Text="{Binding}" FontFamily="{StaticResource MainFont}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Text90}" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Кнопка "Все изменения" -->
        <Button Grid.Row="2"
                Command="{Binding DataContext.OpenChangelogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                Style="{StaticResource SettingsActionBtn}"
                HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconInfo}" Width="14" Height="14" Margin="0,0,6,0" Stroke="{StaticResource InkBrush}" />
                <TextBlock Text="Все изменения" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
