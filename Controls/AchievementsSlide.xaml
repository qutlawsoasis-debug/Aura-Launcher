<UserControl x:Class="AuraLauncher.Controls.AchievementsSlide"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:core="clr-namespace:AuraLauncher.Core"
             xmlns:models="clr-namespace:AuraLauncher.Models"
             mc:Ignorable="d" 
             Focusable="False"
             FocusVisualStyle="{x:Null}">

    <UserControl.Resources>
        <core:IconKeyToGeometryConverter x:Key="IconKeyToGeom" />
    </UserControl.Resources>

    <Grid Margin="16,8,16,16" RenderTransformOrigin="0.5,0.5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 0: Заголовок и кнопка Список/Сетка -->
            <RowDefinition Height="Auto" />  <!-- 1: Полоса общего прогресса -->
            <RowDefinition Height="*" />     <!-- 2: Содержимое: Список (по умолчанию) или Сетка -->
        </Grid.RowDefinitions>

        <!-- 0. Заголовок "ДОСТИЖЕНИЯ 3 ИЗ 14" и переключатель Список / Сетка -->
        <Grid Grid.Row="0">
            <TextBlock Text="{Binding AchievementsHeaderText, FallbackValue='ДОСТИЖЕНИЯ 3 ИЗ 14'}"
                       FontFamily="{StaticResource HeadingFont}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextWhite}"
                       VerticalAlignment="Center" />

            <!-- Кнопка переключения режимов: стеклянная, высота 28px, текст Onest 12px обычный -->
            <Button x:Name="ViewModeBtn"
                    Click="OnToggleViewModeClick"
                    Style="{StaticResource StoryBarBtn}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Height="28">
                <Border Background="{DynamicResource StoriesCardGlass}"
                        BorderBrush="{DynamicResource StoriesCardBorder}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="10,0"
                        Height="28">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path x:Name="ViewModeIcon"
                              Style="{StaticResource IconPath}"
                              Data="{StaticResource IconGrid}"
                              Width="12" Height="12"
                              Stroke="{DynamicResource TextPrimary}"
                              Margin="0,0,6,0" />
                        <TextBlock x:Name="ViewModeText"
                                   Text="Сетка"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="12"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Button>
        </Grid>

        <!-- 1. Тонкая полоса общего прогресса (3px, Accent на StoriesTrack) -->
        <Border Grid.Row="1"
                Height="3"
                Background="{DynamicResource StoriesTrack}"
                CornerRadius="1.5"
                ClipToBounds="False"
                Margin="0,10,0,14">
            <Border Background="{StaticResource Accent}"
                    CornerRadius="1.5"
                    RenderTransformOrigin="0,0">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="{Binding AchievementsProgressRatio, FallbackValue=0.21}" ScaleY="1" />
                </Border.RenderTransform>
            </Border>
        </Border>

        <!-- 2. Область отображения: Режим "Список" (по умолчанию) и Режим "Сетка" -->
        <Grid Grid.Row="2">
            <!-- Режим "Список" (по умолчанию) -->
            <ScrollViewer x:Name="ListViewContainer"
                          Visibility="Visible"
                          Opacity="1.0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <StackPanel Margin="0,0,4,0">
                    <!-- 1. Полученные достижения сверху -->
                    <ItemsControl ItemsSource="{Binding UnlockedAchievements}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:AchievementDisplayItem}">
                                <Border Margin="0,0,0,8"
                                        Padding="10,8"
                                        Background="{DynamicResource StoriesCardGlass}"
                                        BorderBrush="{DynamicResource StoriesCardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Плитка-иконка 44px: заливка золотистым градиентом, иконка темная, без колец -->
                                        <Border Grid.Column="0"
                                                Width="44" Height="44"
                                                CornerRadius="3"
                                                Background="{DynamicResource AchievementGoldBrush}"
                                                BorderThickness="0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <Path Style="{StaticResource IconPath}"
                                                  Width="20" Height="20"
                                                  Stroke="{DynamicResource PrimaryActionText}"
                                                  Data="{Binding IconKey, Converter={StaticResource IconKeyToGeom}}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>

                                        <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Название (Oswald 15, белый) + дата получения справа -->
                                            <Grid Grid.Row="0">
                                                <TextBlock Text="{Binding Title}"
                                                           FontFamily="{StaticResource HeadingFont}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextWhite}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,60,0" />
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontFamily="{StaticResource MainFont}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Text70}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Описание (Onest 12, Text70) -->
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Description}"
                                                       FontFamily="{StaticResource MainFont}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Text70}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 2. Заголовок "Не получены" -->
                    <TextBlock Text="НЕ ПОЛУЧЕНЫ"
                               FontFamily="{StaticResource HeadingFont}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Text55}"
                               Margin="0,4,0,8" />

                    <!-- 3. Неполученные достижения с полоской прогресса и статусом -->
                    <ItemsControl ItemsSource="{Binding LockedAchievements}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:AchievementDisplayItem}">
                                <Border Margin="0,0,0,8"
                                        Padding="10,8"
                                        Background="{DynamicResource StoriesCardGlass}"
                                        BorderBrush="{DynamicResource StoriesCardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Плитка неполученного: StoriesCardGlass 8%, иконка Text55 55% (хорошо видна) -->
                                        <Border Grid.Column="0"
                                                Width="44" Height="44"
                                                CornerRadius="3"
                                                Background="{DynamicResource StoriesCardGlass}"
                                                BorderThickness="0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <Path Style="{StaticResource IconPath}"
                                                  Width="20" Height="20"
                                                  Stroke="{DynamicResource Text55}"
                                                  Data="{Binding IconKey, Converter={StaticResource IconKeyToGeom}}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>

                                        <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Название (Oswald 15, белый) + прогресс "2 из 5" -->
                                            <Grid Grid.Row="0">
                                                <TextBlock Text="{Binding Title}"
                                                           FontFamily="{StaticResource HeadingFont}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextWhite}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,60,0" />
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontFamily="{StaticResource MainFont}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Text70}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Описание (Onest 12, Text70) -->
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Description}"
                                                       FontFamily="{StaticResource MainFont}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Text70}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,5" />

                                            <!-- Полоска прогресса 3px -->
                                            <Border Grid.Row="2"
                                                    Height="3"
                                                    Background="{DynamicResource StoriesTrack}"
                                                    CornerRadius="1.5">
                                                <Border Background="{StaticResource Accent}"
                                                        CornerRadius="1.5"
                                                        RenderTransformOrigin="0,0">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding ProgressRatio}" ScaleY="1" />
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Режим "Сетка" (3 колонки плиток 64px, название под каждой, ряды заполняют высоту) -->
            <ScrollViewer x:Name="GridViewContainer"
                          Visibility="Collapsed"
                          Opacity="0.0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <ItemsControl ItemsSource="{Binding AchievementsGrid}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:AchievementDisplayItem}">
                            <StackPanel Margin="2,0,2,14" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <!-- Плитка 64x64, тот же стиль (золото для полученных, стекло 8% для неполученных) -->
                                <Border x:Name="GridTile"
                                        Width="64" Height="64"
                                        CornerRadius="3"
                                        Cursor="Hand"
                                        Background="{DynamicResource StoriesCardGlass}"
                                        BorderThickness="0"
                                        MouseEnter="OnAchievementMouseEnter"
                                        MouseLeave="OnAchievementMouseLeave"
                                        Tag="{Binding}">
                                    <Path x:Name="GridTileIcon"
                                          Style="{StaticResource IconPath}"
                                          Width="28" Height="28"
                                          Stroke="{DynamicResource Text55}"
                                          Data="{Binding IconKey, Converter={StaticResource IconKeyToGeom}}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>

                                <!-- Название под каждой плиткой (Onest 11, до 2 строк) -->
                                <TextBlock Text="{Binding Title}"
                                           FontFamily="{StaticResource MainFont}"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text90}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxHeight="32"
                                           Width="76"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                    <Setter TargetName="GridTile" Property="Background" Value="{DynamicResource AchievementGoldBrush}" />
                                    <Setter TargetName="GridTileIcon" Property="Stroke" Value="{DynamicResource PrimaryActionText}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Кастомный Popup для ховера по плитке достижения -->
        <Popup x:Name="AchievementPopup"
               Placement="Bottom"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="True"
               Focusable="False">
            <Border Background="{DynamicResource ChangelogModalBg}"
                    BorderBrush="{DynamicResource StoriesCardBorder}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="12,10"
                    MaxWidth="240">
                <StackPanel>
                    <TextBlock x:Name="PopupTitle"
                               FontFamily="{StaticResource HeadingFont}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextWhite}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="PopupDesc"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="12"
                               Foreground="{DynamicResource Text90}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,6" />
                    <TextBlock x:Name="PopupStatus"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
