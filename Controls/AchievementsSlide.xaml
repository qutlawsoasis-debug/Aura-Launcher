<UserControl x:Class="AuraLauncher.Controls.AchievementsSlide"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:core="clr-namespace:AuraLauncher.Core"
             xmlns:models="clr-namespace:AuraLauncher.Models"
             mc:Ignorable="d" 
             Focusable="False"
             FocusVisualStyle="{x:Null}">

    <UserControl.Resources>
        <core:IconKeyToGeometryConverter x:Key="IconKeyToGeom" />
    </UserControl.Resources>

    <Grid Margin="16,8,16,16" RenderTransformOrigin="0.5,0.5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 0: Заголовок и кнопка Список/Сетка -->
            <RowDefinition Height="Auto" />  <!-- 1: Полоса общего прогресса -->
            <RowDefinition Height="*" />     <!-- 2: Содержимое: Сетка или Список -->
        </Grid.RowDefinitions>

        <!-- 0. Заголовок "ДОСТИЖЕНИЯ 3 ИЗ 14" и переключатель Список / Сетка -->
        <Grid Grid.Row="0">
            <TextBlock Text="{Binding AchievementsHeaderText, FallbackValue='ДОСТИЖЕНИЯ 3 ИЗ 14'}"
                       FontFamily="{StaticResource HeadingFont}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextWhite}"
                       VerticalAlignment="Center" />

            <Button x:Name="ViewModeBtn"
                    Click="OnToggleViewModeClick"
                    Style="{StaticResource StoryBarBtn}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                <Border Background="{DynamicResource StoriesCardGlass}"
                        BorderBrush="{DynamicResource StoriesCardBorder}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="8,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path x:Name="ViewModeIcon"
                              Style="{StaticResource IconPath}"
                              Data="{StaticResource IconList}"
                              Width="12" Height="12"
                              Stroke="{DynamicResource TextPrimary}"
                              Margin="0,0,5,0" />
                        <TextBlock x:Name="ViewModeText"
                                   Text="Список"
                                   FontFamily="{StaticResource MainFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Button>
        </Grid>

        <!-- 1. Тонкая полоса общего прогресса (3px, Accent на StoriesTrack) -->
        <Border Grid.Row="1"
                Height="3"
                Background="{DynamicResource StoriesTrack}"
                CornerRadius="1.5"
                ClipToBounds="False"
                Margin="0,10,0,14">
            <Border Background="{StaticResource Accent}"
                    CornerRadius="1.5"
                    RenderTransformOrigin="0,0">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="{Binding AchievementsProgressRatio, FallbackValue=0.21}" ScaleY="1" />
                </Border.RenderTransform>
            </Border>
        </Border>

        <!-- 2. Область отображения: Режим "Сетка" (по умолчанию) и Режим "Список" -->
        <Grid Grid.Row="2">
            <!-- Режим "Сетка" -->
            <ScrollViewer x:Name="GridViewContainer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <ItemsControl ItemsSource="{Binding AchievementsGrid}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:AchievementDisplayItem}">
                            <Border x:Name="ItemBorder"
                                    Width="44" Height="44"
                                    Margin="4,5"
                                    CornerRadius="22"
                                    Cursor="Hand"
                                    Background="{DynamicResource PanelCard}"
                                    BorderBrush="{DynamicResource BorderSubtle}"
                                    BorderThickness="1"
                                    Opacity="0.35"
                                    MouseEnter="OnAchievementMouseEnter"
                                    MouseLeave="OnAchievementMouseLeave"
                                    Tag="{Binding}">
                                <Path x:Name="ItemIcon"
                                      Style="{StaticResource IconPath}"
                                      Width="20" Height="20"
                                      Stroke="{DynamicResource DimInkBrush}"
                                      Data="{Binding IconKey, Converter={StaticResource IconKeyToGeom}}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PanelRaised}" />
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Accent}" />
                                    <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1.5" />
                                    <Setter TargetName="ItemBorder" Property="Opacity" Value="1.0" />
                                    <Setter TargetName="ItemIcon" Property="Stroke" Value="{StaticResource Accent}" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, ElementName=ItemBorder}" Value="True" />
                                        <Condition Binding="{Binding IsUnlocked}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="ItemBorder" Property="Opacity" Value="0.8" />
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Режим "Список" -->
            <ScrollViewer x:Name="ListViewContainer"
                          Visibility="Collapsed"
                          Opacity="0.0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <StackPanel Margin="0,0,4,0">
                    <!-- 1. Полученные достижения -->
                    <ItemsControl ItemsSource="{Binding UnlockedAchievements}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:AchievementDisplayItem}">
                                <Border Margin="0,0,0,8"
                                        Padding="10,8"
                                        Background="{DynamicResource StoriesCardGlass}"
                                        BorderBrush="{DynamicResource StoriesCardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="40" Height="40"
                                                CornerRadius="20"
                                                Background="{DynamicResource PanelRaised}"
                                                BorderBrush="{StaticResource Accent}"
                                                BorderThickness="1.5"
                                                HorizontalAlignment="Left">
                                            <Path Style="{StaticResource IconPath}"
                                                  Width="18" Height="18"
                                                  Stroke="{StaticResource Accent}"
                                                  Data="{Binding IconKey, Converter={StaticResource IconKeyToGeom}}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontFamily="{StaticResource HeadingFont}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextWhite}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Description}"
                                                       FontFamily="{StaticResource MainFont}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Text90}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,2" />
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontFamily="{StaticResource MainFont}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Accent}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 2. Заголовок "НЕ ПОЛУЧЕНЫ" -->
                    <TextBlock Text="НЕ ПОЛУЧЕНЫ"
                               FontFamily="{StaticResource HeadingFont}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="0,6,0,8" />

                    <!-- 3. Неполученные достижения -->
                    <ItemsControl ItemsSource="{Binding LockedAchievements}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:AchievementDisplayItem}">
                                <Border Margin="0,0,0,8"
                                        Padding="10,8"
                                        Background="{DynamicResource StoriesCardGlass}"
                                        BorderBrush="{DynamicResource StoriesCardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="40" Height="40"
                                                CornerRadius="20"
                                                Background="{DynamicResource PanelCard}"
                                                BorderBrush="{DynamicResource BorderSubtle}"
                                                BorderThickness="1"
                                                Opacity="0.45"
                                                HorizontalAlignment="Left">
                                            <Path Style="{StaticResource IconPath}"
                                                  Width="18" Height="18"
                                                  Stroke="{DynamicResource DimInkBrush}"
                                                  Data="{Binding IconKey, Converter={StaticResource IconKeyToGeom}}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Grid Margin="0,0,0,2">
                                                <TextBlock Text="{Binding Title}"
                                                           FontFamily="{StaticResource HeadingFont}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextWhite}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontFamily="{StaticResource MainFont}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           HorizontalAlignment="Right" />
                                            </Grid>

                                            <TextBlock Text="{Binding Description}"
                                                       FontFamily="{StaticResource MainFont}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Text90}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,5" />

                                            <!-- Тонкая полоска прогресса (3px) -->
                                            <Border Height="3" Background="{DynamicResource StoriesTrack}" CornerRadius="1.5">
                                                <Border Background="{StaticResource Accent}"
                                                        CornerRadius="1.5"
                                                        RenderTransformOrigin="0,0">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding ProgressRatio}" ScaleY="1" />
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Кастомный Popup для ховера по иконке достижения -->
        <Popup x:Name="AchievementPopup"
               Placement="Bottom"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="True"
               Focusable="False">
            <Border Background="{DynamicResource ChangelogModalBg}"
                    BorderBrush="{DynamicResource StoriesCardBorder}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="12,10"
                    MaxWidth="240">
                <StackPanel>
                    <TextBlock x:Name="PopupTitle"
                               FontFamily="{StaticResource HeadingFont}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextWhite}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="PopupDesc"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="12"
                               Foreground="{DynamicResource Text90}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,6" />
                    <TextBlock x:Name="PopupStatus"
                               FontFamily="{StaticResource MainFont}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
